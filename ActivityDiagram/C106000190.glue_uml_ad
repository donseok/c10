  <wire id="3" guardcondition="success" firstRelativePoint="430,210" lastRelativePoint="466,300"/>
  <wire id="4" guardcondition="success" firstRelativePoint="590,210" lastRelativePoint="466,300"/>
  <wire id="5" guardcondition="success" firstRelativePoint="750,210" lastRelativePoint="466,300"/>
  <wire id="6" guardcondition="find" firstRelativePoint="160,112" lastRelativePoint="110,178"/>
  <wire id="7" guardcondition="detailFind" firstRelativePoint="320,112" lastRelativePoint="270,178"/>
  <wire id="8" guardcondition="save" firstRelativePoint="500,112" lastRelativePoint="430,178"/>
  <wire id="9" guardcondition="dupCheck" firstRelativePoint="640,112" lastRelativePoint="590,178"/>
  <wire id="10" guardcondition="delete" firstRelativePoint="800,112" lastRelativePoint="750,178"/>
