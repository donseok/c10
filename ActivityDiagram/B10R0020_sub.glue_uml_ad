  <child xsi:type="Glue:SubServiceActivity" id="51116" location="425,165" size="136,-1" input="//@wire.7" output="//@wire.1 //@wire.6" name="ORD_CHECK">
    <property key="class" value="com.posdata.glue.biz.activity.PosSubBizControlActivity"/>
    <property key="new-transaction" value="false"/>
    <property key="ServiceName" value="C102100010-service"/>
    <property key="description" value="이 Activity Diagram은 품질설계의 생산가부요청에 의한 생산가부체크&#xD;&#xA;항목들을 검증하는 Activity이다. &#xD;&#xA; &#xD;&#xA;- 처리내역&#xD;&#xA;    . 품질설계의뢰정보 수신하여 생산가부에러체크(B10R0030)&#xD;&#xA;    . 주문에러체크 및 정합성을 검증&#xD;&#xA;"/>
  </child>
  <child xsi:type="Glue:Activity" id="51180" location="238,163" size="121,-1" input="//@wire.1" output="//@wire.4" name="STAT_SET_E">
    <property key="class" value="com.unionsteel.mes.c10.activity.common.DbSetParam"/>
