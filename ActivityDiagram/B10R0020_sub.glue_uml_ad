    <property key="param0" value="XSTAT|E"/>
    <property key="param1" value="XSTAT_CALLBACK|R"/>
    <property key="param2" value="XMSGS|생산가부검토 결과테이블을 확인하세요."/>
    <property key="description" value="Service 수행 중에 사용될 Binding 변수 및 사전에 Setting되어야 할 사항에 대해 &#xD;&#xA;초기화 하는 Activity이다. &#xD;&#xA;&#xD;&#xA;- 인터페이스테이블 갱신 내역을 PosContext에 등록한다.&#xD;&#xA;   . PI 처리 상태 (오류:'E', 정상:'S')&#xD;&#xA;   . PI 에러 메세지&#xD;&#xA;   . PI 처리 상태 ('R')"/>
  </child>
  <child xsi:type="Glue:Activity" id="51182" location="243,31" size="107,-1" input="//@wire.13" output="//@wire.14" name="COMMIT_IF">
    <property key="class" value="com.unionsteel.mes.c10.activity.common.DbSetCommit"/>
    <property key="checkId" value="P_ERR_KEY"/>
    <property key="exitFlag" value="N"/>
    <property key="txname" value="tx2"/>
    <property key="description" value="이 Activity는 Commit 처리하는 Activity이다. &#xD;&#xA;&#xD;&#xA;1. checkId와 관계 없이 무조건 Commit 처리한다.&#xD;&#xA;2. exitFlag가 ‘Y’이면 transition=‘exit', 아니면 'success'로 Set&#xD;&#xA;    . 단, 처리 중 오류가 발생하면 'failure'로 Set"/>
  </child>
