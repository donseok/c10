    <property key="param83" value="ORD_MIX_WTH4|ORD_MIX_WTH4"/>
    <property key="param84" value="ORD_MIX_WTH5|ORD_MIX_WTH5"/>
    <property key="param85" value="ORD_MIX_WTH6|ORD_MIX_WTH6"/>
    <property key="param86" value="ORD_MIX_WTH7|ORD_MIX_WTH7"/>
    <property key="param87" value="ORD_MIX_WTH8|ORD_MIX_WTH8"/>
    <property key="param88" value="ORD_MIX_WTH9|ORD_MIX_WTH9"/>
    <property key="param89" value="ORD_MIX_WTH10|ORD_MIX_WTH10"/>
    <property key="param90" value="SLIT_MAX_WGT|SLIT_MAX_WGT"/>
    <property key="param91" value="TRST_PROC_YN|TRST_PROC_YN"/>
