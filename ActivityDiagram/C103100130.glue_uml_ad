  <child xsi:type="Glue:Activity" id="49656" location="413,-169" size="149,-1" input="//@wire.4" output="//@wire.1" name="INIT_QLT_ERR">
    <property key="class" value="com.unionsteel.mes.c10.activity.common.DbSetParam"/>
    <property key="param-count" value="1"/>
