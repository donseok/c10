  <child xsi:type="Glue:Activity" id="51304" location="420,177" size="135,-1" input="//@wire.12 //@wire.13 //@wire.19 //@wire.25" output="//@wire.9 //@wire.10" name="MNF_LOOP">
    <property key="class" value="com.unionsteel.mes.c10.activity.nui.DbQualDesignLoop"/>
