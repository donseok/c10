<Glue:GlueDiagram xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Glue="http://www.glueframework.com/activitydiagram/" id="2" location="20,20" size="100,100">
  <child xsi:type="Glue:InitialState" id="155455" location="318,31" size="-1,-1" output="//@wire.0"/>
  <child xsi:type="Glue:Activity" id="155456" location="258,72" size="158,-1" input="//@wire.0" output="//@wire.15" name="INIT_QLT_ERR">
    <property key="class" value="com.unionsteel.mes.c10.activity.common.DbSetParam"/>
    <property key="param-count" value="1"/>
    <property key="param0" value="P_PROC_FLAG|C"/>
    <property key="description" value="Service 수행 중에 사용될 Binding 변수 및 사전에 Setting되어야 할 사항에 대해 &#xD;&#xA;초기화 하는 Activity이다. &#xD;&#xA;&#xD;&#xA;- 품질설계 오류Code를 초기화한다.(QLT_DSN_ERR_CD=''l)&#xD;&#xA;- 오류발생여부 Check 변수를 초기화한다.(P_ERR_KEY= 'N‘)&#xD;&#xA;- 시스템 오류시 프로세스 처리구분 내역을 등록한다.(P_PROC_FLAG='C‘)&#xD;&#xA;&#xD;&#xA;param0 : QLT_DSN_ERR_CD|sp_null"/>
  </child>
  <child xsi:type="Glue:SearchActivity" id="155457" location="258,187" size="166,-1" input="//@wire.15" output="//@wire.14 //@wire.1" name="SEARCH">
