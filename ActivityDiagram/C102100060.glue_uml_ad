    <property key="param14" value="DGLN_DIF_ULV"/>
    <property key="param15" value="STPN"/>
    <property key="param16" value="TLC"/>
    <property key="description" value="이 Activity는 인수도사양기준을 품질설계결과 품질설계결과인수도(TB_C10_QLT_DSN_DLV)테이블에 &#xD;&#xA;등록하는 Activity이다. &#xD;&#xA;품질설계사양구분(QLT_DSN_SPC_TP)에 고객사양('1')으로 SET한다"/>
  </child>
  <child xsi:type="Glue:Activity" id="50205" location="415,251" size="130,-1" input="//@wire.3" output="//@wire.4" name="ERROR_LOG">
