  <child xsi:type="Glue:Activity" id="51304" location="420,177" size="156,-1" input="//@wire.8 //@wire.13 //@wire.22 //@wire.23 //@wire.24" output="//@wire.9 //@wire.10" name="RMT_LOOP">
