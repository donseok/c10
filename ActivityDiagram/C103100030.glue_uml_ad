    <property key="param4" value="ORD_EXC_WTH|ORD_EXC_WTH"/>
    <property key="param5" value="PRD_NM_CD|PRD_NM_CD"/>
    <property key="param6" value="PRD_SHP|PRD_SHP"/>
    <property key="param7" value="MTL_CD|MTL_CD"/>
    <property key="param8" value="PAS_PROC_NO|PAS_PROC_NO"/>
