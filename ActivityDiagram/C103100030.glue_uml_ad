  </child>
  <child xsi:type="Glue:Activity" id="53081" location="638,102" size="110,-1" input="//@wire.9" output="//@wire.10 //@wire.11" name="ROUTER_CHK">
    <property key="class" value="com.poscoict.glue.biz.dhtmlx.PosValueRouter"/>
    <property key="param-count" value="2"/>
    <property key="param0" value="P_ERR_KEY|N|success"/>
    <property key="param1" value="P_ERR_KEY|Y|error"/>
    <property key="description" value="이 Activity는 이전 서비스의 처리가 정상적으로 완료되었는지를 확인하여&#xD;&#xA;이상종료한 경우 다음 주문을 처리하고, 정상 처리된 경우 후속 서비스를 &#xD;&#xA;처리하는 Activity이다. "/>
