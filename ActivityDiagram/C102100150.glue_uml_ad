<?xml version="1.0" encoding="UTF-8"?>
<Glue:GlueDiagram xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:Glue="http://www.glueframework.com/activitydiagram/" id="3" location="20,20" size="100,100">
  <child xsi:type="Glue:InitialState" id="115" location="479,-162" size="-1,-1" output="//@wire.5"/>
  <child xsi:type="Glue:Activity" id="49656" location="412,-103" size="149,-1" input="//@wire.5" output="//@wire.1" name="INIT_QLT_ERR">
    <property key="class" value="com.unionsteel.mes.c10.activity.common.DbSetParam"/>
    <property key="param-count" value="1"/>
    <property key="param0" value="P_PROC_FLAG|C"/>
    <property key="description" value="Service 수행 중에 사용될 Binding 변수 및 사전에 Setting되어야 할 사항에 대해 &#xD;&#xA;초기화 하는 Activity이다. &#xD;&#xA;&#xD;&#xA;- 품질설계 오류Code를 초기화한다.(QLT_DSN_ERR_CD=''l)&#xD;&#xA;- 오류발생여부 Check 변수를 초기화한다.(P_ERR_KEY= 'N‘)&#xD;&#xA;- 시스템 오류시 프로세스 처리구분 내역을 등록한다.(P_PROC_FLAG='C‘)&#xD;&#xA;&#xD;&#xA;param0 : QLT_DSN_ERR_CD|sp_null"/>
  </child>
  <child xsi:type="Glue:SearchActivity" id="49657" location="414,-36" size="154,-1" input="//@wire.1" output="//@wire.2" name="SEARCH">
    <property key="class" value="com.posdata.glue.biz.activity.PosSearch"/>
    <property key="dao" value="mesdao"/>
    <property key="param-count" value="0"/>
    <property key="resultkey" value="RK_SEARCH"/>
    <property key="sqlkey" value="C102100CMN.Jselect"/>
    <property key="description" value="이 Activity는 품질설계대상 주문정보로 &#xD;&#xA;품질설계상태코드 ='J' 인 값만 &#xD;&#xA;품질설계작업을 수행하는 후속 서비스의 기본 정보로 추출하여 보관하는 Activity이다.    "/>
  </child>
  <child xsi:type="Glue:Activity" id="49675" location="421,31" size="135,-1" input="//@wire.2 //@wire.10 //@wire.12" output="//@wire.4 //@wire.13" name="PROC_LOOP">
    <property key="class" value="com.unionsteel.mes.c10.activity.nui.DbQualDesignLoop"/>
    <property key="bind-result" value="RK_SEARCH"/>
    <property key="countName" value="QLT_DSN_STS_CD_COUNT"/>
    <property key="param-count" value="2"/>
    <property key="param0" value="ORD_NO|ORD_NO"/>
    <property key="param1" value="ORD_LN|ORD_LN"/>
    <property key="description" value="이 Activity는 품질설계상태코드='J'인 주문정보를&#xD;&#xA;주문번호, 주문행번에 기준값에 따라 1건씩 read하는 Activity이다.&#xD;&#xA;&#xD;&#xA;1. 서비스간 정보 Interface를 위해 PosContext에 항목변수를 관리한다.&#xD;&#xA;   - 처리 서비스가 Batch job임을 구분(BATCH_JOB=true)&#xD;&#xA;   - 처리대상 주문 행번 건수를 관리&#xD;&#xA;      . 처리 건수관리 변수의 값이 null인 경우 이전 서비스의 Result set건수를 &#xD;&#xA;        읽어 값을 Setting&#xD;&#xA;      . 처리 건수가 0이 아닌 경우 transition='success', &#xD;&#xA;                         0인 경우 'exit'로 Set하고 종료한다.&#xD;&#xA;2. 처리대상 항목을 저장변수에 등록한다.&#xD;&#xA;3. 후속 서비스에서 사용하는 변수를 초기화하여 등록한다.&#xD;&#xA;   . 자동검토결과 Check 변수(P_AUTO_RESULT= 'N‘)&#xD;&#xA;   . 오류발생여부 Check 변수(P_ERR_KEY= 'N‘)&#xD;&#xA;   . 오류 logging변수 Space처리      &#xD;&#xA;4. 처리대상 건수를 1건 차감한다.&#xD;&#xA;&#xD;&#xA;이 Activity는 품질설계상태코드='J'인 주문정보를&#xD;&#xA;주문번호, 주문행번에 기준값에 따라 1건씩 read하는 Activity이다.&#xD;&#xA;&#xD;&#xA;1. 서비스간 정보 Interface를 위해 PosContext에 항목변수를 관리한다.&#xD;&#xA;   - 처리 서비스가 Batch job임을 구분(BATCH_JOB=true)&#xD;&#xA;   - 처리대상 주문 행번 건수를 관리&#xD;&#xA;      . 처리 건수관리 변수의 값이 null인 경우 이전 서비스의 Result set건수를 &#xD;&#xA;        읽어 값을 Setting&#xD;&#xA;      . 처리 건수가 0이 아닌 경우 transition='success', &#xD;&#xA;                         0인 경우 'exit'로 Set하고 종료한다.&#xD;&#xA;2. 처리대상 항목을 저장변수에 등록한다.&#xD;&#xA;3. 후속 서비스에서 사용하는 변수를 초기화하여 등록한다.&#xD;&#xA;   . 자동검토결과 Check 변수(P_AUTO_RESULT= 'N‘)&#xD;&#xA;   . 오류발생여부 Check 변수(P_ERR_KEY= 'N‘)&#xD;&#xA;   . 오류 logging변수 Space처리      &#xD;&#xA;4. 처리대상 건수를 1건 차감한다.&#xD;&#xA;&#xD;&#xA;이 Activity는 Master Data의 업무기준(단순구조)을 읽어 품질설계에 필요한 &#xD;&#xA;정보를 편성하는 Activity이다. &#xD;&#xA;&#xD;&#xA;1. 편성정보: 고객공통, 고객성분, 고객재질, 고객인수도&#xD;&#xA;   - Master Table Code: Main key기준(C10A1020, C10A1021, C10A1022, C10A1023)&#xD;&#xA;   - Key: 고객사사양번호&#xD;&#xA;             &#xD;&#xA;&#xD;&#xA;2. 편성한 결과는 PosContext에 등록&#xD;&#xA;&#xD;&#xA;3. 오류가 없는 경우 transition='success',&#xD;&#xA;    오류가 있는 경우 'failure'로 Set하고 오류Log 메세지 편집"/>
  </child>
  <child xsi:type="Glue:Activity" id="50091" location="203,30" size="145,-1" input="//@wire.4" output="//@wire.3" name="COMMIT">
    <property key="class" value="com.unionsteel.mes.c10.activity.common.DbSetCommit"/>
    <property key="checkId" value="P_ERR_KEY"/>
    <property key="exitFlag" value="N"/>
    <property key="txname" value="tx1"/>
    <property key="description" value="이 Activity는 판단 변수명을 받아 Commit 또는 Rollback처리하는 Activity이다. &#xD;&#xA;&#xD;&#xA;1. checkId를 확인하여 ‘N’인 경우 Commit, ‘Y’인 경우 Rollback&#xD;&#xA;2. exitFlag가 ‘Y’이면 transition=‘exit', 아니면 'success'로 Set&#xD;&#xA;    . 단, 처리 중 오류가 발생하면 'failure'로 Set"/>
  </child>
  <child xsi:type="Glue:FinalState" id="50093" location="117,36" size="-1,-1" input="//@wire.3"/>
  <child xsi:type="Glue:Activity" id="50646" location="420,205" size="135,-1" input="//@wire.14" output="//@wire.8 //@wire.6" name="SEARCH_MD">
    <property key="class" value="com.unionsteel.mes.c10.activity.nui.DbSearchDeliSpec"/>
    <property key="bind_result" value="RK_RESULT"/>
    <property key="bind-list" value="RK_SEARCH"/>
    <property key="dao" value="mesdao"/>
    <property key="prodSpecKind" value="4"/>
    <property key="description" value="이 Activity는 고객인수도사양 및 규격인수도을 읽어 &#xD;&#xA;보증인수도사양을 편성하는 Activity이다. &#xD;&#xA;&#xD;&#xA;1. 편성정보: 고객인수도사양&#xD;&#xA;    - Table Code: 품질설계결과-인수도(TB_C10_QLT_DSN_DLV)&#xD;&#xA;    - Key: 주문번호, 주문행번, 사양구분 '1'(고객사양)&#xD;&#xA;&#xD;&#xA;2. 편성정보: 규격인수도사양&#xD;&#xA;    - Table Code: 품질설계결과-인숟도(TB_C10_QLT_DSN_DLV)&#xD;&#xA;    - Key: 주문번호, 주문행번, 사양구분 '2'(규격사양)&#xD;&#xA;&#xD;&#xA;3. 항목별 우선순위 사양에따라 보증인수도사양편성&#xD;&#xA;&#xD;&#xA;4. 편성한 결과는 PosContext에 등록&#xD;&#xA;&#xD;&#xA;5. 규격인수도정보가 존재하는 경우 transition='success', 아니면 'failure'로 Set"/>
  </child>
