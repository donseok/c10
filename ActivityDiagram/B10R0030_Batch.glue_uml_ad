    <property key="param116" value="CTR_SHPM_MN|CTR_SHPM_MN"/>
    <property key="param117" value="SVC_CRD_PUB_YN|SVC_CRD_PUB_YN"/>
    <property key="param118" value="PAK_MSG_CD|PAK_MSG_CD"/>
    <property key="param119" value="ORD_TEM_GRP_CD|ORD_TEM_GRP_CD"/>
    <property key="param120" value="PTT_FLM_NOT_ADH_WS|PTT_FLM_NOT_ADH_WS"/>
