<?xml version="1.0" encoding="UTF-8"?>
<service name="B10R0080-service" initial="INIT_QLT_ERR">
  <transaction-manager id="tx1" commit="true" />
  <transaction-manager id="tx2" commit="true" />
  <transaction-manager id="tx4" commit="true" />
  <activity name="COMMIT_IF" class="com.unionsteel.mes.c10.activity.common.DbSetCommit">
    <transition name="success" value="end" />
    <property name="checkId" value="P_ERR_KEY" />
    <property name="txname" value="tx2" />
    <property name="exitFlag" value="N" />
  </activity>
  <activity name="COMMIT" class="com.unionsteel.mes.c10.activity.common.DbSetCommit">
    <transition name="success" value="COMMIT_IF" />
    <property name="checkId" value="P_ERR_KEY" />
    <property name="txname" value="tx4" />
    <property name="exitFlag" value="N" />
  </activity>
  <activity name="insert_CUS" class="com.posdata.glue.biz.activity.PosInsert">
    <transition name="success" value="PROC_LOOP" />
    <transition name="success" value="insert_CUS_Proc" />
    <property name="dao" value="masterdao" />
    <property name="resultkey" value="RK_RESULT" />
    <property name="isAudit" value="true" />
    <property name="param0" value="CUS_CD" />
    <property name="sqlkey" value="B10R0080.insert" />
    <property name="param1" value="CUS_NM" />
    <property name="param-count" value="2" />
  </activity>
  <activity name="STAT_SET" class="com.unionsteel.mes.c10.activity.common.DbSetParam">
    <transition name="success" value="MODIFY_IF" />
    <property name="param0" value="XSTAT|S" />
    <property name="param1" value="XMSGS|sp_null" />
    <property name="param2" value="XSTAT_CALLBACK|sp_null" />
    <property name="param-count" value="3" />
  </activity>
  <activity name="CHECK_CNT_CUS" class="com.unionsteel.mes.c10.activity.nui.DbCheckCnt">
    <transition name="false" value="insert_CUS" />
    <transition name="true" value="modify_CUS" />
    <property name="param0" value="CUS_CD" />
    <property name="dao" value="mesdao" />
    <property name="sqlkey" value="B10R0080.select2" />
    <property name="param-count" value="1" />
  </activity>
  <activity name="MODIFY_IF" class="com.posdata.glue.biz.activity.PosModify">
    <transition name="success" value="PROC_LOOP" />
    <property name="resultkey" value="RK_RESULT" />
    <property name="param-count" value="5" />
    <property name="isAudit" value="true" />
    <property name="dao" value="eaidao" />
    <property name="param0" value="XSTAT" />
    <property name="param1" value="XMSGS" />
    <property name="param2" value="XSTAT_CALLBACK" />
    <property name="sqlkey" value="B10R0080.modify" />
    <property name="param3" value="IF_GRP_ID" />
    <property name="param4" value="SEQ_NO" />
  </activity>
  <activity name="insert_CUS_Proc" class="com.poscoict.glue.biz.dhtmlx.PosProcedureInvoker">
    <transition name="success" value="STAT_SET" />
    <property name="param1" value="IN,CUS_NM" />
    <property name="dao" value="masterdao" />
    <property name="procedure-id" value="PL_M00_CUS_INSERT" />
    <property name="param-count" value="2" />
    <property name="param0" value="IN,CUS_CD" />
  </activity>
  <activity name="INIT_QLT_ERR" class="com.unionsteel.mes.c10.activity.common.DbSetParam">
    <transition name="success" value="SEARCH" />
    <property name="param-count" value="1" />
    <property name="param0" value="P_PROC_FLAG|C" />
  </activity>
  <activity name="update_CUS_Proc" class="com.poscoict.glue.biz.dhtmlx.PosProcedureInvoker">
    <transition name="success" value="STAT_SET" />
    <property name="param1" value="IN,CUS_NM" />
    <property name="dao" value="masterdao" />
    <property name="procedure-id" value="PL_M00_CUS_UPDATE" />
    <property name="param-count" value="2" />
    <property name="param0" value="IN,CUS_CD" />
  </activity>
  <activity name="SEARCH" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="failure" value="end" />
    <transition name="success" value="PROC_LOOP" />
    <property name="dao" value="eaidao" />
    <property name="sqlkey" value="B10R0080.select" />
    <property name="param-count" value="0" />
    <property name="resultkey" value="RK_SEARCH" />
  </activity>
  <activity name="PROC_LOOP" class="com.unionsteel.mes.c10.activity.nui.DbQualDesignLoop">
    <transition name="exit" value="COMMIT" />
