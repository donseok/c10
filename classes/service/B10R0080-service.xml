    <property name="countName" value="QLT_DSN_STS_CD_COUNT" />
    <property name="param-count" value="11" />
    <property name="param0" value="IF_GRP_ID|IF_GRP_ID" />
    <property name="param1" value="SEQ_NO|SEQ_NO" />
    <property name="param2" value="XSEQ|XSEQ" />
