    <property name="param5" value="XMSGS|XMSGS" />
    <property name="param6" value="XDATE|XDATE" />
    <property name="param7" value="XTIME|XTIME" />
    <property name="param8" value="XSTAT_CALLBACK|XSTAT_CALLBACK" />
    <property name="param9" value="CUS_CD|CUS_CD" />
    <property name="bind-result" value="RK_SEARCH" />
    <property name="param10" value="CUS_NM|CUS_NM" />
  </activity>
  <activity name="modify_CUS" class="com.posdata.glue.biz.activity.PosModify">
    <transition name="success" value="PROC_LOOP" />
    <transition name="success" value="update_CUS_Proc" />
    <property name="param-count" value="3" />
    <property name="resultkey" value="RK_RESULT" />
    <property name="isAudit" value="true" />
    <property name="param0" value="CUS_CD" />
    <property name="param1" value="CUS_NM" />
    <property name="param2" value="CUS_CD" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="B10R0080.modify2" />
  </activity>
</service>

