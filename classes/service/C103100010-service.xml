<?xml version="1.0" encoding="UTF-8"?>
<service name="C103100010-service" initial="INIT_QLT_ERR">
  <transaction-manager id="tx1" commit="true" />
  <activity name="COMMIT" class="com.unionsteel.mes.c10.activity.common.DbSetCommit">
    <transition name="success" value="end" />
    <property name="checkId" value="P_ERR_KEY" />
    <property name="txname" value="tx1" />
    <property name="exitFlag" value="N" />
  </activity>
  <activity name="INIT_QLT_ERR" class="com.unionsteel.mes.c10.activity.common.DbSetParam">
    <transition name="success" value="SEARCH" />
    <property name="param-count" value="1" />
    <property name="param0" value="P_PROC_FLAG|C" />
  </activity>
  <activity name="SEARCH_MD" class="com.unionsteel.mes.c10.activity.nui.DbSearchRmtlCdData">
    <transition name="success" value="PROC_LOOP" />
    <transition name="failure" value="SUBSERVICE_ERR" />
    <property name="dao" value="mesdao" />
  </activity>
  <activity name="MODIFY_ERR" class="com.posdata.glue.biz.activity.PosModify">
    <transition name="success" value="PROC_LOOP" />
    <property name="dao" value="mesdao" />
    <property name="resultkey" value="RK_RESULT" />
    <property name="isAudit" value="true" />
    <property name="param0" value="ORD_NO" />
    <property name="sqlkey" value="C1021000CMN.modify" />
    <property name="param1" value="ORD_LN" />
    <property name="param-count" value="2" />
  </activity>
  <activity name="SUBSERVICE_ERR" class="com.posdata.glue.biz.activity.PosSubBizControlActivity">
    <transition name="success" value="MODIFY_ERR" />
    <property name="new-transaction" value="false" />
    <property name="ServiceName" value="C103100140-service" />
  </activity>
  <activity name="SEARCH" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="success" value="PROC_LOOP" />
    <property name="dao" value="mesdao" />
    <property name="sqlkey" value="C102100CMN.Jselect" />
    <property name="param-count" value="0" />
    <property name="resultkey" value="RK_SEARCH" />
  </activity>
  <activity name="PROC_LOOP" class="com.unionsteel.mes.c10.activity.nui.DbQualDesignLoop">
    <transition name="exit" value="COMMIT" />
    <transition name="success" value="SEARCH_MD" />
    <property name="param0" value="ORD_NO|ORD_NO" />
    <property name="param1" value="ORD_LN|ORD_LN" />
    <property name="param2" value="RMTL_CD|RMTL_CD" />
    <property name="param3" value="RMTL_CD1|RMTL_CD1" />
    <property name="param4" value="RMTL_CD2|RMTL_CD2" />
    <property name="param5" value="ORD_EXC_THK|ORD_EXC_THK" />
    <property name="param6" value="RMTL_PRFR_CD|RMTL_PRFR_CD" />
    <property name="countName" value="QLT_DSN_STS_CD_COUNT" />
    <property name="bind-result" value="RK_SEARCH" />
    <property name="param-count" value="7" />
  </activity>
</service>

