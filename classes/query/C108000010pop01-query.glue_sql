<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000010pop01 Page 쿼리파일"> 
	 <query id="C108000010pop01.select" desc="C108000010pop01 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발등록 조회 C108000010pop01.select 전경진 */
    CM.PRD_DEV_NO, 
    TO_CHAR(CM.REQ_RGS_DH,'yyyy-mm-dd HH24:MI') AS REQ_RGS_DH,
    (SELECT EMP_NM
       FROM M90APUSER.TB_M90_EMP_INF
      WHERE EMP_ID = CM.SAL_CHR_PRS_ID) AS SAL_CHR_PRS_ID,
    CM.DEV_PRG_CD,
    CM.CUS_CD,
    CM.USG_CD,
    CM.USE_NAT_CD,
    CM.APP_SIM_RCV_ADDR,
    CM.APP_SIM_RCV_NM,
    CM.APP_SIM_RCV_PHON,
    CM.DEV_REQ_RMK,
    CM.DEV_REQ_FILE,
    TO_CHAR(CM.DEV_RGS_DH,'yyyy-mm-dd HH24:MI') AS DEV_RGS_DH,
    (SELECT EMP_NM
       FROM M90APUSER.TB_M90_EMP_INF
      WHERE EMP_ID = CM.DEV_RECV_CHR_UID) AS DEV_RECV_CHR_UID,
    CM.PROC_SIM_MO,
    CM.DEV_RECV_RMK
FROM C10APUSER.TB_C10_PRD_DEV_CMN  CM
WHERE CM.PRD_DEV_NO = :PRD_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000010pop01.dev_req_update" desc="C108000010pop01 정보 수정(영업원)" isNamed="true">
		 <![CDATA[ 
UPDATE/*+ C10 품질설계 제품개발요구 C108000010pop01.dev_req_update 전경진 */
    C10APUSER.TB_C10_PRD_DEV_CMN  
SET CUS_CD= :CUS_CD,
    USG_CD= :USG_CD,
    USE_NAT_CD= :USE_NAT_CD, 
    APP_SIM_RCV_ADDR=:APP_SIM_RCV_ADDR, 
    APP_SIM_RCV_NM= :APP_SIM_RCV_NM, 
    APP_SIM_RCV_PHON= :APP_SIM_RCV_PHON, 
    DEV_REQ_RMK= :DEV_REQ_RMK, 
    DEV_REQ_FILE= :DEV_REQ_FILE,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
    LAST_UPDATED_OBJECT_ID=:ObjectId,      
    LAST_UPDATE_PROGRAM_ID=:ProgramId,     
    LAST_UPDATE_TIMESTAMP=:Timestamp   
WHERE PRD_DEV_NO = :PRD_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000010pop01.dev_recv_update" desc="C108000010pop01 정보 수정(설계원)" isNamed="true">
		 <![CDATA[ 
UPDATE/*+ C10 품질설계 제품개발등록 C108000010pop01.dev_recv_update 전경진 */
    C10APUSER.TB_C10_PRD_DEV_CMN
SET DEV_RGS_DH= NVL(DEV_RGS_DH, SYSDATE),
    DEV_RECV_CHR_UID= NVL(DEV_RECV_CHR_UID, :DEV_RECV_CHR_UID),
    DEV_PRG_CD = DECODE(DEV_PRG_CD,'20','30',DEV_PRG_CD),
    PROC_SIM_MO= :PROC_SIM_MO,
    DEV_RECV_RMK= :DEV_RECV_RMK,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE PRD_DEV_NO = :PRD_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000010pop01.dev_req_insert" desc="C108000010pop01 정보 추가(영업원)" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 제품개발등록 C108000010pop01.dev_req_insert 전경진*/ 
INTO C10APUSER.TB_C10_PRD_DEV_CMN
(   PRD_DEV_NO, 
    REQ_RGS_DH, 
    SAL_CHR_PRS_ID, 
    DEV_PRG_CD, 
    CUS_CD, 
    USG_CD, 
    USE_NAT_CD, 
    APP_SIM_RCV_ADDR, 
    APP_SIM_RCV_NM, 
    APP_SIM_RCV_PHON, 
    DEV_REQ_RMK, 
    DEV_REQ_FILE, 
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP
)VALUES(
(SELECT 'D'|| MAX(DECODE(CD_TP, 'YR_TP', CD_V))
       || MAX(DECODE(CD_TP, 'MN_TP', CD_V))
 FROM M00APUSER.VI_M00_CODE_ACCESS
 WHERE (CD_TP = 'YR_TP' AND CD_V_MEANING = TO_CHAR(SYSDATE, 'YYYY'))
 OR (CD_TP = 'MN_TP' AND CD_V_MEANING = TO_NUMBER(TO_CHAR(SYSDATE, 'MM')))
 OR (CD_TP = 'DD_TP' AND CD_V_MEANING = TO_NUMBER(TO_CHAR(SYSDATE, 'DD')))
) || TO_CHAR(LPAD(C10APUSER.SQ_C10_PRD_DEV_CMN.NEXTVAL,3,0))
,SYSDATE
,:SAL_CHR_PRS_ID
,'20'
,:CUS_CD
,:USG_CD
,:USE_NAT_CD
,:APP_SIM_RCV_ADDR
,:APP_SIM_RCV_NM
,:APP_SIM_RCV_PHON
,:DEV_REQ_RMK
,:DEV_REQ_FILE
,:ObjectType
,:ObjectId
,:ProgramId
,:Timestamp
,:ObjectType
,:ObjectId
,:ProgramId
,:Timestamp)
		 ]]> 
	 </query>
	 <query id="C108000010pop01.dev_recv_insert" desc="C108000010pop01 정보 추가(설계원)" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 제품개발등록 C108000010pop01.dev_recv_insert 전경진*/
INTO C10APUSER.TB_C10_PRD_DEV_CMN
(   PRD_DEV_NO, 
    REQ_RGS_DH, 
    SAL_CHR_PRS_ID, 
    DEV_PRG_CD, 
    CUS_CD, 
    USG_CD, 
    USE_NAT_CD, 
    APP_SIM_RCV_ADDR, 
    APP_SIM_RCV_NM, 
    APP_SIM_RCV_PHON, 
    DEV_REQ_RMK, 
    DEV_REQ_FILE, 
    DEV_RGS_DH, 
    DEV_RECV_CHR_UID, 
    PROC_SIM_MO, 
    DEV_RECV_RMK, 
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP
)VALUES(
(SELECT 'D'|| MAX(DECODE(CD_TP, 'YR_TP', CD_V))
       || MAX(DECODE(CD_TP, 'MN_TP', CD_V))
 FROM M00APUSER.VI_M00_CODE_ACCESS
 WHERE (CD_TP = 'YR_TP' AND CD_V_MEANING = TO_CHAR(SYSDATE, 'YYYY'))
 OR (CD_TP = 'MN_TP' AND CD_V_MEANING = TO_NUMBER(TO_CHAR(SYSDATE, 'MM')))
 OR (CD_TP = 'DD_TP' AND CD_V_MEANING = TO_NUMBER(TO_CHAR(SYSDATE, 'DD')))
) || TO_CHAR(LPAD(C10APUSER.SQ_C10_PRD_DEV_CMN.NEXTVAL,3,0))
,SYSDATE
,:SAL_CHR_PRS_ID
,'30'
,:CUS_CD
,:USG_CD
,:USE_NAT_CD
,:APP_SIM_RCV_ADDR
,:APP_SIM_RCV_NM
,:APP_SIM_RCV_PHON
,:DEV_REQ_RMK
,:DEV_REQ_FILE
,:DEV_RGS_DH
,:DEV_RECV_CHR_UID
,:PROC_SIM_MO
,:DEV_RECV_RMK
,:ObjectType
,:ObjectId
,:ProgramId
,:Timestamp
,:ObjectType
,:ObjectId
,:ProgramId
,:Timestamp)
		 ]]> 
	 </query>
</queryMap>
