<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000030"> 
	 <query id="C104000030.select" desc="C104000030 정보 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-에러현황 C104000030.select 박재영 */
       TB_C10_QLT_DSN_ERR.ORD_NO
      ,TB_C10_QLT_DSN_ERR.ORD_LN
      ,TB_C10_QLT_DSN_ERR.QLT_DSN_ERR_CD
      ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'QLT_DSN_ERR_CD' 
         AND   CD_V = TB_C10_QLT_DSN_ERR.QLT_DSN_ERR_CD) QLT_DSN_ERR_DESC
      ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'QLT_DSN_ERR_SOL_CD' 
         AND   CD_V = TB_C10_QLT_DSN_ERR.QLT_DSN_ERR_CD) QLT_DSN_ERR_SOL_DESC   
      ,TB_C10_QLT_DSN_CMN.ORD_BAK_SND_CAU
      ,TO_CHAR(TB_C10_QLT_DSN_ERR.QLT_DSN_ERR_DD, 'YYYY-MM-DD') QLT_DSN_ERR_DD
   FROM
      TB_C10_QLT_DSN_ERR, TB_C10_QLT_DSN_CMN
   WHERE TB_C10_QLT_DSN_ERR.ORD_NO = TB_C10_QLT_DSN_CMN.ORD_NO
         AND TB_C10_QLT_DSN_ERR.ORD_LN = TB_C10_QLT_DSN_CMN.ORD_LN
         AND TB_C10_QLT_DSN_CMN.QLT_DSN_STS_CD IN ('J','E')
         AND NVL(TB_C10_QLT_DSN_CMN.ORD_BAK_SND_TP,'@') LIKE DECODE(:ORD_BAK_SND_TP,'1','@','')||'%'
         AND TB_C10_QLT_DSN_ERR.QLT_DSN_ERR_DD BETWEEN TO_DATE(DECODE(:ORD_NO||:ORD_LN,'',:QLT_DSN_END_DH_STR,NVL(:QLT_DSN_END_DH_STR, '1900-01-01')),'YYYY-MM-DD')  
         AND TO_DATE(DECODE(:ORD_NO||:ORD_LN,'',:QLT_DSN_END_DH_END,NVL(:QLT_DSN_END_DH_END, '3000-12-31')),'YYYY-MM-DD') + 1
         AND TB_C10_QLT_DSN_ERR.ORD_NO LIKE :ORD_NO||'%' 
         AND TB_C10_QLT_DSN_ERR.ORD_LN LIKE :ORD_LN||'%'
         AND    NOT EXISTS (SELECT * FROM MESAPUSER.VI_MES_TRM_CTL 
                           WHERE CTL_NO = TB_C10_QLT_DSN_CMN.ORD_NO AND CTL_TP = 'O')
ORDER BY TB_C10_QLT_DSN_ERR.QLT_DSN_ERR_DD, TB_C10_QLT_DSN_ERR.ORD_NO, TB_C10_QLT_DSN_ERR.ORD_LN
		 ]]> 
	 </query>
</queryMap>
