<queryMap desc="C107000020tab09 Page 쿼리파일"> 
	 <query id="C107000020tab09.select" desc="C107000020tab09 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  
 DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 PRT_ROLL_NO
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_1 PRT_ROLL_QTY
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_1 RPV_CLR_NM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_2 PRC_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_3 PTN_NM

,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_4 PRT_PTN_NM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_5 PRT_PTN_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_6 PRT_ROLL_PTN_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_7 USG_NM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_8 EAR_USG_NM

,DATAS010.MD_MRG_BAS_DATA_NUM_TP_2 PRT_ROLL_DIA
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_3 PRT_ROLL_CRCM
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_4 PRT_ROLL_WTH
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_5  PRT_ROLL_ENGR
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_9  PRT_ROLL_CMP

,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_10 PRT_ROLL_MNF_DD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_11 PRT_ROLL_WHS_DD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_12 PRT_ROLL_CRYT_DD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_13 PRT_BABY_ROLL
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_14 WHS_CRYT_REA

,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_15 FCT_NM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_16 PRT_ROLL_CTD_LOC
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_17 PRT_ROLL_LOT_NO
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_18 PRT_ROLL_CHR_NM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_19 PRT_ROLLTXT

FROM M00APUSER.TB_M00_DATAS010 DATAS010, 
(SELECT MDL_DEFINE_ID  
FROM M00APUSER.TB_M00_DEFINES010 
WHERE MDL_DEFINE_NM='C10A1091' 
AND START_ACTIVE_DATE <=  SYSDATE 
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010 
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
ORDER BY MD_MRG_BAS_KEY_CHAR_TP_1
		 ]]> 
	 </query>
</queryMap>
