<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C103100130"> 
	 <query id="C103100130CMN.Jselect" desc="정합성체크를위한쿼리" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT A.*, NVL(B.CUT_LN_YN,'N') AS CUT_LN_YN                             
   FROM TB_C10_QLT_DSN_CMN A,
        TB_C10_QLT_DSN_CCL_BOM B
WHERE A.ORD_NO = B.ORD_NO(+)
  AND A.ORD_LN = B.ORD_LN(+)
  AND QLT_DSN_STS_CD ='J'
		 ]]> 
	 </query>
	 <query id="C103100130.AttOrdInsert" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 관심주문SMS전송대상 C103100130.AttOrdInsert 이돈석*/
            C10APUSER.TB_C10_ATT_ORD_MNG
            (
                  ORD_NO 
                , ORD_LN
                , ATT_ORD_RGS_ID
                , ATT_ORD_RGS_DH
                , ATT_RGS_TP
                , CREATED_OBJECT_TYPE         
                , CREATED_OBJECT_ID        
                , CREATED_PROGRAM_ID      
                , CREATION_TIMESTAMP     
                , LAST_UPDATED_OBJECT_TYPE
                , LAST_UPDATED_OBJECT_ID  
                , LAST_UPDATE_PROGRAM_ID  
                , LAST_UPDATE_TIMESTAMP     
            )
VALUES
            (
                  :ORD_NO
                , :ORD_LN
                , :ObjectId
                , sysdate
                , 'A'
                , :ObjectType
                , :ObjectId
                , :ProgramId
                , :Timestamp
                , :ObjectType
                , :ObjectId
                , :ProgramId
                , :Timestamp
            )
		 ]]> 
	 </query>
</queryMap>
