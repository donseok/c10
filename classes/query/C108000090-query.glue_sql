<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000090 Page 쿼리파일"> 
	 <query id="C108000090.selectReqSpec" desc="제품개발요청Spec 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발의뢰BOM 조회 C108000090.selectReqSpec 전경진 */
    SP.PRD_DEV_NO,
    SP.DEV_REQ_SPEC_NO,
    DECODE(SP.CLR_DEV_TP,'D','디자인','C','색상') AS CLR_DEV_TP,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PRD_NM_CD'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SP.PRD_NM_CD) AS PRD_NM_CD,
    SP.CUS_REQ_HUE_TXT,
    SP.COT_MTH ||'-'
    ||(SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'COT_MTH'
       AND CATEGORY_GROUP_NM = 'SZ0000'
       AND CD_V = SP.COT_MTH) AS COT_MTH,
    SP.RSN_TP,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'TLP_TP'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SP.TLP_TP) AS TLP_TP,
    SP.RL_LUS_RT,
    SP.PNT_FLM_THK_TXT,
    SP.PTT_FLM_YN,
    SP.ORD_PRE_WGT,
   (SELECT CD_V_MEANING
      FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP IN ('DEV_REF_TP_CLR','DEV_REF_TP_DESN')
       AND CATEGORY_GROUP_NM = 'SZ0000'
       AND CD_V = SP.DEV_REF_TP) AS DEV_REF_TP,
    SP.REF_CLR_CD_TXT,
    SP.REF_CCL_BOM,
    SP.SIM_HUE_PRG_YN
FROM  C10APUSER.TB_C10_PRD_DEV_SPEC SP
WHERE SP.PRD_DEV_NO = :PRD_DEV_NO		 
AND   SP.DEV_REQ_SPEC_NO = NVL(:DEV_REQ_SPEC_NO,SP.DEV_REQ_SPEC_NO)
ORDER BY SP.DEV_REQ_SPEC_NO
		 ]]> 
	 </query>
	 <query id="C108000090.selectReqBom" desc="제품개발의뢰BOM 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발의뢰BOM 조회 C108000090.selectReqBom 전경진 */
    BM.PRD_DEV_NO, 
    BM.DEV_REQ_SPEC_NO, 
    BM.DEV_REQ_BOM_NO, 
    BM.HUE_CD_FRN_1COT, 
    BM.HUE_CD_FRN_2COT, 
    BM.HUE_CD_FRN_3COT, 
    BM.HUE_CD_FRN_4COT, 
    BM.HUE_CD_BAK_1COT, 
    BM.HUE_CD_BAK_2COT, 
    BM.HUE_CD_BAK_3COT, 
    BM.HUE_CD_BAK_4COT, 
    BM.HUE_CD_LMN, 
    BM.PRT_ROLL_NO1, 
    BM.PRT_INK_CD1, 
    BM.PRT_ROLL_NO2, 
    BM.PRT_INK_CD2, 
    BM.PRT_ROLL_NO3, 
    BM.PRT_INK_CD3, 
    BM.PRT_ROLL_NO4, 
    BM.PRT_INK_CD4, 
    BM.UNI_TEX_ROLL_NO, 
    BM.PICK_UP_ROLL_NO, 
    BM.IMPT_ROLL_NO, 
    BM.SIM_HUE_PRG_YN, 
    BM.PNT_CMP_CD, 
    BM.COT_MTH, 
    BM.RSN_TP, 
    BM.TLP_TP, 
    RL_LUS_RT, 
    BM.PNT_FLM_THK_TXT, 
    BM.LMN_BND_CMP_CD, 
    BM.LMN_KND_TP, 
    BM.LMN_FLM_THK, 
    BM.DSN_SIM_FILE, 
    BM.PRT_BY_ROLL_CMP_CD, 
    BM.SPC_PRD_AF_WK,
    IMG.IMG_NM,
    DECODE(IMG.IMG_NM,null,'N','Y') AS FILE_YN,
    IMG.IMG_ADR
FROM C10APUSER.TB_C10_PRD_DEV_REQ_BOM BM,
(SELECT PRD_DEV_NO
             ,MAX(SEQ_NO)
             ,MAX(IMG_NM) IMG_NM
             ,MAX(IMG_ADR) IMG_ADR
             FROM TB_C10_PRD_DEV_IMG
      GROUP BY PRD_DEV_NO) IMG
WHERE BM.PRD_DEV_NO||BM.DEV_REQ_SPEC_NO||BM.DEV_REQ_BOM_NO = IMG.PRD_DEV_NO (+)
AND   BM.PRD_DEV_NO = :PRD_DEV_NO
AND   BM.DEV_REQ_SPEC_NO = :DEV_REQ_SPEC_NO
ORDER BY BM.DEV_REQ_BOM_NO
		 ]]> 
	 </query>
	 <query id="C108000090.updateReqBom" desc="제품개발의뢰BOM 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 제품개발의뢰BOM 수정 C108000090.updateReqBom 전경진 */
    C10APUSER.TB_C10_PRD_DEV_REQ_BOM RB
SET RB.HUE_CD_FRN_1COT= :HUE_CD_FRN_1COT, 
    RB.HUE_CD_FRN_2COT= :HUE_CD_FRN_2COT, 
    RB.HUE_CD_FRN_3COT= :HUE_CD_FRN_3COT, 
    RB.HUE_CD_FRN_4COT= :HUE_CD_FRN_4COT, 
    RB.HUE_CD_BAK_1COT= :HUE_CD_BAK_1COT, 
    RB.HUE_CD_BAK_2COT= :HUE_CD_BAK_2COT, 
    RB.HUE_CD_BAK_3COT= :HUE_CD_BAK_3COT, 
    RB.HUE_CD_BAK_4COT= :HUE_CD_BAK_4COT, 
    RB.HUE_CD_LMN= :HUE_CD_LMN, 
    RB.PRT_ROLL_NO1= :PRT_ROLL_NO1, 
    RB.PRT_INK_CD1= :PRT_INK_CD1, 
    RB.PRT_ROLL_NO2= :PRT_ROLL_NO2, 
    RB.PRT_INK_CD2= :PRT_INK_CD2, 
    RB.PRT_ROLL_NO3= :PRT_ROLL_NO3, 
    RB.PRT_INK_CD3= :PRT_INK_CD3, 
    RB.PRT_ROLL_NO4= :PRT_ROLL_NO4, 
    RB.PRT_INK_CD4= :PRT_INK_CD4, 
    RB.UNI_TEX_ROLL_NO= :UNI_TEX_ROLL_NO, 
    RB.PICK_UP_ROLL_NO= :PICK_UP_ROLL_NO, 
    RB.IMPT_ROLL_NO= :IMPT_ROLL_NO, 
    RB.SIM_HUE_PRG_YN= :SIM_HUE_PRG_YN, 
    RB.PNT_CMP_CD= :PNT_CMP_CD, 
    RB.COT_MTH= :COT_MTH, 
    RB.RSN_TP= :RSN_TP, 
    RB.TLP_TP= :TLP_TP, 
    RB.RL_LUS_RT= :RL_LUS_RT, 
    RB.PNT_FLM_THK_TXT= :PNT_FLM_THK_TXT, 
    RB.LMN_BND_CMP_CD= :LMN_BND_CMP_CD, 
    RB.LMN_KND_TP= :LMN_KND_TP, 
    RB.LMN_FLM_THK= :LMN_FLM_THK, 
    RB.DSN_SIM_FILE= :DSN_SIM_FILE, 
    RB.PRT_BY_ROLL_CMP_CD= :PRT_BY_ROLL_CMP_CD, 
    RB.SPC_PRD_AF_WK= :SPC_PRD_AF_WK,
    RB.LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    RB.LAST_UPDATED_OBJECT_ID=:ObjectId,  
    RB.LAST_UPDATE_PROGRAM_ID=:ProgramId,
    RB.LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE RB.PRD_DEV_NO = :PRD_DEV_NO
AND   RB.DEV_REQ_SPEC_NO = :DEV_REQ_SPEC_NO
AND   RB.DEV_REQ_BOM_NO= :DEV_REQ_BOM_NO
AND  NOT EXISTS
	(SELECT 'X'
     FROM C10APUSER.TB_C10_PRD_DEV_CMP_BOM CB
     WHERE CB.PRD_DEV_NO = RB.PRD_DEV_NO
	 AND   CB.DEV_REQ_SPEC_NO = RB.DEV_REQ_SPEC_NO
	 AND   CB.DEV_REQ_BOM_NO= RB.DEV_REQ_BOM_NO)
		 ]]> 
	 </query>
	 <query id="C108000090.insertReqBom" desc="제품개발의뢰BOM 삽입" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 제품개발의뢰BOM 등록 C108000090.insertReqBom 전경진*/
INTO C10APUSER.TB_C10_PRD_DEV_REQ_BOM
(   PRD_DEV_NO, 
    DEV_REQ_SPEC_NO, 
    DEV_REQ_BOM_NO, 
    HUE_CD_FRN_1COT, 
    HUE_CD_FRN_2COT, 
    HUE_CD_FRN_3COT, 
    HUE_CD_FRN_4COT, 
    HUE_CD_BAK_1COT, 
    HUE_CD_BAK_2COT, 
    HUE_CD_BAK_3COT, 
    HUE_CD_BAK_4COT, 
    HUE_CD_LMN, 
    PRT_ROLL_NO1, 
    PRT_INK_CD1, 
    PRT_ROLL_NO2, 
    PRT_INK_CD2, 
    PRT_ROLL_NO3, 
    PRT_INK_CD3, 
    PRT_ROLL_NO4, 
    PRT_INK_CD4, 
    UNI_TEX_ROLL_NO, 
    PICK_UP_ROLL_NO, 
    IMPT_ROLL_NO, 
    SIM_HUE_PRG_YN, 
    PNT_CMP_CD, 
    COT_MTH, 
    RSN_TP, 
    TLP_TP, 
    RL_LUS_RT, 
    PNT_FLM_THK_TXT, 
    LMN_BND_CMP_CD, 
    LMN_KND_TP, 
    LMN_FLM_THK, 
    DSN_SIM_FILE, 
    PRT_BY_ROLL_CMP_CD, 
    SPC_PRD_AF_WK,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP
)VALUES(
	:PRD_DEV_NO
	,:DEV_REQ_SPEC_NO
	,TO_CHAR(
	 (SELECT TO_NUMBER(NVL(MAX(DEV_REQ_BOM_NO), '20')) + 1
	  FROM   C10APUSER.TB_C10_PRD_DEV_REQ_BOM
	  WHERE  PRD_DEV_NO= :PRD_DEV_NO
	  AND    DEV_REQ_SPEC_NO= :DEV_REQ_SPEC_NO))
	,:HUE_CD_FRN_1COT
	,:HUE_CD_FRN_2COT
	,:HUE_CD_FRN_3COT
	,:HUE_CD_FRN_4COT
	,:HUE_CD_BAK_1COT
	,:HUE_CD_BAK_2COT
	,:HUE_CD_BAK_3COT
	,:HUE_CD_BAK_4COT
	,:HUE_CD_LMN
	,:PRT_ROLL_NO1
	,:PRT_INK_CD1
	,:PRT_ROLL_NO2
	,:PRT_INK_CD2 
	,:PRT_ROLL_NO3
	,:PRT_INK_CD3 
	,:PRT_ROLL_NO4
	,:PRT_INK_CD4
	,:UNI_TEX_ROLL_NO
	,:PICK_UP_ROLL_NO
	,:IMPT_ROLL_NO
	,:SIM_HUE_PRG_YN
	,:PNT_CMP_CD
	,:COT_MTH
	,:RSN_TP
	,:TLP_TP
	,:RL_LUS_RT
	,:PNT_FLM_THK_TXT
	,:LMN_BND_CMP_CD
	,:LMN_KND_TP 
	,:LMN_FLM_THK 
	,:DSN_SIM_FILE
	,:PRT_BY_ROLL_CMP_CD
	,:SPC_PRD_AF_WK
	,:ObjectType
	,:ObjectId
	,:ProgramId
	,:Timestamp
	,:ObjectType
	,:ObjectId
	,:ProgramId
	,:Timestamp)
		 ]]> 
	 </query>
	 <query id="C108000090.deleteReqBom" desc="제품개발의뢰BOM 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 제품개발의뢰BOM 삭제 C108000090.deleteReqBom 전경진 */
    C10APUSER.TB_C10_PRD_DEV_REQ_BOM RB
WHERE RB.PRD_DEV_NO= :PRD_DEV_NO
AND   RB.DEV_REQ_SPEC_NO= :DEV_REQ_SPEC_NO
AND   RB.DEV_REQ_BOM_NO= :DEV_REQ_BOM_NO
AND  NOT EXISTS
	(SELECT 'X'
     FROM C10APUSER.TB_C10_PRD_DEV_CMP_BOM CB
     WHERE CB.PRD_DEV_NO = RB.PRD_DEV_NO
	 AND   CB.DEV_REQ_SPEC_NO = RB.DEV_REQ_SPEC_NO
	 AND   CB.DEV_REQ_BOM_NO= RB.DEV_REQ_BOM_NO)
		 ]]> 
	 </query>
	 <query id="C108000090.updateDevCmn" desc="제품개발의뢰BOM 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 제품개발공통 진도 수정 C108000090.updateDevCmn 전경진 */
    C10APUSER.TB_C10_PRD_DEV_CMN
SET DEV_PRG_CD= 
    (SELECT CASE WHEN 
           (SELECT COUNT(PRD_DEV_NO)
            FROM TB_C10_PRD_DEV_REQ_BOM RB
            WHERE PRD_DEV_NO = :PRD_DEV_NO
            AND ((COT_MTH = '1'
                AND HUE_CD_FRN_1COT IS NOT NULL  
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = '2'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_BAK_1COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = '3'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = '4'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_BAK_1COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = '5'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = '6'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = '7'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL
                AND HUE_CD_BAK_1COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = '8'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = '9'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL AND HUE_CD_BAK_3COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = 'A'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = 'B'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND HUE_CD_BAK_1COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = 'C'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = 'D'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL AND HUE_CD_BAK_3COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = 'E'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL AND HUE_CD_BAK_3COT IS NOT NULL AND HUE_CD_BAK_4COT IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL) OR
                (COT_MTH = 'F'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL AND HUE_CD_BAK_3COT IS NOT NULL AND HUE_CD_BAK_4COT IS NOT NULL
                AND PRT_ROLL_NO1 IS NOT NULL    AND PRT_INK_CD1 IS NOT NULL     AND PRT_ROLL_NO2 IS NOT NULL    AND PRT_INK_CD2 IS NOT NULL
                AND PRT_ROLL_NO3 IS NOT NULL    AND PRT_INK_CD3 IS NOT NULL     AND PRT_ROLL_NO4 IS NOT NULL    AND PRT_INK_CD4 IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL AND PRT_BY_ROLL_CMP_CD IS NOT NULL) OR
                (COT_MTH = 'G'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL AND HUE_CD_BAK_3COT IS NOT NULL AND HUE_CD_BAK_4COT IS NOT NULL
                AND PRT_ROLL_NO2 IS NOT NULL    AND PRT_INK_CD2 IS NOT NULL
                AND PRT_ROLL_NO3 IS NOT NULL    AND PRT_INK_CD3 IS NOT NULL     AND PRT_ROLL_NO4 IS NOT NULL    AND PRT_INK_CD4 IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL AND PRT_BY_ROLL_CMP_CD IS NOT NULL) OR
                (COT_MTH = 'H'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL AND HUE_CD_BAK_3COT IS NOT NULL AND HUE_CD_BAK_4COT IS NOT NULL
                AND PRT_ROLL_NO3 IS NOT NULL    AND PRT_INK_CD3 IS NOT NULL     AND PRT_ROLL_NO4 IS NOT NULL    AND PRT_INK_CD4 IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL AND PRT_BY_ROLL_CMP_CD IS NOT NULL) OR
                (COT_MTH = 'J'
                AND HUE_CD_FRN_1COT IS NOT NULL AND HUE_CD_FRN_2COT IS NOT NULL AND HUE_CD_FRN_3COT IS NOT NULL AND HUE_CD_FRN_4COT IS NOT NULL 
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL AND HUE_CD_BAK_3COT IS NOT NULL AND HUE_CD_BAK_4COT IS NOT NULL
                AND PRT_ROLL_NO4 IS NOT NULL    AND PRT_INK_CD4 IS NOT NULL
                AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND RSN_TP IS NOT NULL
                AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL       AND PNT_FLM_THK_TXT IS NOT NULL AND PRT_BY_ROLL_CMP_CD IS NOT NULL) OR    
                (COT_MTH IN ('X','Y','Z')
                AND HUE_CD_BAK_1COT IS NOT NULL AND HUE_CD_BAK_2COT IS NOT NULL AND HUE_CD_BAK_3COT IS NOT NULL AND HUE_CD_BAK_4COT IS NOT NULL
                AND HUE_CD_LMN IS NOT NULL      AND UNI_TEX_ROLL_NO IS NOT NULL AND PICK_UP_ROLL_NO IS NOT NULL AND IMPT_ROLL_NO IS NOT NULL
                AND SIM_HUE_PRG_YN IS NOT NULL  AND PNT_CMP_CD IS NOT NULL      AND TLP_TP IS NOT NULL          AND RL_LUS_RT IS NOT NULL
                AND LMN_BND_CMP_CD IS NOT NULL  AND LMN_KND_TP IS NOT NULL      AND LMN_FLM_THK IS NOT NULL ))) > 0 
             THEN '40'
             ELSE '30'
            END AS DEV_PRG_CD_CHK
      FROM DUAL),
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE PRD_DEV_NO = :PRD_DEV_NO
AND   DEV_PRG_CD IN ('20','30')
		 ]]> 
	 </query>
	 <query id="C108000090.selectCmpBomChk" desc="개발 완료 진행 확인" isNamed="true">
		 <![CDATA[ 
SELECT
	NVL((SELECT 'Y'
		FROM  C10APUSER.TB_C10_PRD_DEV_CMP_BOM
		WHERE PRD_DEV_NO = :PRD_DEV_NO
		AND   DEV_REQ_SPEC_NO = :DEV_REQ_SPEC_NO
		AND   DEV_REQ_BOM_NO= :DEV_REQ_BOM_NO
		AND   ROWNUM = 1),'N') AS DEV_CMP_BOM_YN
FROM DUAL
		 ]]> 
	 </query>
</queryMap>
