<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab12 Page 쿼리파일"> 
	 <query id="C107000020tab12.select" desc="C107000020tab12 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  
 DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 PTT_FLM_PRD_ADH_CD
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_1 PTT_FLM_PRD_ADH_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_2 PTT_FLM_PRD_ADH_ULV
FROM M00APUSER.TB_M00_DATAS010 DATAS010, 
(SELECT MDL_DEFINE_ID  
FROM M00APUSER.TB_M00_DEFINES010 
WHERE MDL_DEFINE_NM='C10A2040' 
AND START_ACTIVE_DATE <=  SYSDATE 
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010 
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
ORDER BY DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1
		 ]]> 
	 </query>
</queryMap>
