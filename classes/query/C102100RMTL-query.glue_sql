<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C102100RMTL"> 
	 <query id="C102100RMTL.insert" desc="인수도 사양 등록" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT INTO  /*+ C10 원자재코드등록 C102100RMTL.INSERT 박재영*/                         
TB_C10_QLT_DSN_RMT(                                                                           
             ORD_NO                   --주문번호                                                                                 
            ,ORD_LN                   --주문행번                                                                              
            ,QLT_DSN_MNF_TP			--품질설계제조구분
            ,RMTL_CD			--원자재코드
            ,RMTL_GRD			--원자재등급
            ,CREATED_OBJECT_TYPE        --생성OBJECT유형    
            ,CREATED_OBJECT_ID          --생성OBJECTID      
            ,CREATED_PROGRAM_ID         --생성프로그램ID    
            ,CREATION_TIMESTAMP         --생성일시          
            ,LAST_UPDATED_OBJECT_TYPE   --최종변경OBJECT유형
            ,LAST_UPDATED_OBJECT_ID     --최종변경OBJECTID  
            ,LAST_UPDATE_PROGRAM_ID     --최종변경프로그램ID
            ,LAST_UPDATE_TIMESTAMP      --최종변경일시      
)                                                                                              
VALUES                                                                                         
(                                                                                              
?, ?, ?, ?, ?,                                                                                    
?, ?, ?, ?,                                                                                    
?, ?, ?, ?                                                                                     
)
		 ]]> 
	 </query>
	 <query id="C102100RMTL.select" desc="C102100RMTL.select" fetchSize="10" isNamed="false">
		 <![CDATA[ 
select /*+ C10 품질설계원자재조회 C102100RMTL.select 박재영*/ 
          *
FROM TB_C10_QLT_DSN_RMT
WHERE ORD_NO = ?
AND   ORD_LN = ?
		 ]]> 
	 </query>
	 <query id="C102100RMT.delete" desc="C102100RMT.delete" fetchSize="10" isNamed="false">
		 <![CDATA[ 
DELETE /*+ C10 품질설계결과원자재사양삭제 C102100RMT.delete 박재영*/
FROM TB_C10_QLT_DSN_RMT
WHERE ORD_NO = ?
AND   ORD_LN = ?
		 ]]> 
	 </query>
	 <query id="C102100RMTL.update" desc="C102100RMTL.update" fetchSize="10" isNamed="false">
		 <![CDATA[ 
update /*+ C10 품질설계결과원자재Size수정 C102100RMTL.update 박재영*/
TB_C10_QLT_DSN_RMT SET
            LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
           ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
           ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
           ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
           ,RMTL_TAR_THK	= ?	                 --원자재목표두께
           ,RMTL_TAR_WTH	= ?	                 --원자재목표폭
           ,RMTL_TAR_THK_LVL	= ?	          --원자재목표두께하한
           ,RMTL_TAR_THK_UVL	= ?	          --원자재목표두께상한
           ,RMTL_TAR_WTH_LVL	= ?	          --원자재목표폭하한
           ,RMTL_TAR_WTH_UVL	= ?	          --원자재목표폭상한
           ,RMTL_CD = ?                             --원자재코드
WHERE ORD_NO = ?
AND   ORD_LN = ?
AND   QLT_DSN_MNF_TP = ?
		 ]]> 
	 </query>
	 <query id="C102100RMTL.RMselect" desc="C102100RMTL.RMselect" fetchSize="10" isNamed="false">
		 <![CDATA[ 
select /*+ C10 품질설계원자재제조사양조회 C102100RMTL.RMselect 박재영*/ 
       A.ORD_NO, A.ORD_LN, A.QLT_DSN_MNF_TP, A.RMTL_CD, A.RMTL_GRD,
       B.PLTCM_THK_TRV, B.PLTCM_SET_THK_TRV, B.PLTCM_WTH_TRV, B.PLTCM_EDG_ASG_TP,
       B.COR_WTH_TRV, B.PLTCM_WTH_TRV, B.PLTCM_WTH_SUB_PROC1_TRV, 
       B.PLTCM_WTH_SUB_PROC2_TRV, B.EGL_THK_TRV, B.EGL_WTH_TRV,
       B.TM_THK_TRV, B.TM_WTH_TRV, C.MQL_CD,
       B.CGL_THK_TRV, B.CGL_WTH_TRV,
       (SELECT MAIN_PROC_CD FROM TB_C10_QLT_DSN_PROC WHERE ORD_NO = C.ORD_NO AND ORD_LN = C.ORD_LN AND MAIN_PROC_CD LIKE '8%') CGL_MAIN_PROC_CD,
       (SELECT MAIN_PROC_CD FROM TB_C10_QLT_DSN_PROC WHERE ORD_NO = C.ORD_NO AND ORD_LN = C.ORD_LN AND MAIN_PROC_CD LIKE '9%') EGL_MAIN_PROC_CD
FROM TB_C10_QLT_DSN_RMT A, 
     TB_C10_QLT_DSN_MNF B,
     TB_C10_QLT_DSN_CMN C
WHERE A.ORD_NO = B.ORD_NO
AND   A.ORD_LN = B.ORD_LN 
AND   A.ORD_NO = C.ORD_NO
AND   A.ORD_LN = C.ORD_LN 
AND   A.QLT_DSN_MNF_TP = B.QLT_DSN_MNF_TP
AND   A.ORD_NO = ?
AND   A.ORD_LN = ?
		 ]]> 
	 </query>
	 <query id="C102100RMTL.CMNupdate" desc="C102100RMTL.CMNupdate" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 원자재코드업데이트 C102100RMTL.CMNupdate 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,RMTL_CD = ?                        --원자재코드
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100RMTL.CMNupdate1" desc="C102100RMTL.CMNupdate1" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 원자재코드업데이트 C102100RMTL.CMNupdate1 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,RMTL_CD1 = ?                        --원자재코드
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100RMTL.CMNupdate2" desc="C102100RMTL.CMNupdate2" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 원자재코드업데이트 C102100RMTL.CMNupdate2 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,RMTL_CD2 = ?                        --원자재코드
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
</queryMap>
