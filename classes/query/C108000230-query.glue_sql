<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000230 Page 쿼리파일"> 
	 <query id="C108000230.selectDevTest" desc="시험분석 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 시험분석 조회 C108000230.selectDevTest 전경진 */
    TST_NO,
    TST_PRG_CD ||'-' 
     || (SELECT CD_V_MEANING
           FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'TST_PRG_CD'
            AND CATEGORY_GROUP_NM = 'SZ0000'
            AND CD_V = TST_PRG_CD)  AS TST_PRG_CD,
    TST_TP,       
    NVL((SELECT EMP_NM
         FROM M90APUSER.TB_M90_EMP_INF
         WHERE EMP_ID = TST_REQ_ID), TST_REQ_ID) AS TST_REQ_ID, 
    TO_CHAR(REQ_RGS_DH,'yyyy-mm-dd HH24:MI')     AS REQ_RGS_DH, 
    PRD_DEV_NO, 
    CLAIM_NO,
    TST_TITLE, 
    TST_CONTENT,
    TST_CMP ||'-' 
     || (SELECT CD_V_MEANING
           FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'TST_CMP'
            AND CATEGORY_GROUP_NM = 'SZ0000'
            AND CD_V = TST_CMP) AS TST_CMP, 
    TST_OUT_CMP, 
    NVL2(TST_LINE,
    (TST_LINE ||'-' 
     || (SELECT CD_V_MEANING
           FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'PROC_CD'
            AND CATEGORY_GROUP_NM = 'SA0006'
            AND CD_V = TST_LINE)),'') AS TST_LINE, 
    TO_CHAR(CMP_RGS_DH,'yyyy-mm-dd') AS CMP_RGS_DH, 
    ORD_NO, 
    TST_RMK, 
    (SELECT DECODE(COUNT(IMG_NM),0,'N','Y')
             FROM TB_C10_PRD_DEV_IMG
             WHERE PRD_DEV_NO = TST_NO
              AND  PRD_DEV_IMG_SEQ_NO =1
     ) AS TST_REQ_FILE, 
    TST_RSP_ID, 
    TO_CHAR(TST_CMP_DH,'yyyy-mm-dd') AS TST_CMP_DH, 
    TST_FLD_LOC, 
    TO_CHAR(TST_START_DH,'yyyy-mm-dd HH24:MI') AS TST_START_DH, 
    TO_CHAR(TST_END_DH,'yyyy-mm-dd HH24:MI') AS TST_END_DH, 
    TST_RST, 
    (SELECT DECODE(COUNT(IMG_NM),0,'N','Y')
             FROM TB_C10_PRD_DEV_IMG
             WHERE PRD_DEV_NO = TST_NO
              AND  PRD_DEV_IMG_SEQ_NO =2
     ) TST_END_FILE,
     (SELECT DECODE(COUNT(IMG_NM),0,'N','Y')
             FROM TB_C10_PRD_DEV_IMG
             WHERE PRD_DEV_NO = TST_NO
              AND  PRD_DEV_IMG_SEQ_NO =1
     ) FILE_YN,
     (SELECT DECODE(COUNT(IMG_NM),0,'N','Y')
             FROM TB_C10_PRD_DEV_IMG
             WHERE PRD_DEV_NO = TST_NO
              AND  PRD_DEV_IMG_SEQ_NO =2
     ) DOC_YN 
FROM C10APUSER.TB_C10_PRD_TST_ANLY
WHERE REQ_RGS_DH  BETWEEN TO_DATE(NVL(:TST_RGS_DH_FR,'1900-01-01'),'YYYY-MM-DD')
                  AND TO_DATE(NVL(:TST_RGS_DH_TO,'2999-12-31'),'YYYY-MM-DD') + 1
AND NVL(TST_REQ_ID, ' ') LIKE NVL(:TST_REQ_ID ,'') || '%'
AND NVL(TST_CMP , ' ') LIKE NVL(:TST_CMP,'')  || '%'
AND NVL(TST_OUT_CMP , ' ') LIKE  NVL(:TST_OUT_CMP,'')  || '%'
AND NVL(PRD_DEV_NO, ' ') LIKE  NVL(:PRD_DEV_NO,'') || '%'
AND TST_PRG_CD =  NVL(:TST_PRG_CD ,TST_PRG_CD)
ORDER BY TST_NO, REQ_RGS_DH
		 ]]> 
	 </query>
	 <query id="C108000230.updateDevTest" desc="시험분석 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 시험분석 수정 C108000230.updateDevTest 전경진 */
    C10APUSER.TB_C10_PRD_TST_ANLY
SET TST_TP = SUBSTR(:TST_TP,0,INSTR(:TST_TP,'-') - 1),
    PRD_DEV_NO= :PRD_DEV_NO,
    CLAIM_NO= :CLAIM_NO, 
    TST_TITLE= :TST_TITLE, 
    TST_CONTENT= :TST_CONTENT, 
    TST_CMP= SUBSTR(:TST_CMP,0,INSTR(:TST_CMP,'-') - 1),
    TST_OUT_CMP= :TST_OUT_CMP, 
    TST_LINE= SUBSTR(:TST_LINE,0,INSTR(:TST_LINE,'-') - 1), 
    CMP_RGS_DH= NVL2(:CMP_RGS_DH,TO_DATE(:CMP_RGS_DH),:CMP_RGS_DH), 
    ORD_NO= :ORD_NO, 
    TST_RMK= :TST_RMK,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE TST_NO = :TST_NO
AND   TST_PRG_CD = '10'
		 ]]> 
	 </query>
	 <query id="C108000230.insertDevTest" desc="시험분석 삽입" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 시험분석 등록 C108000230.insertDevTest 전경진*/
INTO C10APUSER.TB_C10_PRD_TST_ANLY
(   TST_NO, 
    TST_PRG_CD,
    TST_TP, 
    TST_REQ_ID, 
    REQ_RGS_DH, 
    PRD_DEV_NO, 
    CLAIM_NO, 
    TST_TITLE, 
    TST_CONTENT, 
    TST_CMP, 
    TST_OUT_CMP, 
    TST_LINE, 
    CMP_RGS_DH, 
    ORD_NO, 
    TST_RMK, 
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
(SELECT 'T'|| MAX(DECODE(CD_TP, 'YR_TP', CD_V))
       || MAX(DECODE(CD_TP, 'MN_TP', CD_V))
 FROM M00APUSER.VI_M00_CODE_ACCESS
 WHERE (CD_TP = 'YR_TP' AND CD_V_MEANING = TO_CHAR(SYSDATE, 'YYYY'))
 OR (CD_TP = 'MN_TP' AND CD_V_MEANING = TO_NUMBER(TO_CHAR(SYSDATE, 'MM')))
 OR (CD_TP = 'DD_TP' AND CD_V_MEANING = TO_NUMBER(TO_CHAR(SYSDATE, 'DD')))
) || TO_CHAR(LPAD(C10APUSER.SQ_C10_PRD_TST_ANLY.NEXTVAL,3,0)),
'10',
:TST_TP,
:ObjectId, 
SYSDATE, 
:PRD_DEV_NO, 
:CLAIM_NO, 
:TST_TITLE, 
:TST_CONTENT, 
:TST_CMP, 
:TST_OUT_CMP, 
:TST_LINE, 
NVL2(:CMP_RGS_DH,TO_DATE(:CMP_RGS_DH),:CMP_RGS_DH), 
:ORD_NO, 
:TST_RMK, 
:ObjectType,
:ObjectId,
:ProgramId,
:Timestamp,
:ObjectType,
:ObjectId,
:ProgramId,
:Timestamp)
		 ]]> 
	 </query>
	 <query id="C108000230.deleteDevTest" desc="시험분석 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 시험분석 삭제 C108000230.deleteDevTest 전경진 */
    C10APUSER.TB_C10_PRD_TST_ANLY
WHERE TST_NO = :TST_NO
AND   TST_PRG_CD = '10'
		 ]]> 
	 </query>
	 <query id="C108000230.updateReceive" desc="시험분석 접수" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 시험분석 접수 C108000230.updateReceive 전경진 */
    C10APUSER.TB_C10_PRD_TST_ANLY
SET TST_PRG_CD= '20',   
    TST_RSP_ID= :TST_RSP_ID, 
    TST_CMP_DH= NVL2(:TST_CMP_DH,TO_DATE(:TST_CMP_DH),:TST_CMP_DH), 
    TST_FLD_LOC= :TST_FLD_LOC,
    TST_START_DH= SYSDATE,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE TST_NO = :TST_NO
AND   TST_PRG_CD IN ('10','20')
		 ]]> 
	 </query>
	 <query id="C108000230.updateComplete" desc="시험분석 완료" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 시험분석 완료 C108000230.updateComplete 전경진 */
    C10APUSER.TB_C10_PRD_TST_ANLY
SET TST_PRG_CD= '30',
    TST_END_DH= SYSDATE,
    TST_RST= :TST_RST,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE TST_NO = :TST_NO
AND   TST_PRG_CD IN ('20','30')
		 ]]> 
	 </query>
	 <query id="C108000230.selectTstSmp" desc="selectTstSmp 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT   /*+ C10 테스트번호지정대상 조회  C108000230.selectTstSmp  */ 
* FROM 
(
    SELECT  /* 개발참조샘플 */
        SMPL_TP
        ,(SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'SMPL_TP'         
          AND CATEGORY_GROUP_NM = 'SZ0000'
          AND CD_V = SMPL_TP) AS SMPL_TP_NM     
        ,SMPL_NO 
        ,TEST_NO AS TST_NO
        ,DEV_NO
        ,'' CMPL_NO
        ,TO_CHAR(SMPL_RCV_DH,'YYYY-MM-DD') SMPL_DH
        ,'' COIL_ID
        ,'' PRD_NM_CD
        ,'' PRD_NM_CD_NM        
        ,'' CCL_BOM_NO
        ,'' PROC_CD
        ,'' SMTL_SLP_CD 
        ,CUS_CD
        ,(SELECT CD_V_MEANING
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'CUS_CD'
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = CUS_CD) CUS_CD_NM
        ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'SMPL_STS_CD'         
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = SMPL_STS_CD) AS SMPL_STS_CD_NM 
        ,SMPL_SZ_CD 
        ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'SMPL_SZ_CD'         
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = SMPL_SZ_CD) AS SMPL_SZ_CD_NM 
        ,SMPL_QTY
    FROM MESAPUSER.TB_M20_SMPL_DEV_REF_MNG A
    WHERE TEST_NO = :TST_NO
    UNION ALL
    SELECT  /* 부적합샘플 */
        SMPL_TP
        ,(SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'SMPL_TP'         
          AND CATEGORY_GROUP_NM = 'SZ0000'
          AND CD_V = SMPL_TP) AS SMPL_TP_NM     
        ,SMPL_NO
        ,TEST_NO AS TST_NO
        ,'' DEV_NO
        ,'' CMPL_NO       
        ,TO_CHAR(SMPL_RGS_DH,'YYYY-MM-DD') SMPL_DH
        ,COIL_ID
        ,(SELECT PRD_NM_CD FROM TB_M47_COIL_CMN WHERE COIL_ID = A.COIL_ID) PRD_NM_CD
        ,(SELECT CD_V_MEANING
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_NM_CD'
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = (SELECT PRD_NM_CD FROM TB_M47_COIL_CMN WHERE COIL_ID = A.COIL_ID)) PRD_NM_CD_NM        
        ,'' CCL_BOM_NO
        ,'' PROC_CD
        ,'' SMTL_SLP_CD 
        ,'' CUS_CD
        ,'' CUS_CD_NM
        ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'SMPL_STS_CD'         
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = SMPL_STS_CD) AS SMPL_STS_CD_NM 
        ,SMPL_SZ_CD 
        ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'SMPL_SZ_CD'         
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = SMPL_SZ_CD) AS SMPL_SZ_CD_NM 
        ,SMPL_QTY
    FROM MESAPUSER.TB_M20_SMPL_DEF_MNG A
    WHERE TEST_NO = :TST_NO
    UNION ALL
    SELECT  /* 불만샘플 */
        SMPL_TP
        ,(SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'SMPL_TP'         
          AND CATEGORY_GROUP_NM = 'SZ0000'
          AND CD_V = SMPL_TP) AS SMPL_TP_NM     
        ,SMPL_NO
        ,TEST_NO AS TST_NO
        ,'' DEV_NO
        ,CMPL_NO      
        ,TO_CHAR(SMPL_RGS_DH,'YYYY-MM-DD') SMPL_DH
        ,COIL_ID
        ,(SELECT PRD_NM_CD FROM TB_M47_COIL_CMN WHERE COIL_ID = A.COIL_ID) PRD_NM_CD
        ,(SELECT CD_V_MEANING
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_NM_CD'
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = (SELECT PRD_NM_CD FROM TB_M47_COIL_CMN WHERE COIL_ID = A.COIL_ID)) PRD_NM_CD_NM        
        ,'' CCL_BOM_NO
        ,'' PROC_CD
        ,'' SMTL_SLP_CD 
        ,CUS_CD
        ,(SELECT CD_V_MEANING
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'CUS_CD'
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = CUS_CD) CUS_CD_NM
        ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'SMPL_CMPL_STS_CD'         
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = SMPL_CMPL_STS_CD) AS SMPL_STS_CD_NM 
        ,SMPL_SZ_CD 
        ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'SMPL_SZ_CD'         
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = SMPL_SZ_CD) AS SMPL_SZ_CD_NM 
        ,SMPL_QTY
    FROM MESAPUSER.TB_M20_SMPL_CMPL_MNG A
    WHERE TEST_NO = :TST_NO
    UNION ALL
    SELECT  /* LAB샘플 */
        SMPL_TP
        ,(SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'SMPL_TP'         
          AND CATEGORY_GROUP_NM = 'SZ0000'
          AND CD_V = SMPL_TP) AS SMPL_TP_NM     
        ,SMPL_NO
        ,TEST_NO AS TST_NO
        ,DEV_NO
        ,'' CMPL_NO       
        ,TO_CHAR(SMPL_PRD_CMP_DH,'YYYY-MM-DD') SMPL_DH
        ,'' COIL_ID
        ,'' PRD_NM_CD
        ,'' PRD_NM_CD_NM        
        ,CCL_BOM_NO
        ,'' PROC_CD
        ,SMTL_SLP_CD 
        ,CUS_CD
        ,(SELECT CD_V_MEANING
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'CUS_CD'
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = CUS_CD) CUS_CD_NM
        ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'SMPL_STS_CD'         
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = SMPL_STS_CD) AS SMPL_STS_CD_NM 
        ,SMPL_SZ_CD 
        ,(SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'SMPL_SZ_CD'         
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = SMPL_SZ_CD) AS SMPL_SZ_CD_NM 
        ,SMPL_QTY
    FROM MESAPUSER.TB_M20_SMPL_LAB_MNG A
    WHERE TEST_NO = :TST_NO
    UNION ALL
    SELECT  /* LOT샘플 */
        SMPL_TP
        ,(SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'SMPL_TP'         
          AND CATEGORY_GROUP_NM = 'SZ0000'
          AND CD_V = SMPL_TP) AS SMPL_TP_NM     
        ,SMPL_NO
        ,TEST_NO AS TST_NO
        ,'' DEV_NO
        ,'' CMPL_NO       
        ,TO_CHAR(SMPL_GTH_DH,'YYYY-MM-DD') SMPL_DH
        ,LOT.COIL_ID COIL_ID
        ,COIL.PRD_NM_CD PRD_NM_CD
        ,(SELECT CD_V_MEANING
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_NM_CD'
         AND CATEGORY_GROUP_NM = 'SZ0000'
         AND CD_V = COIL.PRD_NM_CD) PRD_NM_CD_NM  
        ,DSN.CCL_BOM_NO CCL_BOM_NO
        ,COIL.PROC_CD
        ,'' SMTL_SLP_CD 
        ,DSN.CUS_CD
        ,(SELECT CD_V_MEANING
          FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'CUS_CD'
          AND CATEGORY_GROUP_NM = 'SZ0000'
          AND CD_V = DSN.CUS_CD) CUS_CD_NM
        ,(SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'SMPL_STS_CD'         
          AND CATEGORY_GROUP_NM = 'SZ0000'
          AND CD_V = SMPL_STS_CD) AS SMPL_STS_CD_NM 
        ,SMPL_SZ_CD  
        ,(SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'SMPL_SZ_CD'         
          AND CATEGORY_GROUP_NM = 'SZ0000'
          AND CD_V = SMPL_SZ_CD) AS SMPL_SZ_CD_NM 
        ,SMPL_QTY
    FROM MESAPUSER.TB_M20_SMPL_LOT_MNG LOT,
    MESAPUSER.TB_M47_PRD_ACT_CMN COIL,
    C10APUSER.TB_C10_QLT_DSN_CMN DSN
    WHERE LOT.COIL_ID = COIL.COIL_ID
    AND COIL.ORD_NO = DSN.ORD_NO
    AND COIL.ORD_LN = DSN.ORD_LN
    AND TEST_NO = :TST_NO
  )
ORDER BY SMPL_DH, SMPL_NO
		 ]]> 
	 </query>
	 <query id="C108000230.joinDevTest" desc="해제" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE MESAPUSER.TB_M20_SMPL_DEV_REF_MNG
/*+ C10   개발참조샘플 지정  C108000230.joinDev */
SET TEST_NO = ''
WHERE SMPL_NO = :SMPL_NO
		 ]]> 
	 </query>
