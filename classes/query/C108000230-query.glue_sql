	 <query id="C108000230.checkUser" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10   공급업체조회   C108000230.checkUser  전경진  */
       SMTL_SLP_CD,SMTL_SLP_NM, NVL(DIR_INP_YN,'N') AS DIR_INP_YN
  FROM MESAPUSER.TB_M30_SMTL_SLP_MASTER
 WHERE SMTL_SLP_CD = :SMTL_SLP_CD
		 ]]> 
	 </query>
</queryMap>
