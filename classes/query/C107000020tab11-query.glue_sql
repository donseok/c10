<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab11 Page 쿼리파일"> 
	 <query id="C107000020tab11.select" desc="C107000020tab11 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT    
 DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1   PROC_CD_CCL
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_1  PROC_CD_SHL 
FROM M00APUSER.TB_M00_DATAS010 DATAS010,   
(SELECT MDL_DEFINE_ID    
FROM M00APUSER.TB_M00_DEFINES010   
WHERE MDL_DEFINE_NM='C10A2030'   
AND START_ACTIVE_DATE <=  SYSDATE   
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010   
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
		 ]]> 
	 </query>
</queryMap>
