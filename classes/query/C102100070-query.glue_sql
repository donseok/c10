<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C102100070"> 
	 <query id="C102100070.modify" desc="품질설계결과공통 기본정보 등록" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통업데이트 C102100070.MODIFY 김종범*/                             
TB_C10_QLT_DSN_CMN                                                                             
SET 
       LAST_UPDATED_OBJECT_TYPE =?     --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID    =?       --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID   =?        --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP    =?        --최종변경일시                                                                                               
      ,SPC_NM =?                      --규격명                                                               
      ,SPC_FUL_NM =?                  --규격full명                                                                
      ,ORD_GRA =?                     --비중                                                               
       ,ACPT_RT_SPC =?                 --인수도규격              
      ,SPC_OFC = ?                       --규격기관                                                                                           
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
</queryMap>
