<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="B10R0020"> 
	 <query id="B10R0020.select" desc="B10R0020.select" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 제품사양설계-생산가부요청수신 B10R0020.select 박재영 */
           *
FROM EAIAPUSER.TB_C10_B10R0020
WHERE IF_GRP_ID = ?
AND XSTAT = 'D'
ORDER BY SEQ_NO
		 ]]> 
	 </query>
	 <query id="B10R0020.modify" desc="B10R0020.modify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 생산가부요청수신 B10R0020.modify 박재영*/                      
TB_C10_B10R0020
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,XSTAT = ?                     --PI 처리 상태
      ,XMSGS = (CASE WHEN LENGTHB(?) >100 THEN substrb(?,1,100) ELSE ? END)                     --PI 에러 메세지
      ,XSTAT_CALLBACK = ?            --PI 처리 상태
WHERE IF_GRP_ID = ?                  --Interface Group ID                                                                                      
  AND SEQ_NO = ?                     --Interface SEQ
		 ]]> 
	 </query>
	 <query id="B10S1030.insert" desc="B10S1030.insert" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT INTO  /*+ C10 생산가부요청결과 송신 B10S1030.insert 박재영*/                           
TB_C10_B10S1030 (                                                                           
             IF_GRP_ID		                --인터페이스그룹아이디
             ,SEQ_NO		                  --인터페이스 SEQ
             ,XSEQ		                    --PI Sequence Key Value
             ,XCRUD		                    --PI Data 유형
             ,XSTAT		                    --처리결과
             ,XMSGS		                    --에러메세지
             ,XDATE		                    --PI 송신일자
             ,XTIME		                    --PI 송신시간
             ,XSTAT_CALLBACK		          --Callback 처리결과
             ,ORD_REQ_NO		              --주문요청번호
             ,ORD_REQ_LN		              --주문요청행번
             ,ERR_YN		                  --에러여부
             ,MQL_CD		                  --재질코드
             ,ROL_TAR_THK		              --압연목표두께
             ,RMTL_CD		                  --원자재코드
             ,RMTL_TAR_THK		            --원자재두께
             ,RMTL_TAR_WTH		            --원자재폭
             ,ORD_ERR_TXT		              --주문에러내용
             ,PLTCM_WTH_TRV		            --원자재폭
             ,IF_GRP_ID_REQ                           --수신IF_GRP_ID
             ,PAS_PROC_NO                                 --통과공정    
             ,CREATED_OBJECT_TYPE		      --생성Object유형
             ,CREATED_OBJECT_ID		        --생성ObjectID
             ,CREATED_PROGRAM_ID		      --생성프로그램ID
             ,CREATION_TIMESTAMP		      --생성일시
             ,LAST_UPDATED_OBJECT_TYPE		--최종변경Object유형
             ,LAST_UPDATED_OBJECT_ID		  --최종변경ObjectID
             ,LAST_UPDATE_PROGRAM_ID		  --최종변경프로그램ID
             ,LAST_UPDATE_TIMESTAMP		    --최종변경일시
)                                                                                              
VALUES(                                                                                             
?,
EAIAPUSER.SQ_C10_B10S1030.NEXTVAL,
'1','C',
'R',?,
TO_CHAR(SYSDATE,'YYYYMMDD'),
TO_CHAR(SYSDATE,'HH24MISS'),
?,?,?,?,
?,?,?,?,
?,(CASE WHEN LENGTHB(?) >200 THEN substrb(?,1,200) ELSE ? END),?,?,?,
?,?,?,?,?,?,?,?
)
		 ]]> 
	 </query>
	 <query id="B10R0020.Dselect" desc="B10R0020.Dselect" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 제품사양설계-생산가부요청수신 B10R0020.select 박재영 */
           *
FROM EAIAPUSER.TB_C10_B10R0020
WHERE XSTAT = 'D'
ORDER BY IF_GRP_ID, SEQ_NO
		 ]]> 
	 </query>
	 <query id="B10R0020.BAKselect" desc="B10R0020.BAKselect" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT  /*+ C10 제품사양설계-생산가부요청수신 B10R0020.BAKselect 박재영 */
      ROWNUM,AA.*
FROM (SELECT *
        FROM EAIAPUSER.TB_C10_B10R0020 BB
        WHERE XSTAT = 'D'
        ORDER BY IF_GRP_ID, TO_NUMBER(SEQ_NO) ) AA
WHERE ROWNUM <= 100
		 ]]> 
	 </query>
</queryMap>
