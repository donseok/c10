<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab02 Page 쿼리파일"> 
	 <query id="C107000020tab02.select" desc="C107000020tab02 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT     
 DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1   CUS_BTH_PAP_NO  
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_1  SPC_AVR  
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_2  SPC_YR  
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_3  ORD_USG_CD 
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_4  CUS_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_5  PRD_NM_CD
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_1   PRD_THK_RNG_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_2   PRD_THK_RNG_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_3   PRD_WTH_RNG_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_4   PRD_WTH_RNG_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_5   PRD_LTH_RNG_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_6   PRD_LTH_RNG_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_7   CUS_REQ_ROL_THK
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_6  CUS_REQ_ROL_THK_UNT
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_7  ORD_THK_TP
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_8  PRD_THK_CAL_APL_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_9  GW_ASG_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_10 ORD_SUR_HND_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_11 CCL_BOM_NO
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_12 CUS_BTH_NM
FROM M00APUSER.TB_M00_DATAS010 DATAS010,    
(SELECT MDL_DEFINE_ID     
FROM M00APUSER.TB_M00_DEFINES010    
WHERE MDL_DEFINE_NM='C10A1020'    
AND START_ACTIVE_DATE <=  SYSDATE    
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010    
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
  AND DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 LIKE '%'||:SEARCH_CD||'%'
ORDER BY CUS_BTH_PAP_NO 
		 ]]> 
	 </query>
</queryMap>
