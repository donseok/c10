<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000030 Page 쿼리파일"> 
	 <query id="C106000030.select" desc="C106000030 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질기준개선이력관리조회 C106000030.SELECT 김종범*/  
       QLT_IMV_REQ_NO      --품질개선의뢰번호
    ,  QLT_IMV_STS_CD      --품질개선상태코드
    ,  TO_CHAR(QLT_IMV_REQ_DH, 'YYYY-MM-DD') QLT_IMV_REQ_DH   --품질개선의뢰일시
    ,  QLT_IMV_REQ_PRS_ID  --품질개선의뢰자
    ,  QLT_CHR_PRS_ID  --품질담당자ID
    ,  QLT_IMV_REA  --품질개선사유
    ,  QLT_IMV_CTT--품질개선내용
    ,  QLT_STD_CHG_CTT--기준변경내용
    ,  QLT_IMV_EFF--품질개선효과
    ,  (SELECT (CASE WHEN COUNT(1) > 0 THEN 'Y'
                     ELSE 'N' END)
        FROM TB_C10_QLT_STD_IMV_FILE
        WHERE QLT_IMV_REQ_NO = QSIH.QLT_IMV_REQ_NO) FILE_ADD
  FROM TB_C10_QLT_STD_IMV_HST QSIH   
  WHERE QLT_IMV_REQ_DH BETWEEN TO_DATE(:QLT_IMV_REQ_DH_FR,'YYYY-MM-DD')  AND TO_DATE(:QLT_IMV_REQ_DH_TO,'YYYY-MM-DD') + 1  
   AND QLT_IMV_REQ_NO LIKE :QLT_IMV_REQ_NO||'%'
   AND NVL(QLT_IMV_REQ_PRS_ID,'%') LIKE :QLT_IMV_REQ_PRS_ID||'%' 
   AND NVL(QLT_CHR_PRS_ID, '%') LIKE :QLT_CHR_PRS_ID||'%'
   AND NVL(QLT_IMV_STS_CD, '%') LIKE :QLT_IMV_STS_CD||'%'
   ORDER BY QLT_IMV_REQ_NO
		 ]]> 
	 </query>
	 <query id="C106000030.update" desc="C106000030 정보 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질기준개선이력관리 업데이트 C106000030.UPDATE 김종범*/  
       TB_C10_QLT_STD_IMV_HST
   SET  
       QLT_IMV_STS_CD      = :QLT_IMV_STS_CD
     , QLT_IMV_REQ_PRS_ID  = :QLT_IMV_REQ_PRS_ID       
     , QLT_CHR_PRS_ID      = :QLT_CHR_PRS_ID
     , QLT_IMV_REA         = (CASE WHEN LENGTHB(:QLT_IMV_REA) >200 THEN substrb(:QLT_IMV_REA,1,200) ELSE :QLT_IMV_REA END)
     , QLT_IMV_CTT         = (CASE WHEN LENGTHB(:QLT_IMV_CTT) >400 THEN substrb(:QLT_IMV_CTT,1,400) ELSE :QLT_IMV_CTT END)
     , QLT_STD_CHG_CTT     = (CASE WHEN LENGTHB(:QLT_STD_CHG_CTT) >400 THEN substrb(:QLT_STD_CHG_CTT,1,400) ELSE :QLT_STD_CHG_CTT END) 
     , QLT_IMV_EFF         = (CASE WHEN LENGTHB(:QLT_IMV_EFF) >400 THEN substrb(:QLT_IMV_EFF,1,400) ELSE :QLT_IMV_EFF END)
     , LAST_UPDATED_OBJECT_TYPE = :OBJECTTYPE     -- AUDIT항목
     , LAST_UPDATED_OBJECT_ID   = :OBJECTID           -- AUDIT항목
     , LAST_UPDATE_PROGRAM_ID   = :PROGRAMID      -- AUDIT항목
     , LAST_UPDATE_TIMESTAMP    = :TIMESTAMP      -- AUDIT항목
 WHERE QLT_IMV_REQ_NO = :QLT_IMV_REQ_NO
		 ]]> 
	 </query>
	 <query id="C106000030.delete" desc="C106000030 정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질기준개선이력관 삭제 C106000030.DELETE 김종범*/  
  FROM TB_C10_QLT_STD_IMV_HST
 WHERE QLT_IMV_REQ_NO = :QLT_IMV_REQ_NO
		 ]]> 
	 </query>
	 <query id="C106000030.insert" desc="C106000030 정보 추가" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질기준개선이력관리 등록 C106000030.INSERT 김종범*/ INTO                               
       TB_C10_QLT_STD_IMV_HST(
       QLT_IMV_REQ_NO            --품질개선의뢰번호  
      ,QLT_IMV_STS_CD            --품질개선상태코드
      ,QLT_IMV_REQ_DH            --품질개선의뢰일시
      ,QLT_IMV_REQ_PRS_ID        --품질개선의뢰자  
      ,QLT_CHR_PRS_ID            --품질담당자ID    
      ,QLT_IMV_REA               --품질개선사유    
      ,QLT_IMV_CTT               --품질개선내용    
      ,QLT_STD_CHG_CTT           --기준변경내용    
      ,QLT_IMV_EFF               --품질개선효과    
      ,QLT_IMV_DH                --품질개선완료일  
      ,CREATED_OBJECT_TYPE       --생성OBJECT유형    
      ,CREATED_OBJECT_ID         --생성OBJECTID      
      ,CREATED_PROGRAM_ID        --생성프로그램ID    
      ,CREATION_TIMESTAMP        --생성일시          
      ,LAST_UPDATED_OBJECT_TYPE  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP     --최종변경일시      
)Values
( 
 (SELECT NVL(MAX(QLT_IMV_REQ_NO),TO_CHAR(SYSDATE,'YYYYMM') || '0000')+1 FROM TB_C10_QLT_STD_IMV_HST)            
 ,:QLT_IMV_STS_CD                                                             
 ,TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS')             
 ,:QLT_IMV_REQ_PRS_ID                                                         
 ,:QLT_CHR_PRS_ID                                                              
 ,(CASE WHEN LENGTHB(:QLT_IMV_REA) >200 THEN substrb(:QLT_IMV_REA,1,200) ELSE :QLT_IMV_REA END)
 ,(CASE WHEN LENGTHB(:QLT_IMV_CTT) >400 THEN substrb(:QLT_IMV_CTT,1,400) ELSE :QLT_IMV_CTT END)
 ,(CASE WHEN LENGTHB(:QLT_STD_CHG_CTT) >400 THEN substrb(:QLT_STD_CHG_CTT,1,400) ELSE :QLT_STD_CHG_CTT END) 
 ,(CASE WHEN LENGTHB(:QLT_IMV_EFF) >400 THEN substrb(:QLT_IMV_EFF,1,400) ELSE :QLT_IMV_EFF END)                                                                
 ,DECODE(:QLT_IMV_STS_CD,'E',TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS'),'')
 ,:CREATED_OBJECT_TYPE                                                      
 ,:CREATED_OBJECT_ID                                                        
 ,:CREATED_PROGRAM_ID                                                       
 ,:CREATION_TIMESTAMP                                                       
 ,:LAST_UPDATED_OBJECT_TYPE                                                 
 ,:LAST_UPDATED_OBJECT_ID                                                   
 ,:LAST_UPDATE_PROGRAM_ID                                                   
 ,:LAST_UPDATE_TIMESTAMP                                                    
 )
		 ]]> 
	 </query>
	 <query id="C106000030.max" desc="의뢰번호 MAX생성" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT /*+ C10 품질기준개선이력관리 의뢰번호 MAX생성 C106000030.MAX 김종범*/ INTO TB_C10_QLT_STD_IMV_HST
      (QLT_IMV_REQ_NO) 
VALUES
      ((SELECT MAX(QLT_IMV_REQ_NO)+1 FROM TB_C10_QLT_STD_IMV_HST))
		 ]]> 
	 </query>
</queryMap>
