<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000170 Page 쿼리파일"> 
	 <query id="C108000170.selectLmnDev" desc="라미나개발 조회" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계 제품라미나개발 조회 C108000130.selectLmnDev 전경진 */
     LD.PRD_DEV_NO, 
     LD.LMN_DEV_NO, 
     LD.LMN_BND_DEV_CMP_DH, 
     LD.LMN_BND_DEV_CHR_UID, 
     LD.LMN_FLM_DEV_CHR_UID, 
     LD.LMN_KND_TP, 
     LD.LMN_FLM_THK_CD, 
     LD.LMN_BND_CD, 
     LD.LMN_BND_THR_CD, 
     LD.LMN_UNT
FROM  C10APUSER.TB_C10_PRD_LMN_DEV LD
WHERE LD.PRD_DEV_NO = :PRD_DEV_NO 
AND   LD.LMN_DEV_NO LIKE :LMN_DEV_NO ||'%'
AND   LD.LMN_BND_DEV_CHR_UID LIKE :LMN_BND_DEV_CHR_UID ||'%'
AND   LD.LMN_FLM_DEV_CHR_UID LIKE :LMN_FLM_DEV_CHR_UID ||'%'
ORDER BY CD.PRD_DEV_NO, CD.LMN_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000170.updateLmnDev" desc="라미나개발 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 제품라미나개발 수정 C108000130.updateLmnDev 전경진 */
    C10APUSER.TB_C10_PRD_LMN_DEV
SET LMN_BND_DEV_CMP_DH = :LMN_BND_DEV_CMP_DH,
    LMN_BND_DEV_CHR_UID = :LMN_BND_DEV_CHR_UID,
    LMN_FLM_DEV_CHR_UID = :LMN_FLM_DEV_CHR_UID,
    LMN_KND_TP = :LMN_KND_TP,
    LMN_FLM_THK_CD = :LMN_FLM_THK_CD,
    LMN_BND_CD = :LMN_BND_CD,
    LMN_BND_THR_CD = :LMN_BND_THR_CD,
    LMN_UNT = :LMN_UNT,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE PRD_DEV_NO = :PRD_DEV_NO
AND   LMN_DEV_NO = :LMN_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000170.insertLmnDev" desc="라미나개발 삽입" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 제품라미나개발 등록 C108000130.insertLmnDev 전경진*/
INTO C10APUSER.TB_C10_PRD_LMN_DEV
(   PRD_DEV_NO,
    LMN_DEV_NO, 
    LMN_BND_DEV_CMP_DH, 
    LMN_BND_DEV_CHR_UID, 
    LMN_FLM_DEV_CHR_UID, 
    LMN_KND_TP, 
    LMN_FLM_THK_CD, 
    LMN_BND_CD, 
    LMN_BND_THR_CD, 
    LMN_UNT
    PRT_ROLL_NO,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP
)VALUES(
	:PRD_DEV_NO,
	TO_CHAR(
	 (SELECT TO_NUMBER(NVL(MAX(LMN_DEV_NO), '70')) + 1
	  FROM   C10APUSER.TB_C10_PRD_LMN_DEV
	  WHERE  PRD_DEV_NO= :PRD_DEV_NO) ),
	:LMN_BND_DEV_CMP_DH, 
	:LMN_BND_DEV_CHR_UID, 
	:LMN_FLM_DEV_CHR_UID, 
	:LMN_KND_TP, 
	:LMN_FLM_THK_CD, 
	:LMN_BND_CD, 
	:LMN_BND_THR_CD, 
	:LMN_UNT
	:PRT_ROLL_NO,
	:ObjectType,
	:ObjectId,
	:ProgramId,
	:Timestamp,
	:ObjectType,
	:ObjectId,
	:ProgramId,
	:Timestamp)
		 ]]> 
	 </query>
	 <query id="C108000170.deleteLmnDev" desc="라미나개발 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 제품라미나개발 삭제 C108000130.deleteLmnDev 전경진 */
    C10APUSER.TB_C10_PRD_LMN_DEV
WHERE PRD_DEV_NO = :PRD_DEV_NO 
AND   CLR_DEV_NO = :CLR_DEV_NO
		 ]]> 
	 </query>
</queryMap>
