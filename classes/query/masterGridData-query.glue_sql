<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="masterGridData Page 쿼리파일"> 
	 <query id="masterGridData.select" desc="masterGridData 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT/*+ masterGridData 마스터코드 조회 이민균 */
    CATEGORY_GROUP_NM,      
    CD_V,
    CD_V_MEANING,      
    CD_V_INQUIRY_SEQ
FROM M00APUSER.VI_M00_CODE_ACCESS
WHERE CD_TP = :CD_TP                       
AND CATEGORY_GROUP_NM = :CATEGORY_GROUP_NM    
AND CD_V_MEANING LIKE '%'|| :CD_V_MEANING ||'%'
AND CD_V LIKE '%'|| :CD_V ||'%'
ORDER BY CD_V_MEANING
		 ]]> 
	 </query>
</queryMap>
