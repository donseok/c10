<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000050 Page 쿼리파일"> 
	 <query id="C107000050.select" desc="C107000050 정보 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C107000050   표준항목관리 조회   C107000050.select 원성옥  */
       ATTRS.DT_NM_ID
      ,STANDARD_ENGLISH_ID     --표준항목ID
      ,STANDARD_KOREAN_NAME    --표준항목명
      --,DT_NM_DATA_TP           --항목데이터Type
      ,NVL2(RULE.DT_NM_ID, DECODE(DT_NM_DATA_TP,'1','문자','2','숫자','3','일자'), DT_NM_DATA_TP) AS DT_NM_DATA_TP --항목데이터Type
      ,DT_NM_LEN               --항목길이
      ,DT_NM_DECIMAL_PREC      --항목소수점이하자리
      ,DT_NM_ALIAS             --표준항목명약어
      ,USE_TP                  --사용구분
      ,SYS_TP                  --시스템구분
      --,CHAIN_CODE              --체인코드
	  ,NVL2(RULE.DT_NM_ID, NVL2(CHAIN_CODE,CHAIN_CODE || ' - ','') || MESAPUSER.PL_M60_COMMON_FNC_PKG.getMastValue('MES_MOD_TP', 'SZ0000', CHAIN_CODE), CHAIN_CODE) AS CHAIN_CODE --체인코드
      ,(SELECT USER_NAME
          FROM M90APUSER.TB_M90_EMP_INF
         WHERE USER_NO = CREATED_OBJECT_ID) AS CREATED_OBJECT_ID         --등록자
      ,TO_CHAR(CREATION_TIMESTAMP,'YYYY-MM-DD') AS CREATION_TIMESTAMP    --등록일자
      ,RULE.DT_NM_ID AS RULE_DT_NM_ID                                    --MasterDataLayout정의ID 
 FROM M00APUSER.TB_M00_ATTRS ATTRS
    ,(SELECT DT_NM_ID
       fROM M00APUSER.TB_M00_DEPEND010 DPD1
           ,M00APUSER.TB_M00_DEFINES010 DFS1
           ,M00APUSER.TB_M00_DEFINES020 DFS2
      WHERE DPD1.HIERARCHY_DATA_ID = DFS1.HIERARCHY_DATA_ID
        AND DFS1.MDL_DEFINE_ID =DFS2.MDL_DEFINE_ID 
        AND DFS1.USE_TP ='Y'
        AND DFS2.USE_TP ='Y'
        GROUP BY DT_NM_ID
        UNION 
        SELECT TbM00Rules020.DT_NM_ID
    FROM TB_M00_RULES010 TbM00Rules010
       , TB_M00_RULES020 TbM00Rules020
       , TB_M00_ATTRS TbM00Attrs
	   WHERE TbM00Rules010.MD_RULE_ID = TbM00Rules020.MD_RULE_ID 
         AND TbM00Rules020.DT_NM_ID = TbM00Attrs.DT_NM_ID
         AND TbM00Rules010.USE_TP ='Y'
         AND TbM00Rules020.USE_TP ='Y'
       GROUP BY TbM00Rules020.DT_NM_ID
       ) RULE
WHERE ATTRS.DT_NM_ID = RULE.DT_NM_ID(+)
  AND STANDARD_ENGLISH_ID LIKE :STANDARD_ENGLISH_ID ||'%'
  AND STANDARD_KOREAN_NAME LIKE '%' || :STANDARD_KOREAN_NAME ||'%'
  AND NVL(SYS_TP,'%') LIKE :SYS_TP ||'%'
  AND NVL(CHAIN_CODE,'%') LIKE :CHAIN_CODE
  ORDER BY ATTRS.DT_NM_ID
		 ]]> 
	 </query>
	 <query id="C107000050.update" desc="C107000050.update" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE M00APUSER.TB_M00_ATTRS
   SET /*+ C107000050   표준항목관리 업데이트   C107000050.update 원성옥  */
     STANDARD_ENGLISH_ID = :STANDARD_ENGLISH_ID            --표준항목ID
    ,STANDARD_KOREAN_NAME = :STANDARD_KOREAN_NAME          --표준항목명
    ,DT_NM_DATA_TP = :DT_NM_DATA_TP                        --항목데이터Type
    ,DT_NM_LEN = :DT_NM_LEN                                --항목길이
    ,DT_NM_DECIMAL_PREC = :DT_NM_DECIMAL_PREC              --항목소수점이하자리
    ,USE_TP = :USE_TP                                      --사용구분
    ,SYS_TP = :SYS_TP                                      --시스템구분
    ,CHAIN_CODE = :CHAIN_CODE                              --체인구분
    ,LAST_UPDATED_OBJECT_TYPE = :ObjectType                --최종변경Object유형
    ,LAST_UPDATED_OBJECT_ID = :ObjectId                    --최종변경ObjectID
    ,LAST_UPDATE_PROGRAM_ID = :ProgramId                   --최종변경프로그램ID
    ,LAST_UPDATE_TIMESTAMP = :Timestamp                    --최종변경일자
WHERE DT_NM_ID = :DT_NM_ID
		 ]]> 
	 </query>
	 <query id="C107000050.insert" desc="C107000050.insert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO M00APUSER.TB_M00_ATTRS
		 /*+ C107000050   표준항목관리 삽입   C107000050.insert 원성옥  */
		(DT_NM_ID                                          --항목ID
		,STANDARD_ENGLISH_ID                               --표준항목ID
		,STANDARD_KOREAN_NAME                              --표준항목명
		,DT_NM_DATA_TP                                     --항목데이터Type
		,DT_NM_LEN                                         --항목길이
		,DT_NM_DECIMAL_PREC                                --항목소수점이하자리
		,DT_NM_ALIAS                                       --표준항목명약어
		,DT_NM_ESSEN_V_ENTRY_F                             --항목필수값입력여부
		,DT_NM_DEFAULTS                                    --항목기본값
		,DT_NM_MIN_ALW_V                                   --항목Min허용값
		,DT_NM_MAX_ALW_V                                   --항목Max허용값
		,DT_NM_TARG_V                                      --항목목표값
		,DT_NM_UOM_CD                                      --항목UOM코드
		,PRIMARY_UNIT_OF_MEASURE                           --Primary_UOM
		,DT_NM_V_SCPE_OV_REC_F                             --항목값범위초과인정여부
		,DT_NM_TP                                          --항목유형
		,DT_NM_CHAR                                        --항목특성
		,DT_NM_RSIT_MOD                                    --항목등록요령
		,REMARKS                                           --비고
		,ATTR_NM                                           --AttributeName
		,ATTR_DATA_TP                                      --AttributeDataType
		,DT_NM_SQL_SELECT_STAT                             --항목SqlSelect명령문
		,DT_NM_SQL_COLUMN_STAT                             --항목SqlColumn명령문
		,DT_NM_SQL_TABLE_STAT                              --항목SqlTable명령문
		,LST_UPD_BY_IP                                     --최종수정자IP
		,DT_NM_CNG_GD                                      --항목변경등급
		,DT_NM_OWNER_EMP_NO                                --항목Owner직번
		,DEPARTMENT_CODE                                   --Department코드
		,NAME                                              --부서명
		,USE_TP                                            --사용구분
		,FK_DT_NM_ID                                       --상위항목ID
		,MES_UNIT_OF_MEASURE                               --MES_UOM
		,SYS_TP                                            --시스템구분
		,CHAIN_CODE                                        --체인구분
		,CREATED_OBJECT_TYPE                               --생성Object유형
		,CREATED_OBJECT_ID                                 --생성ObjectID
		,CREATED_PROGRAM_ID                                --생성프로그램ID
		,CREATION_TIMESTAMP                                --생성일시
		,LAST_UPDATED_OBJECT_TYPE                          --최종변경Object유형
		,LAST_UPDATED_OBJECT_ID                            --최종변경ObjectID
		,LAST_UPDATE_PROGRAM_ID                            --최종변경프로그램ID
		,LAST_UPDATE_TIMESTAMP                             --최종변경일자
		)
		VALUES 
		(M00APUSER.SQ_M00_ATTRS.NEXTVAL                     --항목ID
		,:STANDARD_ENGLISH_ID                               --표준항목ID
		,:STANDARD_KOREAN_NAME                              --표준항목명
		,:DT_NM_DATA_TP                                     --항목데이터Type
		,:DT_NM_LEN                                         --항목길이
		,:DT_NM_DECIMAL_PREC                                --항목소수점이하자리
		,:DT_NM_ALIAS                                       --표준항목명약어
		,:DT_NM_ESSEN_V_ENTRY_F                             --항목필수값입력여부
		,:DT_NM_DEFAULTS                                    --항목기본값
		,:DT_NM_MIN_ALW_V                                   --항목Min허용값
		,:DT_NM_MAX_ALW_V                                   --항목Max허용값
		,:DT_NM_TARG_V                                      --항목목표값
		,:DT_NM_UOM_CD                                      --항목UOM코드
		,:PRIMARY_UNIT_OF_MEASURE                           --Primary_UOM
		,:DT_NM_V_SCPE_OV_REC_F                             --항목값범위초과인정여부
		,:DT_NM_TP                                          --항목유형
		,:DT_NM_CHAR                                        --항목특성
		,:DT_NM_RSIT_MOD                                    --항목등록요령
		,:REMARKS                                           --비고
		,:ATTR_NM                                           --AttributeName
		,:ATTR_DATA_TP                                      --AttributeDataType
		,:DT_NM_SQL_SELECT_STAT                             --항목SqlSelect명령문
		,:DT_NM_SQL_COLUMN_STAT                             --항목SqlColumn명령문
		,:DT_NM_SQL_TABLE_STAT                              --항목SqlTable명령문
		,:LST_UPD_BY_IP                                     --최종수정자IP
		,:DT_NM_CNG_GD                                      --항목변경등급
		,:DT_NM_OWNER_EMP_NO                                --항목Owner직번
		,:DEPARTMENT_CODE                                   --Department코드
		,:NAME                                              --부서명
		,:USE_TP                                            --사용구분
		,:FK_DT_NM_ID                                       --상위항목ID
		,:MES_UNIT_OF_MEASURE                               --MES_UOM
		,:SYS_TP                                            --시스템구분
		,:CHAIN_CODE                                        --체인구분
		,:ObjectType                                        --생성Object유형
		,:ObjectId                                          --생성ObjectID
		,:ProgramId                                         --생성프로그램ID
		,:Timestamp                                         --생성일시
		,:ObjectType                                        --최종변경Object유형
		,:ObjectId                                          --최종변경ObjectID
		,:ProgramId                                         --최종변경프로그램ID
		,:Timestamp                                         --최종변경일자
		)
		 ]]> 
	 </query>
	 <query id="C107000050.delete" desc="C107000050.delete" fetchSize="10" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C107000050   표준항목관리 삭제   C107000050.delete 원성옥  */
  FROM M00APUSER.TB_M00_ATTRS
 WHERE DT_NM_ID = :DT_NM_ID
		 ]]> 
	 </query>
	 <query id="C107000050.chkUnique_U1" desc="C107000050.chkUnique_U1" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C107000050   유니크항목 무결성 체크  C107000050.chkUnique_U1 원성옥  */
              '1' AS CHK FROM M00APUSER.TB_M00_ATTRS
        WHERE STANDARD_ENGLISH_ID  = :STANDARD_ENGLISH_ID
          AND STANDARD_KOREAN_NAME = :STANDARD_KOREAN_NAME
          AND DT_NM_DATA_TP        = :DT_NM_DATA_TP          
          AND ((:DT_NM_LEN IS NOT NULL AND DT_NM_LEN = :DT_NM_LEN) OR (:DT_NM_LEN IS NULL AND DT_NM_LEN IS NULL))
          AND ((:DT_NM_DECIMAL_PREC IS NOT NULL AND DT_NM_DECIMAL_PREC = :DT_NM_DECIMAL_PREC) OR (:DT_NM_DECIMAL_PREC IS NULL AND DT_NM_DECIMAL_PREC IS NULL))
		 ]]> 
	 </query>
	 <query id="C107000050.chkUpdateRow" desc="C107000050.chkUpdateRow" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C107000050   업데이트 여부 체크   C107000050.chkUpdateRow 원성옥  */
              '1' AS CHK
         FROM M00APUSER.TB_M00_ATTRS
        WHERE DT_NM_ID             = :DT_NM_ID
          AND STANDARD_ENGLISH_ID  = :STANDARD_ENGLISH_ID
          AND STANDARD_KOREAN_NAME = :STANDARD_KOREAN_NAME
          AND ((:SYS_TP IS NOT NULL AND SYS_TP = :SYS_TP) OR (:SYS_TP IS NULL AND SYS_TP IS NULL))
          AND ((:CHAIN_CODE IS NOT NULL AND CHAIN_CODE = :CHAIN_CODE) OR (:CHAIN_CODE IS NULL AND CHAIN_CODE IS NULL))
          AND DT_NM_DATA_TP        = :DT_NM_DATA_TP          
          AND ((:DT_NM_LEN IS NOT NULL AND DT_NM_LEN = :DT_NM_LEN) OR (:DT_NM_LEN IS NULL AND DT_NM_LEN IS NULL))
          AND ((:DT_NM_DECIMAL_PREC IS NOT NULL AND DT_NM_DECIMAL_PREC = :DT_NM_DECIMAL_PREC) OR (:DT_NM_DECIMAL_PREC IS NULL AND DT_NM_DECIMAL_PREC IS NULL))
          AND ((:USE_TP IS NOT NULL AND USE_TP = :USE_TP) OR (:USE_TP IS NULL AND USE_TP IS NULL))
		 ]]> 
	 </query>
</queryMap>
