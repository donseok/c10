<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000020TAB02"> 
	 <query id="C104000020TAB02.select" desc="C104000020TAB02.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
select /*+ C10 품질설계결과-성분 C104000020TAB02.select 박재영 */ 
        DECODE(QLT_DSN_SPC_TP,'1','고객사양','2','규격사양','3','사내사양','4','보증사양') QLT_DSN_SPC_TP, 
             QLT_DSN_SPC_TP QLT_DSN_SPC_TP_CD,
       MAX(C_LLV) C_LLV,MAX(C_ULV) C_ULV, MAX(SI_LLV) SI_LLV,MAX(SI_ULV) SI_ULV, 
       MAX(MN_LLV) MN_LLV,MAX(MN_ULV) MN_ULV,MAX(P_LLV) P_LLV,MAX(P_ULV) P_ULV, 
       MAX(S_LLV) S_LLV,MAX(S_ULV) S_ULV, MAX(CR_LLV) CR_LLV,MAX(CR_ULV) CR_ULV,
       MAX(NI_LLV) NI_LLV,MAX(NI_ULV) NI_ULV, MAX(CU_LLV) CU_LLV,MAX(CU_ULV) CU_ULV, 
       MAX(AL_LLV) AL_LLV,MAX(AL_ULV) AL_ULV, MAX(TI_LLV) TI_LLV,MAX(TI_ULV) TI_ULV,
       MAX(NB_LLV) NB_LLV,MAX(NB_ULV) NB_ULV, MAX(V_LLV) V_LLV,MAX(V_ULV) V_ULV,
       MAX(N_LLV) N_LLV,MAX(N_ULV) N_ULV
FROM (SELECT '1' QLT_DSN_SPC_TP,
            NULL C_LLV,NULL C_ULV, NULL SI_LLV,NULL SI_ULV,
            NULL MN_LLV,NULL MN_ULV, NULL P_LLV,NULL P_ULV,
            NULL S_LLV,NULL S_ULV, NULL CR_LLV,NULL CR_ULV,
            NULL NI_LLV,NULL NI_ULV, NULL CU_LLV,NULL CU_ULV,
            NULL AL_LLV,NULL AL_ULV, NULL TI_LLV,NULL TI_ULV,
            NULL NB_LLV,NULL NB_ULV, NULL V_LLV,NULL V_ULV,
            NULL N_LLV,NULL N_ULV
      FROM DUAL
      
      UNION ALL

      SELECT '2' QLT_DSN_SPC_TP,
            NULL C_LLV,NULL C_ULV, NULL SI_LLV,NULL SI_ULV,
            NULL MN_LLV,NULL MN_ULV, NULL P_LLV,NULL P_ULV,
            NULL S_LLV,NULL S_ULV, NULL CR_LLV,NULL CR_ULV,
            NULL NI_LLV,NULL NI_ULV,
            NULL CU_LLV,NULL CU_ULV,
            NULL AL_LLV,NULL AL_ULV,
            NULL TI_LLV,NULL TI_ULV,
            NULL NB_LLV,NULL NB_ULV,
            NULL V_LLV,NULL V_ULV,
            NULL N_LLV,NULL N_ULV

      FROM DUAL

      UNION ALL

      SELECT '3' QLT_DSN_SPC_TP,
            NULL C_LLV,NULL C_ULV,
            NULL SI_LLV,NULL SI_ULV,
            NULL MN_LLV,NULL MN_ULV,
            NULL P_LLV,NULL P_ULV,
            NULL S_LLV,NULL S_ULV,
            NULL CR_LLV,NULL CR_ULV,
            NULL NI_LLV,NULL NI_ULV,
            NULL CU_LLV,NULL CU_ULV,
            NULL AL_LLV,NULL AL_ULV,
            NULL TI_LLV,NULL TI_ULV,
            NULL NB_LLV,NULL NB_ULV,
            NULL V_LLV,NULL V_ULV,
            NULL N_LLV,NULL N_ULV

      FROM DUAL

      UNION ALL

      SELECT '4' QLT_DSN_SPC_TP,
            NULL C_LLV,NULL C_ULV,
            NULL SI_LLV,NULL SI_ULV,
            NULL MN_LLV,NULL MN_ULV,
            NULL P_LLV,NULL P_ULV,
            NULL S_LLV,NULL S_ULV,
            NULL CR_LLV,NULL CR_ULV,
            NULL NI_LLV,NULL NI_ULV,
            NULL CU_LLV,NULL CU_ULV,
            NULL AL_LLV,NULL AL_ULV,
            NULL TI_LLV,NULL TI_ULV,
            NULL NB_LLV,NULL NB_ULV,
            NULL V_LLV,NULL V_ULV,
            NULL N_LLV,NULL N_ULV

      FROM DUAL

      UNION ALL
      
      SELECT QLT_DSN_SPC_TP
            ,C_LLV,C_ULV
            ,SI_LLV,SI_ULV
            ,MN_LLV,MN_ULV
            ,P_LLV,P_ULV
            ,S_LLV,S_ULV
            ,CR_LLV,CR_ULV
            ,NI_LLV,NI_ULV
            ,CU_LLV,CU_ULV
            ,AL_LLV,AL_ULV
            ,TI_LLV,TI_ULV
            ,NB_LLV,NB_ULV
            ,V_LLV,V_ULV
            ,N_LLV,N_ULV
      FROM C10APUSER.TB_C10_QLT_DSN_CHM A
      WHERE ORD_NO = :ORD_NO
      AND   ORD_LN = :ORD_LN
      AND NOT EXISTS (SELECT * FROM MESAPUSER.VI_MES_TRM_CTL 
                           WHERE CTL_NO = A.ORD_NO AND CTL_TP = 'O')
      )
GROUP BY DECODE(QLT_DSN_SPC_TP,'1','고객사양','2','규격사양','3','사내사양','보증사양')
         , QLT_DSN_SPC_TP
ORDER BY QLT_DSN_SPC_TP_CD
		 ]]> 
	 </query>
</queryMap>
