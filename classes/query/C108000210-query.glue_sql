<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000210 Page 쿼리파일"> 
	 <query id="C108000210.selectInkDev" desc="잉크젯개발 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 잉크젯개발 조회 C108000210.selectInkDev 전경진 */
     CD.PRD_DEV_NO, 
     CD.CLR_DEV_NO, 
     CD.CLR_DEV_CHR_UID, 
     CD.CLR_DEV_DH, 
     CD.CLR_NO, 
     CD.RSN_TP, 
     CD.LUS_RT_CD, 
     CD.PNT_FLM_THK, 
     CD.PMT, 
     CD.PNT_GRA, 
     CD.NV, 
     CD.SLV_GRA, 
     CD.THR_CD, 
     CD.VISCO, 
     CD.WK_VISCO, 
     CD.QT_L, 
     CD.QT_A, 
     CD.QT_B, 
     CD.PRT_ROLL_NO
FROM C10APUSER.TB_C10_PRD_CLR_DEV CD
WHERE CD.PRD_DEV_NO = :PRD_DEV_NO
AND   CD.CLR_DEV_NO LIKE :CLR_DEV_NO||'%'
AND   CD.CLR_DEV_CHR_UID LIKE :CLR_DEV_CHR_UID||'%'
ORDER BY CD.PRD_DEV_NO, CD.CLR_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000210.updateInkDev" desc="잉크젯개발 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 잉크젯개발 수정 C108000210.updateInkDev 전경진 */
    C10APUSER.TB_C10_PRD_CLR_DEV
SET CLR_DEV_CHR_UID = :CLR_DEV_CHR_UID,
    CLR_DEV_DH = :CLR_DEV_DH,
    CLR_NO = :CLR_NO,
    RSN_TP = :RSN_TP,
    LUS_RT_CD = :LUS_RT_CD,
    PNT_FLM_THK = :PNT_FLM_THK,
    PMT = :PMT,
    PNT_GRA = :PNT_GRA,
    NV = :NV, 
    SLV_GRA = :SLV_GRA, 
    THR_CD = :THR_CD, 
    VISCO = :VISCO, 
    WK_VISCO = :WK_VISCO, 
    QT_L = :QT_L, 
    QT_A = :QT_A, 
    QT_B= :QT_B, 
    PRT_ROLL_NO= :PRT_ROLL_NO,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE PRD_DEV_NO = :PRD_DEV_NO 
AND   CLR_DEV_NO = :CLR_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000210.insertInkDev" desc="잉크젯개발 삽입" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 잉크젯개발 등록 C108000210.insertInkDev 전경진*/
INTO C10APUSER.TB_C10_PRD_CLR_DEV
(   PRD_DEV_NO, 
    CLR_DEV_NO, 
    CLR_DEV_CHR_UID, 
    CLR_DEV_DH, 
    CLR_NO, 
    RSN_TP, 
    LUS_RT_CD, 
    PNT_FLM_THK, 
    PMT, 
    PNT_GRA, 
    NV, 
    SLV_GRA, 
    THR_CD, 
    VISCO, 
    WK_VISCO, 
    QT_L, 
    QT_A, 
    QT_B, 
    PRT_ROLL_NO,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP
)VALUES(
:PRD_DEV_NO, 
TO_CHAR(
 (SELECT TO_NUMBER(NVL(MAX(CLR_DEV_NO), '20')) + 1
  FROM   C10APUSER.TB_C10_PRD_CLR_DEV
  WHERE  PRD_DEV_NO= :PRD_DEV_NO) ),
:CLR_DEV_CHR_UID, 
:CLR_DEV_DH, 
:CLR_NO, 
:RSN_TP, 
:LUS_RT_CD, 
:PNT_FLM_THK, 
:PMT, 
:PNT_GRA, 
:NV, 
:SLV_GRA, 
:THR_CD, 
:VISCO, 
:WK_VISCO, 
:QT_L, 
:QT_A, 
:QT_B, 
:PRT_ROLL_NO,
:ObjectType,
:ObjectId,
:ProgramId,
:Timestamp,
:ObjectType,
:ObjectId,
:ProgramId,
:Timestamp )
		 ]]> 
	 </query>
	 <query id="C108000210.deleteInkDev" desc="잉크젯개발 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 잉크젯개발 삭제 C108000210.deleteInkDev 전경진 */
    C10APUSER.TB_C10_PRD_CLR_DEV
WHERE PRD_DEV_NO = :PRD_DEV_NO 
AND   CLR_DEV_NO = :CLR_DEV_NO
		 ]]> 
	 </query>
</queryMap>
