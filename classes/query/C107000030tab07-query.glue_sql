<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000030tab07 Page 쿼리파일"> 
	 <query id="C107000030tab07.select" desc="C107000030tab07 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT
 RULES040.MD_RULE_CON_NUM        SEQ
,RULES040.MD_RULE_CON_OLSTATR_1  CON1
,RULES040.MD_RULE_CON_MI_V_1     MIN1
,RULES040.MD_RULE_CON_OLSTATR_2  CON2
,RULES040.MD_RULE_CON_MI_V_2     MIN2 
,M00APUSER.FUNC_GET_YEONSAN(UPPER(RULES040.MD_RULE_CON_OLSTATR_3)) CON3
,RULES040.MD_RULE_CON_MI_V_3     MIN3
,RULES040.MD_RULE_CON_MAX_V_3    MAX3

,RULES040.MD_RULE_DECISION_RST1   RST1
,RULES040.MD_RULE_DECISION_RST2   RST2
,RULES040.MD_RULE_DECISION_RST3   RST3
,RULES040.MD_RULE_DECISION_RST4   RST4
,RULES040.MD_RULE_DECISION_RST5   RST5
,RULES040.MD_RULE_DECISION_RST6   RST6
,RULES040.MD_RULE_DECISION_RST7   RST7
,RULES040.MD_RULE_DECISION_RST8   RST8
,RULES040.MD_RULE_DECISION_RST9   RST9
,RULES040.MD_RULE_DECISION_RST10   RST10
,RULES040.MD_RULE_DECISION_RST11   RST11
,RULES040.MD_RULE_DECISION_RST12   RST12
,RULES040.MD_RULE_DECISION_RST13   RST13
,RULES040.MD_RULE_DECISION_RST14   RST14


FROM M00APUSER.TB_M00_RULES040 RULES040,  
    (SELECT MD_RULE_ID   
       FROM M00APUSER.TB_M00_RULES010  
      WHERE MD_RULE_NM='C10B1032'  
        AND START_ACTIVE_DATE <=  SYSDATE  
        AND SYSDATE < END_ACTIVE_DATE)  RULES010  
WHERE RULES010.MD_RULE_ID = RULES040.MD_RULE_ID
		 ]]> 
	 </query>
</queryMap>
