<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="로그인"> 
	 <query id="user.info" desc="사용자 정보를 가져오는 쿼리이다" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT 
  USER_ID, 
  USER_NO, 
  USER_NAME, 
  ENCRYPTED_FOUNDATION_PASSWORD, 
  START_ACTIVE_DATE, 
  END_ACTIVE_DATE, 
  WORK_LOCATION
FROM TB_SEC_USER
WHERE USER_NO = ?
		 ]]> 
	 </query>
</queryMap>
