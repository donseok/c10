            M00APUSER.TB_M00_CODES030
            (
                CD_TP_ID,
                CATEGORY_GROUP_ID,
                CD_V,
                CD_V_MEANING,
                CD_V_EXPLAIN,
                LST_UPD_BY_IP,
                RG_DT_NM_F,
                RG_MIN_V,
                RG_MAX_V,
                CREATED_OBJECT_TYPE,
                CREATED_OBJECT_ID,
                CREATED_PROGRAM_ID,
                CREATION_TIMESTAMP,
                LAST_UPDATED_OBJECT_TYPE,
                LAST_UPDATED_OBJECT_ID,
                LAST_UPDATE_PROGRAM_ID,
                LAST_UPDATE_TIMESTAMP
)
VALUES(
    '952',
    '892',
    ?,
    ?,
    '',
    '',
    '',
    '',
    '',
    ?,?,?,?,
    ?,?,?,?
)
		 ]]> 
	 </query>
