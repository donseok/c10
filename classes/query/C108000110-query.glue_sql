<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000110 Page 쿼리파일"> 
	 <query id="C108000110.selectReqBom" desc="제품개발의뢰BOM 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발의뢰BOM 조회 C108000110.selectReqBom 전경진 */
    RBM.PRD_DEV_NO, 
    RBM.DEV_REQ_SPEC_NO, 
    RBM.DEV_REQ_BOM_NO, 
    RBM.HUE_CD_FRN_1COT, 
    RBM.HUE_CD_FRN_2COT,
    RBM.HUE_CD_FRN_3COT, 
    RBM.HUE_CD_FRN_4COT, 
    RBM.HUE_CD_BAK_1COT, 
    RBM.HUE_CD_BAK_2COT, 
    RBM.HUE_CD_BAK_3COT, 
    RBM.HUE_CD_BAK_4COT, 
    RBM.HUE_CD_LMN, 
    RBM.PRT_ROLL_NO1, 
    RBM.PRT_INK_CD1, 
    RBM.PRT_ROLL_NO2, 
    RBM.PRT_INK_CD2, 
    RBM.PRT_ROLL_NO3, 
    RBM.PRT_INK_CD3, 
    RBM.PRT_ROLL_NO4, 
    RBM.PRT_INK_CD4, 
    RBM.UNI_TEX_ROLL_NO, 
    RBM.PICK_UP_ROLL_NO, 
    RBM.IMPT_ROLL_NO, 
    RBM.SIM_HUE_PRG_YN, 
    RBM.PNT_CMP_CD, 
    RBM.COT_MTH, 
    RBM.RSN_TP, 
    RBM.TLP_TP, 
    RBM.RL_LUS_RT, 
    RBM.PNT_FLM_THK_TXT, 
    RBM.LMN_BND_CMP_CD, 
    RBM.LMN_KND_TP, 
    RBM.LMN_FLM_THK, 
    RBM.DSN_SIM_FILE, 
    RBM.PRT_BY_ROLL_CMP_CD, 
    RBM.SPC_PRD_AF_WK 
FROM C10APUSER.TB_C10_PRD_DEV_REQ_BOM RBM
    ,C10APUSER.TB_C10_PRD_DEV_CMN     CMN
WHERE RBM.PRD_DEV_NO = CMN.PRD_DEV_NO
AND   RBM.PRD_DEV_NO = :PRD_DEV_NO
AND   RBM.DEV_REQ_SPEC_NO = NVL(:DEV_REQ_SPEC_NO, RBM.DEV_REQ_SPEC_NO)
AND   RBM.DEV_REQ_BOM_NO = NVL(:DEV_REQ_BOM_NO, RBM.DEV_REQ_BOM_NO)
AND   RBM.PNT_CMP_CD  = :PNT_CMP_CD 
AND  ((:DEV_PRG_CD_40 = '1' AND CMN.DEV_PRG_CD = '40')
   OR (:DEV_PRG_CD_50 = '1' AND CMN.DEV_PRG_CD = '50')
   OR (:DEV_PRG_CD_51 = '1' AND CMN.DEV_PRG_CD = '51')
   OR (:DEV_PRG_CD_91 = '1' AND CMN.DEV_PRG_CD = '91')
   OR (:DEV_PRG_CD_60 = '1' AND CMN.DEV_PRG_CD = '60'))
ORDER BY RBM.PRD_DEV_NO, RBM.DEV_REQ_SPEC_NO, RBM.DEV_REQ_BOM_NO
		 ]]> 
	 </query>
	 <query id="C108000110.selectCmpBom" desc="제품개발완료BOM 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발완료BOM 조회 C108000110.selectCmpBom 전경진 */
    CBM.PRD_DEV_NO, 
    CBM.DEV_REQ_SPEC_NO, 
    CBM.DEV_REQ_BOM_NO, 
    CBM.DEV_CMP_BOM_NO,
    CBM.PRD_DEV_NO||CBM.DEV_REQ_SPEC_NO||CBM.DEV_REQ_BOM_NO||CBM.DEV_CMP_BOM_NO AS PRD_DEV_CMP_BOM_NO,
    CBM.DEV_CMP_DH, 
    CBM.DEV_CHR_UID, 
    CBM.HUE_CD_FRN_1COT, 
    CBM.HUE_CD_FRN_2COT, 
    CBM.HUE_CD_FRN_3COT, 
    CBM.HUE_CD_FRN_4COT, 
    CBM.HUE_CD_BAK_1COT, 
    CBM.HUE_CD_BAK_2COT, 
    CBM.HUE_CD_BAK_3COT, 
    CBM.HUE_CD_BAK_4COT, 
    CBM.HUE_CD_LMN, 
    CBM.PRT_ROLL_NO1, 
    CBM.PRT_INK_CD1, 
    CBM.PRT_ROLL_NO2, 
    CBM.PRT_INK_CD2, 
    CBM.PRT_ROLL_NO3, 
    CBM.PRT_INK_CD3, 
    CBM.PRT_ROLL_NO4, 
    CBM.PRT_INK_CD4, 
    CBM.UNI_TEX_ROLL_NO, 
    CBM.PICK_UP_ROLL_NO, 
    CBM.IMPT_ROLL_NO,
    CBM.UNFIX_NO,
    CBM.COT_MTH,
    CBM.TLP_TP,
    CBM.CCL_BOM_WR_YN,
    CBM.DISC_PTN_WTH_CD,
    CBM.UNI_TEX_PTN_CD,
    CBM.CUT_LN_YN,
    CBM.PT_TP,
    CBM.PRT_USG_CD,
    CBM.PRT_PTN_CD,
    CBM.SPC_PRD_AF_NO,
    CBM.INK_DEV_NO,
    CBM.DEV_CMP_RMK
FROM C10APUSER.TB_C10_PRD_DEV_CMP_BOM CBM
WHERE CBM.PRD_DEV_NO= :PRD_DEV_NO 
AND   CBM.DEV_REQ_SPEC_NO= :DEV_REQ_SPEC_NO
AND   CBM.DEV_REQ_BOM_NO= :DEV_REQ_BOM_NO
ORDER BY CBM.PRD_DEV_NO, CBM.DEV_REQ_SPEC_NO, CBM.DEV_REQ_BOM_NO, CBM.DEV_CMP_BOM_NO
		 ]]> 
	 </query>
	 <query id="C108000110.updateCmpBom" desc="제품개발완료BOM 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 제품개발완료BOM 수정 C108000110.updateCmpBom 전경진 */
    C10APUSER.TB_C10_PRD_DEV_CMP_BOM
SET DEV_CMP_DH= :DEV_CMP_DH, 
    DEV_CHR_UID= :DEV_CHR_UID, 
    HUE_CD_FRN_1COT= :HUE_CD_FRN_1COT, 
    HUE_CD_FRN_2COT= :HUE_CD_FRN_2COT, 
    HUE_CD_FRN_3COT= :HUE_CD_FRN_3COT, 
    HUE_CD_FRN_4COT= :HUE_CD_FRN_4COT, 
    HUE_CD_BAK_1COT= :HUE_CD_BAK_1COT, 
    HUE_CD_BAK_2COT= :HUE_CD_BAK_2COT, 
    HUE_CD_BAK_3COT= :HUE_CD_BAK_3COT, 
    HUE_CD_BAK_4COT= :HUE_CD_BAK_4COT, 
    HUE_CD_LMN= :HUE_CD_LMN, 
    PRT_ROLL_NO1= :PRT_ROLL_NO1, 
    PRT_INK_CD1= :PRT_INK_CD1, 
    PRT_ROLL_NO2= :PRT_ROLL_NO2, 
    PRT_INK_CD2= :PRT_INK_CD2, 
    PRT_ROLL_NO3= :PRT_ROLL_NO3, 
    PRT_INK_CD3= :PRT_INK_CD3, 
    PRT_ROLL_NO4= :PRT_ROLL_NO4, 
    PRT_INK_CD4= :PRT_INK_CD4, 
    UNI_TEX_ROLL_NO= :UNI_TEX_ROLL_NO, 
    PICK_UP_ROLL_NO= :PICK_UP_ROLL_NO, 
    IMPT_ROLL_NO= :IMPT_ROLL_NO,
    UNFIX_NO= :UNFIX_NO,
    COT_MTH= :COT_MTH,
    TLP_TP= :TLP_TP,
    CCL_BOM_WR_YN= :CCL_BOM_WR_YN,
    DISC_PTN_WTH_CD= :DISC_PTN_WTH_CD,
    UNI_TEX_PTN_CD= :UNI_TEX_PTN_CD,
    CUT_LN_YN= :CUT_LN_YN,
    PT_TP= :PT_TP,
    PRT_USG_CD= :PRT_USG_CD,
    PRT_PTN_CD= :PRT_PTN_CD,
    SPC_PRD_AF_NO= :SPC_PRD_AF_NO,
    INK_DEV_NO= :INK_DEV_NO,
    DEV_CMP_RMK= :DEV_CMP_RMK,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE PRD_DEV_NO= :PRD_DEV_NO 
AND   DEV_REQ_SPEC_NO= :DEV_REQ_SPEC_NO
AND   DEV_REQ_BOM_NO= :DEV_REQ_BOM_NO
AND   DEV_CMP_BOM_NO= :DEV_CMP_BOM_NO
AND	  DEV_CMP_DH IS NULL
		 ]]> 
	 </query>
	 <query id="C108000110.insertCmpBom" desc="제품개발완료BOM 삽입" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 제품개발완료BOM 등록 C108000110.insertCmpBom 전경진*/
INTO C10APUSER.TB_C10_PRD_DEV_CMP_BOM
(   PRD_DEV_NO, 
    DEV_REQ_SPEC_NO, 
    DEV_REQ_BOM_NO, 
    DEV_CMP_BOM_NO, 
    DEV_CMP_DH, 
    DEV_CHR_UID, 
    HUE_CD_FRN_1COT, 
    HUE_CD_FRN_2COT, 
    HUE_CD_FRN_3COT, 
    HUE_CD_FRN_4COT, 
    HUE_CD_BAK_1COT, 
    HUE_CD_BAK_2COT, 
    HUE_CD_BAK_3COT, 
    HUE_CD_BAK_4COT, 
    HUE_CD_LMN, 
    PRT_ROLL_NO1, 
    PRT_INK_CD1, 
    PRT_ROLL_NO2, 
    PRT_INK_CD2, 
    PRT_ROLL_NO3, 
    PRT_INK_CD3, 
    PRT_ROLL_NO4, 
    PRT_INK_CD4, 
    UNI_TEX_ROLL_NO, 
    PICK_UP_ROLL_NO, 
    IMPT_ROLL_NO,
    UNFIX_NO,
    COT_MTH,
    TLP_TP,
    CCL_BOM_WR_YN,
    DISC_PTN_WTH_CD,
    UNI_TEX_PTN_CD,
    CUT_LN_YN,
    PT_TP,
    PRT_USG_CD,
    PRT_PTN_CD,   
    SPC_PRD_AF_NO,
    INK_DEV_NO,
    DEV_CMP_RMK,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP
)VALUES(
	:PRD_DEV_NO, 
	:DEV_REQ_SPEC_NO, 
	:DEV_REQ_BOM_NO, 
	TO_CHAR(
	 (SELECT TO_NUMBER(NVL(MAX(DEV_CMP_BOM_NO), '30')) + 1
	  FROM   C10APUSER.TB_C10_PRD_DEV_CMP_BOM
	  WHERE  PRD_DEV_NO= :PRD_DEV_NO 
	  AND   DEV_REQ_SPEC_NO= :DEV_REQ_SPEC_NO
	  AND   DEV_REQ_BOM_NO= :DEV_REQ_BOM_NO) ),
	:DEV_CMP_DH, 
	:DEV_CHR_UID, 
	:HUE_CD_FRN_1COT, 
	:HUE_CD_FRN_2COT, 
	:HUE_CD_FRN_3COT, 
	:HUE_CD_FRN_4COT, 
	:HUE_CD_BAK_1COT, 
	:HUE_CD_BAK_2COT, 
	:HUE_CD_BAK_3COT, 
	:HUE_CD_BAK_4COT, 
	:HUE_CD_LMN, 
	:PRT_ROLL_NO1, 
	:PRT_INK_CD1, 
	:PRT_ROLL_NO2, 
	:PRT_INK_CD2, 
	:PRT_ROLL_NO3, 
	:PRT_INK_CD3, 
	:PRT_ROLL_NO4, 
	:PRT_INK_CD4, 
	:UNI_TEX_ROLL_NO, 
	:PICK_UP_ROLL_NO, 
	:IMPT_ROLL_NO,
	:UNFIX_NO,
	:COT_MTH,
	:TLP_TP,
	:CCL_BOM_WR_YN,
	:DISC_PTN_WTH_CD,
	:UNI_TEX_PTN_CD,
	:CUT_LN_YN,
	:PT_TP,
	:PRT_USG_CD,
	:PRT_PTN_CD,
	:SPC_PRD_AF_NO,
	:INK_DEV_NO,
	:DEV_CMP_RMK,
	:ObjectType,
	:ObjectId,
	:ProgramId,
	:Timestamp,
	:ObjectType,
	:ObjectId,
	:ProgramId,
	:Timestamp)
		 ]]> 
	 </query>
	 <query id="C108000110.deleteCmpBom" desc="제품개발완료BOM 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 제품개발완료BOM 삭제 C108000110.deleteCmpBom 전경진 */
    C10APUSER.TB_C10_PRD_DEV_CMP_BOM
WHERE PRD_DEV_NO= :PRD_DEV_NO 
AND   DEV_REQ_SPEC_NO= :DEV_REQ_SPEC_NO
AND   DEV_REQ_BOM_NO= :DEV_REQ_BOM_NO
AND   DEV_CMP_BOM_NO= :DEV_CMP_BOM_NO
AND	  DEV_CMP_DH IS NULL
		 ]]> 
	 </query>
	 <query id="C108000110.updateDevCmn" desc="진도코드 50 처리" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 제품개발공통 진도 수정 C108000090.updateDevCmn 전경진 */
    C10APUSER.TB_C10_PRD_DEV_CMN
SET DEV_PRG_CD = '50',
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE PRD_DEV_NO = :PRD_DEV_NO
AND   DEV_PRG_CD = '40'
		 ]]> 
	 </query>
	 <query id="C108000110.selectLabSmp" desc="LAB 샘플 조회" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C10  LAB개발샘플 조회 C108000110.selectLabSmp  전경진 */ 
    SMPL_NO,
    SMPL_TP,
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'SMPL_TP'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SMPL_TP) AS SMPL_TP_NM, 
    SMPL_CHG_TP,
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'SMPL_CHG_TP'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SMPL_CHG_TP) AS SMPL_CHG_TP_NM,         
    DEV_NO AS PRD_DEV_CMP_BOM_NO,
    (SELECT SMTL_SLP_NM
       FROM TB_M30_SMTL_SLP_MASTER
      WHERE SMTL_SLP_CD = A.SMTL_SLP_CD) SMTL_SLP_NM,   
    (SELECT EMP_NM  FROM M90APUSER.TB_M90_EMP_INF WHERE EMP_ID = SMPL_PRD_ID) SMPL_PRD_NM,
    TO_CHAR(SMPL_PRD_CMP_DH,'YYYY-MM-DD') SMPL_PRD_CMP_DH,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'CUS_CD'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = CUS_CD) CUS_CD_NM,
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'SMPL_STS_CD'         
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SMPL_STS_CD) AS SMPL_STS_CD_NM, 
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'SMPL_SZ_CD'         
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SMPL_SZ_CD) AS SMPL_SZ_CD_NM, 
    SMPL_QTY,
    DEV_CMP_BOM_NO,
    CCL_BOM_NO,
    CLR_SUB_MTL_CD,
    CUS_APPR_YN,
    (SELECT EMP_NM  FROM M90APUSER.TB_M90_EMP_INF WHERE EMP_ID = CUS_APPR_ID) CUS_APPR_NM,
    TO_CHAR(CUS_APPR_DH,'YYYY-MM-DD')  CUS_APPR_DH,
    MKT_APPR_YN,
    (SELECT EMP_NM  FROM M90APUSER.TB_M90_EMP_INF WHERE EMP_ID = MKT_APPR_ID) MKT_APPR_NM,
    TO_CHAR(MKT_APPR_DH,'YYYY-MM-DD') MKT_APPR_DH,
    SMPL_PUB_YN,
    REMARK,
    ' ' PRD_NM,
    ( SELECT COUNT(SMPL_NO) FROM MESAPUSER.TB_M20_SMPL_CUR_APPR_DTL WHERE SMPL_NO = A.SMPL_NO) APPR_CNT,
    ( SELECT COUNT(SMPL_NO) FROM MESAPUSER.TB_M20_SMPL_MKT_REQ_DTL WHERE SMPL_NO = A.SMPL_NO) MKT_CNT
 FROM MESAPUSER.TB_M20_SMPL_LAB_MNG A
WHERE DEV_NO = :PRD_DEV_CMP_BOM_NO
ORDER BY SMPL_PRD_CMP_DH, SMPL_NO
		 ]]> 
	 </query>
	 <query id="C108000110.updateLabSmp" desc="샘플 이력 삭제" isNamed="true">
		 <![CDATA[ 
UPDATE  /*+  C108000110   LAB샘플연결 해제 C108000110.updateLabSmp 전경진 */ 
	MESAPUSER.TB_M20_SMPL_LAB_MNG
SET DEV_NO = '',
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE SMPL_NO = :SMPL_NO
AND	  DEV_NO = :PRD_DEV_CMP_BOM_NO
		 ]]> 
	 </query>
</queryMap>
