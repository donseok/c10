<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000120tab02 Page 쿼리파일"> 
	 <query id="C106000120tab02.select" desc="보증서 예외 기준 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000120tab02  보증서 예외 기준 조회   C106000120tab02.select 원성옥  */
       CCL_BOM_NO,
	   CLS_CD,
       DIV_CD,
       RSN_TP,
       BRD_CMP_2,
       RSN_TP_NM,
       PER_FOR_19,
       PER_FOR_6,
       FA_TRM_7,
       FA_TRM_8,
       FA_ROF_9,
       FA_ROF_10,
       FA_WAL_11,
       FA_WAL_12,
       CH_TRM_13,
       CH_TRM_14,
       CH_ROF_15,
       CH_ROF_16,
       CH_WAL_17,
       CH_WAL_18,
       PE_FL_20,
       PE_FL_1,
       (SELECT USER_NAME
          FROM M90APUSER.TB_M90_EMP_INF	
         WHERE USER_NO = LAST_UPDATED_OBJECT_ID) CREATED_OBJECT_ID,
       TO_CHAR(LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD') AS CREATION_TIMESTAMP
   FROM C10APUSER.TB_C10_WAR_TRM_MNG_EXP
  WHERE CCL_BOM_NO LIKE :CCL_BOM_NO ||'%'
    AND CLS_CD LIKE :CLS_COMB ||'%'
    AND DIV_CD LIKE :DIV_COMB ||'%'
    AND RSN_TP LIKE :RSN_COMB ||'%'
  ORDER BY CCL_BOM_NO
		 ]]> 
	 </query>
	 <query id="C106000120tab02.update" desc="보증서 예외기준 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C106000120tab02  보증서 예외기준 수정   C106000120tab02.update 원성옥  */
       C10APUSER.TB_C10_WAR_TRM_MNG_EXP
   SET DIV_CD    = :DIV_CD,
         RSN_TP    = :RSN_TP,
         BRD_CMP_2 = :BRD_CMP_2,
         RSN_TP_NM = :RSN_TP_NM,
         PER_FOR_19= :PER_FOR_19,
         PER_FOR_6 = :PER_FOR_6,
         FA_TRM_7  = :FA_TRM_7,
         FA_TRM_8  = :FA_TRM_8,
         FA_ROF_9  = :FA_ROF_9,
         FA_ROF_10 = :FA_ROF_10,
         FA_WAL_11 = :FA_WAL_11,
         FA_WAL_12 = :FA_WAL_12,
         CH_TRM_13 = :CH_TRM_13,
         CH_TRM_14 = :CH_TRM_14,
         CH_ROF_15 = :CH_ROF_15,
         CH_ROF_16 = :CH_ROF_16,
         CH_WAL_17 = :CH_WAL_17,
         CH_WAL_18 = :CH_WAL_18,
         PE_FL_1   = :PE_FL_1,
         PE_FL_20  = :PE_FL_20,
         GT_MT     = :GT_MT,
         GT_FT     = :GT_FT,
	  LAST_UPDATED_OBJECT_TYPE = :ObjectType,
	  LAST_UPDATED_OBJECT_ID   = :ObjectId,
	  LAST_UPDATE_PROGRAM_ID   = :ProgramId,
	  LAST_UPDATE_TIMESTAMP    = :Timestamp
 WHERE CCL_BOM_NO = :CCL_BOM_NO
   AND CLS_CD = :CLS_CD
		 ]]> 
	 </query>
	 <query id="C106000120tab02.delete" desc="C106000120tab02 정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE FROM /*+ C106000120tab02  보증서 예외기준 삭제   C106000120tab02.update 원성옥  */
       C10APUSER.TB_C10_WAR_TRM_MNG_EXP
 WHERE CCL_BOM_NO = :CCL_BOM_NO
   AND CLS_CD = :CLS_CD
		 ]]> 
	 </query>
	 <query id="C106000120tab02.insert" desc=" 보증서 예외기준 추가" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C106000120tab02  보증서 예외기준 추가   C106000120tab02.insert 원성옥  */
            C10APUSER.TB_C10_WAR_TRM_MNG_EXP(
	        CCL_BOM_NO,
	        CLS_CD,
	        DIV_CD,
	        RSN_TP,
	        BRD_CMP_2,
	        RSN_TP_NM,
	        PER_FOR_19,
	        PER_FOR_6,
	        FA_TRM_7,
	        FA_TRM_8,
	        FA_ROF_9,
	        FA_ROF_10,
	        FA_WAL_11,
	        FA_WAL_12,
	        CH_TRM_13,
	        CH_TRM_14,
	        CH_ROF_15,
	        CH_ROF_16,
	        CH_WAL_17,
	        CH_WAL_18,
	        PE_FL_1,
	        PE_FL_20,
	        CREATED_OBJECT_TYPE, 
	        CREATED_OBJECT_ID,
	        CREATED_PROGRAM_ID,
	        CREATION_TIMESTAMP,
	        LAST_UPDATED_OBJECT_TYPE,
	        LAST_UPDATED_OBJECT_ID,
	        LAST_UPDATE_PROGRAM_ID,
	        LAST_UPDATE_TIMESTAMP,
               GT_MT,
               GT_FT)
	VALUES(
              :CCL_BOM_NO,
		:CLS_CD,
	       :DIV_CD,
	       :RSN_TP,
	       :BRD_CMP_2,
	       :RSN_TP_NM,
	       :PER_FOR_19,
	       :PER_FOR_6,
	       :FA_TRM_7,
	       :FA_TRM_8,
	       :FA_ROF_9,
	       :FA_ROF_10,
	       :FA_WAL_11,
	       :FA_WAL_12,
	       :CH_TRM_13,
	       :CH_TRM_14,
	       :CH_ROF_15,
	       :CH_ROF_16,
	       :CH_WAL_17,
	       :CH_WAL_18,
	       :PE_FL_1,
	       :PE_FL_20,
	       :ObjectType,
	       :ObjectId,
	       :ProgramId,
	       :Timestamp,
	       :ObjectType,
	       :ObjectId,
	       :ProgramId,
	       :Timestamp,
              :GT_MT,
              :GT_FT)
		 ]]> 
	 </query>
	 <query id="C106000120tab02ClsCdComb.select" desc="C106000120tab02ClsCdComb.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT '%' AS CLS_CD,'전체' AS CLS_NM -- '전체'컬럼 생성
  FROM DUAL 
UNION ALL -- 테이블 조합
SELECT CLS_CD, CLS_CD AS CLS_NM  
  FROM C10APUSER.TB_C10_WAR_TRM_MNG_EXP
  GROUP BY CLS_CD
  ORDER BY CLS_CD
		 ]]> 
	 </query>
	 <query id="C106000120tab02DivCdComb.select" desc="C106000120tab02DivCdComb.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT '%' AS DIV_CD ,'전체' AS DIV_NM  -- '전체'컬럼 생성
  FROM DUAL 
UNION ALL -- 테이블 조합
SELECT DIV_CD, DIV_CD  AS DIV_NM  
  FROM C10APUSER.TB_C10_WAR_TRM_MNG_EXP
  GROUP BY DIV_CD
  ORDER BY DIV_CD
		 ]]> 
	 </query>
	 <query id="C106000120tab02RsnTpComb.select" desc="C106000120tab02RsnTpComb.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT '%' AS RSN_TP,'전체' AS RSN_TP_NM   -- '전체'컬럼 생성
  FROM DUAL 
UNION ALL -- 테이블 조합
SELECT RSN_TP, RSN_TP AS RSN_TP_NM  
  FROM C10APUSER.TB_C10_WAR_TRM_MNG_EXP
  GROUP BY RSN_TP
  ORDER BY RSN_TP
		 ]]> 
	 </query>
	 <query id="C106000120tab02.send" desc="보증서기준정보 전송" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT 1 FROM DUAL
		 ]]> 
	 </query>
</queryMap>
