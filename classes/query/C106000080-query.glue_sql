<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000080 Page 쿼리파일"> 
	 <query id="C106000080.select" desc="프린트롤 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT A.ROLL_CD,
       A.ROLL_CD_SEQ_NO,
       B.ROLL_TP,
       A.PROC_CD, --보유라인
	A.DET_LOC,
       B.PTN_NM, --PATTERN 명
       A.USE_YN, --사용가능(여부)
       A.ROLL_DIA, 
       A.ROLL_CIR, 
       A.ROLL_WTH,
       A.ROLL_POINT,
       B.USG_NM, 
       B.DTL_USG_NM,
       A.ROLL_PRD_CMP,
       nvl(A.IMG_YN,'N') AS IMAGE_YN,
       B.RPV_CLR_NM, --대표색상
       nvl((select sum(ROLL_USE_LTH) 
            from   C10APUSER.TB_C10_PTN_ROLL_USE_INF
            where  roll_cd = a.roll_cd
            and    proc_cd = a.proc_cd
            and    PDN_PST_DD between nvl(a.ROLL_USE_STR_DD,'99999999') 
                              and     nvl(a.ROLL_USE_END_DD, '99999999')), 0) ROLL_USE_LTH,
       (select CCL_BOM_NO 
        from   C10APUSER.TB_C10_PTN_ROLL_USE_INF  
        where ( ROLL_CD, PROC_CD, PDN_PST_DD )
             = (select roll_cd, proc_cd, max(PDN_PST_DD)
                 from   C10APUSER.TB_C10_PTN_ROLL_USE_INF
                 where  roll_cd = a.roll_cd
                 and    proc_cd = a.proc_cd
                 and    PDN_PST_DD between nvl(a.ROLL_USE_STR_DD,'99999999') 
                                   and     nvl(a.ROLL_USE_END_DD, '99999999')
                 group by roll_cd, proc_cd) )  AS ROLL_USE_CCL_BOM, 
       (select decode(max(PDN_PST_DD),null,null, 
               substr(max(PDN_PST_DD),1,4)||'-'||substr(max(PDN_PST_DD),5,2)||'-'||substr(max(PDN_PST_DD),7,2)) 
        from   C10APUSER.TB_C10_PTN_ROLL_USE_INF
        where  roll_cd = a.roll_cd
        and    proc_cd = a.proc_cd
        and    PDN_PST_DD between nvl(a.ROLL_USE_STR_DD,'99999999') 
                          and     nvl(a.ROLL_USE_END_DD, '99999999')) ROLL_USE_LST_DT, 
       (select trunc(sysdate - to_date(max(PDN_PST_DD),'YYYYMMDD'))
        from   C10APUSER.TB_C10_PTN_ROLL_USE_INF
        where  roll_cd = a.roll_cd
        and    proc_cd = a.proc_cd
        and    PDN_PST_DD between nvl(a.ROLL_USE_STR_DD,'99999999') 
                          and     nvl(a.ROLL_USE_END_DD, '99999999')) ROLL_UNUSE_DAY,                          
       to_char(to_date(A.ROLL_WHS_DD,'YYYYMMDD'),'YYYY-MM-DD') ROLL_WHS_DD,
       to_char(to_date(A.ROLL_USE_STR_DD,'YYYYMMDD'),'YYYY-MM-DD') ROLL_USE_STR_DD, 
       to_char(to_date(A.ROLL_USE_END_DD,'YYYYMMDD'),'YYYY-MM-DD') ROLL_USE_END_DD, 
       to_char(to_date(A.ROLL_DIS_DD,'YYYYMMDD'),'YYYY-MM-DD') ROLL_DIS_DD, 
       A.RMK_MSG, 
       A.ROLL_RGS_PRS_ID, 
       (SELECT USER_NAME
          FROM M90APUSER.TB_M90_EMP_INF	
         WHERE USER_NO = A.ROLL_RGS_PRS_ID) ROLL_RGS_PRS_NM,
	   A.ROLL_RGS_DH, 
       A.ROLL_MDF_PRS_ID, 
       (SELECT USER_NAME
          FROM M90APUSER.TB_M90_EMP_INF	
         WHERE USER_NO = A.ROLL_MDF_PRS_ID) ROLL_MDF_PRS_NM,
	   A.ROLL_MDF_DH
  FROM C10APUSER.TB_C10_PTN_ROLL_MNG A,
       C10APUSER.VI_C10_PTN_ROLL_INF B
 WHERE NVL(A.ROLL_CD,' ') LIKE :ROLL_CD||'%'
   AND NVL(A.ROLL_RGS_PRS_ID,' ') LIKE :ROLL_RGS_PRS_ID||'%'
   AND NVL(A.PROC_CD,' ') LIKE :PROC_CD||'%'   
   AND NVL(B.RPV_CLR_NM,' ') LIKE :RPV_CLR_NM||'%'
   AND NVL(B.ROLL_TP,' ') LIKE :ROLL_TP||'%'
   AND A.ROLL_CD = B.PRT_ROLL_NO
 ORDER BY A.ROLL_CD, A.ROLL_CD_SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000080.select_summary" desc="프린트롤 summary 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
with PROC as (
              select 'A4' PROC_CD, '4CCL' PROC_NM, 157 S_CP, 1 SEQ FROM DUAL
              union
              select 'A5' PROC_CD, '5CCL' PROC_NM, 146 S_CP, 2 SEQ FROM DUAL
              union
              select 'A7' PROC_CD, '7CCL' PROC_NM, 120 S_CP, 4 SEQ FROM DUAL
              union
              select 'A8' PROC_CD, '8CCL' PROC_NM, 120 S_CP, 5 SEQ FROM DUAL
              union
              select 'A9' PROC_CD, '9CCL' PROC_NM,  98 S_CP, 6 SEQ FROM DUAL
)  
, unuseday as (
              select proc_cd, roll_cd, use_yn,
                    (select trunc(sysdate - to_date(max(PDN_PST_DD),'YYYYMMDD'))
                     from   C10APUSER.TB_C10_PTN_ROLL_USE_INF
                     where  roll_cd = a.roll_cd
                     and    proc_cd = a.proc_cd
                     and    PDN_PST_DD between nvl(a.ROLL_USE_STR_DD,'99999999') 
                                       and     nvl(a.ROLL_USE_END_DD, '99999999')) ROLL_UNUSE_DAY 
              from   C10APUSER.TB_C10_PTN_ROLL_MNG a,
                     C10APUSER.VI_C10_PTN_ROLL_INF b
              where  a.roll_cd = b.PRT_ROLL_NO      
              and    b.ROLL_TP = 'PRINT'
              and    a.ROLL_DIS_DD is null
              and    nvl(a.USE_YN,'Y') = 'Y'
           )
, ROLL as ( 
            select proc_cd, count(roll_cd) cnt_unuse_365e
            from   unuseday 
            where  ROLL_UNUSE_DAY > 365
            group by proc_cd   
)
, ROLL1 as (
            select proc_cd, PROC_NM, S_CP, seq,
                   (select count(roll_cd) from C10APUSER.TB_C10_PTN_ROLL_MNG a, C10APUSER.VI_C10_PTN_ROLL_INF b
                    where  a.roll_cd = b.PRT_ROLL_NO  
                    and    b.ROLL_TP = 'PRINT'
                    and    a.ROLL_DIS_DD is null
                    and    a.proc_cd = x.proc_cd) r_cnt,
                   (select count(roll_cd) from C10APUSER.TB_C10_PTN_ROLL_MNG a, C10APUSER.VI_C10_PTN_ROLL_INF b
                    where  a.roll_cd = b.PRT_ROLL_NO  
                    and    b.ROLL_TP = 'PRINT'
                    and    a.ROLL_DIS_DD is null
                    and    a.ROLL_DIA <= 310
                    and    a.proc_cd = x.proc_cd) dia_310u,
                   (select count(roll_cd) from C10APUSER.TB_C10_PTN_ROLL_MNG a, C10APUSER.VI_C10_PTN_ROLL_INF b
                    where  a.roll_cd = b.PRT_ROLL_NO  
                    and    b.ROLL_TP = 'PRINT'
                    and    a.ROLL_DIS_DD is null
                    and    a.ROLL_DIA > 310
                    and    a.proc_cd = x.proc_cd) dia_310e,
                   (select count(roll_cd) from C10APUSER.TB_C10_PTN_ROLL_MNG  a, C10APUSER.VI_C10_PTN_ROLL_INF b
                    where  a.roll_cd = b.PRT_ROLL_NO  
                    and    b.ROLL_TP = 'PRINT'
                    and    a.ROLL_DIS_DD is null
                    and    a.USE_YN = 'N'
                    and    a.proc_cd = x.proc_cd) nouse_cnt,
                   (select count(roll_cd) from C10APUSER.TB_C10_PTN_ROLL_MNG a, C10APUSER.VI_C10_PTN_ROLL_INF b
                    where  a.roll_cd = b.PRT_ROLL_NO  
                    and    b.ROLL_TP = 'PRINT'
                    and    a.ROLL_DIS_DD is not null
                    and    a.proc_cd = x.proc_cd) dis_cnt
            from   PROC X
)
, rst as (
select a.PROC_NM, a.S_CP, a.r_cnt, a.dia_310u, a.dia_310e, 
       floor(a.s_cp - dia_310u - (dia_310e*1.5)) SV_CP,
       a.nouse_cnt, 
       (a.nouse_cnt + nvl(b.cnt_unuse_365e,0)) dis_dm_cnt,
       a.dis_cnt,
       seq
from   roll1 a, roll b
where  a.proc_cd = b.proc_cd (+)
order by a.seq
)
select PROC_NM, S_CP, r_cnt, dia_310u, dia_310e, 
       SV_CP, nouse_cnt, dis_dm_cnt, dis_cnt
from   rst
union
select '합계', sum(S_CP), sum(r_cnt), sum(dia_310u), sum(dia_310e), 
       sum(SV_CP), sum(nouse_cnt), sum(dis_dm_cnt), sum(dis_cnt)
from   rst       
order by 1
		 ]]> 
	 </query>
	 <query id="C106000080.update" desc="C106000080 정보 수정" isNamed="true">
		 <![CDATA[ 
UPDATE C10APUSER.TB_C10_PTN_ROLL_MNG
   SET PROC_CD              = :PROC_CD,
	DET_LOC			 = :DET_LOC,
       USE_YN                   = :USE_YN,
       ROLL_DIA                 = :ROLL_DIA,
       ROLL_CIR                 = :ROLL_CIR,
       ROLL_WTH                 = :ROLL_WTH,
       ROLL_POINT               = :ROLL_POINT,
       ROLL_PRD_CMP             = :ROLL_PRD_CMP,
       ROLL_WHS_DD              = replace(:ROLL_WHS_DD,'-',''),
       ROLL_USE_STR_DD          = replace(:ROLL_USE_STR_DD,'-',''),
       ROLL_USE_END_DD          = replace(:ROLL_USE_END_DD,'-',''),
       ROLL_DIS_DD              = replace(:ROLL_DIS_DD,'-',''),
       RMK_MSG                  = :RMK_MSG,
       ROLL_MDF_PRS_ID          = :ObjectId,
       ROLL_MDF_DH              = sysdate,
       LAST_UPDATED_OBJECT_TYPE = :ObjectType,
       LAST_UPDATED_OBJECT_ID   = :ObjectId,
       LAST_UPDATE_PROGRAM_ID   = :ProgramId,
       LAST_UPDATE_TIMESTAMP    = :Timestamp
 WHERE ROLL_CD        = :ROLL_CD
   AND ROLL_CD_SEQ_NO = :ROLL_CD_SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000080.delete" desc="C106000080 정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE FROM C10APUSER.TB_C10_PTN_ROLL_MNG
WHERE       ROLL_CD        = :ROLL_CD 
AND         ROLL_CD_SEQ_NO = :ROLL_CD_SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000080.insert" desc="C106000080 정보 추가" isNamed="true">
		 <![CDATA[ 
INSERT INTO C10APUSER.TB_C10_PTN_ROLL_MNG(
       ROLL_CD,
       ROLL_CD_SEQ_NO,
       PROC_CD,
	DET_LOC,
       USE_YN,             
       ROLL_DIA,
       ROLL_CIR,
       ROLL_WTH,             
       ROLL_POINT,           
       ROLL_PRD_CMP,
       IMG_YN,          
       ROLL_WHS_DD,       
       ROLL_USE_STR_DD,       
       ROLL_USE_END_DD,
       ROLL_DIS_DD,
       RMK_MSG,        
       ROLL_RGS_PRS_ID,
       ROLL_RGS_DH,        
       ROLL_MDF_PRS_ID,         
       ROLL_MDF_DH,    
       CREATED_OBJECT_TYPE,    
       CREATED_OBJECT_ID,     
       CREATED_PROGRAM_ID, 
       CREATION_TIMESTAMP,
       LAST_UPDATED_OBJECT_TYPE,
       LAST_UPDATED_OBJECT_ID,  
       LAST_UPDATE_PROGRAM_ID,
       LAST_UPDATE_TIMESTAMP   )
VALUES( :ROLL_CD,
        (SELECT NVL(MAX(ROLL_CD_SEQ_NO)+1,1) 
         FROM   C10APUSER.TB_C10_PTN_ROLL_MNG 
         WHERE  ROLL_CD = :ROLL_CD),
        :PROC_CD,
	 :DET_LOC,
        :USE_YN,
        :ROLL_DIA,
        :ROLL_CIR,
        :ROLL_WTH,
        :ROLL_POINT,
        :ROLL_PRD_CMP,
        'N',
        replace(:ROLL_WHS_DD,'-',''),
        replace(:ROLL_USE_STR_DD,'-',''),
        replace(:ROLL_USE_END_DD,'-',''),
        replace(:ROLL_DIS_DD,'-',''),
        :RMK_MSG,
        :ObjectId,
        sysdate,
        :ObjectId,
        sysdate,
        :ObjectType,
        :ObjectId,
        :ProgramId,
        :Timestamp,
        :ObjectType,
        :ObjectId,
        :ProgramId,
        :Timestamp)
		 ]]> 
	 </query>
	 <query id="C106000080_IMG.delete" desc="10" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C106000080   이미지관리테이블 삭제  C106000080_IMG.delete  이돈석 */
FROM TB_C10_PRT_ROLL_IMG
WHERE PRT_ROLL_NO = :ROLL_CD
  AND PRT_ROLL_IMG_SEQ_NO = :ROLL_CD_SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000080_DUMY.select" desc="10" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C106000080   의미없는 쿼리 C106000080_DUMY.select 이돈석 */
1 DUMY
FROM DUAL
		 ]]> 
	 </query>
	 <query id="C106000080_PRTROLLAJAX.select" desc="10" isNamed="true">
		 <![CDATA[ 
SELECT MAX(PRT_ROLL_NO) PRT_ROLL_NO, 
       MAX(ROLL_TP) ROLL_TP,
       MAX(PTN_NM) PTN_NM,
       MAX(USG_NM) USG_NM,
       MAX(DTL_USG_NM) DTL_USG_NM,
       MAX(RPV_CLR_NM) RPV_CLR_NM
FROM (
        SELECT PRT_ROLL_NO, ROLL_TP, PTN_NM, USG_NM, DTL_USG_NM, RPV_CLR_NM 
        FROM   C10APUSER.VI_C10_PTN_ROLL_INF
        WHERE  PRT_ROLL_NO = :ROLL_CD
        UNION ALL
        SELECT '', '', '', '', '', ''
        FROM   dual
     )
		 ]]> 
	 </query>
	 <query id="C106000080_DUMY.update" desc="" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C106000080   의미없는 쿼리 C106000080_DUMY.select 이돈석 */
1 DUMY
FROM DUAL
		 ]]> 
	 </query>
</queryMap>
