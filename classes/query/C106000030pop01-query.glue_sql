<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000030pop01 Page 쿼리파일"> 
	 <query id="C106000030pop01.select" desc="C106000030pop01 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000030pop01 품질개선이력관리 엑셀파일 조회   C106000030pop01.select  김종범  */
	   QLT_IMV_REQ_NO,
       SEQ,
       IMG_RGS_TP,
       IMG_ADR,
       IMG_NM,
       IMG_NM CHK_IMG_NM,
       './'||REPLACE(substr(IMG_ADR,instr(IMG_ADR,'FILE_UPLOAD')),'\','/')||'/' CHK_IMG_ADR,
       TO_CHAR(RGS_DH,'YYYY-MM-DD') RGS_DH,
       RGS_PRS_ID
FROM TB_C10_QLT_STD_IMV_FILE
WHERE QLT_IMV_REQ_NO = :QLT_IMV_REQ_NO 
ORDER BY SEQ
		 ]]> 
	 </query>
	 <query id="C106000030pop01.insert" desc="C106000030pop01 품질개선이력관리 엑셀파일 등록  C106000030pop01.insert  김종범 " fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C106000030pop01 품질개선이력관리 엑셀파일 등록  C106000030pop01.insert  김종범  */
INTO  TB_C10_QLT_STD_IMV_FILE (
    QLT_IMV_REQ_NO, 
    SEQ, 
    IMG_RGS_TP, 
    IMG_ADR,
    IMG_NM,
    RGS_DH, 
    RGS_PRS_ID,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP)
VALUES (
    :QLT_IMV_REQ_NO, 
    (SELECT NVL(MAX(SEQ),0)+1 FROM TB_C10_QLT_STD_IMV_FILE WHERE QLT_IMV_REQ_NO = :QLT_IMV_REQ_NO), 
    '', 
    :IMG_ADR,
    :IMG_NM,  
     SYSDATE, 
    :ObjectId,
    'C',
    :'mesapuser',
    'C106000030pop01',
     SYSTIMESTAMP,
    'C',
    :'mesapuser',
    'C106000030pop01',
     SYSTIMESTAMP)
		 ]]> 
	 </query>
	 <query id="C106000030pop01.delete" desc="C106000030pop01 품질개선이력관리 엑셀파일 삭제   C106000030pop01.delete 김종범" fetchSize="10" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C106000030pop01 품질개선이력관리 엑셀파일 삭제   C106000030pop01.delete 김종범  */
FROM TB_C10_QLT_STD_IMV_FILE
WHERE QLT_IMV_REQ_NO = :QLT_IMV_REQ_NO 
AND SEQ = :SEQ
		 ]]> 
	 </query>
</queryMap>
