<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="EMP Project 한글 "> 
	 <query id="lovcode.select" desc="EMP 조회" fetchSize="10">
		 <![CDATA[ 
SELECT 
  TbM00CategoryGr.CATEGORY_GROUP_NM,
  TbM00Codes020.CD_TP_CHARACTER,
  TbM00Codes030.CD_TP_ID,
  TbM00Codes030.CATEGORY_GROUP_ID,
  TbM00Codes030.CD_V,
  TbM00Codes030.CD_V_MEANING,
  TbM00Codes030.RG_DT_NM_F,
  TbM00Codes030.CD_V_INQUIRY_SEQ
FROM TB_M00_CATEGORY_GR TbM00CategoryGr,TB_M00_CODES020 TbM00Codes020,TB_M00_CODES030 TbM00Codes030,
    ( SELECT CD_TP MASTER_CD_TP FROM TB_M00_CODES020
      WHERE CD_TP_ID =(
          SELECT FK_CD_TP_ID FROM TB_M00_CODES020
          WHERE CD_TP = ?
            AND END_ACTIVE_DATE=TO_DATE('29991231235959', 'YYYYMMDDHH24MISS'))
    ) MASTER
WHERE TbM00CategoryGr.CATEGORY_GROUP_ID = TbM00Codes030.CATEGORY_GROUP_ID
  --AND TbM00Codes030.CD_TP_ID = ?
  AND TbM00CategoryGr.CATEGORY_GROUP_NM = ?
  AND TbM00CategoryGr.CD_TP = MASTER.MASTER_CD_TP
  AND TbM00Codes020.CD_TP_ID = TbM00Codes030.CD_TP_ID
		 ]]> 
	 </query>
</queryMap>
