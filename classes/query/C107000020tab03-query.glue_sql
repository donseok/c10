<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab03 Page 쿼리파일"> 
	 <query id="C107000020tab03.select" desc="C107000020tab03 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT 
DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 CUS_BTH_PAP_NO
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_1 YP_LLV_MPA
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_2 YP_ULV_MPA
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_3 TS_LLV_MPA
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_4 TS_ULV_MPA
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_5 ELGN_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_6 ELGN_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_7 HRB_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_8 HRB_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_9 ER_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_10 ER_ULV
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_1 MQL_BND_TST_STD_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_2 TST_PIC_GTH_INST_LOC
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_11 TST_PIC_GTH_INST_LTH
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_3 TPG_RGS_NO
FROM M00APUSER.TB_M00_DATAS010 DATAS010,
(SELECT MDL_DEFINE_ID 
FROM M00APUSER.TB_M00_DEFINES010
WHERE MDL_DEFINE_NM='C10A1022'
AND START_ACTIVE_DATE <=  SYSDATE
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
AND DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 LIKE '%'||:SEARCH_CD||'%'
ORDER BY CUS_BTH_PAP_NO
		 ]]> 
	 </query>
</queryMap>
