<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="B10R0030"> 
	 <query id="B10R0030.select" desc="B10R0030.select" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 제품사양설계-품질설계의뢰정보수신 B10R0030.select 박재영 */
          IF_GRP_ID,SEQ_NO,XSEQ,XCRUD,XSTAT,XMSGS,XDATE,XTIME,XSTAT_CALLBACK
          ,ORD_REQ_NO,ORD_REQ_LN,ORD_NO,ORD_LN,PLNT_TP,PRD_NM_CD,PRD_SHP
          ,FLOW_CHL,ORD_KND,ORD_USG_CD,CUS_CD,ACT_CUS_CD,FNL_CUS_CD
          ,CUS_BTH_PAP_NO,SPC_AVR,SPC_YR,ORD_SZ,ORD_EXC_THK,ORD_EXC_WTH
          ,ORD_EXC_LTH,CUS_REQ_DLV_DD,ORD_SCH_DLV_DD,GW_ASG_CD,CCL_BOM_NO
          ,HUE_CD_FRN,HUE_CD_BAK,ORD_ORG_PLT_SPC_AVR
          ,ORD_ROU_CD,ORD_SPNL_TP
          ,ORD_COILG_MTH,ORD_SUR_HND_CD,ORD_SKP_DEG,ORD_EDG_ASG_TP,ORD_THK_TP
          ,WGT_DCS_MTH_TP,ORD_SLV_KND_TP,EMBS_CD,ORD_PTT_FLM_CD,ORD_PTT_FLM_WTH
          ,ORD_PTT_FLM_ADH_LOC_CD,ORD_WGT_UNT,ORD_LN_WGT,ORD_SHT_CNT,ORD_PAK_SHT_CNT
          ,ORD_PAK_UNT_WGT_LLV,ORD_PAK_UNT_WGT_ULV,ORD_DLV_ALW_DIF_LLV,ORD_DLV_ALW_DIF_ULV
          ,ORD_PAK_LTH_LLV,ORD_PAK_LTH_ULV
          ,DECODE(ORD_STDP_LLV,0,ORD_PAK_UNT_WGT_LLV,ORD_STDP_LLV) ORD_STDP_LLV
          ,DECODE(ORD_STDP_ULV,0,ORD_PAK_UNT_WGT_ULV,ORD_STDP_ULV) ORD_STDP_ULV
          ,ORD_STDP_CNT_LLV,ORD_STDP_CNT_ULV,ORD_PAK_UNT_WGT,ORD_SML_PAK_WGT
          ,ORD_SML_PAK_MIR,ORD_UNT_WGT,ORD_PAK_MTH,ORD_COIL_IDIA,ORD_COIL_ODIA
          ,ORD_THK_TLN_LLV,ORD_THK_TLN_ULV,ORD_WTH_TLN_LLV,ORD_WTH_TLN_ULV
          ,ORD_LTH_TLN_LLV,ORD_LTH_TLN_ULV,ORD_THK_MNG_CD,ORD_WTH_MNG_CD
          ,ORD_LTH_MNG_CD,CUS_REQ_CLR_NM,URG_MTL_TP,ORD_RCP_DD,ORD_SHT_LOD_MTH
          ,ORD_SLIT_GRP_CNT,ORD_MIX_WTH1,ORD_MIX_WTH2,ORD_MIX_WTH3,ORD_MIX_WTH4
          ,ORD_MIX_WTH5,ORD_MIX_WTH6,ORD_MIX_WTH7,ORD_MIX_WTH8,ORD_MIX_WTH9
           ,ORD_MIX_WTH10,SLIT_MAX_WGT
          ,TRST_PROC_YN,TAG_TP,NAT_CD,ORD_SPC_TXT,BAK_MRK,ORD_CFM_DD,ORD_RGS_PRS_ID
          ,ORD_TEM_CD,MTL_CD,TAG_PRD_NM,TAG_PO_NO,TAG_DST,TAG_SIZ,TAG_SPC_NM,TAG_GAA
          ,TAG_HUE_FRN,TAG_HUE_BAK,TAG_SPC_MRK,RMTL_PRFR_CD,QLT_DSN_YN
          ,TAG_PO_NO2,CTR_SHPM_MN,SVC_CRD_PUB_YN,PAK_MSG_CD,ORD_TEM_GRP_CD
          ,PTT_FLM_NOT_ADH_WS,PTT_FLM_NOT_ADH_DS,TAG_PART_NO,MO_CVT_ORD_YN,MTL_PRD_ORD_YN,ORD_DSN_CFM_TP
          ,LTH_MNG_YN,LTH_MNG_FROM,LTH_MNG_TO,BORON_ADD_YN, ORD_REP_YN, ORD_REP_NO, ORD_REP_LN, WIP_PAK_MTH
          ,OT_TC_YN,PRT_INKJT_FILE,POC_AUTO_YN
FROM EAIAPUSER.TB_C10_B10R0030
WHERE IF_GRP_ID = ?
AND XSTAT = 'D'
ORDER BY SEQ_NO
		 ]]> 
	 </query>
	 <query id="B10R0030.modify" desc="B10R0030.modify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계요청 B10R0030.modify 박재영*/                      
TB_C10_B10R0030
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,XSTAT = ?                     --PI 처리 상태
      ,XMSGS = ?                     --PI 에러 메세지
      ,XSTAT_CALLBACK = ?            --PI 처리 상태
WHERE IF_GRP_ID = ?                  --Interface Group ID                                                                                      
  AND SEQ_NO = ?                     --Interface SEQ
		 ]]> 
	 </query>
