          ,OT_TC_YN,PRT_INKJT_FILE,POC_AUTO_YN
        FROM EAIAPUSER.TB_C10_B10R0030 BB
        WHERE XSTAT = 'D'
        ORDER BY IF_GRP_ID, TO_NUMBER(SEQ_NO) ) AA
