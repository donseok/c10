<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000050 Page 쿼리파일"> 
	 <query id="C108000050.selectCmn" desc="제품개발공통조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발상세현황 조회 C108000050.selectCmn 전경진 */
    CM.PRD_DEV_NO, 
    TO_CHAR(CM.REQ_RGS_DH,'yyyy-mm-dd HH24:MI')  AS REQ_RGS_DH,
    (SELECT EMP_NM
       FROM M90APUSER.TB_M90_EMP_INF
      WHERE EMP_ID = CM.SAL_CHR_PRS_ID)  AS SAL_CHR_PRS_ID,
    CM.DEV_PRG_CD,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'CUS_CD'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = CM.CUS_CD)  AS CUS_CD,
    CM.USG_CD,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'NAT_CD'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = CM.USE_NAT_CD)  AS USE_NAT_CD,
    CM.APP_SIM_RCV_ADDR,
    CM.APP_SIM_RCV_NM,
    CM.APP_SIM_RCV_PHON,
    CM.DEV_REQ_RMK,
    CM.DEV_REQ_FILE,
    TO_CHAR(CM.DEV_RGS_DH,'yyyy-mm-dd HH24:MI')  AS DEV_RGS_DH,
    (SELECT EMP_NM
       FROM M90APUSER.TB_M90_EMP_INF
      WHERE EMP_ID = CM.DEV_RECV_CHR_UID)  AS DEV_RECV_CHR_UID,
    CM.PROC_SIM_MO,
    CM.DEV_RECV_RMK
FROM C10APUSER.TB_C10_PRD_DEV_CMN  CM
WHERE CM.PRD_DEV_NO = :PRD_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000050.selectSpec" desc="제품개발SPEC 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발상세현황 조회 C108000050.selectSpec 전경진 */
    SP.PRD_DEV_NO,
    SP.DEV_REQ_SPEC_NO,
    DECODE(SP.CLR_DEV_TP,'D','디자인','C','색상') AS CLR_DEV_TP,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PRD_NM_CD'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SP.PRD_NM_CD) AS PRD_NM_CD,
    SP.CUS_REQ_HUE_TXT,
    SP.COT_MTH ||'-'
    ||(SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'COT_MTH'
       AND CATEGORY_GROUP_NM = 'SZ0000'
       AND CD_V = SP.COT_MTH) AS COT_MTH,
    SP.RSN_TP,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'TLP_TP'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SP.TLP_TP) AS TLP_TP,
    SP.RL_LUS_RT,
    SP.PNT_FLM_THK_TXT,
    SP.PTT_FLM_YN,
    SP.ORD_PRE_WGT,
   (SELECT CD_V_MEANING
      FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP IN ('DEV_REF_TP_CLR','DEV_REF_TP_DESN')
       AND CATEGORY_GROUP_NM = 'SZ0000'
       AND CD_V = SP.DEV_REF_TP) AS DEV_REF_TP,
    SP.REF_CLR_CD_TXT,
    SP.REF_CCL_BOM,
    SP.SIM_HUE_PRG_YN
FROM  C10APUSER.TB_C10_PRD_DEV_SPEC SP
WHERE SP.PRD_DEV_NO = :PRD_DEV_NO
		 ]]> 
	 </query>
	 <query id="C108000050.selectReqBom" desc="제품개발의뢰BOM 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발상세현황 조회 C108000050.selectReqBom 전경진 */
    REB.PRD_DEV_NO,
    REB.DEV_REQ_SPEC_NO,
    REB.DEV_REQ_BOM_NO,
    REB.HUE_CD_FRN_1COT,
    REB.HUE_CD_FRN_2COT,
    REB.HUE_CD_FRN_3COT,
    REB.HUE_CD_FRN_4COT,
    REB.HUE_CD_BAK_1COT,
    REB.HUE_CD_BAK_2COT,
    REB.HUE_CD_BAK_3COT,
    REB.HUE_CD_BAK_4COT,
    REB.HUE_CD_LMN,
    REB.PRT_ROLL_NO1,
    REB.PRT_INK_CD1,
    REB.PRT_ROLL_NO2,
    REB.PRT_INK_CD2,
    REB.PRT_ROLL_NO3,
    REB.PRT_INK_CD3,
    REB.PRT_ROLL_NO4,
    REB.PRT_INK_CD4,
    REB.UNI_TEX_ROLL_NO,
    REB.PICK_UP_ROLL_NO,
    REB.IMPT_ROLL_NO,
    REB.SIM_HUE_PRG_YN,
    REB.PNT_CMP_CD ||'-'||(SELECT CD_V_MEANING
           FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'PNT_CMP_CD'
            AND CATEGORY_GROUP_NM = 'SZ0000'
            AND CD_V = REB.PNT_CMP_CD)  AS PNT_CMP_CD,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'COT_MTH'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = REB.COT_MTH)  AS COT_MTH,
    REB.RSN_TP,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'TLP_TP'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = REB.TLP_TP)  AS TLP_TP,
    REB.RL_LUS_RT,
    REB.PNT_FLM_THK_TXT,
    NVL((SELECT CD_V_MEANING
           FROM M00APUSER.VI_M00_CODE_ACCESS
          WHERE CD_TP = 'PNT_CMP_CD'
            AND CATEGORY_GROUP_NM = 'SZ0000'
            AND CD_V = REB.LMN_BND_CMP_CD),REB.LMN_BND_CMP_CD)  AS LMN_BND_CMP_CD,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LMN_KND_TP'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = REB.LMN_KND_TP)  AS LMN_KND_TP,
    REB.LMN_FLM_THK,
    REB.DSN_SIM_FILE,
    REB.PRT_BY_ROLL_CMP_CD,
    REB.SPC_PRD_AF_WK
FROM  C10APUSER.TB_C10_PRD_DEV_REQ_BOM  REB
WHERE REB.PRD_DEV_NO = :PRD_DEV_NO
AND   REB.DEV_REQ_SPEC_NO = :DEV_REQ_SPEC_NO
		 ]]> 
	 </query>
	 <query id="C108000050.selectCmpBom" desc="품개발완료BOM 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발상세현황 조회 C108000050.selectCmpBom 전경진 */
    CPB.PRD_DEV_NO,
    CPB.DEV_REQ_SPEC_NO,
    CPB.DEV_REQ_BOM_NO,
    CPB.DEV_CMP_BOM_NO,
CPB.DEV_CMP_DH,
    --TO_CHAR(CPB.DEV_CMP_DH,'yyyy-mm-dd HH24:MI')  AS DEV_CMP_DH,
    (SELECT EMP_NM
       FROM M90APUSER.TB_M90_EMP_INF
      WHERE EMP_ID = CPB.DEV_CHR_UID)  AS DEV_CHR_UID,
    CPB.HUE_CD_FRN_1COT,
    CPB.HUE_CD_FRN_2COT,
    CPB.HUE_CD_FRN_3COT,
    CPB.HUE_CD_FRN_4COT,
    CPB.HUE_CD_BAK_1COT,
    CPB.HUE_CD_BAK_2COT,
    CPB.HUE_CD_BAK_3COT,
    CPB.HUE_CD_BAK_4COT,
    CPB.HUE_CD_LMN,
    CPB.PRT_ROLL_NO1,
    CPB.PRT_INK_CD1,
    CPB.PRT_ROLL_NO2,
    CPB.PRT_INK_CD2,
    CPB.PRT_ROLL_NO3,
    CPB.PRT_INK_CD3,
    CPB.PRT_ROLL_NO4,
    CPB.PRT_INK_CD4,
    CPB.UNI_TEX_ROLL_NO,
    CPB.PICK_UP_ROLL_NO,
    CPB.IMPT_ROLL_NO,
    CPB.UNFIX_NO,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'COT_MTH'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = CPB.COT_MTH)  AS COT_MTH,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'TLP_TP'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = CPB.TLP_TP)  AS TLP_TP,
    CPB.CCL_BOM_WR_YN,
    CPB.DISC_PTN_WTH_CD,
    CPB.UNI_TEX_PTN_CD,
    CPB.CUT_LN_YN,
    CPB.PT_TP,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PRT_USG_CD'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = CPB.PRT_USG_CD)  AS PRT_USG_CD,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PRT_PTN_CD'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = CPB.PRT_PTN_CD)  AS PRT_PTN_CD,
    CPB.SPC_PRD_AF_NO,
    CPB.INK_DEV_NO,
    CPB.DEV_CMP_RMK
FROM  C10APUSER.TB_C10_PRD_DEV_CMP_BOM  CPB
WHERE CPB.PRD_DEV_NO = :PRD_DEV_NO
AND   CPB.DEV_REQ_SPEC_NO = :DEV_REQ_SPEC_NO
AND   CPB.DEV_REQ_BOM_NO = :DEV_REQ_BOM_NO
		 ]]> 
	 </query>
	 <query id="C108000050.selectCrl" desc="제품개발 요소 합" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계 제품개발상세현황 조회 C108000050.selectCrl 전경진 */
       SUM(CLR_DEV_NO) AS CLR_DEV_NO,
       SUM(LMN_DEV_NO) AS LMN_DEV_NO,
       SUM(TST_NO) 	   AS TST_NO
FROM
(SELECT COUNT(CLR_DEV_NO) AS CLR_DEV_NO,
        0 AS LMN_DEV_NO,
        0 AS TST_NO
FROM  C10APUSER.TB_C10_PRD_CLR_DEV
WHERE PRD_DEV_NO = :PRD_DEV_NO
UNION
SELECT 0 ,
       COUNT(LMN_DEV_NO) AS LMN_DEV_NO,
       0
FROM  C10APUSER.TB_C10_PRD_LMN_DEV
WHERE PRD_DEV_NO = :PRD_DEV_NO
UNION
SELECT 0 ,
	   0 ,
       COUNT(TST_NO) AS TST_NO
FROM  C10APUSER.TB_C10_PRD_TST_ANLY
WHERE PRD_DEV_NO = :PRD_DEV_NO
)
		 ]]> 
	 </query>
</queryMap>
