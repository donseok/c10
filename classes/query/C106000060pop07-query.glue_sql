<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000060pop07 Page 쿼리파일"> 
	 <query id="C106000060pop07.select" desc="C106000060pop07 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 칼라물성 수정이력 popup조회 C106000060pop07.SELECT 성낙원*/   
CCL_BOM_NO, CUS_CD, ORD_USG_CD, MDF_SEQ, MDF_RSN, 
PTT_FLM_DTL_CD, PTT_FLM_DTL_CD_N, UNI_GLS_FLM_CD, CLR_BND_TST_FRN_STD_CD, CLR_BND_TST_BAK_STD_CD, 
MPR_BAS_MEK_FRN, MPR_BAS_MEK_BAK, MPR_BAS_PNCL_HRDN_FRN, MPR_BAS_PNCL_HRDN_BAK, 
CLR_DIF_FRN_ULV, CLR_DIF_BAK_ULV, CCL_QLT_MSG_TXT,
(SELECT USER_NAME
 FROM M90APUSER.TB_M90_EMP_INF
 WHERE USER_NO = TB_C10_CLR_MPR_MDF_LOG.LAST_UPDATED_OBJECT_ID) AS LAST_UPDATED_OBJECT_ID,  --수정자 
LAST_UPDATE_TIMESTAMP        
FROM C10APUSER.TB_C10_CLR_MPR_MDF_LOG
WHERE CCL_BOM_NO = :CCL_BOM_NO
AND   CUS_CD     = :CUS_CD
AND   ORD_USG_CD = :ORD_USG_CD
ORDER BY MDF_SEQ
		 ]]> 
	 </query>
</queryMap>
