<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN//EN"
    "http://www.springframework.org/dtd/spring-beans.dtd">

<beans>

    <bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="oracle.jdbc.driver.OracleDriver"/>
        <property name="url" value="jdbc:oracle:thin:@(DESCRIPTION = (ADDRESS_LIST = (ADDRESS = (PROTOCOL = TCP)(HOST = 210.1.1.146)(PORT = 2010))(ADDRESS = (PROTOCOL = TCP)(HOST = 210.1.1.148)(PORT = 2010)))(CONNECT_DATA = (SERVICE_NAME = USMEAP)))"/>
        <property name="username" value="C10APUSER"/>
        <property name="password" value="C10APUSER_PRD"/>
        <property name="defaultAutoCommit" value="false"/>
        <property name="minIdle" value="0"/>
        <property name="maxActive" value="-1"/>
        <property name="maxIdle" value="1000"/>
    </bean>
    
    
    <bean id="masterDataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="oracle.jdbc.driver.OracleDriver"/>
        <property name="url" value="jdbc:oracle:thin:@(DESCRIPTION = (ADDRESS_LIST = (ADDRESS = (PROTOCOL = TCP)(HOST = 210.1.1.146)(PORT = 2010))(ADDRESS = (PROTOCOL = TCP)(HOST = 210.1.1.148)(PORT = 2010)))(CONNECT_DATA = (SERVICE_NAME = USMEAP)))"/>
        <property name="username" value="M00APUSER"/>
        <property name="password" value="M00APUSER_PRD"/>
        <property name="defaultAutoCommit" value="false"/>
        <property name="minIdle" value="0"/>
        <property name="maxActive" value="-1"/>
        <property name="maxIdle" value="1000"/>
    </bean>

    <bean id="eaiDataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="oracle.jdbc.driver.OracleDriver"/>
        <property name="url" value="jdbc:oracle:thin:@(DESCRIPTION = (ADDRESS_LIST = (ADDRESS = (PROTOCOL = TCP)(HOST = 210.1.1.146)(PORT = 2010))(ADDRESS = (PROTOCOL = TCP)(HOST = 210.1.1.148)(PORT = 2010)))(CONNECT_DATA = (SERVICE_NAME = USMEAP)))"/>
        <property name="username" value="EAIAPUSER"/>
        <property name="password" value="EAIAPUSER_PRD"/>
        <property name="defaultAutoCommit" value="false"/>
        <property name="minIdle" value="0"/>
        <property name="maxActive" value="-1"/>
        <property name="maxIdle" value="1000"/>
    </bean>

    <bean id="m90DataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="oracle.jdbc.driver.OracleDriver"/>
        <property name="url" value="jdbc:oracle:thin:@(DESCRIPTION = (ADDRESS_LIST = (ADDRESS = (PROTOCOL = TCP)(HOST = 210.1.1.146)(PORT = 2010))(ADDRESS = (PROTOCOL = TCP)(HOST = 210.1.1.148)(PORT = 2010)))(CONNECT_DATA = (SERVICE_NAME = USMEAP)))"/>
        <property name="username" value="M90APUSER"/>
        <property name="password" value="M90APUSER_PRD"/>
        <property name="defaultAutoCommit" value="false"/>
        <property name="minIdle" value="0"/>
        <property name="maxActive" value="-1"/>
        <property name="maxIdle" value="1000"/>
    </bean>
      
    <bean id="mesdao" class="com.posdata.glue.dao.PosJdbcDao">
        <property name="dataSource"><ref local="dataSource"/></property>
        <property name="queryManager"><ref local="queryManager"/></property>
		<property name="columnDefCache" value="true" ></property>
		<property name="auditAttributeOption" value="true"/>
    </bean>

    <bean id="masterdao" class="com.posdata.glue.dao.PosJdbcDao">
        <property name="dataSource"><ref local="masterDataSource"/></property>
        <property name="queryManager"><ref local="queryManager"/></property>
		<property name="auditAttributeOption" value="true"/>
    </bean>

    <bean id="eaidao" class="com.posdata.glue.dao.PosJdbcDao">
        <property name="dataSource"><ref local="eaiDataSource"/></property>
        <property name="queryManager"><ref local="queryManager"/></property>
		<property name="columnDefCache" value="true" ></property>
		<property name="auditAttributeOption" value="true"/>
    </bean>

     <bean id="queryManager" class="com.posdata.glue.dao.manager.PosQueryManagerImpl">
        <constructor-arg><ref local="cacheManager"/></constructor-arg>
        <constructor-arg><ref local="queryLoader"/></constructor-arg>
    </bean>

    <bean id="cacheManager" class="com.posdata.glue.cache.PosCacheManagerJCS"/>
    <bean id="queryLoader" class="com.posdata.glue.dao.manager.PosQueryLoader"/>

    <bean id="tx1" class="com.posdata.glue.transaction.PosDataSourceTransactionManager">
        <property name="dataSource">
            <ref local="dataSource"/>
        </property>
    </bean>
    <bean id="tx2" class="com.posdata.glue.transaction.PosDataSourceTransactionManager">
        <property name="dataSource">
            <ref local="eaiDataSource"/>
        </property>
    </bean>
 
    <bean id="tx3" class="com.posdata.glue.transaction.PosDataSourceTransactionManager">
       <property name="dataSource">
           <ref local="m90DataSource"/>
       </property>
    </bean>
        
    <bean id="tx4" class="com.posdata.glue.transaction.PosDataSourceTransactionManager">
       <property name="dataSource">
           <ref local="masterDataSource"/>
       </property>
    </bean>
    
    <bean id="scheduler" class="com.posdata.glue.scheduling.PosJobScheduler" > 
        <property name="startupDelay" value="3"/>
        <property name="triggers"> 
            <list>
            <!--           
                <ref local="cronTrigger1"/>
                <ref local="cronTrigger2"/>
            -->
                <ref local="GlueMaster-Trigger"/>
                <ref local="batchTriggerB10R0020"/>
                <ref local="batchTriggerB10R0030"/>
            </list> 
        </property> 
		<property name="quartzProperties">
            <props>
                <prop key="org.quartz.jobStore.class">org.quartz.simpl.RAMJobStore</prop>
                <prop key="org.quartz.jobStore.misfireThreshold">1000</prop>
                <prop key="org.quartz.threadPool.class">org.quartz.simpl.SimpleThreadPool</prop>
                <prop key="org.quartz.threadPool.threadCount">1</prop>
                <prop key="org.quartz.threadPool.threadPriority">4</prop>
            </props>
        </property>
        <property name="statefulJobGroups">
            <list>
                <value>batchJobB10R0020</value>
                <value>batchJobB10R0030</value>
            </list> 
        </property> 
	</bean>
	<bean id="GlueMaster-Trigger" class="com.posdata.glue.scheduling.PosCronTrigger">
	    <property name="jobDetail" ref="GlueMaster-JCS"/>
	    <property name="cronExpression" value="59 59 23 31 12 ? 2099"/>
	</bean>
	<bean id="GlueMaster-JCS" class="com.posdata.glue.scheduling.PosJobDetail"> 
	    <property name="jobClass" value="com.poscoict.glue.master.job.GlueMasterCacheEventJob"/> 
	</bean>

