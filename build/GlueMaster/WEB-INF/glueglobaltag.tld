    <shortname>taglib</shortname> 
    <info>Glue Custom Tag Library</info>
    <tag>
        <name>setResourceName</name>
        <tagclass>com.posdata.glue.ui.global.tags.SetResourceName</tagclass>
        <attribute>
            <name>name</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
    </tag>
