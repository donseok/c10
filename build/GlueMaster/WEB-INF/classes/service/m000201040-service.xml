<?xml version="1.0" encoding="UTF-8"?>
<service name="m000201040-service" initial="GetCachingData">
  <transaction-manager id="tx1" commit="true" />
  <activity name="ForwardCategoryPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="GetCategoryList" />
    <property name="forwardname" value="category" />
  </activity>
  <activity name="ForwardNewPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="end" />
    <property name="forwardname" value="new" />
  </activity>
  <activity name="GetCachingData" class="com.poscoict.glue.master.common.GetCachingData">
    <transition name="success" value="Router" />
    <property name="cache-key" value="HIERARCHY_OP_TP|HIERARCHY_OWNER_SHIP_TP|LANGUAGE_CODE|_SYS_R_APPLICATION_ID" />
    <property name="sqlkey" value="system.code.value" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="ImportCategory" class="com.poscoict.glue.master.ui.code.ImportCodeCategory">
    <transition name="success" value="end" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="GetCategoryList" class="com.posdata.glue.biz.activity.PosSearchPageSet">
    <transition name="success" value="end" />
    <property name="dao" value="masterdao" />
    <property name="resultkey" value="CategoryGrResult" />
    <property name="param0" value="CategoryGroupNm" />
    <property name="sqlkey" value="TbM00CategoryGr.select.orderbyNm" />
    <property name="pagesize" value="10" />
    <property name="param-count" value="1" />
    <property name="cur-page-name" value="curPageNum" />
  </activity>
  <activity name="GetCodeDef" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="success" value="end" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="m000201020.selCodeHeader" />
    <property name="param0" value="UserEmpNo" />
    <property name="resultkey" value="CodeHeaderRowResult" />
    <property name="param1" value="CdTpId" />
    <property name="param-count" value="2" />
  </activity>
  <activity name="DeleteCategoryGp" class="com.posdata.glue.biz.activity.PosDelete">
    <transition name="success" value="GetCategoryGrList" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="TbM00CategoryGr.delete.byPK" />
    <property name="param0" value="CategoryGroupId" />
    <property name="resultkey" value="delCount" />
    <property name="chkname" value="TbM00CategoryGrVO_chk" />
    <property name="param-count" value="1" />
  </activity>
  <activity name="ForwardExportPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="end" />
    <property name="forwardname" value="export" />
  </activity>
  <activity name="GetCategoryGrExport" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="success" value="ForwardExportPage" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="TbM00CategoryGr.select.cnt" />
    <property name="param0" value="CdTp" />
    <property name="resultkey" value="CategoryGrVOResult" />
    <property name="param1" value="CategoryGroupNm" />
    <property name="param-count" value="2" />
  </activity>
  <activity name="UpdateCode" class="com.poscoict.glue.master.ui.code.ModifyCodeHeader">
    <transition name="success" value="GetCategoryGrList" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="GetCategoryGrList" class="com.posdata.glue.biz.activity.PosSearchPageSet">
    <transition name="success" value="GetCodeDef" />
    <property name="param-count" value="2" />
    <property name="resultkey" value="CategoryGrVOResult" />
    <property name="param0" value="CdTp" />
    <property name="param1" value="SearchWord" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="TbM00CategoryGr.select.cnt" />
    <property name="cur-page-name" value="curPageNum" />
    <property name="pagesize" value="10" />
  </activity>
  <activity name="ForwardModifyPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="GetCodeDef" />
    <property name="forwardname" value="success" />
  </activity>
  <activity name="ForwardImportPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="ImportCategory" />
    <property name="forwardname" value="import" />
  </activity>
  <activity name="UpsertCategoryGp" class="com.poscoict.glue.master.ui.code.SaveCategoryGp">
    <transition name="success" value="GetCategoryGrList" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="Router" class="com.posdata.glue.biz.activity.PosDefaultRouter">
    <transition name="update" value="UpdateCode" />
    <transition name="save" value="UpsertCategoryGp" />
    <transition name="delete" value="DeleteCategoryGp" />
    <transition name="success" value="GetCategoryGrList" />
    <transition name="insert" value="InsertCode" />
    <transition name="new" value="ForwardNewPage" />
    <transition name="export" value="GetCategoryGrExport" />
    <transition name="pop01" value="ForwardCategoryPage" />
    <transition name="import" value="ForwardImportPage" />
  </activity>
  <activity name="InsertCode" class="com.poscoict.glue.master.ui.code.InsertCodeList">
    <transition name="failure" value="ForwardNewPage" />
    <transition name="success" value="ForwardModifyPage" />
    <property name="dao" value="masterdao" />
  </activity>
</service>

