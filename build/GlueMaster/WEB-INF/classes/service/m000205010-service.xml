<?xml version="1.0" encoding="UTF-8"?>
<service name="m000205010-service" initial="GetCachingData">
  <activity name="AppMsgListRouter" class="com.posdata.glue.biz.activity.PosDefaultRouter">
    <transition name="success" value="GetAppMsgList" />
    <transition name="export" value="GetExportMsgList" />
  </activity>
  <activity name="GetCachingData" class="com.poscoict.glue.master.common.GetCachingData">
    <transition name="success" value="AppMsgListRouter" />
    <property name="cache-key" value="LANGUAGE_CODE|_SYS_R_APPLICATION_ID" />
    <property name="sqlkey" value="system.code.value" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="GetExportMsgList" class="com.poscoict.glue.master.ui.appmsg.GetAppMsgList">
    <transition name="success" value="ForwardPage" />
    <property name="pagesize" value="-1" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="m000205010.selAppMsgList" />
    <property name="resultkey" value="AppMsgListVOResult" />
    <property name="param-count" value="0" />
    <property name="cur-page-name" value="curPage" />
  </activity>
  <activity name="GetAppMsgList" class="com.poscoict.glue.master.ui.appmsg.GetAppMsgList">
    <transition name="success" value="end" />
    <property name="pagesize" value="20" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="m000205010.selAppMsgList" />
    <property name="resultkey" value="AppMsgListVOResult" />
    <property name="param-count" value="0" />
    <property name="cur-page-name" value="curPage" />
  </activity>
  <activity name="ForwardPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="end" />
    <property name="forwardname" value="export" />
  </activity>
</service>

