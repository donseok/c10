  </activity>
  <activity name="GetRespUser" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="success" value="end" />
    <property name="sqlkey" value="m000202020.select.TbM00MdRespGrUser" />
    <property name="resultkey" value="TbM00MdRespGrUser_Result" />
    <property name="dao" value="masterdao" />
    <property name="param0" value="MdlDefineNm" />
