    <property name="forwardname" value="export" />
  </activity>
  <activity name="SaveRuleHeader" class="com.poscoict.glue.master.ui.rule.SaveRuleHeader">
    <transition name="success" value="RuleHeaderViewRouter" />
    <transition name="failure" value="RuleHeaderViewRouter" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="GetRuleHierarchyData" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="success" value="GetRespUser" />
    <property name="resultkey" value="TbM00Depend010VOResult" />
