<?xml version="1.0" encoding="UTF-8"?>
<service name="m000202050-service" initial="GetCachingData">
  <activity name="PosMakeKeyData" class="com.poscoict.glue.master.ui.rule.PosMakeKeyData">
    <transition name="success" value="end" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="GetCachingData" class="com.poscoict.glue.master.common.GetCachingData">
    <transition name="success" value="GeneralRuleDataRouter" />
    <property name="cache-key" value="HIERARCHY_OP_TP|HIERARCHY_OWNER_SHIP_TP" />
    <property name="sqlkey" value="system.code.value" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="GetGeneralRuleHeader" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="success" value="*GetRuleLayout" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="m000202030.getTbM00Defines010" />
    <property name="param0" value="UserEmpNo" />
    <property name="resultkey" value="Defind010HeaderRowResult" />
    <property name="param1" value="MdlDefineId" />
    <property name="param-count" value="2" />
  </activity>
  <activity name="ForwardSavePage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="GetGeneralRuleHeader" />
    <property name="forwardname" value="save" />
  </activity>
  <activity name="SaveGeneralRuleData" class="com.poscoict.glue.master.ui.rule.SaveGeneralRuleData">
    <transition name="success" value="ForwardSavePage" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="PosDatas010List" class="com.poscoict.glue.master.ui.rule.GetGeneralRuleData">
    <transition name="success" value="PosMakeKeyData" />
    <property name="cur-page-name" value="curPage" />
    <property name="dao" value="masterdao" />
    <property name="pagesize" value="-1" />
    <property name="page-size-name" value="pageSize" />
  </activity>
  <activity name="GeneralRuleDataRouter" class="com.posdata.glue.biz.activity.PosDefaultRouter">
    <transition name="save" value="SaveMakeCheckedRecorde" />
    <transition name="saveData" value="ForwardSavePage" />
    <transition name="success" value="GetGeneralRuleHeader" />
  </activity>
  <activity name="SaveMakeCheckedRecorde" class="com.poscoict.glue.master.ui.rule.PosMakeCheckedRecorde">
    <transition name="success" value="SaveGeneralRuleData" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="*GetRuleLayout" class="com.poscoict.glue.master.common.PosSearch">
    <transition name="success" value="PosDatas010List" />
    <property name="resultkey" value="Defind020DataLayoutRowResult" />
    <property name="dao" value="masterdao" />
    <property name="param-count" value="1" />
    <property name="sqlkey" value="m000202030.getTbM00Defines020" />
    <property name="param0" value="MdlDefineId" />
  </activity>
</service>

