<?xml version="1.0" encoding="UTF-8"?>
<service name="m000201050-service" initial="CodeValueRouter">
  <transaction-manager id="tx1" commit="true" />
  <activity name="ForwardCategoryPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="GetCategoryGrList" />
    <property name="forwardname" value="category" />
  </activity>
  <activity name="GetCachingData" class="com.poscoict.glue.master.common.GetCachingData">
    <transition name="success" value="end" />
    <property name="cache-key" value="HIERARCHY_OP_TP|HIERARCHY_OWNER_SHIP_TP|LANGUAGE_CODE|_SYS_R_APPLICATION_ID" />
    <property name="sqlkey" value="system.code.value" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="ImportCodeValue" class="com.poscoict.glue.master.ui.code.ImportCodeValue">
    <transition name="success" value="end" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="GetCodeDef" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="success" value="GetCachingData" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="m000201020.selCodeHeader" />
    <property name="param0" value="UserEmpNo" />
    <property name="resultkey" value="CodeHeaderRowResult" />
    <property name="param1" value="CdTpId" />
    <property name="param-count" value="2" />
  </activity>
  <activity name="ForwardExportPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="GetCachingData" />
    <property name="forwardname" value="export" />
  </activity>
  <activity name="GetCodeValueExport" class="com.poscoict.glue.master.ui.code.GetCodeValue">
    <transition name="success" value="ForwardExportPage" />
    <property name="pagesize" value="-1" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="m000201020.selCodeValue" />
    <property name="resultkey" value="CodeValueVOResult" />
    <property name="param-count" value="0" />
    <property name="cur-page-name" value="curPageNum" />
  </activity>
  <activity name="UpdateCode" class="com.poscoict.glue.master.ui.code.ModifyCodeHeader">
    <transition name="success" value="GetCodeValue" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="CodeValueRouter" class="com.posdata.glue.biz.activity.PosDefaultRouter">
    <transition name="success" value="GetCodeValue" />
    <transition name="save" value="SaveCodeValue" />
    <transition name="export" value="GetCodeValueExport" />
    <transition name="pop01" value="ForwardCategoryPage" />
    <transition name="import" value="ForwardImportPage" />
    <transition name="update" value="UpdateCode" />
    <transition name="delete" value="DeleteCodeValue" />
  </activity>
  <activity name="GetCategoryGrList" class="com.posdata.glue.biz.activity.PosSearchPageSet">
    <transition name="success" value="GetCachingData" />
    <property name="param-count" value="2" />
    <property name="resultkey" value="CategoryGrVOResult" />
    <property name="param0" value="CdTp" />
    <property name="param1" value="CategoryGroupNm" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="TbM00CategoryGr.select.cnt" />
    <property name="cur-page-name" value="curPageNum" />
    <property name="pagesize" value="10" />
  </activity>
  <activity name="SaveCodeValue" class="com.poscoict.glue.master.ui.code.SaveCodeValue">
    <transition name="success" value="GetCodeValue" />
    <property name="dao" value="masterdao" />
  </activity>
  <activity name="DeleteCodeValue" class="com.posdata.glue.biz.activity.PosDelete">
    <transition name="success" value="GetCodeValue" />
    <property name="param-count" value="3" />
    <property name="resultkey" value="deleteCnt" />
    <property name="param0" value="CdTpId2" />
    <property name="param1" value="CategoryGroupId" />
    <property name="param2" value="MOD_CD_V" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="TbM00Code030.delete.byPK" />
    <property name="chkname" value="TbM00Codes030VO_chk" />
  </activity>
  <activity name="ForwardImportPage" class="com.posdata.glue.biz.activity.PosForwardPage">
    <transition name="success" value="ImportCodeValue" />
    <property name="forwardname" value="import" />
  </activity>
  <activity name="GetCodeValue" class="com.poscoict.glue.master.ui.code.GetCodeValue">
    <transition name="success" value="GetCodeDef" />
    <property name="pagesize" value="10" />
    <property name="dao" value="masterdao" />
    <property name="sqlkey" value="m000201020.selCodeValue" />
    <property name="resultkey" value="CodeValueVOResult" />
    <property name="param-count" value="0" />
    <property name="cur-page-name" value="curPageNum" />
  </activity>
</service>

