	 <query id="TbM00Code020.insert" desc="코드 Header 삽입" >
		 <![CDATA[ 
INSERT INTO TB_M00_CODES020(
  CD_TP_ID,
  APPLICATION_ID,
  SECURITY_GROUP_ID,
  CD_TP,
  LANGUAGE_CODE,
  START_ACTIVE_DATE,
  END_ACTIVE_DATE,
  USE_TP,
  CD_TP_VERSION,
  VERSION_UP_CAUSE_DESC,
  CD_TP_MEANING,
  CD_TP_EXPLAIN,
  LST_UPD_BY_IP,
  CD_TP_CNG_GD,
  CD_TP_OWNER_EMP_NO,
  CD_TP_CHARACTER,
  MDL_REG_REQ_EMP_ID,
  FK_CD_TP_ID,
  HIERARCHY_DATA_ID,
  MD_VERSION_MAINT_FLAG,
  CREATED_OBJECT_TYPE,
  CREATED_OBJECT_ID,
  CREATED_PROGRAM_ID,
  CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,
  LAST_UPDATED_OBJECT_ID,
  LAST_UPDATE_PROGRAM_ID,
  LAST_UPDATE_TIMESTAMP
) VALUES ( ?,?,?,?,?,TO_DATE(?,'YYYYMMDDHH24MISS'),TO_DATE(?,'YYYYMMDDHH24MISS'),?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP,?,?,?,CURRENT_TIMESTAMP )
		 ]]> 
	 </query>
	 <query id="TbM00Code020.update" desc="코드헤더 업데이트" >
		 <![CDATA[ 
UPDATE TB_M00_CODES020
SET START_ACTIVE_DATE=TO_DATE(?,'YYYYMMDDHH24MISS'),
    END_ACTIVE_DATE=TO_DATE(?,'YYYYMMDDHH24MISS'),
    CD_TP_MEANING=?,
    CD_TP_OWNER_EMP_NO=?,
    USE_TP=?,
    LST_UPD_BY_IP=?,
    HIERARCHY_DATA_ID=?,
    LAST_UPDATED_OBJECT_TYPE=?,
    LAST_UPDATED_OBJECT_ID=?,
    LAST_UPDATE_PROGRAM_ID=?,
    LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE CD_TP_ID=?
		 ]]> 
	 </query>
	 <query id="TbM00Code020.update.usetp" desc="코드헤더 업데이트" >
		 <![CDATA[ 
UPDATE TB_M00_CODES020
SET USE_TP=?,
    LST_UPD_BY_IP=?,
    LAST_UPDATED_OBJECT_TYPE=?,
    LAST_UPDATED_OBJECT_ID=?,
    LAST_UPDATE_PROGRAM_ID=?,
    LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE CD_TP=? AND LANGUAGE_CODE=?
		 ]]> 
	 </query>
	 <query id="TbM00Code020.delete.sync" desc="마스터이행(CODES)" >
		 <![CDATA[ 
DELETE FROM TB_M00_CODES020 WHERE CD_TP_ID IN 
     ( SELECT CD_TP_ID FROM TB_M00_CODES020 WHERE CD_TP=? OR FK_CD_TP_ID IN (SELECT CD_TP_ID FROM TB_M00_CODES020 WHERE CD_TP=? ) )
		 ]]> 
	 </query>
