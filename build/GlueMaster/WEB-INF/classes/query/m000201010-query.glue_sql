	 <query id="TbM00Code030.insert" desc="코드값Insert" >
		 <![CDATA[ 
INSERT INTO TB_M00_CODES030(
  CD_TP_ID,
  CATEGORY_GROUP_ID,
  CD_V,
  CD_V_MEANING,
  CD_V_EXPLAIN,
  LST_UPD_BY_IP,
  RG_DT_NM_F,
  RG_MIN_V,
  RG_MAX_V,
  CREATED_OBJECT_TYPE,CREATED_OBJECT_ID,CREATED_PROGRAM_ID,CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,LAST_UPDATED_OBJECT_ID,LAST_UPDATE_PROGRAM_ID,LAST_UPDATE_TIMESTAMP,
  ACCORD_DATA_CONFIRMER_INF,
  ACCORD_DATA_CONFIRMER_INF1,
  CD_V_INQUIRY_SEQ
) VALUES ( ?,?,?,?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP,?,?,?,CURRENT_TIMESTAMP,?,?,? )
		 ]]> 
	 </query>
	 <query id="TbM00Code030.update" desc="코드값Update" >
		 <![CDATA[ 
UPDATE TB_M00_CODES030
SET CD_V_MEANING= ?,
    LST_UPD_BY_IP=?,
    RG_DT_NM_F= ?,
    RG_MIN_V= ?,
    RG_MAX_V= ?,
    LAST_UPDATED_OBJECT_TYPE=?,
    LAST_UPDATED_OBJECT_ID=?,
    LAST_UPDATE_PROGRAM_ID=?,
    LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP,
    ACCORD_DATA_CONFIRMER_INF=?,
    ACCORD_DATA_CONFIRMER_INF1=?,
    CD_V_INQUIRY_SEQ=?
WHERE CD_TP_ID=?
  AND CATEGORY_GROUP_ID=?
  AND CD_V=?
		 ]]> 
	 </query>
	 <query id="TbM00Code030.delete.byPK" desc="코드값Delete" >
		 <![CDATA[ 
DELETE FROM TB_M00_CODES030 WHERE CD_TP_ID=? AND CATEGORY_GROUP_ID=? AND CD_V=?
		 ]]> 
	 </query>
