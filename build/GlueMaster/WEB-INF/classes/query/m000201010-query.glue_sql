<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="Code"> 
	 <query id="m000201010.selCodeList" desc="코드List (마스터코드,트랜잰션)(DB2/Oracle)" >
		 <![CDATA[ 
SELECT A.*,
  DECODE(TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD'),'2999-12-31',NULL,TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD')) END_ACTIVE_DATE_STR,
  TO_CHAR(A.START_ACTIVE_DATE,'YYYY-MM-DD') START_ACTIVE_DATE_STR,
  (SELECT CD_TP         FROM TB_M00_CODES020 WHERE CD_TP_ID=A.FK_CD_TP_ID) as M_CD_TP,
  (SELECT CD_TP_MEANING FROM TB_M00_CODES020 WHERE CD_TP_ID=A.FK_CD_TP_ID) as M_CD_TP_MEANNING,
  B.HIERARCHY_OP_TP,
  B.HIERARCHY_OWNER_SHIP_TP,
  I.USER_NAME,
  J.MDL_DEFINE_CNG_GD
FROM TB_M00_CODES020 A
  INNER JOIN TB_M00_DEPEND010 B ON A.HIERARCHY_DATA_ID=B.HIERARCHY_DATA_ID
  INNER JOIN ( SELECT USER_EMP_NO,USER_NAME FROM TB_M00_SEC_USER ) I ON A.CD_TP_OWNER_EMP_NO=I.USER_EMP_NO
  LEFT OUTER JOIN ( SELECT DISTINCT resp010.MDL_DEFINE_NM, resp_user.MDL_DEFINE_CNG_GD
                    FROM TB_M00_MD_RESP010 resp010, TB_M00_MD_RESP_GR_USER resp_user
                    WHERE resp_user.USER_EMP_NO=NVL(?,'MASTDATA')
                      AND resp010.MD_RESPONSIBILITY_NM=resp_user.MD_RESPONSIBILITY_NM ) J ON A.CD_TP=J.MDL_DEFINE_NM
ORDER BY M_CD_TP,A.CD_TP
		 ]]> 
	 </query>
	 <query id="m000201020.selCodeHeader" desc="코드Header 조회(DB2/Oracle)" fetchSize="10">
		 <![CDATA[ 
SELECT A.*,
  ( SELECT CD_TP FROM TB_M00_CODES020 WHERE CD_TP_ID=A.FK_CD_TP_ID) as FK_CD_TP,
  TO_CHAR(A.CREATION_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') CREATION_TIMESTAMP_STR,
  TO_CHAR(A.LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP_STR,
  TO_CHAR(A.START_ACTIVE_DATE,'YYYY-MM-DD HH24:MI:SS') START_ACTIVE_DATE_STR,
  DECODE(TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD'),'2999-12-31',null,TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD HH24:MI:SS')) END_ACTIVE_DATE_STR,
  B.HIERARCHY_OP_TP,
  B.HIERARCHY_OWNER_SHIP_TP,
  I.USER_NAME,
  J.MDL_DEFINE_CNG_GD
FROM TB_M00_CODES020 A
  INNER JOIN TB_M00_DEPEND010 B ON A.HIERARCHY_DATA_ID=B.HIERARCHY_DATA_ID
  LEFT OUTER JOIN ( SELECT DISTINCT resp010.MDL_DEFINE_NM, resp_user.MDL_DEFINE_CNG_GD
                    FROM TB_M00_MD_RESP010 resp010, TB_M00_MD_RESP_GR_USER resp_user
                    WHERE resp_user.USER_EMP_NO=NVL(?,'MASTDATA')
                      AND resp010.MD_RESPONSIBILITY_NM = resp_user.MD_RESPONSIBILITY_NM ) J ON A.CD_TP=J.MDL_DEFINE_NM
  LEFT OUTER JOIN ( SELECT USER_EMP_NO,USER_NAME FROM TB_M00_SEC_USER ) I ON A.CD_TP_OWNER_EMP_NO=I.USER_EMP_NO
WHERE A.CD_TP_ID=?
		 ]]> 
	 </query>
	 <query id="m000200050.selCntCodeMeaning" desc="업무기준데이타 CntCodeMeaning" fetchSize="10">
		 <![CDATA[ 
SELECT /* m000200050.selCntCodeMeaning */ COUNT(1) AS CNT
FROM TB_M00_CODES020 TbM00Codes020, TB_M00_CODES030 TbM00Codes030
WHERE TbM00Codes020.CD_TP_ID = (SELECT max(FK_CD_TP_ID) FROM TB_M00_CODES020
                                WHERE CD_TP=( SELECT STANDARD_ENGLISH_ID FROM TB_M00_ATTRS
                                              WHERE DT_NM_ID=(SELECT FK_DT_NM_ID FROM TB_M00_ATTRS WHERE DT_NM_ID=?)
                                             )
                               )
  AND TbM00Codes020.LANGUAGE_CODE='KO'
  AND TbM00Codes020.CD_TP_ID=TbM00Codes030.CD_TP_ID
		 ]]> 
	 </query>
	 <query id="m000201020.selCodeValue" desc="코드값정보" >
		 <![CDATA[ 
SELECT TbM00Codes030.*,
  REPLACE(TbM00Codes030.CD_V,' ','_') MOD_CD_V,
  TO_CHAR(TbM00Codes030.LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP_STR,
  TbM00CategoryGr.CD_TP,
  TbM00CategoryGr.CATEGORY_GROUP_NM,
  TbM00CategoryGr.CATEGORY_GROUP_EXPLAIN
FROM TB_M00_CODES030 TbM00Codes030, TB_M00_CATEGORY_GR TbM00CategoryGr
WHERE TbM00Codes030.CATEGORY_GROUP_ID = TbM00CategoryGr.CATEGORY_GROUP_ID
		 ]]> 
	 </query>
	 <query id="m000201030.selCodeStructure" desc="코드구조(DB2/Oracle)" >
		 <![CDATA[ 
SELECT A.CD_TP_ID,
  A.CD_DT_NM_SEQ,
  A.CD_DT_NM_EXPLAIN,
  A.CD_DT_NM_NM,
  A.CD_DT_NM_LEN,
  A.CD_TP_RG_MI,
  A.CD_TP_RG_MAX,
  B.CD_DT_NM_V,
  B.CD_DT_NM_MEANING
FROM TB_M00_CODES040 A 
  LEFT OUTER JOIN TB_M00_CODES050 B ON A.CD_DT_NM_NM=B.CD_DT_NM_NM
WHERE A.CD_TP_ID = ?
ORDER BY A.CD_DT_NM_SEQ,B.CD_DT_NM_V
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.select.orderbyExplain" desc="코드카테고리정보(m000201010-service)" >
		 <![CDATA[ 
SELECT TbM00CategoryGr.CATEGORY_GROUP_ID,TbM00CategoryGr.CATEGORY_GROUP_NM,TbM00CategoryGr.CATEGORY_GROUP_EXPLAIN
FROM TB_M00_CATEGORY_GR TbM00CategoryGr
WHERE TbM00CategoryGr.CATEGORY_GROUP_ID IN (SELECT CATEGORY_GROUP_ID FROM TB_M00_CODES030 WHERE CD_TP_ID=?)
ORDER BY TbM00CategoryGr.CATEGORY_GROUP_EXPLAIN
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.select.orderbyNm" desc="카테고리 리스트(m000201040-service)" >
		 <![CDATA[ 
SELECT DISTINCT TbM00CategoryGr.CATEGORY_GROUP_NM,TbM00CategoryGr.CATEGORY_GROUP_EXPLAIN
FROM TB_M00_CATEGORY_GR TbM00CategoryGr
WHERE TbM00CategoryGr.CATEGORY_GROUP_NM LIKE '%' || ? || '%'
ORDER BY TbM00CategoryGr.CATEGORY_GROUP_NM
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.select.cnt" desc="카테고리그룹 조회" >
		 <![CDATA[ 
SELECT TbM00CategoryGr.*,
  ( SELECT COUNT(CD_V) FROM TB_M00_CODES030 WHERE CATEGORY_GROUP_ID=TbM00CategoryGr.CATEGORY_GROUP_ID ) AS V_COUNT
FROM TB_M00_CATEGORY_GR TbM00CategoryGr
WHERE TbM00CategoryGr.CD_TP=?
  AND TbM00CategoryGr.CATEGORY_GROUP_NM LIKE ? || '%' 
ORDER BY TbM00CategoryGr.CATEGORY_GROUP_NM DESC
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.select.byPK" desc="jcs.PosCategoryGrVO" >
		 <![CDATA[ 
SELECT * FROM TB_M00_CATEGORY_GR WHERE CATEGORY_GROUP_ID=?
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.select.byUK" desc="카테고리 존재 여부" >
		 <![CDATA[ 
SELECT CATEGORY_GROUP_ID FROM TB_M00_CATEGORY_GR WHERE CD_TP=? AND CATEGORY_GROUP_NM=?
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.select.sync.all" desc="마스터이행(CODES)" >
		 <![CDATA[ 
SELECT * FROM TB_M00_CATEGORY_GR WHERE CD_TP IN ( SELECT CD_TP FROM TB_M00_CODES020 WHERE CD_TP_ID=? OR FK_CD_TP_ID=?)
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.insert" desc="카테고리Insert" >
		 <![CDATA[ 
INSERT INTO TB_M00_CATEGORY_GR(
  CATEGORY_GROUP_ID,
  CD_TP,
  CATEGORY_GROUP_NM,
  CATEGORY_GROUP_EXPLAIN,
  REMARKS,
  LST_UPD_BY_IP,
  CREATED_OBJECT_TYPE,
  CREATED_OBJECT_ID,
  CREATED_PROGRAM_ID,
  CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,
  LAST_UPDATED_OBJECT_ID,
  LAST_UPDATE_PROGRAM_ID,
  LAST_UPDATE_TIMESTAMP
) VALUES ( ?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP,?,?,?,CURRENT_TIMESTAMP )
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.update" desc="카테고리Update" >
		 <![CDATA[ 
UPDATE TB_M00_CATEGORY_GR
SET CATEGORY_GROUP_EXPLAIN=?,
  LST_UPD_BY_IP=?,
  LAST_UPDATED_OBJECT_TYPE=?,
  LAST_UPDATED_OBJECT_ID=?,
  LAST_UPDATE_PROGRAM_ID=?,
  LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE CD_TP=?
  AND CATEGORY_GROUP_NM=?
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.delete.byPK" desc="카테고리Delete" >
		 <![CDATA[ 
DELETE FROM TB_M00_CATEGORY_GR WHERE CATEGORY_GROUP_ID=?
		 ]]> 
	 </query>
	 <query id="TbM00CategoryGr.delete.sync" desc="마스터이행(CODES)" >
		 <![CDATA[ 
DELETE FROM TB_M00_CATEGORY_GR WHERE CD_TP IN 
     ( SELECT CD_TP FROM TB_M00_CODES020 WHERE CD_TP=? OR FK_CD_TP_ID IN (SELECT CD_TP_ID FROM TB_M00_CODES020 WHERE CD_TP=? ) )
		 ]]> 
	 </query>
	 <query id="TbM00Code020.select.sync" desc="마스터이행(CODES)" >
		 <![CDATA[ 
SELECT CD_TP_ID,TO_CHAR(START_ACTIVE_DATE,'YYYYMMDDHH24MISS') START_ACTIVE_DATE_STR,LANGUAGE_CODE
FROM TB_M00_CODES020 
WHERE CD_TP=?
  AND USE_TP='Y'
  AND END_ACTIVE_DATE=TO_DATE('2999-12-31 23:59:59','YYYY-MM-DD HH24:MI:SS')
		 ]]> 
	 </query>
	 <query id="TbM00Code020.select.sync.all" desc="마스터이행(CODES)" >
		 <![CDATA[ 
SELECT * FROM TB_M00_CODES020 WHERE CD_TP_ID IN ( SELECT CD_TP_ID FROM TB_M00_CODES020 WHERE CD_TP_ID=? OR FK_CD_TP_ID=?) ORDER BY CD_TP_ID
		 ]]> 
	 </query>
	 <query id="TbM00Code020.select" desc="코드 정의" fetchSize="10">
		 <![CDATA[ 
SELECT * FROM TB_M00_CODES020
		 ]]> 
	 </query>
	 <query id="TbM00Code020.select.byCdTp" desc="코드 정의" fetchSize="10">
		 <![CDATA[ 
SELECT * FROM TB_M00_CODES020 WHERE CD_TP=? AND LANGUAGE_CODE=? ORDER BY CD_TP_ID DESC
		 ]]> 
