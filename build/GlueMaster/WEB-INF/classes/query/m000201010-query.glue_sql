	 <query id="TbM00Code030.select.byPK" desc="코드값목록(upsert용)" >
		 <![CDATA[ 
SELECT * FROM TB_M00_CODES030 WHERE CD_TP_ID=? AND CATEGORY_GROUP_ID=? AND CD_V=?
