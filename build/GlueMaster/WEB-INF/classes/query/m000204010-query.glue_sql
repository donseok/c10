	 <query id="m000204010.insert.TbM00Interfaces" desc="Interface 등록" fetchSize="10">
		 <![CDATA[ 
INSERT INTO TB_M00_INTERFACES(
  MDL_DEFINE_ID,
  MDL_DEFINE_NM,
  START_ACTIVE_DATE,
  END_ACTIVE_DATE,
  MDL_DEFINE_VERSION,
  VERSION_UP_CAUSE_DESC,
  MDL_DEFINE_EXPLAIN,
  PROCESS_CHAIN_CODE1,
  PROCESS_CHAIN_CODE2,
  LST_UPD_BY_IP,
  MDL_DEFINE_OWNER_EMP_NO,
  MDL_DEFINE_CNG_GD,
  HIERARCHY_DATA_ID,
  FK_MDL_DEFINE_ID,
  CREATED_OBJECT_TYPE,
  CREATED_OBJECT_ID,
  CREATED_PROGRAM_ID,
  CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,
  LAST_UPDATED_OBJECT_ID,
  LAST_UPDATE_PROGRAM_ID,
  LAST_UPDATE_TIMESTAMP)
VALUES( ?, ?, to_date(?,'yyyymmddhh24miss'), to_date(?,'yyyymmddhh24miss'), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, ?, ?, ?, CURRENT_TIMESTAMP )
		 ]]> 
	 </query>
	 <query id="m000204010.update.TbM00Interfaces" desc="Interface 수정" fetchSize="10">
		 <![CDATA[ 
UPDATE TB_M00_INTERFACES
SET MDL_DEFINE_EXPLAIN=?,
  PROCESS_CHAIN_CODE1=?,
  PROCESS_CHAIN_CODE2=?,
  LST_UPD_BY_IP=?,
  MDL_DEFINE_OWNER_EMP_NO=?,
  MDL_DEFINE_CNG_GD=?,
  HIERARCHY_DATA_ID=?,
  LAST_UPDATED_OBJECT_TYPE=?,
  LAST_UPDATED_OBJECT_ID=?,
  LAST_UPDATE_PROGRAM_ID=?,
  LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE MDL_DEFINE_ID=?
		 ]]> 
	 </query>
	 <query id="m000204010.insert.TbM00InterfaceAttrs" desc="Interface 항목등록" fetchSize="10">
		 <![CDATA[ 
INSERT INTO TB_M00_INTERFACE_ATTRS(
  MDL_DEFINE_ID,
  MDL_DEFINE_DT_NM_SEQ,
  DT_NM_ID,
  MDL_DEFINE_DT_NM_NM,
  MDL_DEFINE_DT_NM_GROUP_TP,
  STANDARD_ENGLISH_ID,
  STANDARD_KOREAN_NAME,
  MDL_DEFINE_DT_NM_DATA_TP,
  MDL_DEFINE_DT_NM_LEN,
  MDL_DEFINE_DT_NM_V_DECI_PREC,
  LST_UPD_BY_IP,
  HIERARCHY_DATA_ID,
  CREATED_OBJECT_TYPE,
  CREATED_OBJECT_ID,
  CREATED_PROGRAM_ID,
  CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,
  LAST_UPDATED_OBJECT_ID,
  LAST_UPDATE_PROGRAM_ID,
  LAST_UPDATE_TIMESTAMP
) VALUES ( ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, ?, ?, ?, CURRENT_TIMESTAMP)
		 ]]> 
	 </query>
	 <query id="m000204020.insert.InterfaceChecks030" desc="전문Error체크30 인서트" fetchSize="10">
		 <![CDATA[ 
INSERT INTO TB_M00_INTERFACE_CHECKS030(
  MDL_DEFINE_ID,DT_NM_ID,MD_RULE_DT_NM_BAS_CHK_SEQ,MD_RULE_CHK_OLSTATR_1,MD_RULE_CHK_MI_V_1,MD_RULE_CHK_MAX_V_1,MD_RULE_CHK_OLSTATR_2,MD_RULE_CHK_MI_V_2,MD_RULE_CHK_MAX_V_2,MD_RULE_DT_NM_TRUE_BAS,
  CREATED_OBJECT_TYPE,CREATED_OBJECT_ID,CREATED_PROGRAM_ID,CREATION_TIMESTAMP,LAST_UPDATED_OBJECT_TYPE,LAST_UPDATED_OBJECT_ID,LAST_UPDATE_PROGRAM_ID,LAST_UPDATE_TIMESTAMP
)VALUES(
  ?,?,?,?,?,?,?,?,?,?,'D','EXCEL_MACRO','EXCEL_MACRO',CURRENT_TIMESTAMP,'D','EXCEL_MACRO','EXCEL_MACRO',CURRENT_TIMESTAMP
)
		 ]]> 
	 </query>
