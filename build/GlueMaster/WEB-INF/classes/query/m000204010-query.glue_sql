	 <query id="m000204020.insert.InterfaceChecks010" desc="전문Error체크조회" fetchSize="10">
		 <![CDATA[ 
INSERT INTO TB_M00_INTERFACE_CHECKS010(
  MDL_DEFINE_ID,MDL_DEFINE_NM,FAC_OP_CD,START_ACTIVE_DATE,END_ACTIVE_DATE,CATEGORY_GROUP_NM,MDL_DEFINE_VERSION,VERSION_UP_CAUSE_DESC,MDL_DEFINE_EXPLAIN,MD_RULE_OWNER_EMP_NO,MASTER_DATA_PRC_TP,
  CREATED_OBJECT_TYPE,CREATED_OBJECT_ID,CREATED_PROGRAM_ID,CREATION_TIMESTAMP,LAST_UPDATED_OBJECT_TYPE,LAST_UPDATED_OBJECT_ID,LAST_UPDATE_PROGRAM_ID,LAST_UPDATE_TIMESTAMP
)VALUES(
  ?,?,?,CURRENT_TIMESTAMP,TO_DATE(29991231235959,'YYYYMMDDHH24MISS'),?,?,?,?,?,?,'D','EXCELMACRO','EXCELMACRO',CURRENT_TIMESTAMP,'D','EXCELMACRO','EXCELMACRO',CURRENT_TIMESTAMP
)
		 ]]> 
	 </query>
