	 <query id="m000204010.max.MdRuleDtNmBasChkSeq.InterfaceChecks030" desc="MD_RULE_DT_NM_BAS_CHK_SEQ MAX값" fetchSize="10">
		 <![CDATA[ 
SELECT nvl(MAX(MD_RULE_DT_NM_BAS_CHK_SEQ),0) AS MAX_MD_RULE_DT_NM_BAS_CHK_SEQ FROM TB_M00_INTERFACE_CHECKS030 WHERE MDL_DEFINE_ID=? AND DT_NM_ID=?
		 ]]> 
	 </query>
	 <query id="m000204010.selTCChainCode1" desc="TC체인코드1" fetchSize="10">
		 <![CDATA[ 
SELECT DISTINCT(PROCESS_CHAIN_CODE1) SEND_CODE FROM TB_M00_INTERFACES ORDER BY SEND_CODE
		 ]]> 
	 </query>
	 <query id="m000204010.selTCChainCode2" desc="TC체인코드2" fetchSize="10">
		 <![CDATA[ 
SELECT DISTINCT(PROCESS_CHAIN_CODE2) RECIEVE_CODE FROM TB_M00_INTERFACES ORDER BY RECIEVE_CODE
		 ]]> 
	 </query>
	 <query id="TbM00Interfaces.select.sync" desc="마스터이행(FORMAT)" fetchSize="10">
		 <![CDATA[ 
SELECT MDL_DEFINE_ID,TO_CHAR(START_ACTIVE_DATE,'YYYYMMDDHH24MISS') START_ACTIVE_DATE_STR
FROM TB_M00_INTERFACES
WHERE MDL_DEFINE_NM=?
  AND END_ACTIVE_DATE=TO_DATE('29991231235959','YYYYMMDDHH24MISS')
ORDER BY MDL_DEFINE_ID DESC
		 ]]> 
	 </query>
	 <query id="TbM00Interfaces.select.byPK" desc="마스터이행(FORMAT),전문Error체크조회(DB2/Oracle)" fetchSize="10">
		 <![CDATA[ 
SELECT * FROM TB_M00_INTERFACES WHERE MDL_DEFINE_ID=CAST(? AS INT)
		 ]]> 
	 </query>
	 <query id="TbM00Interfaces.select.tc" desc="마스터이행(FORMAT),INTERFACE 정의" fetchSize="10">
		 <![CDATA[ 
SELECT * FROM TB_M00_INTERFACES WHERE FK_MDL_DEFINE_ID=? AND MDL_DEFINE_ID<>FK_MDL_DEFINE_ID
		 ]]> 
	 </query>
