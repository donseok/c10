<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="Rule - 업무기준 구조 Import"> 
	 <query id="system.code.value" desc="코드조회.코드값순서" >
		 <![CDATA[ 
select
  decode(B.CD_V, null, A.CD_V, B.CD_V) AS CD_V,
  decode(B.CD_V_MEANING, null, A.CD_V_MEANING, B.CD_V_MEANING) AS CD_V_MEANING
from( select B.CD_V,B.CD_V_MEANING
      from TB_M00_CODES020 A, TB_M00_CODES030 B, TB_M00_CATEGORY_GR C
      where A.APPLICATION_ID=50001
        and A.SECURITY_GROUP_ID=0
        and A.CD_TP=?
        and A.LANGUAGE_CODE='KO'
        and A.START_ACTIVE_DATE<sysdate
        and A.USE_TP='Y'
        and A.CD_TP_ID=B.CD_TP_ID
        and A.CD_TP=C.CD_TP
        and C.CATEGORY_GROUP_NM='ZZ0000'
    ) A LEFT OUTER JOIN (
      select B.CD_V,B.CD_V_MEANING
      from TB_M00_CODES020 A, TB_M00_CODES030 B, TB_M00_CATEGORY_GR C
      where A.APPLICATION_ID=50001
        and A.SECURITY_GROUP_ID=0
        and A.CD_TP=?
        and A.LANGUAGE_CODE=?
        and A.START_ACTIVE_DATE<sysdate
        and A.USE_TP='Y'
        and A.CD_TP_ID=B.CD_TP_ID
        and A.CD_TP=C.CD_TP
        and C.CATEGORY_GROUP_NM='ZZ0000'
    ) B ON A.CD_V=B.CD_V
ORDER BY CD_V
		 ]]> 
	 </query>
