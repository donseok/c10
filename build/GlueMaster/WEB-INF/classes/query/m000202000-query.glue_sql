    HIERARCHY_OP_TP=?,
    HIERARCHY_OWNER_SHIP_TP=?,
    MASTER_DATA_PRC_TP=?,
    HIERARCHY_KEY_DT_NM_TP=?,
    HIERARCHY_KEY_1=?,
    HIERARCHY_KEY_2=?,
    USE_TP=?,
    HIERARCHY_DATA_LST_UPD_BY_IP=?,
    LAST_UPDATED_OBJECT_TYPE=?,
    LAST_UPDATED_OBJECT_ID=?,
    LAST_UPDATE_PROGRAM_ID=?,
    LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE HIERARCHY_DATA_ID = ?
		 ]]> 
	 </query>
