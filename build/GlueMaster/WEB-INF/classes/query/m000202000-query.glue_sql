	 <query id="TbM00DbmsConInfo.select" desc="DBMS연결정보" >
		 <![CDATA[ 
SELECT * FROM TB_M00_DBMS_CON_INFO
		 ]]> 
	 </query>
	 <query id="TbM00DbmsConInfo.insert" desc="DBMS연결정보등록" >
		 <![CDATA[ 
INSERT INTO TB_M00_DBMS_CON_INFO(
  DATASOURCE_ID,
  DATASOURCE_TYPE,
  SYSTEM_TYPE,
  DATASOURCE,
  DATASOURCE_EXPLAIN,
  DATASOURCE_DRIVER_CLASS,
  DATASOURCE_ACCOUNT,
  DATASOURCE_PASSWORD,
  CREATED_OBJECT_TYPE,
  CREATED_OBJECT_ID,
  CREATED_PROGRAM_ID,
  CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,
  LAST_UPDATED_OBJECT_ID,
  LAST_UPDATE_PROGRAM_ID,
  LAST_UPDATE_TIMESTAMP
) VALUES (?,?,?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP,?,?,?,CURRENT_TIMESTAMP)
		 ]]> 
	 </query>
	 <query id="TbM00DbmsConInfo.update" desc="DBMS연결정보수정" >
		 <![CDATA[ 
UPDATE TB_M00_DBMS_CON_INFO
SET DATASOURCE_TYPE=?,
    SYSTEM_TYPE=?,
    DATASOURCE=?,
    DATASOURCE_EXPLAIN=?,
    DATASOURCE_DRIVER_CLASS=?,
    DATASOURCE_ACCOUNT=?,
    DATASOURCE_PASSWORD=?,
    LAST_UPDATED_OBJECT_TYPE=?,
    LAST_UPDATED_OBJECT_ID=?,
    LAST_UPDATE_PROGRAM_ID=?,
    LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE DATASOURCE_ID=?
		 ]]> 
	 </query>
	 <query id="TbM00DbmsConInfo.delete" desc="DBMS연결정보삭제" >
		 <![CDATA[ 
DELETE FROM TB_M00_DBMS_CON_INFO WHERE DATASOURCE_ID=?
		 ]]> 
	 </query>
