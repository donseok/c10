  MASTER_DATA_RESP_DEF_ID,
  APPLICATION_ID,
  LANGUAGE_CODE,
  MDL_DEFINE_NM,
  MDL_DEFINE_EXPLAIN,
  MD_RESPONSIBILITY_NM,
  START_ACTIVE_DATE,
  END_ACTIVE_DATE,
  MASTER_DATA_PRC_TP,
  CREATED_OBJECT_TYPE,
  CREATED_OBJECT_ID,
  CREATED_PROGRAM_ID,
  CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,
  LAST_UPDATED_OBJECT_ID,
  LAST_UPDATE_PROGRAM_ID,
  LAST_UPDATE_TIMESTAMP
) VALUES (?,?,?,?,?,?,to_date(?,'YYYYMMDDHH24MISS'),to_date(?,'YYYYMMDDHH24MISS'),?,?,?,?,CURRENT_TIMESTAMP,?,?,?,CURRENT_TIMESTAMP)
		 ]]> 
	 </query>
