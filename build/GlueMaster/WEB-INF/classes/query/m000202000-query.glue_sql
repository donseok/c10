	 <query id="m000100200.select.meta.owner" desc="DB Table Owner" >
		 <![CDATA[ 
select distinct OWNER from ALL_TABLES where TABLE_NAME='TB_M00_SEC_USER'
		 ]]> 
	 </query>
	 <query id="m000100200.select.meta" desc="DB Talbe Column" >
		 <![CDATA[ 
SELECT /*+first_rows*/
  A.COLUMN_NAME,
  A.DATA_TYPE,
  DECODE(B.TABLE_NAME,'','','PK') AS PRIMARY_KEY
FROM ALL_TAB_COLUMNS A
  LEFT OUTER JOIN ( SELECT TABLE_NAME,COLUMN_NAME
                    FROM ALL_CONS_COLUMNS
                    WHERE OWNER=?
                      AND CONSTRAINT_NAME=(SELECT CONSTRAINT_NAME
                                           FROM ALL_CONSTRAINTS
                                           WHERE OWNER=?
                                             AND TABLE_NAME=?
                                             AND CONSTRAINT_TYPE='P')
                  ) B ON A.COLUMN_NAME=B.COLUMN_NAME
WHERE A.OWNER=?
  AND A.TABLE_NAME=?
		 ]]> 
	 </query>
	 <query id="m000202020.select.TbM00MdRespGrUser" desc="" isNamed="false">
		 <![CDATA[ 
select TB_M00_MD_RESP_GR_USER.USER_EMP_NO,nvl(TB_M00_SEC_USER.USER_NAME,TB_M00_MD_RESP_GR_USER.USER_EMP_NO) USER_NAME
from TB_M00_MD_RESP_GR_USER, TB_M00_SEC_USER
where TB_M00_MD_RESP_GR_USER.MD_RESPONSIBILITY_NM=?
  and TB_M00_MD_RESP_GR_USER.USER_EMP_NO=TB_M00_SEC_USER.USER_EMP_NO
		 ]]> 
	 </query>
</queryMap>
