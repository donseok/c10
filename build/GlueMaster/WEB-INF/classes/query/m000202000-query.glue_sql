	 <query id="TbM00Attrs.select.byUK" desc="항목PK" fetchSize="10">
		 <![CDATA[ 
SELECT DT_NM_ID FROM TB_M00_ATTRS WHERE STANDARD_ENGLISH_ID=? AND STANDARD_KOREAN_NAME=? AND DT_NM_DATA_TP=? AND DT_NM_LEN=? AND (DT_NM_DECIMAL_PREC=? or DT_NM_DECIMAL_PREC is null)
		 ]]> 
	 </query>
	 <query id="TbM00Attrs.insert" desc="항목등록" fetchSize="10">
		 <![CDATA[ 
INSERT INTO TB_M00_ATTRS(
  DT_NM_ID,
  STANDARD_ENGLISH_ID,
  STANDARD_KOREAN_NAME,
  DT_NM_DATA_TP,
  DT_NM_LEN,
  DT_NM_DECIMAL_PREC,
  LST_UPD_BY_IP,
  FK_DT_NM_ID,
  DT_NM_TP,
  USE_TP,
  MES_UNIT_OF_MEASURE,
  CREATED_OBJECT_TYPE,
  CREATED_OBJECT_ID,
  CREATED_PROGRAM_ID,
  CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,
  LAST_UPDATED_OBJECT_ID,
  LAST_UPDATE_PROGRAM_ID,
  LAST_UPDATE_TIMESTAMP)
VALUES( ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, ?, ?, ?, CURRENT_TIMESTAMP)
		 ]]> 
	 </query>
	 <query id="TbM00Attrs.update" desc="항목수정" fetchSize="10">
		 <![CDATA[ 
UPDATE TB_M00_ATTRS
SET FK_DT_NM_ID=?,
  LAST_UPDATED_OBJECT_TYPE=?,
  LAST_UPDATED_OBJECT_ID=?,
  LAST_UPDATE_PROGRAM_ID=?,
  LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE STANDARD_ENGLISH_ID=?
  AND FK_DT_NM_ID is null
		 ]]> 
	 </query>
