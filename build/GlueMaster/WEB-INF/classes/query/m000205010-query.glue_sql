<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="화면출력메시지 관리(Oracle/DB2)"> 
	 <query id="TbM00Messages010.select" desc="공통_체인(부문)조회m000205010.selApplicationIdList" fetchSize="10">
		 <![CDATA[ 
SELECT APPLICATION_ID,APPLICATION_NAME FROM TB_M00_MESSAGES010
		 ]]> 
	 </query>
	 <query id="TbM00Messages010.insert" desc="Application_ID 정의" fetchSize="10">
		 <![CDATA[ 
INSERT INTO TB_M00_MESSAGES010(
  APPLICATION_ID,
  APPLICATION_NAME,
  LST_UPD_BY_IP,
  CREATED_OBJECT_TYPE,CREATED_OBJECT_ID,CREATED_PROGRAM_ID,CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,LAST_UPDATED_OBJECT_ID,LAST_UPDATE_PROGRAM_ID,LAST_UPDATE_TIMESTAMP
) VALUES (?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, ?, ?, ?, CURRENT_TIMESTAMP)
		 ]]> 
	 </query>
	 <query id="TbM00Messages020.select" desc="언어코드 조회(m000100100-service)" fetchSize="10">
		 <![CDATA[ 
SELECT * FROM TB_M00_MESSAGES020 ORDER BY USE_LANG_SET_F, NLS_LANG
		 ]]> 
	 </query>
	 <query id="TbM00Messages020.select.inUse" desc="언어 목록 조회" >
		 <![CDATA[ 
SELECT LANGUAGE_CODE,NLS_LANG FROM TB_M00_MESSAGES020 WHERE USE_LANG_SET_F IN ('B','C') ORDER BY USE_LANG_SET_F, NLS_LANG
		 ]]> 
	 </query>
	 <query id="TbM00Messages020.insert" desc="언어코드 추가(m000100100-service)" fetchSize="10">
		 <![CDATA[ 
INSERT INTO TB_M00_MESSAGES020(
  LANGUAGE_CODE,
  USE_LANG_ID,
  NLS_LANG,
  NLS_AREA,
  ISO_LANG_TP,
  ISO_AREA_TP,
  NLS_CD_SET,
  USE_LANG_SET_F,
  LST_UPD_BY_IP,
  LOCAL_LANG,
  UTF8_LANG,
  CREATED_OBJECT_TYPE,CREATED_OBJECT_ID,CREATED_PROGRAM_ID,CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,LAST_UPDATED_OBJECT_ID,LAST_UPDATE_PROGRAM_ID,LAST_UPDATE_TIMESTAMP
) VALUES (?, SQ_M00_MESSAGE020.nextval, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, ?, ?, ?, CURRENT_TIMESTAMP)
		 ]]> 
	 </query>
	 <query id="TbM00Messages020.update" desc="언어코드 수정(m000100100-service)" fetchSize="10">
		 <![CDATA[ 
UPDATE TB_M00_MESSAGES020
SET USE_LANG_SET_F=?,
  LST_UPD_BY_IP=?,
  LAST_UPDATED_OBJECT_TYPE=?,
  LAST_UPDATED_OBJECT_ID=?,
  LAST_UPDATE_PROGRAM_ID=?,
  LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE LANGUAGE_CODE=?
		 ]]> 
	 </query>
	 <query id="TbM00Messages030.select" desc="메시지 정의 조회" fetchSize="10">
		 <![CDATA[ 
SELECT * FROM TB_M00_MESSAGES030
		 ]]> 
	 </query>
	 <query id="TbM00Messages030.select.max" desc="메세지번호" fetchSize="10">
		 <![CDATA[ 
SELECT NVL(MAX(MESSAGE_NUM),0)+1 MAXNUM FROM TB_M00_MESSAGES030
		 ]]> 
	 </query>
	 <query id="TbM00Messages030.insert" desc="메세지 등록" fetchSize="10">
		 <![CDATA[ 
INSERT INTO TB_M00_MESSAGES030(
  APPLICATION_ID,
  MESSAGE_TP,
  MESSAGE_CONT,
  LANGUAGE_CODE,
  MESSAGE_NM,
  MESSAGE_EXPLAIN,
  APPL_MSG_OWNER_EMP_NO,
  MESSAGE_NUM,
  LST_UPD_BY_IP,
  CREATED_OBJECT_TYPE,
  CREATED_OBJECT_ID,
  CREATED_PROGRAM_ID,
  CREATION_TIMESTAMP,
  LAST_UPDATED_OBJECT_TYPE,
  LAST_UPDATED_OBJECT_ID,
  LAST_UPDATE_PROGRAM_ID,
  LAST_UPDATE_TIMESTAMP)
VALUES (?,?,?,?,?,?,?,?,?,?,?,?,CURRENT_TIMESTAMP,?,?,?,CURRENT_TIMESTAMP)
		 ]]> 
	 </query>
	 <query id="TbM00Messages030.update" desc="메세지 수정" fetchSize="10">
		 <![CDATA[ 
UPDATE TB_M00_MESSAGES030
SET MESSAGE_TP=?
   ,MESSAGE_CONT=?
   ,MESSAGE_NM=?
   ,MESSAGE_EXPLAIN=?
   ,APPL_MSG_OWNER_EMP_NO=?
   ,LST_UPD_BY_IP=?
   ,LAST_UPDATED_OBJECT_TYPE=?
   ,LAST_UPDATED_OBJECT_ID=?
   ,LAST_UPDATE_PROGRAM_ID=?
   ,LAST_UPDATE_TIMESTAMP=CURRENT_TIMESTAMP
WHERE APPLICATION_ID=?
  AND LANGUAGE_CODE=?
  AND MESSAGE_NM=?
		 ]]> 
	 </query>
	 <query id="m000205010.selAppMsgList" desc="메시지 목록(DB2/Oracle)" fetchSize="10">
		 <![CDATA[ 
SELECT 
  A.APPLICATION_ID,
  A.MESSAGE_TP,
  A.MESSAGE_NUM,
  A.MESSAGE_NM,
  A.MESSAGE_EXPLAIN,
  A.LANGUAGE_CODE,
  A.MESSAGE_CONT,
  A.APPL_MSG_OWNER_EMP_NO,
  SUBSTR(A.MESSAGE_CONT, 1, 35) MSG_CONT,
  to_char(A.CREATION_TIMESTAMP, 'YYYY-MM-DD') CREATE_DAY,
  to_char(A.CREATION_TIMESTAMP, 'YYYY-MM-DD HH:MI:SS') CREATE_DATE,
  nvl(B.USER_NAME, A.APPL_MSG_OWNER_EMP_NO) USER_NAME,
  D.NLS_LANG||'('||A.LANGUAGE_CODE||')' LANGUAGE_CODE_1
FROM TB_M00_MESSAGES030 A 
  LEFT OUTER JOIN TB_M00_SEC_USER B ON A.APPL_MSG_OWNER_EMP_NO = B.USER_EMP_NO
  INNER JOIN TB_M00_MESSAGES010 C ON A.APPLICATION_ID = C.APPLICATION_ID
  INNER JOIN TB_M00_MESSAGES020 D ON A.LANGUAGE_CODE = D.LANGUAGE_CODE
ORDER BY MESSAGE_NM
		 ]]> 
	 </query>
	 <query id="m000205010.selAppMsgSelected" desc="메시지 정보(DB2/Oracle)" fetchSize="10">
		 <![CDATA[ 
SELECT * 
FROM(
SELECT
  A.APPLICATION_ID,
  A.MESSAGE_TP,
  A.MESSAGE_NUM,
  A.MESSAGE_NM,
  A.MESSAGE_EXPLAIN,
  A.LANGUAGE_CODE,
  A.MESSAGE_CONT,
  A.APPL_MSG_OWNER_EMP_NO,
  SUBSTR(A.MESSAGE_CONT, 1, 35) MSG_CONT,
  to_char(A.CREATION_TIMESTAMP, 'YYYY-MM-DD') CREATE_DAY,
  to_char(A.CREATION_TIMESTAMP, 'YYYY-MM-DD HH:MI:SS') CREATE_DATE,
  B.USER_NAME,
  D.NLS_LANG||'('||A.LANGUAGE_CODE||')' LANGUAGE_CODE_1
FROM TB_M00_MESSAGES030 A
  LEFT OUTER JOIN TB_M00_SEC_USER B ON A.APPL_MSG_OWNER_EMP_NO = B.USER_EMP_NO
  INNER JOIN TB_M00_MESSAGES010 C ON A.APPLICATION_ID = C.APPLICATION_ID
  INNER JOIN TB_M00_MESSAGES020 D ON A.LANGUAGE_CODE = D.LANGUAGE_CODE
ORDER BY MESSAGE_NM 
)
WHERE APPLICATION_ID=? AND LANGUAGE_CODE=? AND MESSAGE_NM=?
		 ]]> 
	 </query>
</queryMap>
