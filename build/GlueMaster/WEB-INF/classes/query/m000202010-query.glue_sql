<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="Rule"> 
	 <query id="m000202010.selBusinessRuleListAll" desc="업무기준 List (일반기준,판단기준)(m000202010-service)" fetchSize="10">
		 <![CDATA[ 
select /* m000202010.selBusinessRuleListAll */ RULE_LIST.*, 
  TO_CHAR(RULE_LIST.START_ACTIVE_DATE, 'YYYY-MM-DD') START_ACTIVE_DATE_STR,
  DECODE(TO_CHAR(RULE_LIST.END_ACTIVE_DATE, 'YYYY-MM-DD'), '2999-12-31', null, TO_CHAR(RULE_LIST.END_ACTIVE_DATE, 'YYYY-MM-DD')) END_ACTIVE_DATE_STR,
  I.USER_NAME
FROM( SELECT TbM00Defines010.MDL_DEFINE_ID      AS MD_ID,
        TbM00Defines010.MDL_DEFINE_NM           AS MD_NM,
        TbM00Defines010.MDL_DEFINE_EXPLAIN      AS MD_EXPLAIN,
        TbM00Defines010.MDL_DEFINE_OWNER_EMP_NO AS OWNER_EMP_NO,
        TbM00Defines010.MASTER_DATA_PRC_TP,
        TbM00Defines010.MDL_DEFINE_CNG_GD       AS CNG_GD,
        TbM00Defines010.USE_TP,
        TbM00Defines010.MDL_DEFINE_VERSION      AS VERSION,
        TbM00Defines010.ACCORD_DATA_CONFIRM_DEST_FLAG,
        TbM00Defines010.START_ACTIVE_DATE,
        TbM00Defines010.END_ACTIVE_DATE,
        TbM00Depend010.HIERARCHY_DATA_ATTR,
        TbM00Depend010.HIERARCHY_WKS_SHARE_L,
        TbM00Depend010.HIERARCHY_OP_TP,
        TbM00Depend010.HIERARCHY_OWNER_SHIP_TP,
        TbM00Depend010.HIERARCHY_DATA_ID
      FROM TB_M00_DEFINES010 TbM00Defines010, TB_M00_DEPEND010 TbM00Depend010
      WHERE TbM00Defines010.MASTER_DATA_PRC_TP IN ('1A0', '1A1', '1A2')
        AND TbM00Defines010.HIERARCHY_DATA_ID=TbM00Depend010.HIERARCHY_DATA_ID
      UNION
      SELECT TbM00Rules010.MD_RULE_ID      AS MD_ID,
        TbM00Rules010.MD_RULE_NM           AS MD_NM,
        TbM00Rules010.MD_RULE_EXPLAIN      AS MD_EXPLAIN,
        TbM00Rules010.MD_RULE_OWNER_EMP_NO AS OWNER_EMP_NO,
        TbM00Rules010.MASTER_DATA_PRC_TP,
        TbM00Rules010.MD_RULE_CNG_GD       AS CNG_GD,
        TbM00Rules010.USE_TP,
        TbM00Rules010.MD_RULE_VERSION      AS VERSION,
        TbM00Rules010.ACCORD_DATA_CONFIRM_DEST_FLAG,
        TbM00Rules010.START_ACTIVE_DATE,
        TbM00Rules010.END_ACTIVE_DATE,
        TbM00Depend010.HIERARCHY_DATA_ATTR,
        TbM00Depend010.HIERARCHY_WKS_SHARE_L,
        TbM00Depend010.HIERARCHY_OP_TP,
        TbM00Depend010.HIERARCHY_OWNER_SHIP_TP,
        TbM00Depend010.HIERARCHY_DATA_ID
      FROM TB_M00_RULES010 TbM00Rules010, TB_M00_DEPEND010 TbM00Depend010
      WHERE TbM00Rules010.MASTER_DATA_PRC_TP IN ('1B0', '1B1')
        AND TbM00Rules010.HIERARCHY_DATA_ID=TbM00Depend010.HIERARCHY_DATA_ID
    ) RULE_LIST,
    ( SELECT USER_EMP_NO,USER_NAME FROM TB_M00_SEC_USER ) I
WHERE RULE_LIST.OWNER_EMP_NO=I.USER_EMP_NO
order by MD_NM, MD_ID ASC
		 ]]> 
	 </query>
	 <query id="m000202010.selectRuleList" desc="RuleList 조회(m000202010-service,m000202310-service)" fetchSize="200">
		 <![CDATA[ 
SELECT /* m000202010.selectRuleList */
  MD_RULE_NM      AS RULE_NM,
  MD_RULE_ID      AS RULE_ID,
  MD_RULE_EXPLAIN AS RULE_EXPLAIN,
  MASTER_DATA_PRC_TP,
  ACCORD_DATA_CONFIRM_DEST_FLAG,
  TO_CHAR(START_ACTIVE_DATE,'yyyy-mm-dd hh24:mi:ss') AS START_ACTIVE_DATE_STR,
  TO_CHAR(END_ACTIVE_DATE,'yyyy-mm-dd hh24:mi:ss')   AS END_ACTIVE_DATE_STR,
  TO_CHAR(START_ACTIVE_DATE,'YYYYMMDDHH24MISS')      AS START_ACTIVE_DATE,
  NVL(TO_CHAR(END_ACTIVE_DATE,'YYYYMMDDHH24MISS'),'29991231235959') END_ACTIVE_DATE
FROM TB_M00_RULES010 TbM00Rules010
WHERE MASTER_DATA_PRC_TP IN ('1B0','1B1')
  AND USE_TP='Y'
  AND CURRENT_TIMESTAMP>=START_ACTIVE_DATE
  AND CURRENT_TIMESTAMP < END_ACTIVE_DATE
UNION
SELECT
  MDL_DEFINE_NM      AS RULE_NM,
  MDL_DEFINE_ID      AS RULE_ID,
  MDL_DEFINE_EXPLAIN AS RULE_EXPLAIN,
  MASTER_DATA_PRC_TP,
  ACCORD_DATA_CONFIRM_DEST_FLAG,
  TO_CHAR(START_ACTIVE_DATE,'yyyy-mm-dd hh24:mi:ss') AS START_ACTIVE_DATE_STR,
  TO_CHAR(END_ACTIVE_DATE,'yyyy-mm-dd hh24:mi:ss')   AS END_ACTIVE_DATE_STR,
  TO_CHAR(START_ACTIVE_DATE,'YYYYMMDDHH24MISS')      AS START_ACTIVE_DATE,
  NVL(TO_CHAR(END_ACTIVE_DATE,'YYYYMMDDHH24MISS'),'29991231235959') END_ACTIVE_DATE
FROM TB_M00_DEFINES010 TbM00Defines010
WHERE USE_TP='Y'
  AND CURRENT_TIMESTAMP>=START_ACTIVE_DATE
  AND CURRENT_TIMESTAMP < END_ACTIVE_DATE
		 ]]> 
	 </query>
	 <query id="m000202030.getTbM00Defines010" desc="업무기준(일반기준) Header 조회(m000202030-service,m000202040-service,m000202050-service)" fetchSize="10">
		 <![CDATA[ 
SELECT /* m000202030.getTbM00Defines010 */ A.*,
  TO_CHAR(A.CREATION_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') CREATION_TIMESTAMP_STR,
  TO_CHAR(A.LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP_STR,
  TO_CHAR(A.START_ACTIVE_DATE,'YYYY-MM-DD HH24:MI:SS') START_ACTIVE_DATE_STR,
  DECODE(TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD'),'2999-12-31',null,TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD HH24:MI:SS')) END_ACTIVE_DATE_STR,
  B.HIERARCHY_OP_TP,
  B.HIERARCHY_OWNER_SHIP_TP,
  B.HIERARCHY_DATA_ATTR,
  B.HIERARCHY_WKS_SHARE_L,
  I.USER_NAME,
  J.MDL_DEFINE_CNG_GD CNG_GD
FROM TB_M00_DEFINES010 A
  INNER JOIN TB_M00_DEPEND010 B ON A.HIERARCHY_DATA_ID=B.HIERARCHY_DATA_ID
  LEFT OUTER JOIN ( SELECT USER_EMP_NO,USER_NAME FROM TB_M00_SEC_USER ) I ON A.MDL_DEFINE_OWNER_EMP_NO=I.USER_EMP_NO
  LEFT OUTER JOIN ( SELECT DISTINCT resp010.MDL_DEFINE_NM, resp_user.MDL_DEFINE_CNG_GD
                    FROM TB_M00_MD_RESP010 resp010, TB_M00_MD_RESP_GR_USER resp_user
                    WHERE resp_user.USER_EMP_NO=NVL(?,'MASTDATA')
                      AND resp010.MD_RESPONSIBILITY_NM=resp_user.MD_RESPONSIBILITY_NM
                  ) J ON A.MDL_DEFINE_NM=J.MDL_DEFINE_NM
WHERE A.MDL_DEFINE_ID=?
		 ]]> 
	 </query>
	 <query id="m000202060.getTbM00Rules010" desc="업무기준(판단기준)/계산식 Header 조회(m000202060-service,m000202070-service,m000202080-service,m000203010-service,m000203030-service)" fetchSize="10">
		 <![CDATA[ 
SELECT /* m000202060.getTbM00Rules010 */ A.*,
  TO_CHAR(A.CREATION_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') CREATION_TIMESTAMP_STR,
  TO_CHAR(A.LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP_STR,
  TO_CHAR(A.START_ACTIVE_DATE,'YYYY-MM-DD HH24:MI:SS') START_ACTIVE_DATE_STR,
  DECODE(TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD'),'2999-12-31',null,TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD HH24:MI:SS')) END_ACTIVE_DATE_STR,
  B.HIERARCHY_OP_TP,
  B.HIERARCHY_OWNER_SHIP_TP,
  B.HIERARCHY_DATA_ATTR,
  B.HIERARCHY_WKS_SHARE_L,
  I.USER_NAME,
  J.MDL_DEFINE_CNG_GD CNG_GD
FROM TB_M00_RULES010 A
  INNER JOIN TB_M00_DEPEND010 B ON A.HIERARCHY_DATA_ID=B.HIERARCHY_DATA_ID
  LEFT OUTER JOIN ( SELECT USER_EMP_NO,USER_NAME FROM TB_M00_SEC_USER ) I ON A.MD_RULE_OWNER_EMP_NO=I.USER_EMP_NO
  LEFT OUTER JOIN ( SELECT DISTINCT resp010.MDL_DEFINE_NM, resp_user.MDL_DEFINE_CNG_GD
                    FROM TB_M00_MD_RESP010 resp010, TB_M00_MD_RESP_GR_USER resp_user
                    WHERE resp_user.USER_EMP_NO=NVL(?,'MASTDATA')
                      AND resp010.MD_RESPONSIBILITY_NM=resp_user.MD_RESPONSIBILITY_NM
                  ) J ON A.MD_RULE_NM=J.MDL_DEFINE_NM
WHERE A.MD_RULE_ID=?
		 ]]> 
	 </query>
	 <query id="m000202060.getTbM00Rules020" desc="업무기준(판단기준) Layout 조회, 계산식 변수 조회(m000202060-service,m000202070-service,m000202080-service,m000203030-service)" fetchSize="10">
		 <![CDATA[ 
SELECT /* m000202060.getTbM00Rules020 */ TbM00Rules020.*,
  TbM00Attrs.STANDARD_ENGLISH_ID,
  TbM00Attrs.STANDARD_KOREAN_NAME
FROM TB_M00_RULES020 TbM00Rules020, TB_M00_ATTRS TbM00Attrs
WHERE TbM00Rules020.MD_RULE_ID=?
  AND TbM00Rules020.DT_NM_ID=TbM00Attrs.DT_NM_ID
ORDER BY TbM00Rules020.MD_RULE_DT_NM_SEQ
		 ]]> 
	 </query>
	 <query id="m000202000.TbM00Defines010" desc="일반기준Header(m000202010-service,m000202020-service,m000202030-service,m000202040-service)" fetchSize="10">
		 <![CDATA[ 
SELECT A.MDL_DEFINE_ID,A.MDL_DEFINE_NM,A.MDL_DEFINE_EXPLAIN,A.MDL_DEFINE_VERSION,A.HIERARCHY_DATA_ID,A.USE_TP,A.MASTER_DATA_PRC_TP,A.START_ACTIVE_DATE,
  TO_CHAR(A.START_ACTIVE_DATE,'YYYYMMDDHH24MISS') START_ACTIVE_DATE_STR,
  TO_CHAR(A.END_ACTIVE_DATE,'YYYYMMDDHH24MISS') END_ACTIVE_DATE_STR,
  A.MDL_DEFINE_OWNER_EMP_NO,
  A.MDL_DEFINE_CNG_GD,
  A.ATTRIBUTE3,
  B.HIERARCHY_OP_TP,
  B.HIERARCHY_OWNER_SHIP_TP,
  B.HIERARCHY_DATA_ATTR,
  B.HIERARCHY_WKS_SHARE_L,
  B.CATEGORY_GROUP_ID,
  B.HIERARCHY_CORE_INF
FROM TB_M00_DEFINES010 A
  INNER JOIN TB_M00_DEPEND010 B ON A.HIERARCHY_DATA_ID=B.HIERARCHY_DATA_ID
		 ]]> 
	 </query>
	 <query id="m000202020.TbM00Rules010" desc="판단기준 기본속성,계산식 조회(ImportCalcInput,ImportCalcList)" fetchSize="10">
		 <![CDATA[ 
SELECT A.MD_RULE_ID,A.MD_RULE_NM,A.MD_RULE_EXPLAIN,A.MD_RULE_VERSION,A.HIERARCHY_DATA_ID,A.USE_TP,A.MASTER_DATA_PRC_TP,A.START_ACTIVE_DATE,
  TO_CHAR(A.START_ACTIVE_DATE,'YYYYMMDDHH24MISS') START_ACTIVE_DATE_STR,
  TO_CHAR(A.END_ACTIVE_DATE,'YYYYMMDDHH24MISS') END_ACTIVE_DATE_STR,
  A.MD_RULE_CNG_GD,
  A.MD_RULE_OWNER_EMP_NO,
  A.ATTRIBUTE3,
  B.HIERARCHY_OP_TP,
  B.HIERARCHY_OWNER_SHIP_TP,
  B.HIERARCHY_DATA_ATTR,
  B.HIERARCHY_WKS_SHARE_L,
  B.CATEGORY_GROUP_ID,
  B.HIERARCHY_CORE_INF
FROM TB_M00_RULES010 A
  INNER JOIN TB_M00_DEPEND010 B ON A.HIERARCHY_DATA_ID=B.HIERARCHY_DATA_ID
		 ]]> 
	 </query>
	 <query id="m000202070.selDecisionRuleData" desc="판단기준데이타" fetchSize="10">
		 <![CDATA[ 
SELECT AA.*,
  ROWNUM AS ROW_NUM
FROM( SELECT B.*,
        DECODE((SELECT SEQUENCE_NUMBER 
                FROM TB_M00_MD_RESP010 RESP010, TB_M00_MD_RESP020 RESP020
                WHERE RESP010.MASTER_DATA_RESP_DEF_ID=RESP020.MASTER_DATA_RESP_DEF_ID
                  AND RESP010.MDL_DEFINE_NM          =A.MD_RULE_NM
                  AND RESP020.SEQUENCE_NUMBER        =B.MD_RULE_CON_NUM
                  AND RESP010.MD_RESPONSIBILITY_NM IN ( SELECT MD_RESPONSIBILITY_NM FROM TB_M00_MD_RESP_GR_USER WHERE USER_EMP_NO=? )
                  AND ROWNUM<=1),'','N','Y')  MODIFY_YN
      FROM TB_M00_RULES040 B, TB_M00_RULES010 A
      WHERE A.MD_RULE_ID=?
        AND B.MD_RULE_ID=A.MD_RULE_ID
      ORDER BY DECODE(MD_RULE_CON_NUM,0,0,MD_RULE_CON_DO_SEQ) ASC,MD_RULE_CON_NUM ASC
    ) AA
		 ]]> 
	 </query>
	 <query id="m000202070.selDecisionRuleDataEx" desc="판단기준데이타 Export" fetchSize="10">
		 <![CDATA[ 
SELECT AA.*,
  ROWNUM AS ROW_NUM,
FROM( SELECT *
      FROM TB_M00_RULES040
      WHERE MD_RULE_ID=?
      ORDER BY DECODE(MD_RULE_CON_NUM,0,0,MD_RULE_CON_DO_SEQ) ASC,MD_RULE_CON_NUM ASC
    ) AA
		 ]]> 
	 </query>
	 <query id="m000203010.selCalcSelectList" desc="계산식 목록 조회(변경이력포함)(DB2/Oracle)" fetchSize="10">
		 <![CDATA[ 
SELECT A.*,
  TO_CHAR(A.CREATION_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') CREATION_TIMESTAMP_STR,
  TO_CHAR(A.LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP_STR,
  TO_CHAR(A.START_ACTIVE_DATE,'YYYY-MM-DD') START_ACTIVE_DATE_STR,
  DECODE(TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD'),'2999-12-31',NULL,TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD')) END_ACTIVE_DATE_STR,
  B.HIERARCHY_OP_TP,
  B.HIERARCHY_OWNER_SHIP_TP,
  B.HIERARCHY_DATA_ATTR,
  B.HIERARCHY_WKS_SHARE_L,
  I.USER_NAME,
  J.MDL_DEFINE_CNG_GD CNG_GD
FROM TB_M00_RULES010 A
  INNER JOIN TB_M00_DEPEND010 B ON A.HIERARCHY_DATA_ID=B.HIERARCHY_DATA_ID
  LEFT OUTER JOIN ( SELECT DISTINCT resp010.MDL_DEFINE_NM, resp_user.MDL_DEFINE_CNG_GD
                    FROM TB_M00_MD_RESP010 resp010, TB_M00_MD_RESP_GR_USER resp_user
                    WHERE resp_user.USER_EMP_NO=NVL(?,'MASTDATA')
                      AND resp010.MD_RESPONSIBILITY_NM=resp_user.MD_RESPONSIBILITY_NM ) J ON A.MDL_DEFINE_NM=J.MDL_DEFINE_NM
  LEFT OUTER JOIN ( SELECT USER_EMP_NO,USER_NAME FROM TB_M00_SEC_USER ) I ON A.MD_RULE_OWNER_EMP_NO=I.USER_EMP_NO
WHERE A.MASTER_DATA_PRC_TP IN ('1C0', '1C2')
ORDER BY MD_RULE_NM, START_ACTIVE_DATE
		 ]]> 
	 </query>
	 <query id="m000203020.selCalcDetailList" desc="계산식 조회,Input처리조건 조회" fetchSize="10">
		 <![CDATA[ 
SELECT TbM00Rules020.*,
  DECODE(TbM00Rules020.MD_RULE_DT_NM_COMP_CHK_V_APP_F,'I','0','1') as APP_F_ORDER,
  TbM00Attrs.STANDARD_KOREAN_NAME,
  TbM00Attrs.STANDARD_ENGLISH_ID,
  ( SELECT MASTER_DATA_PRC_TP FROM TB_M00_RULES010   WHERE MD_RULE_NM=TbM00Rules020.MD_RULE_DT_NM_DRIVED_V_PROC AND USE_TP='Y'
    UNION
    SELECT MASTER_DATA_PRC_TP FROM TB_M00_DEFINES010 WHERE MDL_DEFINE_NM=TbM00Rules020.MD_RULE_DT_NM_DRIVED_V_PROC AND USE_TP='Y'
  ) REF_MASTER_DATA_PRC_TP,
  ( SELECT MD_RULE_ID    FROM TB_M00_RULES010   WHERE MD_RULE_NM=TbM00Rules020.MD_RULE_DT_NM_DRIVED_V_PROC AND USE_TP='Y'
    UNION
    SELECT MDL_DEFINE_ID FROM TB_M00_DEFINES010 WHERE MDL_DEFINE_NM=TbM00Rules020.MD_RULE_DT_NM_DRIVED_V_PROC AND USE_TP='Y'
  ) REF_MD_RULE_ID
FROM TB_M00_RULES020 TbM00Rules020, TB_M00_ATTRS TbM00Attrs
WHERE TbM00Rules020.MD_RULE_ID = ?
  AND TbM00Rules020.DT_NM_ID = TbM00Attrs.DT_NM_ID
ORDER BY TbM00Rules020.MD_RULE_ID,APP_F_ORDER,TbM00Rules020.MD_RULE_DT_NM_SEQ
		 ]]> 
	 </query>
	 <query id="m000203060.selRules030Factor" desc="Factor상수 조회" fetchSize="10">
		 <![CDATA[ 
SELECT TbM00Rules030.*,TbM00Rules060.OLSTATR_CD
FROM TB_M00_RULES030 TbM00Rules030,TB_M00_RULES060 TbM00Rules060
WHERE TbM00Rules030.MD_RULE_ID=?
  AND TbM00Rules030.MD_RULE_CHK_OLSTATR_1=TbM00Rules060.OLSTATR_NM
ORDER BY TbM00Rules030.DT_NM_ID, TbM00Rules030.MD_RULE_DT_NM_BAS_CHK_SEQ
		 ]]> 
	 </query>
	 <query id="m000203020.getTbM00Rules030" desc="Factor상수 조회" fetchSize="10">
		 <![CDATA[ 
SELECT TbM00Rules030.*,TbM00Rules060.OLSTATR_CD
FROM TB_M00_RULES030 TbM00Rules030,TB_M00_RULES060 TbM00Rules060
WHERE TbM00Rules030.MD_RULE_ID=?
  AND TbM00Rules030.DT_NM_ID=?
  AND TbM00Rules030.MD_RULE_CHK_OLSTATR_1=TbM00Rules060.OLSTATR_NM
ORDER BY TbM00Rules030.DT_NM_ID, TbM00Rules030.MD_RULE_DT_NM_BAS_CHK_SEQ
		 ]]> 
	 </query>
	 <query id="m000203010.selCalcSelectListExportfomula" desc="계산식 목록 조회(Import용)" isNamed="false">
		 <![CDATA[ 
SELECT R.*
         ,R050.ACTION_TYPE 
         ,R050.MD_RULE_CON_DO_SEQ
         ,R050.MD_RULE_DT_NM_CONNECT_CHK_NO
         ,R050.MD_RULE_DT_NM_CONNECT_CHK_TPSD
         ,R050.MD_RULE_DECISION_RST1
FROM(
      SELECT A.*,
        TO_CHAR(A.CREATION_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') CREATION_TIMESTAMP_STR,
        TO_CHAR(A.LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD HH24:MI:SS') LAST_UPDATE_TIMESTAMP_STR,
        TO_CHAR(A.START_ACTIVE_DATE,'YYYY-MM-DD') START_ACTIVE_DATE_STR,
        DECODE(TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD'),'2999-12-31',NULL,TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD')) END_ACTIVE_DATE_STR,
        B.HIERARCHY_OP_TP,
        B.HIERARCHY_OWNER_SHIP_TP,
        B.HIERARCHY_DATA_ATTR,
        B.HIERARCHY_WKS_SHARE_L,
        I.USER_NAME,
        J.MDL_DEFINE_CNG_GD CNG_GD
      FROM TB_M00_RULES010 A
        INNER JOIN TB_M00_DEPEND010 B ON A.HIERARCHY_DATA_ID=B.HIERARCHY_DATA_ID
        LEFT OUTER JOIN ( SELECT DISTINCT resp010.MDL_DEFINE_NM, resp_user.MDL_DEFINE_CNG_GD
                          FROM TB_M00_MD_RESP010 resp010, TB_M00_MD_RESP_GR_USER resp_user
                          WHERE resp_user.USER_EMP_NO=NVL(?,'MASTDATA')
                            AND resp010.MD_RESPONSIBILITY_NM=resp_user.MD_RESPONSIBILITY_NM ) J ON A.MDL_DEFINE_NM=J.MDL_DEFINE_NM
        LEFT OUTER JOIN ( SELECT USER_EMP_NO,USER_NAME FROM TB_M00_SEC_USER ) I ON A.MD_RULE_OWNER_EMP_NO=I.USER_EMP_NO
      WHERE A.MASTER_DATA_PRC_TP IN ('1C0', '1C2')
    ) R
  LEFT OUTER JOIN TB_M00_RULES050 R050 ON R.MD_RULE_ID=R050.MD_RULE_ID
		 ]]> 
	 </query>
	 <query id="m000203010.selCalcSelectListExportinput" desc="계산식 목록 조회(Import용)" isNamed="false">
		 <![CDATA[ 
SELECT 
  (SELECT MD_RULE_NM from TB_M00_RULES010 where MD_RULE_ID = ?) MD_RULE_NM,
  (SELECT MD_RULE_VERSION from TB_M00_RULES010 where MD_RULE_ID = ?) MD_RULE_VERSION,
  input.*,
  factor.*
from(
      SELECT TbM00Rules020.*,
        DECODE(TbM00Rules020.MD_RULE_DT_NM_COMP_CHK_V_APP_F,'I','0','1') as APP_F_ORDER,
        TbM00Attrs.STANDARD_KOREAN_NAME,
        TbM00Attrs.STANDARD_ENGLISH_ID,
        TbM00Attrs.DT_NM_DECIMAL_PREC,
        ( SELECT MASTER_DATA_PRC_TP FROM TB_M00_RULES010   WHERE MD_RULE_NM=TbM00Rules020.MD_RULE_DT_NM_DRIVED_V_PROC AND USE_TP='Y'
          UNION
          SELECT MASTER_DATA_PRC_TP FROM TB_M00_DEFINES010 WHERE MDL_DEFINE_NM=TbM00Rules020.MD_RULE_DT_NM_DRIVED_V_PROC AND USE_TP='Y'
        ) REF_MASTER_DATA_PRC_TP,
        ( SELECT MD_RULE_ID    FROM TB_M00_RULES010   WHERE MD_RULE_NM=TbM00Rules020.MD_RULE_DT_NM_DRIVED_V_PROC AND USE_TP='Y'
          UNION
          SELECT MDL_DEFINE_ID FROM TB_M00_DEFINES010 WHERE MDL_DEFINE_NM=TbM00Rules020.MD_RULE_DT_NM_DRIVED_V_PROC AND USE_TP='Y'
        ) REF_MD_RULE_ID
      FROM TB_M00_RULES020 TbM00Rules020, TB_M00_ATTRS TbM00Attrs
      WHERE TbM00Rules020.MD_RULE_ID = ?
        AND TbM00Rules020.DT_NM_ID = TbM00Attrs.DT_NM_ID
    ) input
  LEFT OUTER JOIN(  SELECT TbM00Rules030.*,TbM00Rules060.OLSTATR_CD
                    FROM TB_M00_RULES030 TbM00Rules030,TB_M00_RULES060 TbM00Rules060
                    WHERE TbM00Rules030.MD_RULE_ID = ?
                      AND TbM00Rules030.MD_RULE_CHK_OLSTATR_1=TbM00Rules060.OLSTATR_NM
                 ) factor ON input.DT_NM_ID =factor.DT_NM_ID
ORDER BY input.DT_NM_ID
		 ]]> 
	 </query>
	 <query id="TbM00Defines010.select.sync" desc="마스터이행(DEFINES)" >
		 <![CDATA[ 
SELECT MDL_DEFINE_ID,TO_CHAR(START_ACTIVE_DATE,'YYYYMMDDHH24MISS') START_ACTIVE_DATE_STR,ACCORD_DATA_CONFIRM_DEST_FLAG
FROM TB_M00_DEFINES010 
WHERE MDL_DEFINE_NM=?
  AND USE_TP='Y'
