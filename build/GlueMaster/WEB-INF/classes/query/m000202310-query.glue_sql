<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="m000202310.업무기준 JCS 대상"> 
	 <query id="oracle.m000202030.getTbM00Defines020" desc="업무기준(일반기준) Layout 조회(OnlyOracle)" fetchSize="10">
		 <![CDATA[ 
SELECT TbM00Defines020.*,
  TbM00Attrs.STANDARD_ENGLISH_ID,
  TbM00Attrs.STANDARD_KOREAN_NAME,
  TbM00Attrs.DT_NM_LEN,
  ( SELECT CD_TP_ID FROM TB_M00_CODES020
    WHERE CD_TP=( SELECT STANDARD_ENGLISH_ID FROM TB_M00_ATTRS
                  WHERE DT_NM_ID IN ( SELECT HIERARCHY_KEY_2 FROM TB_M00_DEPEND010
                                      WHERE HIERARCHY_DATA_ID=DECODE(TbM00Defines020.MDL_DEFINE_DT_NM_WILDCARD_TP,'Y','',TbM00Defines020.HIERARCHY_DATA_ID)
                                    )
                    AND ROWNUM=1
                )
      AND SYSDATE BETWEEN START_ACTIVE_DATE AND END_ACTIVE_DATE
      AND USE_TP='Y') CD_TP_ID
FROM TB_M00_DEFINES020 TbM00Defines020, TB_M00_ATTRS TbM00Attrs
WHERE TbM00Defines020.DT_NM_ID=TbM00Attrs.DT_NM_ID
  AND TbM00Defines020.MDL_DEFINE_ID=?
ORDER BY MDL_DEFINE_DT_NM_SEQ
		 ]]> 
	 </query>
	 <query id="db2.m000202030.getTbM00Defines020" desc="업무기준(일반기준) Layout 조회(OnlyDB2)" fetchSize="10">
		 <![CDATA[ 
SELECT TbM00Defines020.*,
  TbM00Attrs.STANDARD_ENGLISH_ID,
  TbM00Attrs.STANDARD_KOREAN_NAME,
  TbM00Attrs.DT_NM_LEN,
  ( SELECT CD_TP_ID FROM TB_M00_CODES020
    WHERE CD_TP=( SELECT STANDARD_ENGLISH_ID FROM TB_M00_ATTRS
                  WHERE DT_NM_ID IN ( SELECT HIERARCHY_KEY_2 FROM TB_M00_DEPEND010
                                      WHERE HIERARCHY_DATA_ID=DECODE(TbM00Defines020.MDL_DEFINE_DT_NM_WILDCARD_TP,'Y',null,TbM00Defines020.HIERARCHY_DATA_ID)
                                    )
                   FETCH FIRST 1 ROW ONLY
                )
      AND CURRENT_TIMESTAMP BETWEEN START_ACTIVE_DATE AND END_ACTIVE_DATE
      AND USE_TP='Y') CD_TP_ID
FROM TB_M00_DEFINES020 TbM00Defines020, TB_M00_ATTRS TbM00Attrs
WHERE TbM00Defines020.DT_NM_ID=TbM00Attrs.DT_NM_ID
  AND TbM00Defines020.MDL_DEFINE_ID=?
ORDER BY MDL_DEFINE_DT_NM_SEQ
		 ]]> 
	 </query>
	 <query id="oracle.m000202080.AutorityRules050VO" desc="연관판단기준내용조회(OnlyOracle)" fetchSize="10">
		 <![CDATA[ 
SELECT
  RULES050.MD_RULE_ID, 
  RULES050.MD_RULE_DT_NM_CONNECT_CHK_NO, 
  RULES050.MD_RULE_CON_DO_SEQ, 
  RULES050.MD_RULE_DT_NM_CONNECT_CHK_NM, 
  RULES050.MD_RULE_DT_NM_CONNECT_CHK_TPSD, 
  RULES050.MD_RULE_DT_NM_CONNECT_CHK_TRUE, 
  RULES050.MD_RULE_DECISION_RST1, 
  RULES050.MD_RULE_DECISION_RST2, 
  RULES050.MD_RULE_DECISION_RST3, 
  RULES050.ACTION_TYPE, 
  RULES050.USE_TP, 
  RULES050.START_ACTIVE_DATE, 
  RULES050.END_ACTIVE_DATE,
  DECODE(RULES050.MD_RULE_CON_DO_SEQ,-1,'',RULES050.MD_RULE_CON_DO_SEQ) MD_RULE_CON_DO_EXPLAIN,
  DECODE((SELECT SEQUENCE_NUMBER 
          FROM TB_M00_MD_RESP010 A, TB_M00_MD_RESP020 B
          WHERE A.MASTER_DATA_RESP_DEF_ID = B.MASTER_DATA_RESP_DEF_ID
            AND A.MDL_DEFINE_NM           = RULES010.MD_RULE_NM
            AND B.SEQUENCE_NUMBER         = RULES050.MD_RULE_DT_NM_CONNECT_CHK_NO
            AND A.MD_RESPONSIBILITY_NM IN ( SELECT MD_RESPONSIBILITY_NM FROM TB_M00_MD_RESP_GR_USER
                                            WHERE USER_EMP_NO=?
                                          )
            AND ROWNUM<=1),'','N','Y')  MODIFY_YN
FROM TB_M00_RULES050 RULES050, TB_M00_RULES010 RULES010
WHERE RULES010.MD_RULE_ID=?
  AND RULES050.MD_RULE_ID=RULES010.MD_RULE_ID
ORDER BY DECODE(MD_RULE_CON_DO_SEQ,0,0,MD_RULE_CON_DO_SEQ) ASC, MD_RULE_DT_NM_CONNECT_CHK_NO ASC
		 ]]> 
	 </query>
	 <query id="db2.m000202080.AutorityRules050VO" desc="연관판단기준내용조회(OnlyDB2)" fetchSize="10">
		 <![CDATA[ 
SELECT
  RULES050.MD_RULE_ID, 
  RULES050.MD_RULE_DT_NM_CONNECT_CHK_NO, 
  RULES050.MD_RULE_CON_DO_SEQ, 
  RULES050.MD_RULE_DT_NM_CONNECT_CHK_NM, 
  RULES050.MD_RULE_DT_NM_CONNECT_CHK_TPSD, 
  RULES050.MD_RULE_DT_NM_CONNECT_CHK_TRUE, 
  RULES050.MD_RULE_DECISION_RST1, 
  RULES050.MD_RULE_DECISION_RST2, 
  RULES050.MD_RULE_DECISION_RST3, 
  RULES050.ACTION_TYPE, 
  RULES050.USE_TP, 
  RULES050.START_ACTIVE_DATE, 
  RULES050.END_ACTIVE_DATE,
  DECODE(RULES050.MD_RULE_CON_DO_SEQ,-1,NULL,RULES050.MD_RULE_CON_DO_SEQ) MD_RULE_CON_DO_EXPLAIN,
  DECODE((SELECT SEQUENCE_NUMBER 
          FROM TB_M00_MD_RESP010 A, TB_M00_MD_RESP020 B
          WHERE A.MASTER_DATA_RESP_DEF_ID = B.MASTER_DATA_RESP_DEF_ID
            AND A.MDL_DEFINE_NM           = RULES010.MD_RULE_NM
            AND B.SEQUENCE_NUMBER         = RULES050.MD_RULE_DT_NM_CONNECT_CHK_NO
            AND A.MD_RESPONSIBILITY_NM IN ( SELECT MD_RESPONSIBILITY_NM FROM TB_M00_MD_RESP_GR_USER
                                            WHERE USER_EMP_NO=?
                                          )
            limit 1 ),NULL,'N','Y')  MODIFY_YN
FROM TB_M00_RULES050 RULES050, TB_M00_RULES010 RULES010
WHERE RULES010.MD_RULE_ID=?
  AND RULES050.MD_RULE_ID=RULES010.MD_RULE_ID
ORDER BY DECODE(MD_RULE_CON_DO_SEQ,0,0,MD_RULE_CON_DO_SEQ) ASC, MD_RULE_DT_NM_CONNECT_CHK_NO ASC
		 ]]> 
	 </query>
	 <query id="oracle.m000202080.selMaxRules050VO" desc="판단기준데이타 MaxRules050VO(OnlyOracle)" fetchSize="10">
		 <![CDATA[ 
SELECT MD_RULE_DT_NM_CONNECT_CHK_NO FROM TB_M00_RULES050 WHERE MD_RULE_ID=? AND ROWNUM=1 ORDER BY MD_RULE_DT_NM_CONNECT_CHK_NO DESC
		 ]]> 
	 </query>
	 <query id="db2.m000202080.selMaxRules050VO" desc="판단기준데이타 MaxRules050VO(OnlyDB2)" fetchSize="10">
		 <![CDATA[ 
SELECT MD_RULE_DT_NM_CONNECT_CHK_NO FROM TB_M00_RULES050 WHERE MD_RULE_ID=? ORDER BY MD_RULE_DT_NM_CONNECT_CHK_NO DESC FETCH FIRST 1 ROW ONLY
		 ]]> 
	 </query>
	 <query id="oracle.m000209020.SignAttrsApply" desc="항목신청승인저장(OnlyOracle)" fetchSize="10">
		 <![CDATA[ 
UPDATE TB_M00_DATA_ITEMS010 
SET DATA_VAR_ID=?,INVEST_RESULT=?,PROGRESS_STS=?,CODE_YN=DECODE((SELECT CD_TP FROM TB_M00_CODES020 WHERE CD_TP=? AND ROWNUM=1),NULL,'','Y') 
WHERE DATA_ITEM_NAME=?
		 ]]> 
	 </query>
	 <query id="db2.m000209020.SignAttrsApply" desc="항목신청승인저장(OnlyDB2)" fetchSize="10">
		 <![CDATA[ 
UPDATE TB_M00_DATA_ITEMS010
SET DATA_VAR_ID=?,INVEST_RESULT=?,PROGRESS_STS=?,CODE_YN=CASE (SELECT CD_TP FROM TB_M00_CODES020 WHERE CD_TP=? FETCH FIRST 1 ROWS ONLY) WHEN NULL THEN ''ELSE 'Y' END 
WHERE DATA_ITEM_NAME=?
		 ]]> 
	 </query>
	 <query id="oracle.m000202040.MaxDatas010VO" desc="업무기준 MaxDatas010VO(OnlyOracle)" fetchSize="10">
		 <![CDATA[ 
SELECT MD_MRG_BAS_DATA_SEQ FROM TB_M00_DATAS010 WHERE MD_MRG_BAS_ID=? AND ROWNUM=1 order by MD_MRG_BAS_DATA_SEQ DESC
		 ]]> 
	 </query>
	 <query id="db2.m000202040.MaxDatas010VO" desc="업무기준 MaxDatas010VO(OnlyDB2)" fetchSize="10">
		 <![CDATA[ 
SELECT MD_MRG_BAS_DATA_SEQ FROM TB_M00_DATAS010 WHERE MD_MRG_BAS_ID=? order by MD_MRG_BAS_DATA_SEQ DESC FETCH FIRST 1 ROW ONLY
		 ]]> 
	 </query>
</queryMap>
