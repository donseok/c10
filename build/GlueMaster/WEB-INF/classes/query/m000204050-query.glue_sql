<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="포맷목록조회(DB2)"> 
	 <query id="oracle.m000204010.selTCList" desc="TC리스트(OnlyOracle)" fetchSize="10">
		 <![CDATA[ 
SELECT 
  R1.*,
  DECODE(R1.MODIFY_FORMAT_ID-R1.VIEW_FORMAT_ID,0,'','Y') NEW_VERSION_FLAG
FROM( SELECT A.*,
        ( SELECT MIN(MDL_DEFINE_ID) MAX_MDL_DEFINE_ID
          FROM TB_M00_INTERFACES
          WHERE MDL_DEFINE_NM=A.FORMAT_NAME
          AND END_ACTIVE_DATE>SYSDATE
        ) VIEW_FORMAT_ID,
        ( SELECT MAX(MDL_DEFINE_ID) MAX_MDL_DEFINE_ID
          FROM TB_M00_INTERFACES
          WHERE MDL_DEFINE_NM=A.FORMAT_NAME
        ) MODIFY_FORMAT_ID
      FROM( SELECT  
              A.MDL_DEFINE_ID, 
              A.MDL_DEFINE_NM,
              ( SELECT K.FAC_OP_CD 
                FROM TB_M00_INTERFACE_CHECKS010 K
                WHERE K.MDL_DEFINE_NM=A.MDL_DEFINE_NM
                  AND ROWNUM=1
              ) FAC_OP_CD,
              A.MDL_DEFINE_VERSION, 
              A.MDL_DEFINE_EXPLAIN,
              A.MDL_DEFINE_EXPORT_VIEW_NM, 
              A.MDL_DEFINE_IMPORT_VIEW_NM,
              A.PROCESS_CHAIN_CODE1, 
              A.PROCESS_CHAIN_CODE2,
              A.START_ACTIVE_DATE, 
              A.END_ACTIVE_DATE,
              A.INF_LST_RCP_DT, 
              A.HR_ORGANIZATION_CODE,
              A.HR_ORGANIZATION_NAME, 
              A.LAST_UPDATED_OBJECT_ID,
              A.LAST_UPDATE_TIMESTAMP, 
              A.CREATION_TIMESTAMP,
              A.LST_UPD_BY_IP,  
              A.MDL_DEFINE_OWNER_EMP_NO,
              A.MDL_DEFINE_CNG_GD, 
              A.HIERARCHY_DATA_ID,
              A.MD_RULE_NM, 
              A.FK_MDL_DEFINE_ID, 
              A.EXPAND_DT_NM_CLS_BAS,
              ( SELECT MDL_DEFINE_NM 
                FROM TB_M00_INTERFACES
                WHERE MDL_DEFINE_ID=A.FK_MDL_DEFINE_ID
                  AND ROWNUM = 1
              ) FORMAT_NAME,
              DECODE((SELECT COUNT(*) 
                      FROM TB_M00_INTERFACE_CHECKS010
                      WHERE MDL_DEFINE_NM=A.MDL_DEFINE_NM),0,'','Y') ECHK_FLAG,
              decode(sign(A.END_ACTIVE_DATE-SYSDATE),-1,'N',decode(sign(SYSDATE-A.START_ACTIVE_DATE),1,'Y','F')) USE_TP,
              J.MDL_DEFINE_CNG_GD as RESP_GRADE,
              DECODE(A.MDL_DEFINE_NM,J.MDL_DEFINE_NM,'ENABLE','DISABLE') RESP_CHECK 
            FROM TB_M00_INTERFACES A,
                ( SELECT DISTINCT 
                    resp010.MDL_DEFINE_NM,
                    resp_user.MDL_DEFINE_CNG_GD
                  FROM TB_M00_MD_RESP010 resp010,TB_M00_MD_RESP_GR_USER resp_user 
                  WHERE resp_user.USER_EMP_NO='MASTDATA'
                    AND resp010.MD_RESPONSIBILITY_NM = resp_user.MD_RESPONSIBILITY_NM
                ) J
            WHERE A.MDL_DEFINE_ID <> A.FK_MDL_DEFINE_ID
              AND A.END_ACTIVE_DATE = TO_DATE('2999-12-31 23:59:59','YYYY-MM-DD HH24:MI:SS')
              AND A.MDL_DEFINE_NM = J.MDL_DEFINE_NM(+)
          ) A
    ) R1
ORDER BY MDL_DEFINE_NM
		 ]]> 
	 </query>
	 <query id="db2.m000204010.selTCList" desc="TC리스트" fetchSize="10">
		 <![CDATA[ 
SELECT 
  R1.*,
  DECODE(R1.MODIFY_FORMAT_ID-R1.VIEW_FORMAT_ID,0,NULL,'Y') NEW_VERSION_FLAG
FROM( SELECT A.*,
        ( SELECT MIN(MDL_DEFINE_ID) MAX_MDL_DEFINE_ID
          FROM TB_M00_INTERFACES
          WHERE MDL_DEFINE_NM=A.FORMAT_NAME
          AND END_ACTIVE_DATE>CURRENT_TIMESTAMP
        ) VIEW_FORMAT_ID,
        ( SELECT MAX(MDL_DEFINE_ID) MAX_MDL_DEFINE_ID
          FROM TB_M00_INTERFACES
          WHERE MDL_DEFINE_NM=A.FORMAT_NAME
        ) MODIFY_FORMAT_ID
      FROM( SELECT  
              A.MDL_DEFINE_ID, 
              A.MDL_DEFINE_NM,
              ( SELECT K.FAC_OP_CD 
                FROM TB_M00_INTERFACE_CHECKS010 K
                WHERE K.MDL_DEFINE_NM=A.MDL_DEFINE_NM
                FETCH FIRST 1 ROW ONLY
              ) FAC_OP_CD,
              A.MDL_DEFINE_VERSION, 
              A.MDL_DEFINE_EXPLAIN,
              A.MDL_DEFINE_EXPORT_VIEW_NM, 
              A.MDL_DEFINE_IMPORT_VIEW_NM,
              A.PROCESS_CHAIN_CODE1, 
              A.PROCESS_CHAIN_CODE2,
              A.START_ACTIVE_DATE, 
              A.END_ACTIVE_DATE,
              A.INF_LST_RCP_DT, 
              A.HR_ORGANIZATION_CODE,
              A.HR_ORGANIZATION_NAME, 
              A.LAST_UPDATED_OBJECT_ID,
              A.LAST_UPDATE_TIMESTAMP, 
              A.CREATION_TIMESTAMP,
              A.LST_UPD_BY_IP,  
              A.MDL_DEFINE_OWNER_EMP_NO,
              A.MDL_DEFINE_CNG_GD, 
              A.HIERARCHY_DATA_ID,
              A.MD_RULE_NM, 
              A.FK_MDL_DEFINE_ID, 
              A.EXPAND_DT_NM_CLS_BAS,
              ( SELECT MDL_DEFINE_NM 
                FROM TB_M00_INTERFACES
                WHERE MDL_DEFINE_ID=A.FK_MDL_DEFINE_ID
                FETCH FIRST 1 ROW ONLY
              ) FORMAT_NAME,
              DECODE((SELECT COUNT(*) 
                      FROM TB_M00_INTERFACE_CHECKS010
                      WHERE MDL_DEFINE_NM=A.MDL_DEFINE_NM),0,NULL,'Y') ECHK_FLAG,
              decode(sign(A.END_ACTIVE_DATE-CURRENT_TIMESTAMP),-1,'N',decode(sign(CURRENT_TIMESTAMP-A.START_ACTIVE_DATE),1,'Y','F')) USE_TP,
              J.MDL_DEFINE_CNG_GD as RESP_GRADE,
              DECODE(A.MDL_DEFINE_NM,J.MDL_DEFINE_NM,'ENABLE','DISABLE') RESP_CHECK 
            FROM TB_M00_INTERFACES A
            LEFT OUTER JOIN
                ( SELECT DISTINCT 
                    resp010.MDL_DEFINE_NM,
                    resp_user.MDL_DEFINE_CNG_GD
                  FROM TB_M00_MD_RESP010 resp010,TB_M00_MD_RESP_GR_USER resp_user 
                  WHERE resp_user.USER_EMP_NO='MASTDATA'
                    AND resp010.MD_RESPONSIBILITY_NM = resp_user.MD_RESPONSIBILITY_NM
                ) J
            ON  A.MDL_DEFINE_NM = J.MDL_DEFINE_NM   
            WHERE A.MDL_DEFINE_ID <> A.FK_MDL_DEFINE_ID
              AND A.END_ACTIVE_DATE = TO_DATE('2999-12-31 23:59:59','YYYY-MM-DD HH24:MI:SS')
          ) A
    ) R1
ORDER BY MDL_DEFINE_NM
		 ]]> 
	 </query>
	 <query id="oracle.m000204050.selTCBelngtoFormat" desc="전문리스트belongtoformat" fetchSize="10">
		 <![CDATA[ 
SELECT
  A.MDL_DEFINE_ID,
  A.MDL_DEFINE_NM,
  ( SELECT K.FAC_OP_CD
    FROM TB_M00_INTERFACE_CHECKS010 K
    WHERE K.MDL_DEFINE_NM=A.MDL_DEFINE_NM
      AND ROWNUM=1
  ) FAC_OP_CD,
  A.MDL_DEFINE_VERSION,
  A.MDL_DEFINE_EXPLAIN,
  A.MDL_DEFINE_EXPORT_VIEW_NM,
  A.MDL_DEFINE_IMPORT_VIEW_NM,
  A.PROCESS_CHAIN_CODE1,
  A.PROCESS_CHAIN_CODE2,
  A.START_ACTIVE_DATE,
  A.END_ACTIVE_DATE,
  A.INF_LST_RCP_DT,
  A.HR_ORGANIZATION_CODE,
  A.HR_ORGANIZATION_NAME,
  A.LAST_UPDATED_OBJECT_ID,
  A.LAST_UPDATE_TIMESTAMP,
  A.CREATION_TIMESTAMP,
  A.LST_UPD_BY_IP,
  A.MDL_DEFINE_OWNER_EMP_NO,
  A.MDL_DEFINE_CNG_GD,
  A.HIERARCHY_DATA_ID,
  A.MD_RULE_NM,
  A.FK_MDL_DEFINE_ID,
  A.EXPAND_DT_NM_CLS_BAS,
  ( SELECT MDL_DEFINE_NM
    FROM TB_M00_INTERFACES
    WHERE MDL_DEFINE_ID=A.FK_MDL_DEFINE_ID
      AND ROWNUM=1
  ) FORMAT_NAME,
  DECODE((SELECT COUNT(*)
          FROM TB_M00_INTERFACE_CHECKS010
          WHERE MDL_DEFINE_NM=A.MDL_DEFINE_NM),0,'','Y') ECHK_FLAG,
  decode(sign(A.END_ACTIVE_DATE-SYSDATE),-1,'N',decode(sign(SYSDATE-A.START_ACTIVE_DATE),1,'Y','F')) USE_TP,
  J.MDL_DEFINE_CNG_GD as RESP_GRADE,
  DECODE(A.MDL_DEFINE_NM,J.MDL_DEFINE_NM,'ENABLE','DISABLE') RESP_CHECK
FROM TB_M00_INTERFACES A,
    ( SELECT DISTINCT resp010.MDL_DEFINE_NM,resp_user.MDL_DEFINE_CNG_GD
      FROM TB_M00_MD_RESP010 resp010,TB_M00_MD_RESP_GR_USER resp_user
      WHERE resp_user.USER_EMP_NO='MASTDATA'
        AND resp010.MD_RESPONSIBILITY_NM = resp_user.MD_RESPONSIBILITY_NM
    ) J
WHERE A.FK_MDL_DEFINE_ID=?
  AND A.END_ACTIVE_DATE=TO_DATE('2999-12-31 23:59:59','YYYY-MM-DD HH24:MI:SS')
  AND A.MDL_DEFINE_NM=J.MDL_DEFINE_NM(+)
		 ]]> 
	 </query>
