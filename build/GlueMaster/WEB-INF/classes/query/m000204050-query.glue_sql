	 <query id="oracle.m000204050.selFormatListExport" desc="포맷리스트" >
		 <![CDATA[ 
SELECT FINFO.* 
       ,ATTR.MDL_DEFINE_DT_NM_SEQ
       ,ATTR.STANDARD_ENGLISH_ID
       ,ATTR.STANDARD_KOREAN_NAME
       ,ATTR.MDL_DEFINE_DT_NM_DATA_TP
       ,ATTR.MDL_DEFINE_DT_NM_LEN
       ,ATTR.MDL_DEFINE_DT_NM_V_DECI_PREC
FROM
(
SELECT
  A.MDL_DEFINE_ID,
  A.MDL_DEFINE_NM,
  ( SELECT K.FAC_OP_CD
    FROM TB_M00_INTERFACE_CHECKS010 K
    WHERE K.MDL_DEFINE_NM=A.MDL_DEFINE_NM
      AND ROWNUM=1
  ) FAC_OP_CD,
  A.MDL_DEFINE_VERSION,
  A.MDL_DEFINE_EXPLAIN,
  A.MDL_DEFINE_EXPORT_VIEW_NM,
  A.MDL_DEFINE_IMPORT_VIEW_NM,
  A.PROCESS_CHAIN_CODE1,
  A.PROCESS_CHAIN_CODE2,
  A.START_ACTIVE_DATE, 
  A.END_ACTIVE_DATE,
  TO_CHAR(A.START_ACTIVE_DATE,'YYYY-MM-DD HH24:MI:SS') START_ACTIVE_DATE_STR,
  TO_CHAR(A.END_ACTIVE_DATE,'YYYY-MM-DD HH24:MI:SS') END_ACTIVE_DATE_STR,
  A.INF_LST_RCP_DT,
  A.HR_ORGANIZATION_CODE,
  A.HR_ORGANIZATION_NAME,
  A.LAST_UPDATED_OBJECT_ID,
  A.LAST_UPDATE_TIMESTAMP,
  A.CREATION_TIMESTAMP,
  A.LST_UPD_BY_IP,
  A.MDL_DEFINE_OWNER_EMP_NO,
  A.MDL_DEFINE_CNG_GD,
  A.HIERARCHY_DATA_ID,
  A.MD_RULE_NM,
  A.FK_MDL_DEFINE_ID,
  A.EXPAND_DT_NM_CLS_BAS,
  DECODE((SELECT COUNT(*)
          FROM TB_M00_INTERFACE_CHECKS010
          WHERE MDL_DEFINE_NM=A.MDL_DEFINE_NM),0,'','Y') ECHK_FLAG,
  decode(sign(A.END_ACTIVE_DATE-SYSDATE),-1,'N',decode(sign(SYSDATE-A.START_ACTIVE_DATE),1,'Y','F')) USE_TP,
  J.MDL_DEFINE_CNG_GD as RESP_GRADE,
  DECODE(A.MDL_DEFINE_NM,J.MDL_DEFINE_NM,'ENABLE','DISABLE') RESP_CHECK,
  ( SELECT count(*)
    FROM TB_M00_INTERFACES
    WHERE A.MDL_DEFINE_ID=FK_MDL_DEFINE_ID
  ) COUNT_TC
FROM TB_M00_INTERFACES A,
    ( SELECT DISTINCT resp010.MDL_DEFINE_NM,resp_user.MDL_DEFINE_CNG_GD
      FROM TB_M00_MD_RESP010 resp010,TB_M00_MD_RESP_GR_USER resp_user 
      WHERE resp_user.USER_EMP_NO='MASTDATA'
        AND resp010.MD_RESPONSIBILITY_NM=resp_user.MD_RESPONSIBILITY_NM
    ) J
WHERE A.FK_MDL_DEFINE_ID is null
  AND A.END_ACTIVE_DATE=TO_DATE('2999-12-31 23:59:59','YYYY-MM-DD HH24:MI:SS')
  AND A.MDL_DEFINE_NM=J.MDL_DEFINE_NM(+)
) FINFO
LEFT OUTER JOIN TB_M00_INTERFACE_ATTRS ATTR ON FINFO.MDL_DEFINE_ID=ATTR.MDL_DEFINE_ID
ORDER BY  ATTR.MDL_DEFINE_ID,ATTR.MDL_DEFINE_DT_NM_SEQ
		 ]]> 
	 </query>
