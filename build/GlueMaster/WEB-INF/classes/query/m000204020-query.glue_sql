<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="Interface(Oracle/DB2)"> 
	 <query id="m000204020.selTcErrCheckOpCdVO" desc="전문Error체크조회(DB2/Oracle)" fetchSize="10">
		 <![CDATA[ 
SELECT DISTINCT A.FAC_OP_CD,C.CD_V_MEANING
FROM TB_M00_INTERFACE_CHECKS010 A,TB_M00_CODES020 B,TB_M00_CODES030 C,TB_M00_CATEGORY_GR E
WHERE MDL_DEFINE_NM=NVL( CAST(? AS VARCHAR(150)) ,'')
  AND B.CD_TP='FAC_OP_CD'
  AND B.CD_TP_ID=C.CD_TP_ID
  AND A.FAC_OP_CD=C.CD_V
  AND C.CATEGORY_GROUP_ID=E.CATEGORY_GROUP_ID
  AND A.CATEGORY_GROUP_NM=E.CATEGORY_GROUP_NM
  AND CURRENT_TIMESTAMP BETWEEN A.START_ACTIVE_DATE AND NVL(A.END_ACTIVE_DATE,CURRENT_TIMESTAMP)
  AND CURRENT_TIMESTAMP BETWEEN B.START_ACTIVE_DATE AND NVL(B.END_ACTIVE_DATE,CURRENT_TIMESTAMP)
ORDER BY FAC_OP_CD ASC
		 ]]> 
	 </query>
	 <query id="m000204020.selTCDetailVO" desc="전문Error체크조회(DB2/Oracle)" fetchSize="10">
		 <![CDATA[ 
SELECT
  A.MDL_DEFINE_DT_NM_NM,
  A.MDL_DEFINE_DT_NM_SEQ,
  A.MDL_DEFINE_DT_NM_GROUP_TP,
  A.MDL_DEFINE_DT_NM_DATA_TP,
  A.MDL_DEFINE_DT_NM_LEN,
  A.MDL_DEFINE_DT_NM_V_DECI_PREC,
  DECODE(B.MD_RULE_DT_NM_COMP_CHK_V_APP_F,'B','1','G','1','0') BR_CHECK_FLAG,
  DECODE(B.MD_RULE_DT_NM_COMP_CHK_V_APP_F,'T','1','G','1','0') BL_CHECK_FLAG,
  DECODE(B.MD_RULE_DT_NM_COMP_CHK_V_APP_F,'G','1','0') ALL_CHECK_FLAG,
  A.STANDARD_ENGLISH_ID,
  A.STANDARD_KOREAN_NAME,
  B.DT_NM_UOM_CD,
  decode(A.MDL_DEFINE_DT_NM_DATA_TP, 1, 'VARCHAR', 2, 'NUMBER', 3, 'DATE', 4, 'CHAR', 5,'TIMESTAMP', 6,'ARRAY'  ) DATA_TP
FROM TB_M00_INTERFACE_ATTRS A
  LEFT OUTER JOIN ( SELECT
                      R1.MDL_DEFINE_NM,
                      R1.START_ACTIVE_DATE,
                      R1.END_ACTIVE_DATE,
                      R1.FAC_OP_CD,
                      R2.DT_NM_UOM_CD,
                      R2.MDL_DEFINE_DT_NM_NM,
                      R2.MD_RULE_DT_NM_COMP_CHK_V_APP_F,
                      R2.STANDARD_ENGLISH_ID,
                      R2.STANDARD_KOREAN_NAME,
                      R2.DT_NM_ID,
                      R2.MDL_DEFINE_DT_NM_SEQ
                    FROM TB_M00_INTERFACE_CHECKS010 R1, TB_M00_INTERFACE_CHECKS020 R2
                    WHERE (R1.MDL_DEFINE_NM,R1.START_ACTIVE_DATE,NVL(R1.FAC_OP_CD,'__')) IN
                          ( SELECT MDL_DEFINE_NM, MIN(START_ACTIVE_DATE), NVL(FAC_OP_CD,'__')
                            FROM TB_M00_INTERFACE_CHECKS010 R4
                            WHERE R4.MDL_DEFINE_NM=?
                              AND (R4.FAC_OP_CD=? OR R4.FAC_OP_CD IS NULL OR R4.FAC_OP_CD='')
                              AND R4.END_ACTIVE_DATE>CURRENT_TIMESTAMP
                            GROUP BY R4.MDL_DEFINE_NM,R4.FAC_OP_CD)
                      AND R1.MDL_DEFINE_ID=R2.MDL_DEFINE_ID ) B ON A.DT_NM_ID=B.DT_NM_ID AND A.MDL_DEFINE_DT_NM_SEQ=B.MDL_DEFINE_DT_NM_SEQ
WHERE A.MDL_DEFINE_ID=?
ORDER BY A.MDL_DEFINE_DT_NM_SEQ
		 ]]> 
	 </query>
	 <query id="m000204030.selTCErrorCheckInfoVO" desc="인터페이스점검기준(DB2/Oracle)" fetchSize="10">
		 <![CDATA[ 
SELECT
  R1.MDL_DEFINE_ID,
  R1.MDL_DEFINE_NM,
  R1.FAC_OP_CD,
  R1.CATEGORY_GROUP_NM,
  R2.MDL_DEFINE_DT_NM_SEQ, 
  R2.DT_NM_ID,
  R2.STANDARD_KOREAN_NAME,
  R2.STANDARD_ENGLISH_ID,
  R2.MDL_DEFINE_DT_NM_DATA_TP, 
  R2.MDL_DEFINE_DT_NM_LEN, 
  R2.MD_RULE_DT_NM_DETAIL_OPER_TYPE, 
  decode(R2.MDL_DEFINE_DT_NM_DATA_TP,1,'VARCHAR',2,'NUMBER',3,'DATE',4,'CHAR',5,'TIMESTAMP',6,'ARRAY') DATA_TP,
  DECODE(R2.MD_RULE_DT_NM_COMP_CHK_V_APP_F,'G','Y','B','Y','') as BR,
  DECODE(R2.MD_RULE_DT_NM_COMP_CHK_V_APP_F,'G','Y','T','Y','') as TC,
  R2.MD_RULE_DT_NM_CD_F, 
  R3.MD_RULE_CHK_OLSTATR_1, 
  R3.MD_RULE_CHK_MI_V_1, 
  R3.MD_RULE_CHK_MAX_V_1, 
  R3.MD_RULE_CHK_OLSTATR_2,
  R3.MD_RULE_CHK_MI_V_2, 
  R3.MD_RULE_CHK_MAX_V_2, 
  R3.MD_RULE_DT_NM_TRUE_BAS,
  R3.MD_RULE_DT_NM_BAS_CHK_SEQ
FROM TB_M00_INTERFACE_CHECKS010 R1
  INNER JOIN TB_M00_INTERFACE_CHECKS020 R2 ON R2.MDL_DEFINE_ID=R1.MDL_DEFINE_ID
  LEFT OUTER JOIN TB_M00_INTERFACE_CHECKS030 R3 ON R2.MDL_DEFINE_ID=R3.MDL_DEFINE_ID AND R2.DT_NM_ID=R3.DT_NM_ID
WHERE (R1.MDL_DEFINE_NM,R1.START_ACTIVE_DATE,NVL(R1.FAC_OP_CD,'__')) IN
    ( SELECT MDL_DEFINE_NM,MIN(START_ACTIVE_DATE),NVL(FAC_OP_CD,'__')
      FROM TB_M00_INTERFACE_CHECKS010
      WHERE MDL_DEFINE_NM=?
        AND (FAC_OP_CD=? OR FAC_OP_CD IS NULL)
        AND END_ACTIVE_DATE>CURRENT_TIMESTAMP
      GROUP BY MDL_DEFINE_NM,FAC_OP_CD) 
ORDER BY R2.MDL_DEFINE_DT_NM_SEQ,MD_RULE_DT_NM_BAS_CHK_SEQ
		 ]]> 
	 </query>
</queryMap>
