<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd">
<web-app>
    <description>Glue Master Data Management Web Application</description>
    <servlet>
        <servlet-name>startupservlet</servlet-name>
        <servlet-class>com.poscoict.glue.master.web.servlet.GlueMasterStartupServlet</servlet-class>
        <init-param>
            <param-name>SystemPropertyName</param-name>
            <param-value>GlueMaster.log4j.configuration</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet>
        <servlet-name>reload.admin</servlet-name>
        <servlet-class>com.poscoict.glue.master.web.servlet.GlueMasterUtilServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>reload.admin</servlet-name>
        <url-pattern>/reload.admin</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>adduser.admin</servlet-name>
        <servlet-class>com.poscoict.glue.master.web.servlet.GlueMasterUtilServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>adduser.admin</servlet-name>
        <url-pattern>/adduser.admin</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>action</servlet-name>
        <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
        <init-param>
            <param-name>config</param-name>
            <param-value>/WEB-INF/struts-config.xml</param-value>
        </init-param>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>action</servlet-name>
        <url-pattern>*.do</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>35</session-timeout>
    </session-config>
    <mime-mapping>
        <extension>html</extension>
        <mime-type>text/html</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>txt</extension>
        <mime-type>text/plain</mime-type>
    </mime-mapping>
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- the filters are called in the sequence listed in this file. -->
    <!-- Encoding Filter -->
    <filter>
        <filter-name>Set Character Encoding</filter-name>
        <filter-class>com.posdata.glue.web.PosCharacterEncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>Set Character Encoding</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Glue Secirity Filter -->
    <filter>
        <filter-name>GlueMasterSecurityFilter</filter-name>
        <filter-class>com.poscoict.glue.master.web.GlueMasterSecurityFilter</filter-class>
        <init-param>
            <param-name>login-type</param-name>
            <param-value>login</param-value>
        </init-param>
        <init-param>
            <param-name>login-id-name</param-name>
            <param-value>hidden_id</param-value>
        </init-param>
        <init-param>
            <param-name>login-pw-name</param-name>
            <param-value>hidden_password</param-value>
        </init-param>
        <init-param>
            <param-name>check-request</param-name>
            <param-value>false</param-value>
        </init-param>
        <init-param>
            <param-name>login-page</param-name>
            <param-value>login_gsm.jsp</param-value>
        </init-param>
        <init-param>
            <param-name>lazy-loading</param-name>
            <param-value>true</param-value>
        </init-param>
        <init-param>
            <param-name>exclude-url-patterns</param-name>
            <param-value>login_encrypt_password.jsp,menu.do</param-value>
        </init-param>
        <init-param>
            <param-name>use-service-id</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>GlueMasterSecurityFilter</filter-name>
        <url-pattern>*.do</url-pattern>
    </filter-mapping>
</web-app>