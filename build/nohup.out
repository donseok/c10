      FROM TB_M00_DEFINES010
    ) RULE_LIST
WHERE SYSDATE>=START_ACTIVE_DATE
  AND SYSDATE<END_ACTIVE_DATE
  AND ACCORD_DATA_CONFIRM_DEST_FLAG='Y'
  AND MASTER_DATA_PRC_TP IN ('1A0','1A1','1A2','1B0')
]
