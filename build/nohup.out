          ,(SLIT_GRP_CNT                  --Slit조수
           ,MIX_WTH1                      --조합폭1
           ,MIX_WTH2                      --조합폭2
           ,MIX_WTH3	                  --조합폭3
           ,MIX_WTH4                      --조합폭4
           ,MIX_WTH5	                  --조합폭5
           ,MIX_WTH6                      --조합폭6
           ,MIX_WTH7	                  --조합폭7
           ,MIX_WTH8	                  --조합폭8
           ,MIX_WTH9	                  --조합폭9
           ,MIX_WTH10	                  --조합폭10
           ,PRD_WTH_RNG_LLV               --제품폭범위하한값
           ,PRD_WTH_RNG_ULV               --제품폭범위상한값
           ,COR_WTH_TRV                   --정전폭목표값
           ,CCL_WTH_TRV                   --CCL폭목표값
           ,MID_COR_WTH_TRV) =            --중간정전폭목표값
                               (select SLIT_GRP_CNT                  --Slit조수
                                       ,MIX_WTH1                      --조합폭1
