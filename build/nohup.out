  TbM00Rules050.MD_RULE_DT_NM_CONNECT_CHK_NO,
  TbM00Rules050.MD_RULE_DT_NM_CONNECT_CHK_TPSD,
  TbM00Rules050.MD_RULE_DECISION_RST1,
  TbM00Rules050.MD_RULE_DECISION_RST2,
  TbM00Rules050.MD_RULE_DECISION_RST3,
  TbM00Rules050.ACTION_TYPE,
  TbM00Rules050.MD_RULE_CON_DO_SEQ,
  TbM00Rules010.MES_UNIT_OF_MEASURE
FROM TB_M00_RULES010 TbM00Rules010
  LEFT OUTER JOIN (SELECT * FROM TB_M00_RULES050 WHERE MD_RULE_DT_NM_CONNECT_CHK_NO>0 )TbM00Rules050 ON TbM00Rules010.MD_RULE_ID=TbM00Rules050.MD_RULE_ID
WHERE TbM00Rules010.MD_RULE_ID=?]
