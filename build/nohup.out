SELECT /* rule.list.select */ RULE_LIST.*,
  TO_CHAR(RULE_LIST.START_ACTIVE_DATE, 'YYYYMMDDHH24MISS') START_ACTIVE_DATE_STR,
  NVL(TO_CHAR(RULE_LIST.END_ACTIVE_DATE, 'YYYYMMDDHH24MISS'), '29991231235959') END_ACTIVE_DATE_STR
FROM( SELECT MASTER_DATA_PRC_TP, START_ACTIVE_DATE, END_ACTIVE_DATE, ACCORD_DATA_CONFIRM_DEST_FLAG, MD_RULE_NM AS RULE_NM
      FROM TB_M00_RULES010
      UNION
      SELECT MASTER_DATA_PRC_TP, START_ACTIVE_DATE, END_ACTIVE_DATE, ACCORD_DATA_CONFIRM_DEST_FLAG, MDL_DEFINE_NM AS RULE_NM
      FROM TB_M00_DEFINES010
    ) RULE_LIST
WHERE SYSDATE>=START_ACTIVE_DATE
  AND SYSDATE<END_ACTIVE_DATE
  AND ACCORD_DATA_CONFIRM_DEST_FLAG='Y'
  AND MASTER_DATA_PRC_TP IN ('1A0','1A1','1A2','1B0')
]
