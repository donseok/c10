<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration xmlns:log4j='http://jakarta.apache.org/log4j/'>
    <appender name="CONSOLE" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern"
                value = "%d %-5p - [%t]%C||%m%n"/>
                <!--value="%p - %C{1}.%M(%L) | %m%n"/>-->
        </layout>
    </appender>
 
     <!-- 분단위 -->
	 <appender name="FILEAPPENDER" class="org.apache.log4j.DailyRollingFileAppender">
	   <param name="datePattern" value="yyyy-MM-dd-HH-mm"/>
	   <param name="file" value="../../../LOG/log4j/C10/c10.log"/>
	   <layout class="org.apache.log4j.PatternLayout">
	     <param name="ConversionPattern" value="[%d{yyyy-MM-dd HH:mm:ss, SSS}] %-6p [%t] - %C{1}.%M(%L) | %m%n"/>
	   </layout>
	 </appender> 

	<appender name="ServiceLoggerApppender" class="com.poscoict.glue.log4j.JNDIAppender">
	   <param name="jndiName" value="jdbc/rw/M90DS"/>
	   <param name="sql" value="INSERT INTO M90APUSER.TB_M90_SERVICE_LOG (SERVICE_EXE_DT, SERVICE_ID, ACTOR, FLAG, INPUT, ERROR_TRACE, ERROR_MESSAGE, EXECUTION_DATE ) VALUES ( ?, ?, ?, ?, ?, ?, ?, SYSDATE)"/>
	   <param name="params" value="@SEQ,ProgramId,USER_ID,#success,@NULL,@ERROR_TRACE,@ERROR_MESSAGE"/>
	 </appender>

	<appender name="MsgLoggerApppender" class="com.poscoict.glue.log4j.JNDIAppender">
	   <param name="jndiName" value="jdbc/rw/M90DS"/>
	   <param name="sql" value="INSERT INTO TB_M90_MSG_LOG (MSG_GEN_DT, MSG, MSG_TYPE, MSG_ID, MODULE_TYPE, SENDER, RECEIVER ) VALUES (?,?,?,?,?,?,?)"/>
	   <param name="params" value="@SEQ,MSG,MSG_TYPE,MSG_ID,MODULE_TYPE,SENDER,RECEIVER"/>
	 </appender>
	 
	 <appender name="ErrorMsgLoggerApppender" class="com.poscoict.glue.log4j.JNDIAppender">
	   <param name="jndiName" value="jdbc/rw/M90DS"/>
	   <param name="sql" value="INSERT INTO TB_M90_MSG_ERROR (MSG_GEN_DT, MSG_ID, MSG, MSG_TYPE, MODULE_TYPE, SENDER, RECEIVER, ERROR_ACTIVITY_NAME, ERROR_CODE, ERROR_CONTENT, OCCUR_DATE) VALUES (?,?,?,?,?,?,?,?,?,?,SYSDATE)"/>
	   <param name="params" value="@SEQ,MSG_ID,MSG,MSG_TYPE,MODULE_TYPE,SENDER,RECEIVER,ERROR_ACTIVITY_NAME,ERROR_CODE,ERROR_CONTENT"/>
	 </appender>
	 
	 <logger name="serviceLogger">
	   <level value="debug"/>
	   <appender-ref ref="ServiceLoggerApppender"/> 
	 </logger>	 
	 
	 <logger name="msgLogger">
	   <level value="debug"/>
	   <appender-ref ref="MsgLoggerApppender"/> 
	 </logger>
	 
	 <logger name="errorMsgLogger">
	   <level value="debug"/>
	   <appender-ref ref="ErrorMsgLoggerApppender"/> 
	 </logger>

    <logger name="org.apache">
        <level value="warn"/>
    </logger>

    <logger name="org.springframework">
        <level value="warn"/>
    </logger>

    <logger name="com.posdata">
        <level value="debug"/>
    </logger>
    
    <logger name="com.unionsteel">
        <level value="debug"/>
    </logger>

    <logger name="org.acegisecurity">
        <level value="warn"/>
    </logger>

    <root>
        <level value="info"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILEAPPENDER"/>
    </root>
</log4j:configuration>