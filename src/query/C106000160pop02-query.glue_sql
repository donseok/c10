<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000160pop02-query.glue_sql"> 
	 <query id="C106000160pop02_Grid_1.select" desc="C106000160pop02 정보 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C106000160pop02   키워드파일 조회   C106000160pop02_Grid_1.select  이돈석  */
       KEY_WRD_NO,
       KEY_WRD_SEQ_NO,
       SEQ_NO,
       DECODE(IMG_RGS_TP,'2','모바일','PC') IMG_RGS_TP,
       IMG_ADR,
       IMG_NM,
       TO_CHAR(KEY_WRD_RGS_DH,'YYYY-MM-DD') KEY_WRD_RGS_DH,
       KEY_WRD_RGS_PRS_ID,
       IMG_NM CHK_IMG_NM,
       './'||REPLACE(SUBSTR(IMG_ADR, instr(IMG_ADR, 'IMG_UPLOAD')), '\', '/')||'/' CHK_IMG_ADR,
       (SELECT KEY_WRD FROM TB_C10_KEY_WRD_MNG WHERE KEY_WRD_NO = :KEY_WRD_NO AND KEY_WRD_SEQ_NO = :KEY_WRD_SEQ_NO) KEY_WRD
FROM TB_C10_KEY_WRD
WHERE KEY_WRD_NO = :KEY_WRD_NO
AND KEY_WRD_SEQ_NO = :KEY_WRD_SEQ_NO
AND PRD_SPC_TP = '8'
ORDER BY KEY_WRD_NO, KEY_WRD_SEQ_NO, SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000160pop02.insert" desc="키워드파일 업로드" isNamed="true">
		 <![CDATA[ 
INSERT /* C106000160pop02   키워드이미지 업로드  C106000160pop02.insert  이돈석  */
INTO TB_C10_KEY_WRD (
    KEY_WRD_NO,
	KEY_WRD_SEQ_NO,
	SEQ_NO,
	IMG_RGS_TP,
	IMG_ADR,
	IMG_NM,
	KEY_WRD_RGS_DH,
	KEY_WRD_RGS_PRS_ID,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP,
    PRD_SPC_TP)
VALUES (
    :IMG_RGS_FLAG_ID, 
    :IMG_RGS_FLAG_ID2, 
    (SELECT NVL(MAX(SEQ_NO),0)+1 FROM TB_C10_KEY_WRD WHERE KEY_WRD_NO = :IMG_RGS_FLAG_ID AND KEY_WRD_SEQ_NO = :IMG_RGS_FLAG_ID2), 
    :IMG_RGS_TP, 
    :FILE_ADDR,
    :FILE_NAME,  
    SYSDATE, 
    :ObjectId,
    'C',
    :ObjectId,
    'C106000160pop02',
    SYSTIMESTAMP,
    'C',
    :ObjectId,
    'C106000160pop02',
    SYSTIMESTAMP,
    :PRD_SPC_TP)
		 ]]> 
	 </query>
	 <query id="C106000160pop02.delete" desc="키워드 파일 삭제" isNamed="true">
		 <![CDATA[ 
DELETE  /* C106000160pop02   키워드 파일 삭제  C106000160pop02.delete  이돈석  */
TB_C10_KEY_WRD
WHERE  KEY_WRD_NO = :IMG_RGS_FLAG_ID
AND KEY_WRD_SEQ_NO =  :IMG_RGS_FLAG_ID2
AND SEQ_NO = :SEQ
		 ]]> 
	 </query>
	 <query id="C106000160pop02.update" desc="키워드 파일 등록여부 yn" isNamed="true">
		 <![CDATA[ 
UPDATE  /* C106000160pop02   키워드 파일 등록여부 yn  C106000160pop02.update  이돈석  */
TB_C10_KEY_WRD_MNG
SET KFILE_YN = DECODE((SELECT COUNT(IMG_NM) CNT
                FROM   TB_C10_KEY_WRD
                WHERE  KEY_WRD_NO = :IMG_RGS_FLAG_ID
                AND    KEY_WRD_SEQ_NO = :IMG_RGS_FLAG_ID2
                AND    PRD_SPC_TP = '8'), 0, 'N', 'Y' ) ,
         LAST_UPDATED_OBJECT_TYPE = :ObjectType,
         LAST_UPDATED_OBJECT_ID = :ObjectId,
         LAST_UPDATE_PROGRAM_ID = :ProgramId,
         LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE  KEY_WRD_NO = :IMG_RGS_FLAG_ID
AND    KEY_WRD_SEQ_NO = :IMG_RGS_FLAG_ID2
		 ]]> 
	 </query>
</queryMap>
