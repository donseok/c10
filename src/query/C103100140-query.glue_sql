<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C103100140"> 
	 <query id="C103100040.insert" desc="품질설계결과ERR insert" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT INTO /*+ C10 품질설계결과ERR C103100140.INSERT 김종범*/                                 
TB_C10_QLT_DSN_ERR (                                                                           
                     ORD_NO                    --주문번호          
                    ,ORD_LN                    --주문행번          
                    ,QLT_DSN_ERR_CD            --품질설계에러코드  
                    ,QLT_DSN_ERR_DD   --품질설계에러발생일 QLT_DSN_ERR_DD
                    ,CREATED_OBJECT_TYPE       --생성OBJECT유형    
                    ,CREATED_OBJECT_ID         --생성OBJECTID      
                    ,CREATED_PROGRAM_ID        --생성프로그램ID    
                    ,CREATION_TIMESTAMP        --생성일시          
                    ,LAST_UPDATED_OBJECT_TYPE  --최종변경OBJECT유형
                    ,LAST_UPDATED_OBJECT_ID    --최종변경OBJECTID  
                    ,LAST_UPDATE_PROGRAM_ID    --최종변경프로그램ID
                    ,LAST_UPDATE_TIMESTAMP     --최종변경일시      
)                                                                                              
VALUES 
(                                                                                       
?,?,?,TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS'),
?,?,?,?,                                              
?,?,?,?                                              
)
		 ]]> 
	 </query>
	 <query id="C103100140.select" desc="TB_C10_QLT_DSN_ERR 중복체크 SELECT" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과ERR_CHK C103100140.SELECT 김종범*/                                 
       ORD_NO                    --주문번호          
      ,ORD_LN                    --주문행번          
      ,QLT_DSN_ERR_CD            --품질설계에러코드       
  FROM TB_C10_QLT_DSN_ERR
 WHERE ORD_NO = ?
   AND ORD_LN =?
   AND QLT_DSN_ERR_CD =?
		 ]]> 
	 </query>
	 <query id="C103100140.delete" desc="C103100140.delete" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과에러 삭제 C103100140.delete 박재영*/                                 
  FROM TB_C10_QLT_DSN_ERR
 WHERE ORD_NO = ?
   AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C103100140.chkINSERT" desc="C103100140.chkINSERT" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT INTO /*+ C10 데이터이행결과ERR C103100140.chkINSERT 김종범*/                                 
TB_C10_QLT_IMP_CHK (                                                                           
                     ORD_NO                    --주문번호          
                    ,ORD_LN                     --주문행번          
                    ,ORD_ERR_TXT	           --주문에러내용
                    ,CREATED_OBJECT_TYPE       --생성OBJECT유형    
                    ,CREATED_OBJECT_ID         --생성OBJECTID      
                    ,CREATED_PROGRAM_ID        --생성프로그램ID    
                    ,CREATION_TIMESTAMP        --생성일시          
                    ,LAST_UPDATED_OBJECT_TYPE  --최종변경OBJECT유형
                    ,LAST_UPDATED_OBJECT_ID    --최종변경OBJECTID  
                    ,LAST_UPDATE_PROGRAM_ID    --최종변경프로그램ID
                    ,LAST_UPDATE_TIMESTAMP     --최종변경일시      
)                                                                                              
VALUES 
(                                                                                       
?,?,(CASE WHEN LENGTHB(?) >1000 THEN substrb(?,1,1000) ELSE ? END),
?,?,?,?,                                              
?,?,?,?                                              
)
		 ]]> 
	 </query>
</queryMap>
