<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000150 Page 쿼리파일"> 
	 <query id="C106000150.CLRselect" desc="칼라코드 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
/* C106000150   칼라코드조회  C106000150.CLRselect  이돈석 */
SELECT CLR_SUB_MTL_CD,
       CLR_NM,
       DECODE(USE_YN,'1','Y','N') AS USE_YN,
       PNT_CMP_CD,
       PNT_CMP_NM,
       DECODE( DOC_YN,'1','Y','N') AS DOC_YN,
       NVL(CUR_QTY,0) AS CUR_QTY
  FROM (
SELECT /*+ parallel(A, 8) */
       A.CLR_SUB_MTL_CD, --칼라부재료코드
       A.CLR_NM, --색상명
       DECODE(B.USE_YN,'Y','1','N','0') AS USE_YN,--사용여부
       PNT_CMP_CD,--도료업체코드
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PNT_CMP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PNT_CMP_CD) PNT_CMP_NM,--도료업체코드(마스터)
       (SELECT (CASE WHEN COUNT(1) > 0 THEN '1'
                     ELSE '0' END)
          FROM C10APUSER.TB_C10_CLR_CMP_MNG_FILE
         WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD
           AND PNT_CMP_CD = B.PNT_CMP_CD) DOC_YN,
       (SELECT NVL(SUM(CUR_QTY),0)
          FROM  MESAPUSER.VI_M30_SMTL_MASTER
         WHERE SMTL_PRG_CD = 'C'
           AND SMTL_CLR_CD  = B.CLR_SUB_MTL_CD
           AND SMTL_SLP_CD = B.PNT_CMP_CD ) AS CUR_QTY
 FROM TB_C10_CLR_CD_MNG  A,
      TB_C10_CLR_CMP_MNG B
 WHERE A.CLR_SUB_MTL_CD = B.CLR_SUB_MTL_CD 
   AND B.CLR_SUB_MTL_CD LIKE NVL(:FIND_CD||'%','%')
)
 WHERE NVL(DOC_YN,'@') LIKE DECODE(:DOC_YN,'1','1','')||'%'
    AND NVL(USE_YN,'@') LIKE DECODE(:USE_YN,'1','1','')||'%'
    AND ((:CUR_TP = '1' AND NVL(CUR_QTY,0) > 0) OR (:CUR_TP = '0' AND NVL(CUR_QTY,0) >= 0))
		 ]]> 
	 </query>
	 <query id="C106000150_IMG.delete" desc="10" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C106000150   이미지관리테이블 삭제  C106000150_IMG.delete  이돈석 */
FROM TB_C10_DGT_PRT_IMG
WHERE DGT_PRT_IMG_NO = :DGT_PRT_IMG_NO
  AND DGT_PRT_IMG_SEQ_NO = :DGT_PRT_IMG_SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000150_DUMY.select" desc="10" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C106000150   의미없는 쿼리 C106000150_DUMY.select 이돈석 */
1 DUMY
FROM DUAL
		 ]]> 
	 </query>
	 <query id="C106000150_CCLBOMAJAX.select" desc="10" isNamed="true">
		 <![CDATA[ 
SELECT *
FROM TB_C10_CCL_BOM
WHERE CCL_BOM_NO LIKE :CCL_BOM_NO||'%'
		 ]]> 
	 </query>
	 <query id="C106000150.BOMselect" desc="CCLBOM조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
/* C106000150   CCLBOM조회  C106000150.BOMselect  이돈석 */
SELECT CLR_SUB_MTL_CD,
       CLR_NM,
       DECODE(USE_YN,'1','Y','N') AS USE_YN,
       PNT_CMP_CD,
       PNT_CMP_NM,
       DECODE( DOC_YN,'1','Y','N') AS DOC_YN,
       NVL(CUR_QTY,0) AS CUR_QTY
  FROM (
SELECT /*+ parallel(A, 8) */
       A.CLR_SUB_MTL_CD, --칼라부재료코드
       A.CLR_NM, --색상명
       DECODE(B.USE_YN,'Y','1','N','0') AS USE_YN,--사용여부
       PNT_CMP_CD,--도료업체코드
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PNT_CMP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PNT_CMP_CD) PNT_CMP_NM,--도료업체코드(마스터)
       (SELECT (CASE WHEN COUNT(1) > 0 THEN '1'
                     ELSE '0' END)
          FROM C10APUSER.TB_C10_CLR_CMP_MNG_FILE
         WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD
           AND PNT_CMP_CD = B.PNT_CMP_CD) DOC_YN,
       (SELECT NVL(SUM(CUR_QTY),0)
          FROM  MESAPUSER.VI_M30_SMTL_MASTER
         WHERE SMTL_PRG_CD = 'C'
           AND SMTL_CLR_CD  = B.CLR_SUB_MTL_CD
           AND SMTL_SLP_CD = B.PNT_CMP_CD ) AS CUR_QTY
 FROM TB_C10_CLR_CD_MNG  A,
      TB_C10_CLR_CMP_MNG B
 WHERE A.CLR_SUB_MTL_CD = B.CLR_SUB_MTL_CD 
   AND B.CLR_SUB_MTL_CD IN
   (
        SELECT HUE_CD_FRN_1COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_FRN_1COT IS NOT NULL
         UNION
        SELECT HUE_CD_FRN_2COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_FRN_2COT IS NOT NULL
         UNION
        SELECT HUE_CD_FRN_3COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_FRN_3COT IS NOT NULL
         UNION
        SELECT HUE_CD_FRN_4COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_FRN_4COT IS NOT NULL
         UNION
        SELECT HUE_CD_BAK_1COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_BAK_1COT IS NOT NULL 
         UNION
        SELECT HUE_CD_BAK_2COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_BAK_2COT IS NOT NULL 
         UNION
        SELECT HUE_CD_BAK_3COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_BAK_3COT IS NOT NULL
         UNION
        SELECT HUE_CD_BAK_4COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_BAK_4COT IS NOT NULL
         UNION
        SELECT THR_CD_FRN_1COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND THR_CD_FRN_1COT IS NOT NULL
         UNION
        SELECT THR_CD_FRN_2COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND THR_CD_FRN_2COT IS NOT NULL
         UNION
        SELECT THR_CD_FRN_3COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND THR_CD_FRN_3COT IS NOT NULL
         UNION
        SELECT THR_CD_FRN_4COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND THR_CD_FRN_4COT IS NOT NULL
         UNION
        SELECT THR_CD_BAK_1COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND THR_CD_BAK_1COT IS NOT NULL
         UNION
        SELECT THR_CD_BAK_2COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND THR_CD_BAK_2COT IS NOT NULL
         UNION
        SELECT THR_CD_BAK_3COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND THR_CD_BAK_3COT IS NOT NULL
         UNION
        SELECT THR_CD_BAK_4COT AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND THR_CD_BAK_4COT IS NOT NULL
         UNION
        SELECT PRT_INK_CD1 AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND PRT_INK_CD1 IS NOT NULL
         UNION
        SELECT PRT_INK_CD2 AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND PRT_INK_CD2 IS NOT NULL
         UNION
        SELECT PRT_INK_CD3 AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND PRT_INK_CD3 IS NOT NULL
         UNION
        SELECT PRT_INK_CD4 AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND PRT_INK_CD4 IS NOT NULL
         UNION
        SELECT PRT_INK_BAK_CD1 AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND PRT_INK_BAK_CD1 IS NOT NULL
         UNION
        SELECT PRT_INK_BAK_CD2 AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND PRT_INK_BAK_CD2 IS NOT NULL
         UNION
        SELECT PRT_INK_BAK_CD3 AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND PRT_INK_BAK_CD3 IS NOT NULL
         UNION
        SELECT PRT_INK_BAK_CD4 AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND PRT_INK_BAK_CD4 IS NOT NULL
         UNION
        SELECT HUE_CD_CHM AS CLR_SUB_MTL_CD
          FROM TB_C10_CCL_BOM
         WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
           AND HUE_CD_CHM IS NOT NULL
   )
)
 WHERE NVL(DOC_YN,'@') LIKE DECODE(:DOC_YN,'1','1','')||'%'
   AND NVL(USE_YN,'@') LIKE DECODE(:USE_YN,'1','1','')||'%'
   AND ((:CUR_TP = '1' AND NVL(CUR_QTY,0) > 0) OR (:CUR_TP = '0' AND NVL(CUR_QTY,0) >= 0))
		 ]]> 
	 </query>
	 <query id="C106000150.ExcelDown" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
/* C106000150   칼라코드조회  C106000150.ExcelDown  이돈석 */
SELECT CLR_SUB_MTL_CD,
       CLR_NM,
       USE_YN,
       PNT_CMP_CD,
       PNT_CMP_NM,
       DECODE(DOC_YN,'1','Y','N') AS DOC_YN,
       NVL(CUR_QTY,0) AS CUR_QTY
  FROM (
SELECT /*+ parallel(A, 8) */
       A.CLR_SUB_MTL_CD, --칼라부재료코드
       A.CLR_NM, --색상명
       B.USE_YN AS USE_YN,--사용여부
       PNT_CMP_CD,--도료업체코드
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PNT_CMP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PNT_CMP_CD) PNT_CMP_NM,--도료업체코드(마스터)
       (SELECT (CASE WHEN COUNT(1) > 0 THEN '1'
                     ELSE '0' END)
          FROM C10APUSER.TB_C10_CLR_CMP_MNG_FILE
         WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD
           AND PNT_CMP_CD = B.PNT_CMP_CD) DOC_YN,
       (SELECT NVL(SUM(CUR_QTY),0)
          FROM  MESAPUSER.VI_M30_SMTL_MASTER
         WHERE SMTL_PRG_CD = 'C'
           AND SMTL_CLR_CD  = B.CLR_SUB_MTL_CD
           AND SMTL_SLP_CD = B.PNT_CMP_CD ) AS CUR_QTY
 FROM TB_C10_CLR_CD_MNG  A,
      TB_C10_CLR_CMP_MNG B
 WHERE A.CLR_SUB_MTL_CD = B.CLR_SUB_MTL_CD
)
 WHERE NVL(DOC_YN,'0') = '0'
   AND NVL(USE_YN,'N') = 'Y'
   AND NVL(CUR_QTY,0) > 0
		 ]]> 
	 </query>
</queryMap>
