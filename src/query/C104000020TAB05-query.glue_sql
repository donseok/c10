<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000020TAB05"> 
	 <query id="C104000020TAB05_RMT.select" desc="원자재조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C10 품질설계결과-제조표준1(C104000020TAB05) C104000020TAB05_RMT.select  박재영 */
     A.ORD_NO--주문번호
    ,A.ORD_LN--주문행번
    ,A.QLT_DSN_MNF_TP--품질설계제조구분
    ,(SELECT A.RMTL_CD || ' - ' || CD_V_MEANING 
     FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'RMTL_CD'         
     AND   CATEGORY_GROUP_NM = 'SZ0000'
     AND   CD_V = A.RMTL_CD) AS RMTL_CD
    ,(SELECT A.RMTL_GRD || ' - ' || CD_V_MEANING 
     FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'RMTL_GRD'         
     AND   CATEGORY_GROUP_NM = 'SZ0000'
     AND   CD_V = A.RMTL_GRD) AS RMTL_GRD 
    ,A.RMTL_TAR_THK      --원자재목표두께
    ,A.RMTL_TAR_WTH      --원자재목표폭
    ,A.RMTL_TAR_THK_LVL  --원자재목표두께하한
    ,A.RMTL_TAR_THK_UVL  --원자재목표두께상한
    ,A.RMTL_TAR_WTH_LVL  --원자재목표폭하한
    ,A.RMTL_TAR_WTH_UVL  --원자재목표폭상한
    ,NVL(A.RMTL_TAR_THK_LVL_STD,A.RMTL_TAR_THK_LVL) AS RMTL_TAR_THK_LVL_STD  --원자재목표두께하한기준값
    ,NVL(A.RMTL_TAR_THK_UVL_STD,A.RMTL_TAR_THK_UVL) AS RMTL_TAR_THK_UVL_STD  --원자재목표두께상한기준값
    ,NVL(A.RMTL_TAR_WTH_STD,A.RMTL_TAR_WTH) AS RMTL_TAR_WTH_STD  --원자재목표폭기준값
    ,A.RMTL_TAR_THK AS RMTL_TAR_THK_BF     --원자재목표두께변경전값
    ,A.RMTL_TAR_THK_LVL AS RMTL_TAR_THK_LVL_BF --원자재목표두께하한변경전값
    ,A.RMTL_TAR_THK_UVL AS RMTL_TAR_THK_UVL_BF --원자재목표두께상한변경전값
    ,A.RMTL_TAR_WTH AS RMTL_TAR_WTH_BF --원자재목표폭변경전값
FROM
TB_C10_QLT_DSN_RMT A,
TB_C10_QLT_DSN_CMN B
WHERE A.ORD_NO = B.ORD_NO
AND A.ORD_LN = B.ORD_LN
AND A.ORD_NO = :ORD_NO
AND A.ORD_LN = :ORD_LN
AND B.PRD_NM_CD NOT IN ('A','B','C','D','E','1','2','N','8')
ORDER BY A.QLT_DSN_MNF_TP
		 ]]> 
	 </query>
	 <query id="C104000020TAB05_MNF.select" desc="PLTCM/ECL조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C10 품질설계결과-용융도금(제조표준)(C104000020TAB05) C104000020TAB05_MNF.select 박재영 */ 
	A.ORD_NO,--주문번호
	A.ORD_LN,--주문행번
	A.QLT_DSN_MNF_TP,--품질설계제조구분
	A.RMTL_CD,--원자재코드
	A.CRM_MNF_STD_NO,--냉연제조표준번호
	A.PLTCM_5STD_WR_TP,--PLTCM5StandWRType
	A.PLTCM_SLV_USE_YN,--PLTCM내경링사용여부
	A.ECL_CDR_CD,--ECLC-D방지약품
	A.ECL_COILG_TS_CD,--ECL권취장력
	'일반 ANN' FUR_TP_GEN_ANN,
	--A.FUR_TP_GEN_ANN,--일반ANN소둔로유형
	A.HEAT_CYL_NO_GEN_ANN,--일반ANN소둔CYCLE
	A.COR_TM_GEN_ANN,--일반ANN소둔보정시간
	A.COIL_TMP_GEN_ANN,--일반ANN코일온도
	A.CLG_END_TMP_GEN_ANN,--일반ANN냉각종료온도
	'H-C ANN' FUR_TP_HC_ANN,
	--A.FUR_TP_HC_ANN,--HCANN소둔로유형
	A.HEAT_CYL_NO_HC_ANN,--HCANN소둔CYCLE
	A.COR_TM_HC_ANN,--HCANN소둔보정시간
	A.COIL_TMP_HC_ANN,--HCANN코일온도
	A.CLG_END_TMP_HC_ANN,--HCANN냉각종료온도
	A.TM_PASS_CNT,--TMPass수
	A.ROU_RA_LLV,--조도RA하한값
	A.ROU_RA_ULV,--조도RA상한값
	A.ROU_PPI_LLV,--조도PPI하한값
	A.ROU_PPI_ULV,--조도PPI상한값
	A.ROU_R_MAX_LLV,--조도RMAX하한값
	A.HEAT_CYL_NO_2CGL,--소둔CYCLE#2CGL
	A.HTG_TEM_2CGL,--가열온도#2CGL
	A.CLG_TEM_2CGL,--냉각온도#2CGL
	A.SHK_TM_2CGL,--ShockingTime#2CGL
	A.LN_SPD_2CGL,--LineSpeed#2CGL
	A.HEAT_CYL_NO_3CGL,--소둔CYCLE#3CGL
	A.HTG_TEM_3CGL,--가열온도#3CGL
	A.CLG_TEM_3CGL,--냉각온도#3CGL
	A.SHK_TM_3CGL,--ShockingTime#3CGL
	A.LN_SPD_3CGL,--LineSpeed#3CGL
	A.HEAT_CYL_NO_4CGL,--소둔CYCLE#4CGL
	A.HTG_TEM_4CGL,--가열온도#4CGL
	A.CLG_TEM_4CGL,--냉각온도#4CGL
	A.SHK_TM_4CGL,--ShockingTime#4CGL
	A.LN_SPD_4CGL,--LineSpeed#4CGL
	A.HEAT_CYL_NO_5CGL,--소둔CYCLE#5CGL
	A.HTG_TEM_5CGL,--가열온도#5CGL
	A.CLG_TEM_5CGL,--냉각온도#5CGL
	A.SHK_TM_5CGL,--ShockingTime#5CGL
	A.LN_SPD_5CGL,--LineSpeed#5CGL
	A.SPNL_TP ||
        (SELECT ' : ' || CD_V_MEANING
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'ORD_SPNL_TP'
         AND   CD_V = SPNL_TP
         AND   CATEGORY_GROUP_NM = 
        DECODE(B.PRD_NM_CD,'C','SC0000','D','SC0000','G','SG0000','K','SG0000','J','SG0000','L','SL0000','V','SV0000','W','SW0000','SZ0000')) SPNL_TP,--Spangle구분
	A.CGL_LVL_YN,--CGLLeveler사용여부
	A.CGL_SP_ASG_YN,--CGLSkinPass
	A.CGL_SUR_HND_CD ||
    (SELECT ' : ' || CD_V_MEANING FROM M00APUSER.VI_M00_CODE_ACCESS
    WHERE CD_TP = 'ORD_SUR_HND_CD'         
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = A.CGL_SUR_HND_CD) AS CGL_SUR_HND_CD,--CGL표면처리코드     
	A.EGL_SUR_HND_CD,--EGL표면처리코드
	A.RSN_ATT_AMT_TRV,--수지부착량기준목표
	A.RSN_ATT_AMT_LLV,--수지부착량기준하한
	A.RSN_ATT_AMT_ULV,--수지부착량기준상한
	A.WK_GW_TRV,--작업도금량목표값
	A.WK_GW_FRN_LLV,--작업도금량전면하한값
	A.WK_GW_FRN_ULV,--작업도금량전면상한값
	A.WK_GW_BAK_LLV,--작업도금량후면하한값
	A.WK_GW_BAK_ULV,--작업도금량후면상한값
	A.WK_GW_TOT_LLV,--작업도금량전체하한값
	A.WK_GW_TOT_ULV,--작업도금량전체상한값
	A.PIL_DIR,--Piling방향
	A.OIL_PNT_CD,--도유코드
	A.PRD_THK_RNG_LLV,--제품두께범위하한값
	A.PRD_THK_RNG_ULV,--제품두께범위상한값
	A.PRD_WTH_RNG_LLV,--제품폭범위하한값
	A.PRD_WTH_RNG_ULV,--제품폭범위상한값
	A.GAL_THK_LLV,--도금두께하한
	A.GAL_THK_ULV,--도금두께상한
	A.GAL_THK_TRV,--도금두께목표
	A.SPC_GAL_THK,--사양도금두께
	A.COR_THK_TRV,--정전두께목표값
	A.COR_WTH_TRV,--정전폭목표값
	A.SLIT_GRP_CNT,--Slit조수
	A.MIX_WTH1,--조합폭1
	A.MIX_WTH2,--조합폭2
	A.MIX_WTH3,--조합폭3
	A.MIX_WTH4,--조합폭4
	A.MIX_WTH5,--조합폭5
	A.MIX_WTH6,--조합폭6
	A.MIX_WTH7,--조합폭7
	A.MIX_WTH8,--조합폭8
	A.CCL_THK_TRV,--CCL두께목표값
	A.CCL_WTH_TRV,--CCL폭목표값
	A.MID_COR_THK_TRV,--중간정전두께목표값
	A.MID_COR_WTH_TRV,--중간정전폭목표값
	A.CGL_THK_TRV,--CGL두께목표값
	A.CGL_WTH_TRV,--CGL폭목표값
	A.EGL_THK_TRV,--EGL두께목표값
	A.EGL_WTH_TRV,--EGL폭목표값
	A.TM_THK_TRV,--TM두께목표값
	A.TM_WTH_TRV,--TM폭목표값
	A.TM_WTH_SUB_PROC1_TRV,--TM폭대체공정1목표값
	A.TM_WTH_SUB_PROC2_TRV,--TM폭대체공정2목표값
	A.PLTCM_SET_THK_TRV,--PLTCMX-RaySet두께값
	A.PLTCM_THK_TRV,--PLTCM두께목표값
	A.PLTCM_THK_LLV,--PLTCM두께하한값
	A.PLTCM_THK_ULV,--PLTCM두께상한값
	A.PLTCM_WTH_TRV,--PLTCM폭목표값
	A.PLTCM_WTH_SUB_PROC1_TRV,--PLTCM폭대체공정1목표값
	A.PLTCM_WTH_SUB_PROC2_TRV,--PLTCM폭대체공정2목표값
	A.PLTCM_EDG_ASG_TP,--PLTCMEdge지정구분
	A.COR_EDG_ASG_TP,--정전Edge지정구분
	CASE WHEN B.PRD_NM_CD NOT IN ('1','2','3','4','5','6','7','8','9')
			  AND SUBSTR(B.BAK_MRK,0,4) = 'BACK'
		 THEN B.BAK_MRK
		 ELSE '' END	AS BAK_MRK,--TOP/Back마킹
    B.EMBS_CD,--EMBOSS무늬
    PL_WTH_TRV,--PL폭목표값
    PL_WTH_SUB_PROC1_TRV,--PL폭대체공정1목표값
    PL_WTH_SUB_PROC2_TRV,--PL폭대체공정2목표값 
    PL_WTH_TRV - A.PLTCM_WTH_TRV AS NECKING_WTH,
    C10APUSER.FC_NECKING_CAL(A.RMTL_CD,PL_WTH_TRV,A.PLTCM_SET_THK_TRV) AS BIGDATA_NECKING_WTH,
    A.PLTCM_5STD_WR_TP AS PLTCM_5STD_WR_TP_BF,--PLTCM5StandWRType변경이전값(2023.7.27추가)
	A.PLTCM_SLV_USE_YN AS PLTCM_SLV_USE_YN_BF,--PLTCM내경링사용여부변경이전값(2023.7.27추가)
    A.PLTCM_EDG_ASG_TP AS PLTCM_EDG_ASG_TP_BF,--PLTCMEdge지정구분변경이전값(2023.8.3추가)
    A.PL_WTH_TRV           AS PL_WTH_TRV_BF,  
    A.PL_WTH_SUB_PROC1_TRV AS PL_WTH_SUB_PROC1_TRV_BF,
    A.PL_WTH_SUB_PROC2_TRV AS PL_WTH_SUB_PROC2_TRV_BF,
    A.PLTCM_SET_THK_TRV    AS PLTCM_SET_THK_TRV_BF, 
    A.PLTCM_THK_TRV        AS PLTCM_THK_TRV_BF,  
    A.PLTCM_THK_LLV        AS PLTCM_THK_LLV_BF,   
    A.PLTCM_THK_ULV        AS PLTCM_THK_ULV_BF,   
    A.PLTCM_WTH_TRV        AS PLTCM_WTH_TRV_BF,   
    A.PLTCM_WTH_SUB_PROC1_TRV  AS PLTCM_WTH_SUB_PROC1_TRV_BF,  
    A.PLTCM_WTH_SUB_PROC2_TRV  AS PLTCM_WTH_SUB_PROC2_TRV_BF,  
    A.HEAT_CYL_NO_2CGL     AS HEAT_CYL_NO_2CGL_BF,   
    A.HTG_TEM_2CGL   AS HTG_TEM_2CGL_BF,   
    A.CLG_TEM_2CGL   AS CLG_TEM_2CGL_BF,   
    A.SHK_TM_2CGL    AS SHK_TM_2CGL_BF,   
    A.LN_SPD_2CGL    AS LN_SPD_2CGL_BF,   
    A.HEAT_CYL_NO_3CGL   AS HEAT_CYL_NO_3CGL_BF,   
    A.HTG_TEM_3CGL   AS HTG_TEM_3CGL_BF,   
    A.CLG_TEM_3CGL   AS CLG_TEM_3CGL_BF,   
    A.SHK_TM_3CGL    AS SHK_TM_3CGL_BF,   
    A.LN_SPD_3CGL    AS LN_SPD_3CGL_BF,   
    A.HEAT_CYL_NO_4CGL   AS HEAT_CYL_NO_4CGL_BF,   
    A.HTG_TEM_4CGL   AS HTG_TEM_4CGL_BF,   
    A.CLG_TEM_4CGL   AS CLG_TEM_4CGL_BF,   
    A.SHK_TM_4CGL    AS SHK_TM_4CGL_BF,   
    A.LN_SPD_4CGL    AS LN_SPD_4CGL_BF,   
    A.HEAT_CYL_NO_5CGL AS HEAT_CYL_NO_5CGL_BF, 
    A.HTG_TEM_5CGL   AS HTG_TEM_5CGL_BF,   
    A.CLG_TEM_5CGL   AS CLG_TEM_5CGL_BF,   
    A.SHK_TM_5CGL    AS SHK_TM_5CGL_BF,   
    A.LN_SPD_5CGL    AS LN_SPD_5CGL_BF,   
    A.WK_GW_TOT_LLV   AS WK_GW_TOT_LLV_BF,   
    A.WK_GW_TOT_ULV   AS WK_GW_TOT_ULV_BF,   
    A.WK_GW_TRV     AS WK_GW_TRV_BF,   
    A.GAL_THK_TRV   AS GAL_THK_TRV_BF,   
    A.CGL_LVL_YN   AS CGL_LVL_YN_BF,   
    A.RSN_ATT_AMT_TRV   AS RSN_ATT_AMT_TRV_BF,   
    A.RSN_ATT_AMT_LLV   AS RSN_ATT_AMT_LLV_BF,   
    A.RSN_ATT_AMT_ULV   AS RSN_ATT_AMT_ULV_BF,   
    A.COR_THK_TRV   AS COR_THK_TRV_BF,  
    A.COR_WTH_TRV AS COR_WTH_TRV_BF
FROM TB_C10_QLT_DSN_MNF A, 
     TB_C10_QLT_DSN_CMN B
WHERE    A.ORD_NO = B.ORD_NO
AND      A.ORD_LN = B.ORD_LN
AND      A.ORD_NO = :ORD_NO
AND      A.ORD_LN = :ORD_LN
AND      A.QLT_DSN_MNF_TP = :QLT_DSN_MNF_TP
AND      B.PRD_NM_CD NOT IN ('A','B','C','D','E','1','2','N','8')
		 ]]> 
	 </query>
	 <query id="C104000020TAB05_MSG.select" desc="품질메세지조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-용융도금(제조표준)(C104000020TAB05)  C104000020TAB05_MSG.SELECT  박재영 */
       ORD_NO,--주문번호
       ORD_LN,--주문행번
       QLT_DSN_MNF_TP,--품질설계제조구분
       QLT_MSG_NM--품질MESSAGE
FROM   TB_C10_QLT_DSN_MSG A
WHERE  ORD_NO = :ORD_NO
AND    ORD_LN = :ORD_LN
AND    QLT_DSN_MNF_TP = :QLT_DSN_MNF_TP
		 ]]> 
	 </query>
	 <query id="C104000020TAB05.RMTupdate" desc="C104000020TAB05.RMTupdate" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 용융도금-제조표준 C104000020TAB05.RMTupdate 박재영*/                      
TB_C10_QLT_DSN_RMT
SET    
       LAST_UPDATED_OBJECT_TYPE = :ObjectType   --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = :ObjectId           --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = :ProgramId      --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = :Timestamp        --최종변경일시
      ,RMTL_CD	= SUBSTR(:RMTL_CD,1,3)                                 --원자재코드
      ,RMTL_GRD = SUBSTR(:RMTL_GRD,1,1)                              --원자재등급    
      ,RMTL_TAR_THK = :RMTL_TAR_THK                  --원자재목표두께
      ,RMTL_TAR_WTH = :RMTL_TAR_WTH                --원자재목표폭
      ,RMTL_TAR_THK_LVL = :RMTL_TAR_THK_LVL      --원자재목표두께하한
      ,RMTL_TAR_THK_UVL	= :RMTL_TAR_THK_UVL      --원자재목표두께상한
      ,RMTL_TAR_THK_LVL_STD = :RMTL_TAR_THK_LVL_STD  --원자재목표두께하한기준값
      ,RMTL_TAR_THK_UVL_STD = :RMTL_TAR_THK_UVL_STD  --원자재목표두께상한기준값
      ,RMTL_TAR_WTH_STD = :RMTL_TAR_WTH_STD          --원자재목표폭기준값
WHERE ORD_NO = :ORD_NO                                 --주문번호                                                                                      
  AND ORD_LN = :ORD_LN                                    --주문행번
  AND QLT_DSN_MNF_TP = :QLT_DSN_MNF_TP         --품질설계제조구분
		 ]]> 
	 </query>
	 <query id="C104000020TAB05.PLTCMupdate" desc="C104000020TAB05.PLTCMupdate" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 용융도금-제조표준 C104000020TAB05.PLTCMupdate 박재영*/                      
TB_C10_QLT_DSN_MNF
SET    
       LAST_UPDATED_OBJECT_TYPE = :ObjectType     --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = :ObjectId             --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = :ProgramId         --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = :Timestamp          --최종변경일시    
      ,PLTCM_5STD_WR_TP = :PLTCM_5STD_WR_TP     --PLTCM5StandWRType
      ,PLTCM_SLV_USE_YN = :PLTCM_SLV_USE_YN      --PLTCM내경링사용여부
      ,PLTCM_EDG_ASG_TP = :PLTCM_EDG_ASG_TP      --PLTCMEdge지정구분
      ,PLTCM_SET_THK_TRV = :PLTCM_SET_THK_TRV     --PLTCMX-RaySet두께값
      ,PL_WTH_TRV = :PL_WTH_TRV                                            --PL폭목표값
      ,PL_WTH_SUB_PROC1_TRV = :PL_WTH_SUB_PROC1_TRV         --PL폭대체공정1목표값
      ,PL_WTH_SUB_PROC2_TRV = :PL_WTH_SUB_PROC2_TRV         --PL폭대체공정2목표값
      ,PLTCM_THK_TRV = :PLTCM_THK_TRV                 --PLTCM두께목표값
      ,PLTCM_THK_LLV = :PLTCM_THK_LLV                  --PLTCM두께하한값
      ,PLTCM_THK_ULV = :PLTCM_THK_ULV                 --PLTCM두께상한값
      ,PLTCM_WTH_TRV = :PLTCM_WTH_TRV                --PLTCM폭목표값
      ,PLTCM_WTH_SUB_PROC1_TRV = :PLTCM_WTH_SUB_PROC1_TRV        --PLTCM폭대체공정1목표값
      ,PLTCM_WTH_SUB_PROC2_TRV = :PLTCM_WTH_SUB_PROC2_TRV        --PLTCM폭대체공정2목표값
WHERE ORD_NO = :ORD_NO                                  --주문번호                                                                                      
  AND ORD_LN = :ORD_LN                                     --주문행번
  AND QLT_DSN_MNF_TP = :QLT_DSN_MNF_TP          --품질설계제조구분
		 ]]> 
	 </query>
