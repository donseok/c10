	 <query id="C104000020TAB05.STSselect" desc="C104000020TAB05.STSselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C104000020TAB05.STSselect 박재영*/      
*                               
 FROM TB_C10_QLT_DSN_CMN
 WHERE ORD_NO = :ORD_NO
 AND    ORD_LN = :ORD_LN
 AND    QLT_DSN_STS_CD = 'A'
		 ]]> 
	 </query>
	 <query id="C104000020TAB05.CHG_HSTinsert" desc="C104000020TAB05.CHG_HSTinsert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 품질설계결과수정이력 C104000020TAB05.CHG_HSTinsert 박재영*/
            TB_C10_QLT_DSN_CHG_HST
            (    
              ORD_NO                      --주문번호
		     ,ORD_LN                      --주문행번
		     ,SEQ	                      --수정SEQ
		     ,CHG_TXT                     --수정내역
             ,CREATED_OBJECT_TYPE
             ,CREATED_OBJECT_ID
             ,CREATED_PROGRAM_ID
             ,CREATION_TIMESTAMP
             ,LAST_UPDATED_OBJECT_TYPE
             ,LAST_UPDATED_OBJECT_ID
             ,LAST_UPDATE_PROGRAM_ID
             ,LAST_UPDATE_TIMESTAMP
            )
VALUES
            (
              :ORD_NO
              ,:ORD_LN 
              ,NVL((SELECT MAX(SEQ) + 1 FROM TB_C10_QLT_DSN_CHG_HST WHERE ORD_NO = :ORD_NO AND ORD_LN = :ORD_LN),1)
              ,'C104000020TAB05'
              ,:ObjectType
              ,:ObjectId
              ,:ProgramId
              ,:Timestamp
              ,:ObjectType
              ,:ObjectId
              ,:ProgramId
              ,:Timestamp
            )
		 ]]> 
	 </query>
	 <query id="C104000020TAB05_PROC" desc="C104000020TAB05_PROC" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-용융도금(제조표준)(C104000020TAB05) C104000020TAB05_PROC.select 이돈석 */ 
	  SUB_PROC_CD1, 
         SUB_PROC_CD2    
FROM  TB_C10_QLT_DSN_PROC
WHERE ORD_NO = :ORD_NO
AND   ORD_LN = :ORD_LN
AND   (MAIN_PROC_CD LIKE '8%' OR MAIN_PROC_CD LIKE '9%')
		 ]]> 
	 </query>
	 <query id="C104000020TAB05_CMN" desc="C10 품질설계결과-설계공통" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-용융도금 이돈석 */ 
 ORD_EXC_WTH, ORD_SLIT_GRP_CNT	  
FROM  TB_C10_QLT_DSN_CMN
WHERE ORD_NO = :ORD_NO
AND   ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020TAB05.MNF_MDFinsert" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /* C10 품질설계결과수정이력 C104000020TAB05.MNF_MDFinsert 이돈석*/
            TB_C10_QLT_DSN_MNF_MDF_LOG
            (    
              ORD_NO
             ,ORD_LN
             ,MDF_SEQ
             ,QLT_DSN_MNF_TP
             ,RMTL_TAR_THK
             ,RMTL_TAR_THK_LVL
             ,RMTL_TAR_THK_UVL
             ,RMTL_TAR_WTH
             ,PLTCM_5STD_WR_TP
             ,PLTCM_SLV_USE_YN
             ,PLTCM_EDG_ASG_TP
             ,RMTL_TAR_THK_BF
             ,RMTL_TAR_THK_LVL_BF
             ,RMTL_TAR_THK_UVL_BF
             ,RMTL_TAR_WTH_BF
             ,PLTCM_5STD_WR_TP_BF
             ,PLTCM_SLV_USE_YN_BF
             ,PLTCM_EDG_ASG_TP_BF
             ,MDF_PRS_ID
             ,MDF_DH
             ,CREATED_OBJECT_TYPE
             ,CREATED_OBJECT_ID
             ,CREATED_PROGRAM_ID
             ,CREATION_TIMESTAMP
             ,LAST_UPDATED_OBJECT_TYPE
             ,LAST_UPDATED_OBJECT_ID
             ,LAST_UPDATE_PROGRAM_ID
             ,LAST_UPDATE_TIMESTAMP
            )
VALUES
            (
             :ORD_NO
             ,:ORD_LN 
             ,NVL((SELECT MAX(MDF_SEQ) + 1 FROM TB_C10_QLT_DSN_MNF_MDF_LOG WHERE ORD_NO = :ORD_NO AND ORD_LN = :ORD_LN),1)
             ,:QLT_DSN_MNF_TP
             ,:RMTL_TAR_THK
             ,:RMTL_TAR_THK_LVL
             ,:RMTL_TAR_THK_UVL
             ,:RMTL_TAR_WTH
             ,:PLTCM_5STD_WR_TP
             ,:PLTCM_SLV_USE_YN
             ,:PLTCM_EDG_ASG_TP
             ,:RMTL_TAR_THK_BF
             ,:RMTL_TAR_THK_LVL_BF
             ,:RMTL_TAR_THK_UVL_BF
             ,:RMTL_TAR_WTH_BF
             ,:PLTCM_5STD_WR_TP_BF
             ,:PLTCM_SLV_USE_YN_BF
             ,:PLTCM_EDG_ASG_TP_BF
             ,:ObjectId
             ,sysdate
             ,:ObjectType
             ,:ObjectId
             ,:ProgramId
             ,:Timestamp
             ,:ObjectType
             ,:ObjectId
             ,:ProgramId
             ,:Timestamp
            )
		 ]]> 
	 </query>
