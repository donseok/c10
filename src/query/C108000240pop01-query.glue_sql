, :OPINION_TEXT
, :ObjectType
, :ObjectId
, :ProgramId
, :Timestamp
, :ObjectType
, :ObjectId
, :ProgramId
, :Timestamp
)
		 ]]> 
	 </query>
	 <query id="C108000240pop01.updateDevStop" desc="개발 중단 상태 UPDATE" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 칼라개발관리 개발중단 상태변경 C108000240pop01.updateDevStop SJS */
C10APUSER.TB_C10_CLR_DEV_MNG
SET DEV_PRG_CD = '8'
  , LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
		 ]]> 
	 </query>
	 <query id="C108000240pop01.updateAprvDeptCd" desc="처리담당부서 변경" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 칼라개발관리 처리담당부서 변경 C108000240pop01.updateAprvDeptCd SJS */
C10APUSER.TB_C10_CLR_DEV_APRV
SET DEPT_CD = :DEPT_CD
  , LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
AND DEV_PRG_CD = :DEV_PRG_CD
AND NVL(APRV_STATUS, '0') != '2'
		 ]]> 
	 </query>
	 <query id="C108000240pop01.updateLastTs" desc="메인 테이블 최종업데이트일시 갱신" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 칼라개발관리 최종업데이트 갱신 C108000240pop01.updateLastTs SJS */
C10APUSER.TB_C10_CLR_DEV_MNG
SET LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
		 ]]> 
	 </query>
	 <query id="C108000240pop01.autoApproveComplete" desc="개발완료 자동 승인" isNamed="true">
		 <![CDATA[
UPDATE /*+ C108000240pop01 개발완료 자동 승인 C108000240pop01.autoApproveComplete SJS */
C10APUSER.TB_C10_CLR_DEV_APRV
SET APRV_STATUS = '2'
  , APRV_USER = :APRV_USER
  , DEPT_CD = (SELECT DEPT_CD FROM M90APUSER.TB_M90_EMP_INF WHERE USER_NO = :APRV_USER)
  , APRV_DT = TO_CHAR(SYSDATE, 'YYYYMMDD')
  , OPINION = '개발완료대기 승인자에 의한 자동 승인'
  , LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
AND DEV_PRG_CD = '7'
AND NVL(APRV_STATUS, '0') NOT IN ('2', '3')
		 ]]>
	 </query>
	 <query id="C108000240pop01.updateDevPrg" desc="결재 시 개발진도 및 최종업데이트일시 갱신" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 칼라개발관리 개발진도 갱신 C108000240pop01.updateDevPrg SJS */
C10APUSER.TB_C10_CLR_DEV_MNG
SET DEV_PRG_CD = :AGR_STEP_CD
  , LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
		 ]]> 
	 </query>
	 <query id="C108000240pop01.findBom" desc="CCL-BOM 검색 (4자리 이상)" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C108000240pop01 CCL-BOM 검색 C108000240pop01.findBom SJS */
CCL_BOM_NO
FROM C10APUSER.TB_C10_CCL_BOM
WHERE UPPER(CCL_BOM_NO) LIKE '%' || UPPER(:CCL_BOM_NO) || '%'
AND CCL_BOM_USE_YN = 'Y'
ORDER BY CCL_BOM_NO
		 ]]> 
	 </query>
	 <query id="C108000240pop01.updateCclBom" desc="CCL_BOM_NO 업데이트" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 CCL_BOM_NO 업데이트 C108000240pop01.updateCclBom SJS */
C10APUSER.TB_C10_CLR_DEV_MNG
SET CCL_BOM_NO = :CCL_BOM_NO
  , LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
		 ]]> 
	 </query>
	 <query id="C108000240pop01.autoApproveAnalysis" desc="분석/개발 자동 승인" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 분석/개발 자동 승인 C108000240pop01.autoApproveAnalysis SJS */
C10APUSER.TB_C10_CLR_DEV_APRV
SET APRV_STATUS = '2'
  , APRV_USER = '-'
  , APRV_DT = TO_CHAR(SYSDATE, 'YYYYMMDD')
  , OPINION = '시편승인 담당자에게 문의'
  , LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
AND DEV_PRG_CD = '2'
AND NVL(APRV_STATUS, '0') NOT IN ('2', '3')
		 ]]> 
	 </query>
	 <query id="C108000240pop01.updateDevPrgByMax" desc="결재 상태 기준 DEV_PRG_CD 갱신" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 DEV_PRG_CD MAX 갱신 C108000240pop01.updateDevPrgByMax SJS */
C10APUSER.TB_C10_CLR_DEV_MNG
SET DEV_PRG_CD = NVL((
    SELECT MAX(DEV_PRG_CD)
    FROM C10APUSER.TB_C10_CLR_DEV_APRV
    WHERE DEV_ID = :DEV_ID
    AND APRV_STATUS = '2'
    AND DEV_PRG_CD IN ('1','2','3','4','5','6','7')
), '1')
  , LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
		 ]]> 
	 </query>
	 <query id="C108000240pop01.findFile" desc="첨부파일 목록 조회" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C108000240pop01 칼라개발의뢰 첨부파일 조회 C108000240pop01.findFile SJS */
FILE_TP, IMG_NM,
       (SELECT USER_NAME FROM M90APUSER.TB_SEC_USER WHERE USER_NO = A.RGS_PRS_ID) RGS_PRS_NM,
       TO_CHAR(RGS_DH, 'YYYY-MM-DD') RGS_DD,
       IMG_ADR, SEQ_NO, IMG_NM CHK_IMG_NM,
       NVL(A.DEL_FLAG, 'N') DEL_FLAG
FROM C10APUSER.TB_C10_CLR_DEV_FILE A
WHERE DEV_ID = :DEV_ID
ORDER BY SEQ_NO
		 ]]> 
	 </query>
</queryMap>
