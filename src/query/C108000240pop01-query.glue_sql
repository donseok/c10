)
VALUES
(
SEQ_CLR_DEV_APRV.NEXTVAL
, :DEV_ID
, :DEV_PRG_CD
, :DEPT_CD
, :APRV_USER
, '1'
, ''
, :OPINION
, :OBJECTTYPE
, :OBJECTID
, :PROGRAMID
, :TIMESTAMP
, :OBJECTTYPE
, :OBJECTID
, :PROGRAMID
, :TIMESTAMP
)
		 ]]> 
	 </query>
	 <query id="C108000240pop01.insertAprvAutoApprove" desc="개발접수 자동 승인 INSERT" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C108000240pop01 칼라개발관리 개발접수 자동승인 C108000240pop01.insertAprvAutoApprove SJS */
INTO C10APUSER.TB_C10_CLR_DEV_APRV
(
