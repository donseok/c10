, :PROGRAMID
, :TIMESTAMP
)
		 ]]> 
	 </query>
	 <query id="C108000240pop01.findAprv" desc="가" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C108000240POP01 칼라 개발 관리 결재리스트 조회 C108000240POP01.FINDAPRV SJS */
APRV_ID
, DEV_ID
, DEV_PRG_CD
, DEPT_CD
, APRV_USER
, APRV_STATUS
, CASE WHEN APRV_DT IS NOT NULL AND LENGTH(APRV_DT) = 8 THEN SUBSTR(APRV_DT,1,4) || '-' || SUBSTR(APRV_DT,5,2) || '-' || SUBSTR(APRV_DT,7,2) ELSE APRV_DT END AS APRV_DT
, OPINION 
, DECODE(DEV_PRG_CD,'1','개발접수','2','분석/개발','3','시편승인','4','사양승인','5','BOM등록','6','개발완료대기','7','개발완료','8','개발중단')DEV_PRG_NM
, DECODE(APRV_STATUS,'1','요청','2','완료','3','중단')APRV_STATUS_NM
, (SELECT CD_V_MEANING FROM M00APUSER.VI_M00_CODE_ACCESS
   WHERE CD_TP = 'DEPT_CD'  
	 AND CATEGORY_GROUP_NM = 'SZ0000'
	 AND SUBSTR(CD_V,1,4) in ('5010','6000')
	 AND CD_V != '50106465'
	 AND CD_V = DEPT_CD) AS DEPT_NM
, (SELECT USER_NAME FROM M90APUSER.TB_SEC_USER WHERE USER_NO = APRV_USER) AS APRV_USER_NM
FROM C10APUSER.TB_C10_CLR_DEV_APRV
WHERE DEV_ID = :DEV_ID
ORDER BY DEV_PRG_CD
		 ]]> 
	 </query>
	 <query id="C108000240pop01.updateAprvStatus" desc="결재 처리 (승인/반려)" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 칼라개발관리 결재 처리 C108000240pop01.updateAprvStatus SJS */
C10APUSER.TB_C10_CLR_DEV_APRV
SET APRV_STATUS = :APRV_RESULT
  , APRV_USER = :AGR_USER_ID
  , APRV_DT = TO_CHAR(SYSDATE, 'YYYYMMDD')
  , OPINION = :OPINION_TEXT
  , LAST_UPDATED_OBJECT_TYPE = :OBJECTTYPE
  , LAST_UPDATED_OBJECT_ID = :OBJECTID
  , LAST_UPDATE_PROGRAM_ID = :PROGRAMID
  , LAST_UPDATE_TIMESTAMP = :TIMESTAMP
WHERE DEV_ID = :DEV_ID
AND DEV_PRG_CD = :AGR_STEP_CD
		 ]]> 
	 </query>
	 <query id="C108000240pop01.findDeptInfo" desc="가" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C108000240POP01 칼라 개발 관리 담당자 부서 조회  C108000240POP01.FINDDEPTINFO SJS */ 
DEPT_CD
, (SELECT CD_V_MEANING FROM M00APUSER.VI_M00_CODE_ACCESS WHERE CD_TP = 'DEPT_CD' AND CATEGORY_GROUP_NM = 'SZ0000' AND CD_V = DEPT_CD) DEPT_NM
FROM M90APUSER.TB_M90_EMP_INF
WHERE USER_NO = :USER_NO
		 ]]> 
	 </query>
	 <query id="C108000240pop01.saveAprv" desc="가" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 칼라 개발 관리 결재 C108000240pop01.saveAprv SJS */
 C10APUSER.TB_C10_CLR_DEV_APRV
 SET APRV_STATUS = :APRV_RESULT
 , APRV_USER = :AGR_USER_ID
 , APRV_DT = TO_CHAR(SYSDATE, 'YYYYMMDD')
 , OPINION = :OPINION_TEXT
 , LAST_UPDATED_OBJECT_TYPE = :ObjectType
 , LAST_UPDATED_OBJECT_ID = :ObjectId
 , LAST_UPDATE_PROGRAM_ID = :ProgramId
 , LAST_UPDATE_TIMESTAMP = :Timestamp
 WHERE DEV_ID = :DEV_ID
 AND DEV_PRG_CD = :AGR_STEP_CD
		 ]]> 
	 </query>
	 <query id="C108000240pop01.findUser" desc="사용자 검색" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C108000240pop01 담당자 변경 사용자 검색 C108000240pop01.findUser SJS */
USER_NO, USER_NAME, DEPT_CD,
  (SELECT CD_V_MEANING FROM M00APUSER.VI_M00_CODE_ACCESS
   WHERE CD_TP = 'DEPT_CD' AND CATEGORY_GROUP_NM = 'SZ0000' AND CD_V = DEPT_CD) DEPT_NM
FROM M90APUSER.TB_M90_EMP_INF
WHERE CMP_RGN_DATE IS NULL
AND (USER_NO LIKE '%' || :SEARCH_KEY || '%' OR USER_NAME LIKE '%' || :SEARCH_KEY || '%')
AND EXISTS (SELECT 1 FROM M90APUSER.TB_SEC_USER B WHERE B.USER_NO = TB_M90_EMP_INF.USER_NO)
ORDER BY USER_NAME
		 ]]> 
	 </query>
	 <query id="C108000240pop01.updateDevChr" desc="담당자 변경" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C108000240pop01 칼라 개발 관리 담당자 변경 C108000240pop01.updateDevChr SJS */
C10APUSER.TB_C10_CLR_DEV_MNG
SET DEV_CHR_ID = :NEW_CHR_ID
  , DEV_CHR_DEPT = (SELECT DEPT_CD FROM M90APUSER.TB_M90_EMP_INF WHERE USER_NO = :NEW_CHR_ID)
  , BF_CHR_ID = :BF_CHR_ID
  , LAST_UPDATED_OBJECT_TYPE = :ObjectType
  , LAST_UPDATED_OBJECT_ID = :ObjectId
  , LAST_UPDATE_PROGRAM_ID = :ProgramId
  , LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE DEV_ID = :DEV_ID
		 ]]> 
	 </query>
	 <query id="C108000240pop01.insertDevStop" desc="개발 중단 결재 레코드 INSERT" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C108000240pop01 칼라개발관리 개발중단 저장 C108000240pop01.insertDevStop SJS */
INTO C10APUSER.TB_C10_CLR_DEV_APRV
(
APRV_ID
, DEV_ID
, DEV_PRG_CD
, DEPT_CD
, APRV_USER
, APRV_STATUS
, APRV_DT
, OPINION
, CREATED_OBJECT_TYPE
, CREATED_OBJECT_ID
, CREATED_PROGRAM_ID
, CREATION_TIMESTAMP
, LAST_UPDATED_OBJECT_TYPE
, LAST_UPDATED_OBJECT_ID
, LAST_UPDATE_PROGRAM_ID
, LAST_UPDATE_TIMESTAMP
)
VALUES
(
SEQ_CLR_DEV_APRV.NEXTVAL
