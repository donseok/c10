<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000120tab01 Page 쿼리파일"> 
	 <query id="C106000120tab01.select" desc="C106000120tab01 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT 'VERSION ' || VER_CD AS VER_CD,
	   CLS_CD,
       DIV_CD,
       RSN_TP,
       BRD_CMP_2,
       RSN_TP_NM,
       PER_FOR_19,
       PER_FOR_6,
       FA_TRM_7,
       FA_TRM_8,
       FA_ROF_9,
       FA_ROF_10,
       FA_WAL_11,
       FA_WAL_12,
       CH_TRM_13,
       CH_TRM_14,
       CH_ROF_15,
       CH_ROF_16,
       CH_WAL_17,
       CH_WAL_18,
       PE_FL_20,
       PE_FL_1,
       (SELECT USER_NAME
          FROM M90APUSER.TB_M90_EMP_INF	
         WHERE USER_NO = LAST_UPDATED_OBJECT_ID) CREATED_OBJECT_ID,
       TO_CHAR(LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD') AS CREATION_TIMESTAMP,
       TO_NUMBER(VER_CD) AS VER_CD_DESC
   FROM C10APUSER.TB_C10_WAR_TRM_MNG
  WHERE TO_CHAR(LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD') BETWEEN :DH_STR AND :DH_END
    AND CLS_CD LIKE :CLS_COMB ||'%'
    AND DIV_CD LIKE :DIV_COMB ||'%'
    AND RSN_TP LIKE :RSN_COMB ||'%'
    AND VER_CD LIKE :VER_COMB ||'%'
    AND TO_NUMBER(VER_CD) >= DECODE(:SETTING,'Y',(SELECT MAX(TO_NUMBER(VER_CD)) FROM C10APUSER.TB_C10_WAR_TRM_MNG), 0)
  ORDER BY VER_CD_DESC DESC, CLS_CD, DIV_CD
		 ]]> 
	 </query>
	 <query id="C106000120tab01.update" desc="C106000120tab01 정보 수정" isNamed="true">
		 <![CDATA[ 
UPDATE C10APUSER.TB_C10_WAR_TRM_MNG
   SET CLS_CD    = :CLS_CD,
       DIV_CD    = :DIV_CD,
       RSN_TP    = :RSN_TP,
       BRD_CMP_2 = :BRD_CMP_2,
       RSN_TP_NM = :RSN_TP_NM,
       PER_FOR_19= :PER_FOR_19,
       PER_FOR_6 = :PER_FOR_6,
       FA_TRM_7  = :FA_TRM_7,
       FA_TRM_8  = :FA_TRM_8,
       FA_ROF_9  = :FA_ROF_9,
       FA_ROF_10 = :FA_ROF_10,
       FA_WAL_11 = :FA_WAL_11,
       FA_WAL_12 = :FA_WAL_12,
       CH_TRM_13 = :CH_TRM_13,
       CH_TRM_14 = :CH_TRM_14,
       CH_ROF_15 = :CH_ROF_15,
       CH_ROF_16 = :CH_ROF_16,
       CH_WAL_17 = :CH_WAL_17,
       CH_WAL_18 = :CH_WAL_18,
       PE_FL_1   = :PE_FL_1,
       PE_FL_20  = :PE_FL_20,
	   LAST_UPDATED_OBJECT_TYPE = :ObjectType,
	   LAST_UPDATED_OBJECT_ID   = :ObjectId,
	   LAST_UPDATE_PROGRAM_ID   = :ProgramId,
	   LAST_UPDATE_TIMESTAMP    = :Timestamp
 WHERE CLS_CD    = :CLS_CD
   AND DIV_CD    = :DIV_CD
   AND RSN_TP    = :RSN_TP
   AND VER_CD    = (SELECT MAX(TO_NUMBER(VER_CD)) FROM C10APUSER.TB_C10_WAR_TRM_MNG)
		 ]]> 
	 </query>
	 <query id="C106000120tab01.delete" desc="C106000120tab01 정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE FROM C10APUSER.TB_C10_WAR_TRM_MNG
 WHERE CLS_CD = :CLS_CD
   AND DIV_CD = :DIV_CD
   AND RSN_TP = :RSN_TP
   AND VER_CD = (SELECT MAX(TO_NUMBER(VER_CD)) FROM C10APUSER.TB_C10_WAR_TRM_MNG)
		 ]]> 
	 </query>
	 <query id="C106000120tab01.insert" desc="C106000120tab01 정보 추가" isNamed="true">
		 <![CDATA[ 
INSERT INTO C10APUSER.TB_C10_WAR_TRM_MNG(
	        VER_CD,
	        CLS_CD,
	        DIV_CD,
	        RSN_TP,
	        BRD_CMP_2,
	        RSN_TP_NM,
	        PER_FOR_19,
	        PER_FOR_6,
	        FA_TRM_7,
	        FA_TRM_8,
	        FA_ROF_9,
	        FA_ROF_10,
	        FA_WAL_11,
	        FA_WAL_12,
	        CH_TRM_13,
	        CH_TRM_14,
	        CH_ROF_15,
	        CH_ROF_16,
	        CH_WAL_17,
	        CH_WAL_18,
	        PE_FL_1,
	        PE_FL_20,
	        CREATED_OBJECT_TYPE, 
	        CREATED_OBJECT_ID,
	        CREATED_PROGRAM_ID,
	        CREATION_TIMESTAMP,
	        LAST_UPDATED_OBJECT_TYPE,
	        LAST_UPDATED_OBJECT_ID,
	        LAST_UPDATE_PROGRAM_ID,
	        LAST_UPDATE_TIMESTAMP)
	VALUES(
           (SELECT MAX(TO_NUMBER(VER_CD)) FROM C10APUSER.TB_C10_WAR_TRM_MNG),
		   :CLS_CD,
	       :DIV_CD,
	       :RSN_TP,
	       :BRD_CMP_2,
	       :RSN_TP_NM,
	       :PER_FOR_19,
	       :PER_FOR_6,
	       :FA_TRM_7,
	       :FA_TRM_8,
	       :FA_ROF_9,
	       :FA_ROF_10,
	       :FA_WAL_11,
	       :FA_WAL_12,
	       :CH_TRM_13,
	       :CH_TRM_14,
	       :CH_ROF_15,
	       :CH_ROF_16,
	       :CH_WAL_17,
	       :CH_WAL_18,
	       :PE_FL_1,
	       :PE_FL_20,
	       :ObjectType,
	       :ObjectId,
	       :ProgramId,
	       :Timestamp,
	       :ObjectType,
	       :ObjectId,
	       :ProgramId,
	       :Timestamp)
		 ]]> 
	 </query>
	 <query id="C106000120tab01.insertNewVer" desc="C106000120tab01.insertNewVer" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO C10APUSER.TB_C10_WAR_TRM_MNG /*C106000120tab01.insertNewVer*/
SELECT 
    (SELECT (MAX(TO_NUMBER(VER_CD)))+1 FROM C10APUSER.TB_C10_WAR_TRM_MNG),
    CLS_CD,
    DIV_CD,
    RSN_TP,
    STRT_DH,
    END_DH,
    BRD_CMP_2,
    RSN_TP_NM,
    PER_FOR_19,
    PER_FOR_6,
    PE_FL_1,
    FA_TRM_7,
    FA_TRM_8,
    FA_ROF_9,
    FA_ROF_10,
    FA_WAL_11,
    FA_WAL_12,
    CH_TRM_13,
    CH_TRM_14,
    CH_ROF_15,
    CH_ROF_16,
    CH_WAL_17,
    CH_WAL_18,
    PE_FL_20,
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
	       :ObjectType,
	       :ObjectId,
	       :ProgramId,
	       :Timestamp,
    DATA_END_STATUS,
    DATA_END_OBJECT_TYPE,
    DATA_END_OBJECT_ID,
    DATA_END_PROGRAM_ID,
    DATA_END_TIMESTAMP,
    ARCHIVE_COMPLETED_FLAG,
    ARCHIVED_EMPLOYEE_NUM,
    ARCHIVED_TIMESTAMP,
    ARCHIVE_PROGRAM_ID 
FROM C10APUSER.TB_C10_WAR_TRM_MNG
WHERE VER_CD = (SELECT MAX(TO_NUMBER(VER_CD)) FROM C10APUSER.TB_C10_WAR_TRM_MNG)
  AND VER_CD IS NOT NULL
		 ]]> 
	 </query>
	 <query id="C106000120tab01ClsCdComb.select" desc="C106000120tab01ClsCdComb.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT '%' AS CLS_CD,'전체' AS CLS_NM -- '전체'컬럼 생성
  FROM DUAL 
UNION ALL -- 테이블 조합
SELECT CLS_CD, CLS_CD AS CLS_NM  
  FROM C10APUSER.TB_C10_WAR_TRM_MNG
  WHERE TO_CHAR(LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD') BETWEEN :DH_STR AND :DH_END
  GROUP BY CLS_CD
  ORDER BY CLS_CD
		 ]]> 
	 </query>
	 <query id="C106000120tab01DivCdComb.select" desc="C106000120tab01DivCdComb.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT '%' AS DIV_CD ,'전체' AS DIV_NM  -- '전체'컬럼 생성
  FROM DUAL 
UNION ALL -- 테이블 조합
SELECT DIV_CD, DIV_CD  AS DIV_NM  
  FROM C10APUSER.TB_C10_WAR_TRM_MNG
  WHERE TO_CHAR(LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD') BETWEEN :DH_STR AND :DH_END
  GROUP BY DIV_CD
  ORDER BY DIV_CD
		 ]]> 
	 </query>
	 <query id="C106000120tab01RsnTpComb.select" desc="C106000120tab01RsnTpComb.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT '%' AS RSN_TP,'전체' AS RSN_TP_NM   -- '전체'컬럼 생성
  FROM DUAL 
UNION ALL -- 테이블 조합
SELECT RSN_TP, RSN_TP AS RSN_TP_NM  
  FROM C10APUSER.TB_C10_WAR_TRM_MNG
  WHERE TO_CHAR(LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD') BETWEEN :DH_STR AND :DH_END
  GROUP BY RSN_TP
  ORDER BY RSN_TP
		 ]]> 
	 </query>
	 <query id="C106000120tab01VerCdComb.select" desc="C106000120tab01VerCdComb.select" isNamed="true">
		 <![CDATA[ 
SELECT '%' AS VER_CD,'전체' AS VER_NM   -- '전체'컬럼 생성
  FROM DUAL 
UNION ALL -- 테이블 조합
SELECT VER_CD, VER_NM FROM
(SELECT VER_CD, 'VERSION ' || VER_CD AS VER_NM  
  FROM C10APUSER.TB_C10_WAR_TRM_MNG
  WHERE TO_CHAR(LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD') BETWEEN :DH_STR AND :DH_END
  GROUP BY VER_CD
  ORDER BY TO_NUMBER(VER_CD))
		 ]]> 
	 </query>
	 <query id="C106000120tab01.find" desc="C106000120tab01.find" isNamed="true">
		 <![CDATA[ 
SELECT 1 
 FROM C10APUSER.TB_C10_WAR_TRM_MNG
WHERE VER_CD = SUBSTR(:VER_CD,9,1)
  AND CLS_CD = :CLS_CD
  AND DIV_CD = :DIV_CD
  AND RSN_TP = :RSN_TP
		 ]]> 
	 </query>
	 <query id="C106000120tab01.send" desc="보증서기준정보 전송" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT 1 FROM DUAL
		 ]]> 
	 </query>
</queryMap>
