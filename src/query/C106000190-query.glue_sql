	 <query id="C106000190.detail.updateRawJson" desc="OCR 원본 JSON 저장" isNamed="true">
		 <![CDATA[ 
UPDATE TB_C10_CLR_STD_OCR
           SET OCR_RAW_JSON = :OCR_RAW_JSON
         WHERE OCR_NO = :OCR_NO
		 ]]> 
	 </query>
	 <query id="C106000190.dup.check" desc="칼라부자재코드 중복 체크" isNamed="true">
		 <![CDATA[ 
SELECT COUNT(1) AS CNT
          FROM TB_C10_CLR_CD_MNG
         WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
</queryMap>
