<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000020TAB08"> 
	 <query id="C104000020TAB08.select" desc="C104000020TAB08 정보 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-통과공정 C104000020TAB08.select 박재영 */
      TB_C10_QLT_DSN_PROC.ORD_NO
      ,TB_C10_QLT_DSN_PROC.ORD_LN
      ,TB_C10_QLT_DSN_CMN.PRD_NM_CD
      ,TB_C10_QLT_DSN_CMN.MTL_CD
      ,TB_C10_QLT_DSN_PROC.PROC_SEQ
      ,TB_C10_QLT_DSN_PROC.MAIN_PROC_CD
      ,TB_C10_QLT_DSN_PROC.SUB_PROC_CD1
      ,TB_C10_QLT_DSN_PROC.SUB_PROC_CD2
      ,TB_C10_QLT_DSN_PROC.SUB_PROC_CD3
      ,TB_C10_QLT_DSN_PROC.SUB_PROC_CD4
      ,TB_C10_QLT_DSN_PROC.SUB_PROC_CD5
      ,TB_C10_QLT_DSN_PROC.SUB_PROC_CD6
      ,TB_C10_QLT_DSN_PROC.MTL_CD
      ,DECODE(TB_C10_QLT_DSN_PROC.SMS_RCV_YN, 'Y' , '1' ,'0') SMS_RCV_YN
   FROM  TB_C10_QLT_DSN_PROC, TB_C10_QLT_DSN_CMN
   WHERE TB_C10_QLT_DSN_PROC.ORD_NO = TB_C10_QLT_DSN_CMN.ORD_NO
   AND   TB_C10_QLT_DSN_PROC.ORD_LN = TB_C10_QLT_DSN_CMN.ORD_LN
   AND   TB_C10_QLT_DSN_CMN.ORD_NO = :ORD_NO
   AND   TB_C10_QLT_DSN_CMN.ORD_LN = :ORD_LN
   AND    NOT EXISTS (SELECT * FROM MESAPUSER.VI_MES_TRM_CTL 
                           WHERE CTL_NO = TB_C10_QLT_DSN_CMN.ORD_NO AND CTL_TP = 'O')
   ORDER BY TB_C10_QLT_DSN_PROC.PROC_SEQ
		 ]]> 
	 </query>
	 <query id="C104000020TAB08.STSselect" desc="C104000020TAB08.STSselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C104000020TAB08.STSselect 박재영*/      
*                               
 FROM TB_C10_QLT_DSN_CMN
 WHERE ORD_NO = :ORD_NO
 AND    ORD_LN = :ORD_LN
 AND    QLT_DSN_STS_CD = 'A'
		 ]]> 
	 </query>
	 <query id="C104000020TAB08.CHG_HSTinsert" desc="C104000020TAB08.CHG_HSTinsert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 품질설계결과수정이력 C104000020TAB08.CHG_HSTinsert 박재영*/
            TB_C10_QLT_DSN_CHG_HST
            (    
              ORD_NO                      --주문번호
		,ORD_LN                      --주문행번
		,SEQ	                      --수정SEQ
		,CHG_TXT                     --수정내역
             ,CREATED_OBJECT_TYPE
             ,CREATED_OBJECT_ID
             ,CREATED_PROGRAM_ID
             ,CREATION_TIMESTAMP
             ,LAST_UPDATED_OBJECT_TYPE
             ,LAST_UPDATED_OBJECT_ID
             ,LAST_UPDATE_PROGRAM_ID
             ,LAST_UPDATE_TIMESTAMP
            )
VALUES
            (
              :ORD_NO
              ,:ORD_LN 
              ,NVL((SELECT MAX(SEQ) + 1 FROM TB_C10_QLT_DSN_CHG_HST WHERE ORD_NO = :ORD_NO AND ORD_LN = :ORD_LN),1)
              ,'C104000020TAB08'
              ,:ObjectType
              ,:ObjectId
              ,:ProgramId
              ,:Timestamp
              ,:ObjectType
              ,:ObjectId
              ,:ProgramId
              ,:Timestamp
            )
		 ]]> 
	 </query>
	 <query id="C104000020TAB08.PLselect" desc="C104000020TAB08.PLselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-제조사양 C104000020TAB08PLselect 이돈석 */
      PL_WTH_SUB_PROC1_TRV, 
      PL_WTH_SUB_PROC2_TRV 
   FROM  TB_C10_QLT_DSN_MNF
   WHERE  ORD_NO = :ORD_NO
   AND    ORD_LN = :ORD_LN
   ORDER BY ORD_NO
		 ]]> 
	 </query>
	 <query id="C104000020TAB08CANNselect" desc="C104000020TAB08CANNselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-제조사양 C104000020TAB08CANNselect 이돈석 */
      HEAT_CYL_NO_2CGL, 
      HEAT_CYL_NO_3CGL,
      HEAT_CYL_NO_4CGL,
      HEAT_CYL_NO_5CGL
   FROM  TB_C10_QLT_DSN_MNF
   WHERE  ORD_NO = :ORD_NO
   AND    ORD_LN = :ORD_LN
   ORDER BY ORD_NO
		 ]]> 
	 </query>
	 <query id="C104000020TAB08ANNselect" desc="C104000020TAB08ANNselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-제조사양 C104000020TAB08ANNselect 이돈석 */
      HEAT_CYL_NO_GEN_ANN, 
      HEAT_CYL_NO_HC_ANN 
   FROM  TB_C10_QLT_DSN_MNF
   WHERE  ORD_NO = :ORD_NO
   AND    ORD_LN = :ORD_LN
   ORDER BY ORD_NO
		 ]]> 
	 </query>
	 <query id="C104000020TAB08PROCselect" desc="C104000020TAB08PROCselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-제조사양 C104000020TAB08PROCselect 이돈석 */
      PAS_PROC_NO  
   FROM  TB_C10_QLT_DSN_CMN A
   WHERE  ORD_NO = :ORD_NO
   AND    ORD_LN = :ORD_LN
   AND    NOT EXISTS (SELECT * FROM MESAPUSER.VI_MES_TRM_CTL 
                           WHERE CTL_NO = A.ORD_NO AND CTL_TP = 'O')
   ORDER BY ORD_NO
		 ]]> 
	 </query>
	 <query id="C104000020TAB08ROWCNTselect" desc="C104000020TAB08ROWCNTselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과-제조사양 C104000020TAB08ROWCNTselect 이돈석 */
      COUNT(*) PROC_CNT  
   FROM  TB_C10_QLT_DSN_PROC A
   WHERE  ORD_NO = :ORD_NO
   AND    ORD_LN = :ORD_LN
   AND    NOT EXISTS (SELECT * FROM MESAPUSER.VI_MES_TRM_CTL 
                           WHERE CTL_NO = A.ORD_NO AND CTL_TP = 'O')
		 ]]> 
	 </query>
</queryMap>
