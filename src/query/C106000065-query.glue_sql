<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000065 Page 쿼리파일"> 
	 <query id="C106000065_Grid1.select" desc="10" fetchSize="1000" isNamed="true">
		 <![CDATA[ 
select /*+ C106000065   CCL-BOM & 칼라코드 조회 C106000065_Grid1.select 성낙원 */
       a.CCL_BOM_NO, a.CCL_BOM_USE_YN, a.DTL_CLR_NM,
       b1.clr_sub_mtl_cd  HUE_CD_FRN,      b1.use_yn  FRN_YN, 
       b2.clr_sub_mtl_cd  HUE_CD_BAK,      b2.use_yn  BAK_YN, 
       b3.clr_sub_mtl_cd  HUE_CD_FRN_4COT, b3.use_yn  FRN4_YN, 
       b4.clr_sub_mtl_cd  HUE_CD_FRN_3COT, b4.use_yn  FRN3_YN, 
       b5.clr_sub_mtl_cd  HUE_CD_FRN_2COT, b5.use_yn  FRN2_YN, 
       b6.clr_sub_mtl_cd  HUE_CD_FRN_1COT, b6.use_yn  FRN1_YN, 
       b7.clr_sub_mtl_cd  HUE_CD_BAK_1COT, b7.use_yn  BAK1_YN, 
       b8.clr_sub_mtl_cd  HUE_CD_BAK_2COT, b8.use_yn  BAK2_YN, 
       b9.clr_sub_mtl_cd HUE_CD_BAK_3COT,  b9.use_yn BAK3_YN, 
       b10.clr_sub_mtl_cd HUE_CD_BAK_4COT, b10.use_yn BAK4_YN, 
       b11.clr_sub_mtl_cd HUE_CD_LMN,      b11.use_yn LMN_YN,
       b12.clr_sub_mtl_cd  HUE_CD_SUB,     b12.use_yn  SUB_YN
from   C10APUSER.TB_C10_CCL_BOM a, 
       C10APUSER.TB_C10_CLR_CD_MNG b1,
       C10APUSER.TB_C10_CLR_CD_MNG b2,
       C10APUSER.TB_C10_CLR_CD_MNG b3,
       C10APUSER.TB_C10_CLR_CD_MNG b4,
       C10APUSER.TB_C10_CLR_CD_MNG b5,
       C10APUSER.TB_C10_CLR_CD_MNG b6,
       C10APUSER.TB_C10_CLR_CD_MNG b7,
       C10APUSER.TB_C10_CLR_CD_MNG b8,
       C10APUSER.TB_C10_CLR_CD_MNG b9,
       C10APUSER.TB_C10_CLR_CD_MNG b10,
       C10APUSER.TB_C10_CLR_CD_MNG b11,
       C10APUSER.TB_C10_CLR_CD_MNG b12
 where a.ccl_bom_no     like upper(trim(:CCL_BOM_NO))||'%'
 and   a.ccl_bom_use_yn like :CCL_BOM_USE_YN
 and  (a.hue_cd_frn      like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_bak      like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_frn_4cot like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_frn_3cot like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_frn_2cot like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_frn_1cot like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_bak_1cot like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_bak_2cot like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_bak_3cot like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_bak_4cot like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_lmn      like upper(trim(:CLR_CD))||'%' or
       a.hue_cd_sub      like upper(trim(:CLR_CD))||'%'   )
 and   a.hue_cd_frn        =    b1.clr_sub_mtl_cd (+)
 and   a.hue_cd_bak        =    b2.clr_sub_mtl_cd (+)
 and   a.hue_cd_frn_4cot   =    b3.clr_sub_mtl_cd (+)
 and   a.hue_cd_frn_3cot   =    b4.clr_sub_mtl_cd (+)
 and   a.hue_cd_frn_2cot   =    b5.clr_sub_mtl_cd (+)
 and   a.hue_cd_frn_1cot   =    b6.clr_sub_mtl_cd (+)
 and   a.hue_cd_bak_1cot   =    b7.clr_sub_mtl_cd (+)
 and   a.hue_cd_bak_2cot   =    b8.clr_sub_mtl_cd (+)
 and   a.hue_cd_bak_3cot   =    b9.clr_sub_mtl_cd (+)
 and   a.hue_cd_bak_4cot   =    b10.clr_sub_mtl_cd (+)
 and   a.hue_cd_lmn        =    b11.clr_sub_mtl_cd (+)
 and   a.hue_cd_sub        =    b12.clr_sub_mtl_cd (+)
 and  (nvl(b1.use_yn,' ')  like :CLR_USE_YN or
       nvl(b2.use_yn,' ')  like :CLR_USE_YN or
       nvl(b3.use_yn,' ')  like :CLR_USE_YN or
       nvl(b4.use_yn,' ')  like :CLR_USE_YN or
       nvl(b5.use_yn,' ')  like :CLR_USE_YN or
       nvl(b6.use_yn,' ')  like :CLR_USE_YN or
       nvl(b7.use_yn,' ')  like :CLR_USE_YN or
       nvl(b8.use_yn,' ')  like :CLR_USE_YN or
       nvl(b9.use_yn,' ')  like :CLR_USE_YN or
       nvl(b10.use_yn,' ') like :CLR_USE_YN or
       nvl(b11.use_yn,' ') like :CLR_USE_YN or
       nvl(b12.use_yn,' ') like :CLR_USE_YN   )
 order by a.CCL_BOM_NO
		 ]]> 
	 </query>
	 <query id="C106000065_Grid2.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
with PT as ( /*+ C106000065   CCL-BOM & 칼라코드 조회 C106000065_Grid2.select 성낙원 */
     select 1 seq, '전면' clr_loc, clr_sub_mtl_cd clr_cd, use_yn, clr_nm,
            MESAPUSER.FUNC_DECODE('SUB_MTL_TP_CD', 'SZ0000', sub_mtl_tp)              sub_mtl_tp,
            MESAPUSER.FUNC_DECODE('RSN_TP', 'SZ0000', rsn_tp)                         rsn_tp,
            MESAPUSER.FUNC_DECODE('LUS_RT_CD', 'SZ0000', lus_rt_cd)                   lus_rt_cd,
            RL_LUS_RT, LUS_RT_LLV, LUS_RT_ULV, TP_CD, 
            WK_VISCO, PNT_FLM_THK,
            MESAPUSER.FUNC_DECODE('PRT_INK_TP', 'SZ0000', prt_ink_tp)                 prt_ink_tp,
            NV, PNT_GRA, SLV_GRA, THR_CD, PNT_UNT, PMT, QT_L, QT_A, QT_B, STD_CLR_NM,
            MESAPUSER.FUNC_DECODE('LMN_KND_TP', 'SZ0000', lmn_knd_tp)                 lmn_knd_tp,
            LMN_BND_CD, LMN_BND_THR_CD,
            MESAPUSER.FUNC_DECODE('LMN_FLM_THK_CD', 'SZ0000', lmn_flm_thk_cd)         lmn_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_LUS_RT_CD', 'SZ0000', ptt_flm_lus_rt_cd)   ptt_flm_lus_rt_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_THK_CD', 'SZ0000', ptt_flm_thk_cd)         ptt_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_MQL_CD', 'SZ0000', ptt_flm_mql_cd)         ptt_flm_mql_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_SUS_ADH_CD', 'SZ0000', ptt_flm_sus_adh_cd) ptt_flm_sus_adh_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_PRD_ADH_CD', 'SZ0000', ptt_flm_prd_adh_cd) ptt_flm_prd_adh_cd,
            RMRK
     from   C10APUSER.TB_C10_CLR_CD_MNG where clr_sub_mtl_cd = :P_HUE_CD_FRN
     
     union all

     select 2 seq, '후면' clr_loc,  clr_sub_mtl_cd clr_cd, use_yn, clr_nm,
            MESAPUSER.FUNC_DECODE('SUB_MTL_TP_CD', 'SZ0000', sub_mtl_tp)              sub_mtl_tp,
            MESAPUSER.FUNC_DECODE('RSN_TP', 'SZ0000', rsn_tp)                         rsn_tp,
            MESAPUSER.FUNC_DECODE('LUS_RT_CD', 'SZ0000', lus_rt_cd)                   lus_rt_cd,
            RL_LUS_RT, LUS_RT_LLV, LUS_RT_ULV, TP_CD, 
            WK_VISCO, PNT_FLM_THK,
            MESAPUSER.FUNC_DECODE('PRT_INK_TP', 'SZ0000', prt_ink_tp)                 prt_ink_tp,
            NV, PNT_GRA, SLV_GRA, THR_CD, PNT_UNT, PMT, QT_L, QT_A, QT_B, STD_CLR_NM,
            MESAPUSER.FUNC_DECODE('LMN_KND_TP', 'SZ0000', lmn_knd_tp)                 lmn_knd_tp,
            LMN_BND_CD, LMN_BND_THR_CD,
            MESAPUSER.FUNC_DECODE('LMN_FLM_THK_CD', 'SZ0000', lmn_flm_thk_cd)         lmn_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_LUS_RT_CD', 'SZ0000', ptt_flm_lus_rt_cd)   ptt_flm_lus_rt_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_THK_CD', 'SZ0000', ptt_flm_thk_cd)         ptt_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_MQL_CD', 'SZ0000', ptt_flm_mql_cd)         ptt_flm_mql_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_SUS_ADH_CD', 'SZ0000', ptt_flm_sus_adh_cd) ptt_flm_sus_adh_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_PRD_ADH_CD', 'SZ0000', ptt_flm_prd_adh_cd) ptt_flm_prd_adh_cd,
            RMRK
     from   C10APUSER.TB_C10_CLR_CD_MNG where clr_sub_mtl_cd = :P_HUE_CD_BAK

     union all
     
     select 3 seq, 'Top4' clr_loc, clr_sub_mtl_cd clr_cd, use_yn, clr_nm,
            MESAPUSER.FUNC_DECODE('SUB_MTL_TP_CD', 'SZ0000', sub_mtl_tp)              sub_mtl_tp,
            MESAPUSER.FUNC_DECODE('RSN_TP', 'SZ0000', rsn_tp)                         rsn_tp,
            MESAPUSER.FUNC_DECODE('LUS_RT_CD', 'SZ0000', lus_rt_cd)                   lus_rt_cd,
            RL_LUS_RT, LUS_RT_LLV, LUS_RT_ULV, TP_CD, 
            WK_VISCO, PNT_FLM_THK,
            MESAPUSER.FUNC_DECODE('PRT_INK_TP', 'SZ0000', prt_ink_tp)                 prt_ink_tp,
            NV, PNT_GRA, SLV_GRA, THR_CD, PNT_UNT, PMT, QT_L, QT_A, QT_B, STD_CLR_NM,
            MESAPUSER.FUNC_DECODE('LMN_KND_TP', 'SZ0000', lmn_knd_tp)                 lmn_knd_tp,
            LMN_BND_CD, LMN_BND_THR_CD,
            MESAPUSER.FUNC_DECODE('LMN_FLM_THK_CD', 'SZ0000', lmn_flm_thk_cd)         lmn_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_LUS_RT_CD', 'SZ0000', ptt_flm_lus_rt_cd)   ptt_flm_lus_rt_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_THK_CD', 'SZ0000', ptt_flm_thk_cd)         ptt_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_MQL_CD', 'SZ0000', ptt_flm_mql_cd)         ptt_flm_mql_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_SUS_ADH_CD', 'SZ0000', ptt_flm_sus_adh_cd) ptt_flm_sus_adh_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_PRD_ADH_CD', 'SZ0000', ptt_flm_prd_adh_cd) ptt_flm_prd_adh_cd,
            RMRK
     from   C10APUSER.TB_C10_CLR_CD_MNG where clr_sub_mtl_cd = :P_HUE_CD_FRN_4COT
 
     union all
     
     select 4 seq, 'Top3' clr_loc, clr_sub_mtl_cd clr_cd, use_yn, clr_nm,
            MESAPUSER.FUNC_DECODE('SUB_MTL_TP_CD', 'SZ0000', sub_mtl_tp)              sub_mtl_tp,
            MESAPUSER.FUNC_DECODE('RSN_TP', 'SZ0000', rsn_tp)                         rsn_tp,
            MESAPUSER.FUNC_DECODE('LUS_RT_CD', 'SZ0000', lus_rt_cd)                   lus_rt_cd,
            RL_LUS_RT, LUS_RT_LLV, LUS_RT_ULV, TP_CD, 
            WK_VISCO, PNT_FLM_THK,
            MESAPUSER.FUNC_DECODE('PRT_INK_TP', 'SZ0000', prt_ink_tp)                 prt_ink_tp,
            NV, PNT_GRA, SLV_GRA, THR_CD, PNT_UNT, PMT, QT_L, QT_A, QT_B, STD_CLR_NM,
            MESAPUSER.FUNC_DECODE('LMN_KND_TP', 'SZ0000', lmn_knd_tp)                 lmn_knd_tp,
            LMN_BND_CD, LMN_BND_THR_CD,
            MESAPUSER.FUNC_DECODE('LMN_FLM_THK_CD', 'SZ0000', lmn_flm_thk_cd)         lmn_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_LUS_RT_CD', 'SZ0000', ptt_flm_lus_rt_cd)   ptt_flm_lus_rt_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_THK_CD', 'SZ0000', ptt_flm_thk_cd)         ptt_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_MQL_CD', 'SZ0000', ptt_flm_mql_cd)         ptt_flm_mql_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_SUS_ADH_CD', 'SZ0000', ptt_flm_sus_adh_cd) ptt_flm_sus_adh_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_PRD_ADH_CD', 'SZ0000', ptt_flm_prd_adh_cd) ptt_flm_prd_adh_cd,
            RMRK
     from   C10APUSER.TB_C10_CLR_CD_MNG where clr_sub_mtl_cd = :P_HUE_CD_FRN_3COT
 
     union all
     
     select 5 seq, 'Top2' clr_loc, clr_sub_mtl_cd clr_cd, use_yn, clr_nm,
            MESAPUSER.FUNC_DECODE('SUB_MTL_TP_CD', 'SZ0000', sub_mtl_tp)              sub_mtl_tp,
            MESAPUSER.FUNC_DECODE('RSN_TP', 'SZ0000', rsn_tp)                         rsn_tp,
            MESAPUSER.FUNC_DECODE('LUS_RT_CD', 'SZ0000', lus_rt_cd)                   lus_rt_cd,
            RL_LUS_RT, LUS_RT_LLV, LUS_RT_ULV, TP_CD, 
            WK_VISCO, PNT_FLM_THK,
            MESAPUSER.FUNC_DECODE('PRT_INK_TP', 'SZ0000', prt_ink_tp)                 prt_ink_tp,
            NV, PNT_GRA, SLV_GRA, THR_CD, PNT_UNT, PMT, QT_L, QT_A, QT_B, STD_CLR_NM,
            MESAPUSER.FUNC_DECODE('LMN_KND_TP', 'SZ0000', lmn_knd_tp)                 lmn_knd_tp,
            LMN_BND_CD, LMN_BND_THR_CD,
            MESAPUSER.FUNC_DECODE('LMN_FLM_THK_CD', 'SZ0000', lmn_flm_thk_cd)         lmn_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_LUS_RT_CD', 'SZ0000', ptt_flm_lus_rt_cd)   ptt_flm_lus_rt_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_THK_CD', 'SZ0000', ptt_flm_thk_cd)         ptt_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_MQL_CD', 'SZ0000', ptt_flm_mql_cd)         ptt_flm_mql_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_SUS_ADH_CD', 'SZ0000', ptt_flm_sus_adh_cd) ptt_flm_sus_adh_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_PRD_ADH_CD', 'SZ0000', ptt_flm_prd_adh_cd) ptt_flm_prd_adh_cd,
            RMRK
     from   C10APUSER.TB_C10_CLR_CD_MNG where clr_sub_mtl_cd = :P_HUE_CD_FRN_2COT
 
     union all
     
     select 6 seq, 'Top1' clr_loc, clr_sub_mtl_cd clr_cd, use_yn, clr_nm,
            MESAPUSER.FUNC_DECODE('SUB_MTL_TP_CD', 'SZ0000', sub_mtl_tp)              sub_mtl_tp,
            MESAPUSER.FUNC_DECODE('RSN_TP', 'SZ0000', rsn_tp)                         rsn_tp,
            MESAPUSER.FUNC_DECODE('LUS_RT_CD', 'SZ0000', lus_rt_cd)                   lus_rt_cd,
            RL_LUS_RT, LUS_RT_LLV, LUS_RT_ULV, TP_CD, 
            WK_VISCO, PNT_FLM_THK,
            MESAPUSER.FUNC_DECODE('PRT_INK_TP', 'SZ0000', prt_ink_tp)                 prt_ink_tp,
            NV, PNT_GRA, SLV_GRA, THR_CD, PNT_UNT, PMT, QT_L, QT_A, QT_B, STD_CLR_NM,
            MESAPUSER.FUNC_DECODE('LMN_KND_TP', 'SZ0000', lmn_knd_tp)                 lmn_knd_tp,
            LMN_BND_CD, LMN_BND_THR_CD,
            MESAPUSER.FUNC_DECODE('LMN_FLM_THK_CD', 'SZ0000', lmn_flm_thk_cd)         lmn_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_LUS_RT_CD', 'SZ0000', ptt_flm_lus_rt_cd)   ptt_flm_lus_rt_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_THK_CD', 'SZ0000', ptt_flm_thk_cd)         ptt_flm_thk_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_MQL_CD', 'SZ0000', ptt_flm_mql_cd)         ptt_flm_mql_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_SUS_ADH_CD', 'SZ0000', ptt_flm_sus_adh_cd) ptt_flm_sus_adh_cd,
            MESAPUSER.FUNC_DECODE('PTT_FLM_PRD_ADH_CD', 'SZ0000', ptt_flm_prd_adh_cd) ptt_flm_prd_adh_cd,
            RMRK
     from   C10APUSER.TB_C10_CLR_CD_MNG where clr_sub_mtl_cd = :P_HUE_CD_FRN_1COT
 
     union all
     
     select 7 seq, 'Back1' clr_loc, clr_sub_mtl_cd clr_cd, use_yn, clr_nm,
            MESAPUSER.FUNC_DECODE('SUB_MTL_TP_CD', 'SZ0000', sub_mtl_tp)              sub_mtl_tp,
            MESAPUSER.FUNC_DECODE('RSN_TP', 'SZ0000', rsn_tp)                         rsn_tp,
            MESAPUSER.FUNC_DECODE('LUS_RT_CD', 'SZ0000', lus_rt_cd)                   lus_rt_cd,
