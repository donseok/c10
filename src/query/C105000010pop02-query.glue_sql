<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C105000010pop02 Page 쿼리파일"> 
	 <query id="C105000010pop02.select" desc="규격약호popup조회 C105000010pop02.SELECT " fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 생산가부이력등록 규격약호popup조회 C105000010pop02.SELECT 김종범*/
 SPC_AVR --규격약호
,SPC_OFC --규격기관
,SPC_NM  --규격명
,SPC_FUL_NM --규격Full Name
FROM M00APUSER.VI_M00_C10A1010
WHERE NVL(SPC_AVR,'%') LIKE '%'|| :SPC_AVR ||'%'
AND NVL(SPC_OFC,'%') LIKE '%'|| :SPC_OFC ||'%'
ORDER BY SPC_AVR
		 ]]> 
	 </query>
</queryMap>
