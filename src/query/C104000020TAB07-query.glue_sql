<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000020TAB07"> 
	 <query id="C104000020TAB07.select" desc="CCL BOM 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C104000020TAB07   박재영   C104000020TAB07.select    */ 
    A.ORD_NO,--주문번호
    A.ORD_LN,--주문행번     
    A.COT_MTH || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'COT_MTH' 
      AND   CD_V = A.COT_MTH
      AND   CATEGORY_GROUP_NM = 'SZ0000') COT_MTH -- 코팅방식
    ,A.HUE_CD_FRN --색상코드전면
    ,A.HUE_CD_BAK --색상코드후면
    ,A.HUE_CD_SUB --색상코드SUB
    ,A.HUE_CD_CHM --색상코드Chemical
    ,A.PNT_FLM_THK_FRN_TOT --도막두께전면Total
    ,A.PNT_FLM_THK_BAK_TOT --도막두께후면Total
    ,A.LUS_RT_CD_FRN -- 광택도코드전면
    ,A.LUS_RT_CD_BAK --광택도코드후면
    ,A.RSN_TP_FRN --수지구분전면
    ,A.RSN_TP_BAK --수지구분후면
    ,A.DTL_CLR_NM --상세색상명
    ,A.RSN_TP_FRN_1COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_FRN_1COT) RSN_TP_FRN_1COT --수지구분전면1Coat
    ,A.RSN_TP_FRN_2COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_FRN_2COT) RSN_TP_FRN_2COT --수지구분전면2Coat
    ,A.RSN_TP_FRN_3COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_FRN_3COT) RSN_TP_FRN_3COT --수지구분전면3Coat
    ,A.RSN_TP_FRN_4COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_FRN_4COT) RSN_TP_FRN_4COT --수지구분전면4Coat
    ,A.RSN_TP_BAK_1COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_BAK_1COT) RSN_TP_BAK_1COT --수지구분후면1Coat
    ,A.RSN_TP_BAK_2COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_BAK_2COT) RSN_TP_BAK_2COT --수지구분후면2Coat
    ,A.RSN_TP_BAK_3COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_BAK_3COT) RSN_TP_BAK_3COT --수지구분후면3Coat
    ,A.RSN_TP_BAK_4COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_BAK_4COT) RSN_TP_BAK_4COT --수지구분후면4Coat
    ,A.RSN_TP_LMN --수지구분Lamina
    ,A.HUE_CD_FRN_1COT --색상코드전면1Coat
    ,A.HUE_CD_FRN_2COT --색상코드전면2Coat
    ,A.HUE_CD_FRN_3COT --색상코드전면3Coat
    ,A.HUE_CD_FRN_4COT --색상코드전면4Coat
    ,A.HUE_CD_BAK_1COT --색상코드후면1Coat
    ,A.HUE_CD_BAK_2COT --색상코드후면2Coat
    ,A.HUE_CD_BAK_3COT --색상코드후면3Coat
    ,A.HUE_CD_BAK_4COT --색상코드후면4Coat
    ,A.HUE_CD_LMN --색상코드Lamina
    ,A.PNT_FLM_THK_FRN_1COT --도막두께전면1Coat
    ,A.PNT_FLM_THK_FRN_2COT --도막두께전면2Coat
    ,A.PNT_FLM_THK_FRN_3COT --도막두께전면3Coat
    ,A.PNT_FLM_THK_FRN_4COT --도막두께전면4Coat
    ,A.PNT_FLM_THK_BAK_1COT --도막두께후면1Coat
    ,A.PNT_FLM_THK_BAK_2COT --도막두께후면2Coat
    ,A.PNT_FLM_THK_BAK_3COT --도막두께후면3Coat
    ,A.PNT_FLM_THK_BAK_4COT --도막두께후면4Coat
    ,A.PNT_FLM_THK_LMN --도막두께Lamina
    ,A.LUS_RT_CD_FRN_1COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD'
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_FRN_1COT) AS LUS_RT_CD_FRN_1COT --광택도코드전면1Coat
    ,A.LUS_RT_CD_FRN_2COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_FRN_2COT) AS LUS_RT_CD_FRN_2COT --광택도코드전면2Coat
    ,A.LUS_RT_CD_FRN_3COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_FRN_3COT) AS LUS_RT_CD_FRN_3COT --광택도코드전면3Coat
    ,A.LUS_RT_CD_FRN_4COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_FRN_4COT) AS LUS_RT_CD_FRN_4COT --광택도코드전면4Coat
    ,A.LUS_RT_CD_BAK_1COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_BAK_1COT) AS LUS_RT_CD_BAK_1COT --광택도코드후면1Coat
    ,A.LUS_RT_CD_BAK_2COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_BAK_2COT) AS LUS_RT_CD_BAK_2COT --광택도코드후면2Coat
    ,A.LUS_RT_CD_BAK_3COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_BAK_3COT) AS LUS_RT_CD_BAK_3COT --광택도코드후면3Coat
    ,A.LUS_RT_CD_BAK_4COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_BAK_4COT) AS LUS_RT_CD_BAK_4COT --광택도코드후면4Coat
    ,A.LUS_RT_CD_LMN  || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LUS_RT_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LUS_RT_CD_LMN) AS LUS_RT_CD_LMN --광택도코드Lamina
    ,A.LUS_RT_FRN_1COT_LLV || ' - ' || A.LUS_RT_FRN_1COT_ULV AS LUS_RT_FRN_1COT -- 광택도전면1Coat하한/상한값
    ,A.LUS_RT_FRN_2COT_LLV || ' - ' || A.LUS_RT_FRN_2COT_ULV AS LUS_RT_FRN_2COT -- 광택도전면2Coat하한/상한값
    ,A.LUS_RT_FRN_3COT_LLV || ' - ' || A.LUS_RT_FRN_3COT_ULV AS LUS_RT_FRN_3COT -- 광택도전면3Coat하한/상한값
    ,A.LUS_RT_FRN_4COT_LLV || ' - ' || A.LUS_RT_FRN_4COT_ULV AS LUS_RT_FRN_4COT -- 광택도전면4Coat하한/상한값
    ,A.LUS_RT_BAK_1COT_LLV || ' - ' || A.LUS_RT_BAK_1COT_ULV AS LUS_RT_BAK_1COT -- 광택도후면1Coat하한/상한값
    ,A.LUS_RT_BAK_2COT_LLV || ' - ' || A.LUS_RT_BAK_2COT_ULV AS LUS_RT_BAK_2COT -- 광택도후면2Coat하한/상한값
    ,A.LUS_RT_BAK_3COT_LLV || ' - ' || A.LUS_RT_BAK_3COT_ULV AS LUS_RT_BAK_3COT -- 광택도후면3Coat하한/상한값
    ,A.LUS_RT_BAK_4COT_LLV || ' - ' || A.LUS_RT_BAK_4COT_ULV AS LUS_RT_BAK_4COT -- 광택도후면4Coat하한/상한값
    ,A.LUS_RT_LMN_LLV || ' - ' || A.LUS_RT_LMN_ULV AS LUS_RT_LMN --광택도Lamina하한/상한값
    ,A.WK_VISCO_FRN_1COT --작업점도전면1Coat
    ,A.WK_VISCO_FRN_2COT --작업점도전면2Coat
    ,A.WK_VISCO_FRN_3COT --작업점도전면3Coat
    ,A.WK_VISCO_FRN_4COT --작업점도전면4Coat
    ,A.WK_VISCO_BAK_1COT --작업점도후면1Coat
    ,A.WK_VISCO_BAK_2COT --작업점도후면2Coat
    ,A.WK_VISCO_BAK_3COT --작업점도후면3Coat
    ,A.WK_VISCO_BAK_4COT --작업점도후면4Coat
    ,A.PMT_FRN_1COT --PMT전면1Coat
    ,A.PMT_FRN_2COT --PMT전면2Coat
    ,A.PMT_FRN_3COT --PMT전면3Coat
    ,A.PMT_FRN_4COT --PMT전면4Coat
    ,A.PMT_BAK_1COT --PMT후면1Coat
    ,A.PMT_BAK_2COT --PMT후면2Coat
    ,A.PMT_BAK_3COT --PMT후면3Coat
    ,A.PMT_BAK_4COT --PMT후면4Coat
    ,A.PMT_LMN --PMTLamina
    ,A.THR_CD_FRN_1COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'THR_CD_FRN_1COT' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.THR_CD_FRN_1COT) AS THR_CD_FRN_1COT  --신나코드전면1Coat
    ,A.THR_CD_FRN_2COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'THR_CD_FRN_2COT' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.THR_CD_FRN_2COT) AS THR_CD_FRN_2COT --신나코드전면2Coat
    ,A.THR_CD_FRN_3COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'THR_CD_FRN_3COT' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.THR_CD_FRN_3COT) AS THR_CD_FRN_3COT --신나코드전면3Coat
    ,A.THR_CD_FRN_4COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'THR_CD_FRN_4COT' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.THR_CD_FRN_4COT) AS THR_CD_FRN_4COT --신나코드전면4Coat
    ,A.THR_CD_BAK_1COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'THR_CD_BAK_1COT' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.THR_CD_BAK_1COT) AS THR_CD_BAK_1COT --신나코드후면1Coat
    ,A.THR_CD_BAK_2COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'THR_CD_BAK_2COT' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.THR_CD_BAK_2COT) AS THR_CD_BAK_2COT --신나코드후면2Coat
    ,A.THR_CD_BAK_3COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'THR_CD_BAK_3COT' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.THR_CD_BAK_3COT) AS THR_CD_BAK_3COT --신나코드후면3Coat
    ,A.THR_CD_BAK_4COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'THR_CD_BAK_4COT' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.THR_CD_BAK_4COT) AS THR_CD_BAK_4COT --신나코드후면4Coat
    ,A.CLR_DIF_FRN_LLV --색차전면하한값
    ,A.CLR_DIF_FRN_ULV --색차전면상한값
    ,A.CLR_DIF_BAK_LLV --색차후면하한값
    ,A.CLR_DIF_BAK_ULV --색차후면상한값
    ,A.MPR_BAS_PNCL_HRDN_FRN --물성기준연필경도전면
    ,A.MPR_BAS_PNCL_HRDN_BAK --물성기준연필경도후면
    ,A.MPR_BAS_MEK_FRN --물성기준MEK전면
    ,A.MPR_BAS_MEK_BAK --물성기준MEK후면
    ,A.CLR_BND_TST_FRN_STD_CD --칼라Bending전면기준코드
    ,A.CLR_BND_TST_FRN_GRD_PNT --칼라Bending시험전면평점
    ,A.CLR_BND_TST_BAK_STD_CD --칼라Bending후면기준코드
    ,A.CLR_BND_TST_BAK_GRD_PNT --칼라Bending시험후면평점
    ,A.PTT_FLM_DTL_CD || ' / ' || DECODE(A.PTT_FLM_DTL_CD,'','',A.PTT_FLM_DTL_CD_N) AS PTT_FLM_DTL_CD --보호필름상세코드       			
    ,(SELECT CD_V || ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_LUS_RT_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.PTT_FLM_LUS_RT_CD) AS PTT_FLM_LUS_RT_CD--보호필름광택코드 
    ,(SELECT CD_V || ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_THK_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.PTT_FLM_THK_CD) AS PTT_FLM_THK_CD--보호필름두께코드 
    ,(SELECT CD_V || ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_MQL_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.PTT_FLM_MQL_CD) AS PTT_FLM_MQL_CD--보호필름재질코드 
    ,(SELECT CD_V || ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_SUS_ADH_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.PTT_FLM_SUS_ADH_CD) || ' / ' ||
      (SELECT CD_V || ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_SUS_ADH_CD_N'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = DECODE(A.PTT_FLM_DTL_CD,'','',SUBSTR(A.PTT_FLM_SUS_ADH_CD_N,1,1))) AS PTT_FLM_SUS_ADH_CD--보호필름SUS점착력코드          
    ,(SELECT CD_V || ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_PRD_ADH_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.PTT_FLM_PRD_ADH_CD) AS PTT_FLM_PRD_ADH_CD--보호필름제품점착력코드 
    ,A.LMN_KND_TP || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LMN_KND_TP' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LMN_KND_TP) AS LMN_KND_TP --Lamina유형
    ,A.LMN_BND_CD || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'LMN_BND_CD' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.LMN_BND_CD) AS LMN_BND_CD  --Lamina접착제코드
    ,A.LMN_BND_THR_CD || 
    (SELECT ' : ' || CD_V_MEANING 
     FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'LMN_BND_THR_CD' 
     AND   CATEGORY_GROUP_NM = 'SZ0000'
     AND   CD_V = A.LMN_BND_THR_CD) AS LMN_BND_THR_CD  --Lamina접착제신나코드
    ,A.LMN_BND_CD1              --Lamina접착제코드1
    ,A.LMN_BND_THR_CD1        --Lamina접착제신나코드1
    ,A.LMN_FLM_THK_CD || 
    (SELECT ' : ' || CD_V_MEANING 
    FROM M00APUSER.VI_M00_CODE_ACCESS
    WHERE CD_TP = 'LMN_FLM_THK_CD' 
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = A.LMN_FLM_THK_CD) AS LMN_FLM_THK_CD --Lamina필름두께코드
    ,A.LMN_FLM_WTH_CD	--Lamina필름폭코드
    ,A.PRT_ROLL_NO1 --PrintRollNo전면1도
    ,A.PRT_ROLL_NO2 --PrintRollNo전면2도
    ,A.PRT_ROLL_NO3 --PrintRollNo전면3도
    ,A.PRT_ROLL_NO4 --PrintRollNo전면4도
    ,A.PRT_INK_CD1 --PrintInkCode전면1도
    ,A.PRT_INK_CD2 --PrintInkCode전면2도
    ,A.PRT_INK_CD3 --PrintInkCode전면3도
    ,A.PRT_INK_CD4 --PrintInkCode전면4도
    ,A.PRT_ROLL_PTN_CD1--PrintRollPatternCode전면1도
    ,A.PRT_ROLL_PTN_CD2--PrintRollPatternCode전면2도
    ,A.PRT_ROLL_PTN_CD3--PrintRollPatternCode전면3도
    ,A.PRT_ROLL_PTN_CD4--PrintRollPatternCode전면4도
    ,A.PRT_ROLL_BAK_NO1 --PrintRollNo후면1도
    ,A.PRT_ROLL_BAK_NO2 --PrintRollNo후면2도
    ,A.PRT_ROLL_BAK_NO3 --PrintRollNo후면3도
    ,A.PRT_ROLL_BAK_NO4 --PrintRollNo후면4도
    ,A.PRT_INK_BAK_CD1 --PrintInkCode후면1도
    ,A.PRT_INK_BAK_CD2 --PrintInkCode후면2도
    ,A.PRT_INK_BAK_CD3 --PrintInkCode후면3도
    ,A.PRT_INK_BAK_CD4 --PrintInkCode후면4도
    ,A.PRT_ROLL_PTN_BAK_CD1--PrintRollPatternCode후면1도
    ,A.PRT_ROLL_PTN_BAK_CD2--PrintRollPatternCode후면2도
    ,A.PRT_ROLL_PTN_BAK_CD3--PrintRollPatternCode후면3도
    ,A.PRT_ROLL_PTN_BAK_CD4--PrintRollPatternCode후면4도    
    ,A.MAIN_PROC_CD --주공정코드
    ,A.SUB_PROC_CD1 --대체공정코드1
    ,A.SUB_PROC_CD2 --대체공정코드2
    ,A.SUB_PROC_CD3 --대체공정코드3
    ,A.CCL_QLT_MSG_TXT -- CCL공정품질메시지
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_FRN_1COT) AS CLR_SUB_MTL_CD_OLD_FRN_1COT--구색상코드전면1Coat
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_FRN_2COT) AS CLR_SUB_MTL_CD_OLD_FRN_2COT--구색상코드전면2Coat
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_FRN_3COT) AS CLR_SUB_MTL_CD_OLD_FRN_3COT--구색상코드전면3Coat
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_FRN_4COT) AS CLR_SUB_MTL_CD_OLD_FRN_4COT--구색상코드전면4Coat
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_BAK_1COT) AS CLR_SUB_MTL_CD_OLD_BAK_1COT--구색상코드후면1Coat
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_BAK_2COT) AS CLR_SUB_MTL_CD_OLD_BAK_2COT--구색상코드후면2Coat
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_BAK_3COT) AS CLR_SUB_MTL_CD_OLD_BAK_3COT--구색상코드후면3Coat
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_BAK_4COT) AS CLR_SUB_MTL_CD_OLD_BAK_4COT --구색상코드후면4Coat 
    ,(SELECT CLR_SUB_MTL_CD_OLD 
      FROM TB_C10_CLR_CD_MNG
      WHERE CLR_SUB_MTL_CD = A.HUE_CD_LMN) AS CLR_SUB_MTL_CD_OLD_HUE_CD_LMN--Lamina구색상코드      
    ,A.PRT_USG_CD || 
    (SELECT ' : ' || CD_V_MEANING 
    FROM M00APUSER.VI_M00_CODE_ACCESS
    WHERE CD_TP = 'PRT_USG_CD' 
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = A.PRT_USG_CD) AS PRT_USG_CD --프린트용도코드
    ,A.PRT_PTN_CD || 
    (SELECT ' : ' || CD_V_MEANING 
    FROM M00APUSER.VI_M00_CODE_ACCESS
    WHERE CD_TP = 'PRT_PTN_CD' 
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = A.PRT_PTN_CD) AS PRT_PTN_CD --프린트패턴코드
    ,A.UNI_TEX_PTN_CD   -- Uni-Tex패턴코드
    ,A.UNI_TEX_ROLL_NO  -- Uni-Tex Roll번호
    ,A.PICK_UP_ROLL_NO  -- Pick-Up Roll번호
    ,A.UNI_GLS_FLM_CD   -- Uni-Glass Film코드
    ,A.TLP_TP || 
    (SELECT ' : ' || CD_V_MEANING 
    FROM M00APUSER.VI_M00_CODE_ACCESS
    WHERE CD_TP = 'TLP_TP' 
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = A.TLP_TP) AS TLP_TP --무독성구분
    ,A.CUT_LN_YN-- 재단선유무
    ,(SELECT CCL_THK_TRV
      FROM C10APUSER.TB_C10_QLT_DSN_MNF
      WHERE ORD_NO = :ORD_NO
      AND ORD_LN = :ORD_LN
      AND QLT_DSN_MNF_TP ='1') AS CCL_THK_TRV--CCL두께목표값
    ,(SELECT CCL_WTH_TRV  
      FROM C10APUSER.TB_C10_QLT_DSN_MNF
      WHERE ORD_NO = :ORD_NO
      AND ORD_LN = :ORD_LN
      AND QLT_DSN_MNF_TP ='1') AS CCL_WTH_TRV--CCL폭목표값
    ,A.IMPT_ROLL_NO         --ImprintingRollNo
    ,A.IMPT_ROLL_BAK_NO   --ImprintingRollNo후면
    ,B.ORD_USG_CD
    ,B.FNL_CUS_CD
    ,NVL(A.PTT_FLM_MNG_ADH_TXT,(SELECT CD_V || ' : ' || CD_V_MEANING 
     				FROM M00APUSER.VI_M00_CODE_ACCESS
				WHERE CD_TP = 'PTT_FLM_PRD_ADH_CD'         
			        AND   CATEGORY_GROUP_NM = 'SZ0000'
		  	        AND   CD_V = A.PTT_FLM_PRD_ADH_CD))  AS PTT_FLM_MNG_ADH_TXT
    , KEY_WRD1
    , KEY_WRD2
    , KEY_WRD3
    , KEY_WRD4
    , KEY_WRD1_LNK
    , KEY_WRD2_LNK
    , KEY_WRD3_LNK
    , KEY_WRD4_LNK
    ,A.RSN_TP_QT_BR_FRN_1COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP_QT_BR' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = RSN_TP_QT_BR_FRN_1COT) RSN_TP_QT_BR_FRN_1COT --품질수지구분전면1Coat
    ,A.RSN_TP_QT_BR_FRN_2COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP_QT_BR' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_QT_BR_FRN_2COT) RSN_TP_QT_BR_FRN_2COT --품질수지구분전면2Coat
    ,A.RSN_TP_QT_BR_FRN_3COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP_QT_BR' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_QT_BR_FRN_3COT) RSN_TP_QT_BR_FRN_3COT --품질수지구분전면3Coat
    ,A.RSN_TP_QT_BR_FRN_4COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP_QT_BR' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_QT_BR_FRN_4COT) RSN_TP_QT_BR_FRN_4COT --품질수지구분전면4Coat
    ,A.RSN_TP_QT_BR_BAK_1COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP_QT_BR' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_QT_BR_BAK_1COT) RSN_TP_QT_BR_BAK_1COT --품질수지구분후면1Coat
    ,A.RSN_TP_QT_BR_BAK_2COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP_QT_BR' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_QT_BR_BAK_2COT) RSN_TP_QT_BR_BAK_2COT --품질수지구분후면2Coat
    ,A.RSN_TP_QT_BR_BAK_3COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP_QT_BR' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_QT_BR_BAK_3COT) RSN_TP_QT_BR_BAK_3COT --품질수지구분후면3Coat
    ,A.RSN_TP_QT_BR_BAK_4COT || 
     (SELECT ' : ' || CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'RSN_TP_QT_BR' 
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = A.RSN_TP_QT_BR_BAK_4COT) RSN_TP_QT_BR_BAK_4COT --품질수지구분후면4Coat
FROM  TB_C10_QLT_DSN_CCL_BOM A
     ,TB_C10_QLT_DSN_CMN     B
WHERE A.ORD_NO = B.ORD_NO
AND   A.ORD_LN = B.ORD_LN 
AND   A.ORD_NO = :ORD_NO
AND   A.ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.MNFupdate" desc="C104000020TAB07.MNFupdate" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 칼라-제조사양 C104000020TAB07.MNFupdate 박재영*/                      
TB_C10_QLT_DSN_MNF
SET    
       LAST_UPDATED_OBJECT_TYPE = :ObjectType      --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = :ObjectId              --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = :ProgramId         --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = :Timestamp          --최종변경일시   
      ,CCL_THK_TRV  = :CCL_THK_TRV                       --CCL두께목표값 
      ,CCL_WTH_TRV	= :CCL_WTH_TRV                      --CCL폭목표값
WHERE ORD_NO = :ORD_NO                             --주문번호                                                                                      
  AND ORD_LN = :ORD_LN                             --주문행번
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.CMNselect" desc="C104000020TAB07.CMNselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C10 칼라-제조사양 C104000020TAB07.CMNselect 박재영 */ 
	     EMBS_CD || 
             (SELECT ' : ' || CD_V_MEANING 
              FROM M00APUSER.VI_M00_CODE_ACCESS
              WHERE CD_TP = 'EMBS_CD' 
              AND   CD_V = EMBS_CD
              AND   CATEGORY_GROUP_NM = 'SZ0000') EMBS_CD
        ,BAK_MRK --Back마킹
        ,ORD_PTT_FLM_WTH           --주문보호필름폭
        ,PTT_FLM_NOT_ADH_WS      --보호필름미부착폭WS
        ,PTT_FLM_NOT_ADH_DS       --보호필름미부착폭DS
   FROM TB_C10_QLT_DSN_CMN A
WHERE  ORD_NO = :ORD_NO
AND   ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.STSselect" desc="C104000020TAB07.STSselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C104000020TAB07.STSselect 박재영*/      
*                               
 FROM TB_C10_QLT_DSN_CMN
 WHERE ORD_NO = :ORD_NO
 AND    ORD_LN = :ORD_LN
 AND    QLT_DSN_STS_CD = 'A'
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.CCLupdate" desc="C104000020TAB07.CCLupdate" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /* C10 칼라-제조사양메세지 C104000020TAB07.CCLupdate 박재영*/                      
    TB_C10_QLT_DSN_CCL_BOM
SET    
    LAST_UPDATED_OBJECT_TYPE = :ObjectType      --최종변경OBJECT유형
    ,LAST_UPDATED_OBJECT_ID = :ObjectId              --최종변경OBJECTID  
    ,LAST_UPDATE_PROGRAM_ID = :ProgramId         --최종변경프로그램ID
    ,LAST_UPDATE_TIMESTAMP = :Timestamp          --최종변경일시   
    ,CCL_QLT_MSG_TXT = :CCL_QLT_MSG_TXT          --품질Message
WHERE ORD_NO = :ORD_NO                             --주문번호                                                                                      
  AND ORD_LN = :ORD_LN                             --주문행번
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.CCLupdate1" desc="C104000020TAB07.CCLupdate1" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /* C10 칼라-제조사양메세지 C104000020TAB07.CCLupdate1 이돈석*/                      
    TB_C10_QLT_DSN_CCL_BOM
SET    
    LAST_UPDATED_OBJECT_TYPE = :ObjectType      --최종변경OBJECT유형
    ,LAST_UPDATED_OBJECT_ID = :ObjectId              --최종변경OBJECTID  
    ,LAST_UPDATE_PROGRAM_ID = :ProgramId         --최종변경프로그램ID
    ,LAST_UPDATE_TIMESTAMP = :Timestamp          --최종변경일시   
    ,KEY_WRD1 = :KEY_WRD1
    ,KEY_WRD2 = :KEY_WRD2
    ,KEY_WRD3 = :KEY_WRD3
    ,KEY_WRD4 = :KEY_WRD4
    ,KEY_WRD1_LNK = :KEY_WRD1
    ,KEY_WRD2_LNK = :KEY_WRD2
    ,KEY_WRD3_LNK = :KEY_WRD3
    ,KEY_WRD4_LNK = :KEY_WRD4
WHERE ORD_NO = :ORD_NO                             --주문번호                                                                                      
  AND ORD_LN = :ORD_LN                             --주문행번
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.CHG_HSTinsert" desc="C104000020TAB07.CHG_HSTinsert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 품질설계결과수정이력 C104000020TAB07.CHG_HSTinsert 박재영*/
            TB_C10_QLT_DSN_CHG_HST
            (    
              ORD_NO                      --주문번호
		     ,ORD_LN                      --주문행번
		     ,SEQ	                      --수정SEQ
		     ,CHG_TXT                     --수정내역
             ,CREATED_OBJECT_TYPE
             ,CREATED_OBJECT_ID
             ,CREATED_PROGRAM_ID
             ,CREATION_TIMESTAMP
             ,LAST_UPDATED_OBJECT_TYPE
             ,LAST_UPDATED_OBJECT_ID
             ,LAST_UPDATE_PROGRAM_ID
             ,LAST_UPDATE_TIMESTAMP
            )
VALUES
            (
              :ORD_NO
              ,:ORD_LN 
              ,NVL((SELECT MAX(SEQ) + 1 FROM TB_C10_QLT_DSN_CHG_HST WHERE ORD_NO = :ORD_NO AND ORD_LN = :ORD_LN),1)
              ,'C104000020TAB07'
              ,:ObjectType
              ,:ObjectId
              ,:ProgramId
              ,:Timestamp
              ,:ObjectType
              ,:ObjectId
              ,:ProgramId
              ,:Timestamp
            )
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.CCLBOMupdate" desc="C104000020TAB07.CCLBOMupdate" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /* C10 칼라-제조사양메세지 C104000020TAB07.CCLBOMupdate 박재영*/                      
C10APUSER.TB_C10_CLR_MPR
SET    LAST_UPDATED_OBJECT_TYPE = :ObjectType      --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = :ObjectId          --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = :ProgramId         --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = :Timestamp          --최종변경일시   
      ,CCL_QLT_MSG_TXT = :CCL_QLT_MSG_TXT
WHERE CCL_BOM_NO = (SELECT CCL_BOM_NO FROM TB_C10_QLT_DSN_CMN
                     WHERE ORD_NO = :ORD_NO
                       AND ORD_LN = :ORD_LN)
    AND ((CUS_CD = '******' AND ORD_USG_CD ='******')
       OR (CUS_CD = '******' AND ORD_USG_CD =:ORD_USG_CD)
       OR (CUS_CD = :FNL_CUS_CD AND ORD_USG_CD ='******')
       OR (CUS_CD = :FNL_CUS_CD AND ORD_USG_CD = :ORD_USG_CD) )
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.CCLMPRinsert" desc="C104000020TAB07.CCLMPRinsert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 CCL-BOM관리 C104000020TAB07.CCLMPRinsert  김종화  */   
INTO EAIAPUSER.TB_C10_B10S0120
(
      IF_GRP_ID                                         --인터페이스그룹아이디
    , SEQ_NO                                            --인터페이스 SEQ
    , XSEQ                                              --PI Sequence Key Value
    , XCRUD                                             --PI Data 유형
    , XSTAT                                             --처리상태 
    , XDATE                                             --응답날짜
    , XTIME                                             --응답시간
    , CCL_BOM_NO                                        --CCLBOM번호
    , CUS_CD                                            --고객사코드
    , ORD_USG_CD                                        --주문용도코드
    , PTT_FLM_DTL_CD                                    --보호필름상세코드
    , PTT_FLM_PRD_ADH_NM                                --보호필름제품점착력명
    , PTT_FLM_THK_NM                                    --보호필름두께명
    , PTT_FLM_MQL_NM                                    --보호필름재질명
    , UNI_GLS_FLM_CD                                    --UniGls필름코드    
    , CCL_QLT_MSG_TXT                                   --품질메시지
    , CREATED_OBJECT_TYPE                               --생성Object유형
    , CREATED_OBJECT_ID                                 --생성ObjectID 
    , CREATED_PROGRAM_ID                                --생성프로그램ID
    , CREATION_TIMESTAMP                                --생성일시 
    , LAST_UPDATED_OBJECT_TYPE                          --최종변경Object유형
    , LAST_UPDATED_OBJECT_ID                            --최종변경ObjectID 
    , LAST_UPDATE_PROGRAM_ID                            --최종변경프로그램ID
    , LAST_UPDATE_TIMESTAMP                             --최종변경일시
)
SELECT 
    TO_CHAR(SYSTIMESTAMP, 'YYYYMMDDHH24MISSFF4') IF_GRP_ID --인터페이스그룹아이디
    , EAIAPUSER.SQ_C10_B10S0120.NEXTVAL                           --인터페이스 SEQ
    , '1'                                               --PI Sequence Key Value
    , 'C'                                               --PI Data 유형
    , 'R'                                               --처리상태
    , SUBSTR(:IF_GRP_ID, 1, 8)                          --응답날짜
    , SUBSTR(:IF_GRP_ID, 9, 6)                          --응답시간
    , CCL_BOM_NO                                       --CCLBOM번호
    , CUS_CD                                           --고객사코드
    , ORD_USG_CD                                       --주문용도코드
    , PTT_FLM_DTL_CD                                   --보호필름상세코드
    , (SELECT CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_PRD_ADH_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = SUBSTR(PTT_FLM_DTL_CD,5,1))  AS PTT_FLM_PRD_ADH_CD_NM_MASTER                     --보호필름제품점착력명
    ,     (SELECT CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_THK_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = SUBSTR(PTT_FLM_DTL_CD,2,1)) AS PTT_FLM_THK_CD_NM_MASTER                         --보호필름두께명
    ,   (SELECT CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_MQL_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = SUBSTR(PTT_FLM_DTL_CD,3,1)) AS PTT_FLM_MQL_CD_NM_MASTER                         --보호필름재질명
    , UNI_GLS_FLM_CD                                   --UNIGLS필름코드   
    , CCL_QLT_MSG_TXT                                  --품질메시지
    , :ObjectType                                      
    , :ObjectId                                        
    , :ProgramId                                       
    , :Timestamp                                       
    , :ObjectType                                      
    , :ObjectId                                        
    , :ProgramId                                       
    , :Timestamp                                       
 FROM C10APUSER.TB_C10_CLR_MPR   
 WHERE CCL_BOM_NO =( SELECT CCL_BOM_NO 
                                    FROM C10APUSER.TB_C10_QLT_DSN_CMN 
                                    WHERE ORD_NO = :ORD_NO
                                       AND ORD_LN = :ORD_LN )
   AND CUS_CD = '******'
  AND ORD_USG_CD ='******'
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.CLR_MPR_MDF_LOG_Inst" desc="품질설계 CCL-BOM관리 이력" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 품질설계 CCL-BOM관리 LOG C104000020TAB07.CLR_MPR_MDF_LOG_Inst 전경진*/ TB_C10_CLR_MPR_MDF_LOG(
    CCL_BOM_NO,--CCLBOM번호
    CUS_CD,--고객사코드
    ORD_USG_CD,--주문용도코드
    MDF_SEQ, --수정 Seq
    MDF_RSN, --수정 사유
    PTT_FLM_DTL_CD,--보호필름상세코드
    PTT_FLM_DTL_CD_N,--구보호필름상세코드
    UNI_GLS_FLM_CD,--UGS필름
    CLR_DIF_FRN_LLV,--색차전면하한값
    CLR_DIF_FRN_ULV,--색차전면상한값
    CLR_DIF_BAK_LLV,--색차후면하한값
    CLR_DIF_BAK_ULV,--색차후면상한값
    MPR_BAS_PNCL_HRDN_FRN,--물성기준연필경도전면
    MPR_BAS_PNCL_HRDN_BAK,--물성기준연필경도후면
    MPR_BAS_MEK_FRN,--물성기준MEK전면
    MPR_BAS_MEK_BAK,--물성기준MEK후면
    CLR_BND_TST_FRN_STD_CD,--칼라Bending전면기준코드
    CLR_BND_TST_FRN_GRD_PNT,--칼라Bending시험전면평점
    CLR_BND_TST_BAK_STD_CD,--칼라Bending후면기준코드
    CLR_BND_TST_BAK_GRD_PNT,--칼라Bending시험후면평점
    PTT_FLM_ADH_LLV,--보호필름점착력하한
    PTT_FLM_ADH_ULV,--보호필름점착력상한
    CCL_QLT_MSG_TXT,--CCL공정품질메시지
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
) SELECT 
    A.CCL_BOM_NO,--CCLBOM번호
    A.CUS_CD,--고객사코드
    A.ORD_USG_CD,--주문용도코드
    nvl((select max(mdf_seq)+1 from TB_C10_CLR_MPR_MDF_LOG where CCL_BOM_NO = A.CCL_BOM_NO and CUS_CD = A.CUS_CD and ORD_USG_CD = A.ORD_USG_CD),0), --수정 Seq No
    '품질설계 결과 동기화', -- 수정 사유
    A.PTT_FLM_DTL_CD,--보호필름상세코드
    A.PTT_FLM_DTL_CD_N,--구보호필름상세코드
    A.UNI_GLS_FLM_CD,--UGS필름
    A.CLR_DIF_FRN_LLV,--색차전면하한값
    A.CLR_DIF_FRN_ULV,--색차전면상한값
    A.CLR_DIF_BAK_LLV,--색차후면하한값
    A.CLR_DIF_BAK_ULV,--색차후면상한값
    A.MPR_BAS_PNCL_HRDN_FRN,--물성기준연필경도전면
    A.MPR_BAS_PNCL_HRDN_BAK,--물성기준연필경도후면
    A.MPR_BAS_MEK_FRN,--물성기준MEK전면
    A.MPR_BAS_MEK_BAK,--물성기준MEK후면
    A.CLR_BND_TST_FRN_STD_CD,--칼라Bending전면기준코드
    A.CLR_BND_TST_FRN_GRD_PNT,--칼라Bending시험전면평점
    A.CLR_BND_TST_BAK_STD_CD,--칼라Bending후면기준코드
    A.CLR_BND_TST_BAK_GRD_PNT,--칼라Bending시험후면평점
    A.PTT_FLM_ADH_LLV,--보호필름점착력하한
    A.PTT_FLM_ADH_ULV,--보호필름점착력상한
    A.CCL_QLT_MSG_TXT,--CCL공정품질메시지
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp
     FROM C10APUSER.TB_C10_CLR_MPR  A
  WHERE A.CCL_BOM_NO =( SELECT CCL_BOM_NO 
                        FROM C10APUSER.TB_C10_QLT_DSN_CMN 
                        WHERE ORD_NO = :ORD_NO
                        AND ORD_LN = :ORD_LN )
  AND ((A.CUS_CD = '******' AND A.ORD_USG_CD ='******')
       OR (A.CUS_CD = '******' AND A.ORD_USG_CD =:ORD_USG_CD)
       OR (A.CUS_CD = :FNL_CUS_CD AND A.ORD_USG_CD ='******')
       OR (A.CUS_CD = :FNL_CUS_CD AND A.ORD_USG_CD = :ORD_USG_CD) )
		 ]]> 
	 </query>
	 <query id="C104000020TAB07.CCLBOMKWDupdate" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /* C10 칼라-제조사양메세지 C104000020TAB07.CCLBOMKWDupdate 이돈석*/                      
C10APUSER.TB_C10_CLR_MPR
SET    LAST_UPDATED_OBJECT_TYPE = :ObjectType      --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = :ObjectId          --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = :ProgramId         --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = :Timestamp          --최종변경일시   
      ,KEY_WRD1 = :KEY_WRD1  --키워드1
      ,KEY_WRD2 = :KEY_WRD2  --키워드2
      ,KEY_WRD3 = :KEY_WRD3  --키워드3
      ,KEY_WRD4 = :KEY_WRD4  --키워드4
WHERE CCL_BOM_NO = (SELECT CCL_BOM_NO FROM TB_C10_QLT_DSN_CMN
                     WHERE ORD_NO = :ORD_NO
                       AND ORD_LN = :ORD_LN)
    AND ((CUS_CD = '******' AND ORD_USG_CD ='******')
       OR (CUS_CD = '******' AND ORD_USG_CD =:ORD_USG_CD)
       OR (CUS_CD = :FNL_CUS_CD AND ORD_USG_CD ='******')
       OR (CUS_CD = :FNL_CUS_CD AND ORD_USG_CD = :ORD_USG_CD))
		 ]]> 
	 </query>
</queryMap>
