<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000060pop01 Page 쿼리파일"> 
	 <query id="C106000060pop01.select" desc="C106000060pop01 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 칼라롤관리기준popup조회 C106000060pop01.SELECT 김종범*/   
PRT_ROLL_NO, -- ROLL NO
RPV_CLR_NM, --대표색상
PRC_CD, --적용라인
PTN_NM, --PATTERN 명
PRT_PTN_CD, --프린트패턴코드
PRT_ROLL_PTN_CD, --롤패턴코드
(SELECT  CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRT_ROLL_PTN_CD'         
         AND   CATEGORY_GROUP_NM = 'SU0000'
         AND   CD_V = PRT_ROLL_PTN_CD) AS PRT_ROLL_PTN_NM, --원단위
PRT_ROLL_WHS_DD -- 롤 입고일자
FROM M00APUSER.VI_M00_C10A1091
WHERE NVL(PRT_ROLL_NO,'%') LIKE '%'|| :PRT_ROLL_NO ||'%'
AND NVL(RPV_CLR_NM,'%') LIKE '%'|| :RPV_CLR_NM ||'%'
AND NVL(PTN_NM,'%') LIKE '%'|| :PTN_NM ||'%'
ORDER BY PRT_ROLL_NO
		 ]]> 
	 </query>
</queryMap>
