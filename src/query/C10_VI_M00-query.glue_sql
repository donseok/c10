<queryMap desc="VI_M00"> 
	 <query id="C10A1022" desc="" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 Master Data 고객재질사양 조회 C10A1022.SELECT 김종범*/    
             *
  FROM M00APUSER.VI_M00_C10A1022
 WHERE CUS_BTH_PAP_NO = ?
		 ]]> 
	 </query>
	 <query id="C10A1010" desc="Master Data 규격공통사양 인수도규격 조회" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 Master Data 규격공통사양 MD 조회 C10A1010.SELECT 김종범*/                             
       SPC_NM,
       SPC_FUL_NM,
       ORD_GRA,
       ACPT_RT_SPC,                    --인수도규격 
       MQL_CD
 FROM M00APUSER.VI_M00_C10A1010       --규격공통VIEW                                                                               
WHERE SPC_AVR = ?                    --규격약호                                                                   
  AND SPC_YR = ?                     --규격년도
		 ]]> 
	 </query>
