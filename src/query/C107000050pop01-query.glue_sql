<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000050pop01 Page 쿼리파일"> 
	 <query id="C107000050pop01.insert" desc="C107000050pop01 정보 insert/update" fetchSize="10" isNamed="true">
		 <![CDATA[ 
MERGE INTO #TABLE_NAME#
       USING DUAL
       ON(DT_NM_ID =:DT_NM_ID)
  WHEN MATCHED THEN
UPDATE SET
     STANDARD_ENGLISH_ID = :STANDARD_ENGLISH_ID            --표준항목ID
    ,STANDARD_KOREAN_NAME = :STANDARD_KOREAN_NAME          --표준항목명
    ,DT_NM_DATA_TP = :DT_NM_DATA_TP                        --항목데이터Type
    ,DT_NM_LEN = :DT_NM_LEN                                --항목길이
    ,DT_NM_DECIMAL_PREC = :DT_NM_DECIMAL_PREC              --항목소수점이하자리
    ,USE_TP = :USE_TP                                      --사용구분
    ,SYS_TP = :SYS_TP                                      --시스템구분
    ,CHAIN_CODE = :CHAIN_CODE                              --체인구분
    ,LAST_UPDATED_OBJECT_TYPE = :ObjectType                --최종변경Object유형
    ,LAST_UPDATED_OBJECT_ID = :ObjectId                    --최종변경ObjectID
    ,LAST_UPDATE_PROGRAM_ID = :ProgramId                   --최종변경프로그램ID
    ,LAST_UPDATE_TIMESTAMP = :Timestamp                    --최종변경일자
  WHEN NOT MATCHED THEN
INSERT	
    (DT_NM_ID                                              --항목ID
	,STANDARD_ENGLISH_ID                                   --표준항목ID
	,STANDARD_KOREAN_NAME                                  --표준항목명
	,DT_NM_DATA_TP                                         --항목데이터Type
	,DT_NM_LEN                                             --항목길이
	,DT_NM_DECIMAL_PREC                                    --항목소수점이하자리
    ,USE_TP                                                --사용구분
	,SYS_TP                                                --시스템구분
	,CHAIN_CODE                                            --체인구분
	,CREATED_OBJECT_TYPE                                   --생성Object유형
	,CREATED_OBJECT_ID                                     --생성ObjectID
	,CREATED_PROGRAM_ID                                    --생성프로그램ID
	,CREATION_TIMESTAMP                                    --생성일시
	,LAST_UPDATED_OBJECT_TYPE                              --최종변경Object유형
	,LAST_UPDATED_OBJECT_ID                                --최종변경ObjectID
	,LAST_UPDATE_PROGRAM_ID                                --최종변경프로그램ID
	,LAST_UPDATE_TIMESTAMP                                 --최종변경일자
        )
VALUES 
    (:DT_NM_ID                                             --항목ID
	,:STANDARD_ENGLISH_ID                                  --표준항목ID
	,:STANDARD_KOREAN_NAME                                 --표준항목명
	,:DT_NM_DATA_TP                                        --항목데이터Type
	,:DT_NM_LEN                                            --항목길이
	,:DT_NM_DECIMAL_PREC                                   --항목소수점이하자리
    ,:USE_TP                                               --사용구분
	,:SYS_TP                                               --시스템구분
	,:CHAIN_CODE                                           --체인구분
	,:ObjectType                                           --생성Object유형
	,:ObjectId                                             --생성ObjectID
	,:ProgramId                                            --생성프로그램ID
	,:Timestamp                                            --생성일시
	,:ObjectType                                           --최종변경Object유형
	,:ObjectId                                             --최종변경ObjectID
	,:ProgramId                                            --최종변경프로그램ID
	,:Timestamp                                            --최종변경일자
    )
		 ]]> 
	 </query>
	 <query id="C107000050pop01.update" desc="C107000050pop01.update" fetchSize="10" isNamed="false">
