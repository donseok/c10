<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000130pop01 Page 쿼리파일"> 
	 <query id="C106000130.update" desc="C10 품질설계 재설계 C106000130.update 이돈석" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 재설계 C106000130.update 이돈석 */ 
TB_C10_QLT_DSN_CMN SET
QLT_DSN_STS_CD = 'I', 
QLT_DSN_ERR_YN = 'N',
QLT_RDSN_DH = SYSDATE,
QLT_RDSN_PRS_ID = SUBSTR(:ObjectId,1,10),
QLT_DSN_YN = 'Y',
LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
LAST_UPDATED_OBJECT_ID=:ObjectId,      
LAST_UPDATE_PROGRAM_ID=:ProgramId,     
LAST_UPDATE_TIMESTAMP=:Timestamp      
WHERE  ORD_NO= :ORD_NO
AND ORD_LN= :ORD_LN
		 ]]> 
	 </query>
	 <query id="C106000130.update2" desc="C10 품질설계 재설계 C106000130.update2 이돈석" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 재설계 C106000130.update2 이돈석 */ 
TB_C10_QLT_DSN_CMN SET
QLT_DSN_STS_CD = 'A',
QLT_DSN_YN = 'N',
LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
LAST_UPDATED_OBJECT_ID=:ObjectId,      
LAST_UPDATE_PROGRAM_ID=:ProgramId,     
LAST_UPDATE_TIMESTAMP=:Timestamp      
WHERE  ORD_NO= :ORD_NO
AND ORD_LN= :ORD_LN
		 ]]> 
	 </query>
</queryMap>
