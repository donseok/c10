	 <query id="C102100MNF.PROCupdate1" desc="C102100MNF.PROCupdate1" fetchSize="10" isNamed="false">
		 <![CDATA[ 
update /*+ C10 품질설계결과제조사양 공정별Size수정 C102100MNF.PROCupdate1 성낙원*/
