<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C102100MNF"> 
	 <query id="C102100MNF.insert" desc="C102100MNF.insert" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT INTO  /*+ C10 품질설계결과제조표준등록 C102100MNF.INSERT 박재영*/                           
TB_C10_QLT_DSN_MNF (                                                                           
            ORD_NO	                  --주문번호
           ,ORD_LN	                  --주문행번           
           ,QLT_DSN_MNF_TP	   --품질설계제조구분
           ,RMTL_CD	                  --원자재코드
           ,CRM_MNF_STD_NO	          --냉연제조표준번호
           ,ECL_CDR_CD		--ECLC-D방지약품
           ,ECL_COILG_TS_CD		--ECL권취장력
           ,CGL_LVL_YN		--CGLLeveler사용여부
           ,SPNL_TP		--Spangle구분
           ,CGL_SP_ASG_YN		--CGLSkinPass
           ,CGL_SUR_HND_CD		--CGL표면처리코드
           ,EGL_SUR_HND_CD	--EGL표면처리코드
           ,OIL_PNT_CD		--도유코드           
           ,CREATED_OBJECT_TYPE       --생성OBJECT유형                                                                 
           ,CREATED_OBJECT_ID         --생성OBJECTID                                                                   
           ,CREATED_PROGRAM_ID        --생성프로그램ID                                                                 
           ,CREATION_TIMESTAMP        --생성일시                                                                       
           ,LAST_UPDATED_OBJECT_TYPE  --최종변경OBJECT유형     
           ,LAST_UPDATED_OBJECT_ID    --최종변경OBJECTID       
           ,LAST_UPDATE_PROGRAM_ID    --최종변경프로그램ID     
           ,LAST_UPDATE_TIMESTAMP     --최종변경일시           
)                                                                                              
VALUES                                                                                         
(                                                                                              
?,?,?,?,
?,?,?,?,
?,?,?,?,?,
?,?,?,?,
?,?,?,?
)
		 ]]> 
	 </query>
	 <query id="C102100MNF.select" desc="C102100MNF.select" fetchSize="10" isNamed="false">
		 <![CDATA[ 
select /*+ C10 품질설계결과제조사양조회 C102100MNF.select 박재영*/ 
         *
FROM TB_C10_QLT_DSN_MNF
WHERE ORD_NO = ?
AND   ORD_LN = ?
ORDER BY QLT_DSN_MNF_TP
		 ]]> 
	 </query>
	 <query id="C102100MNF.select2" desc="C102100MNF.select2" fetchSize="10" isNamed="false">
		 <![CDATA[ 
select /*+ C10 품질설계결과제조사양조회-차선 C102100MNF.select SJS */ 
         *
FROM TB_C10_QLT_DSN_MNF
WHERE ORD_NO = ?
AND   ORD_LN = ?
AND   QLT_DSN_MNF_TP = '2'
ORDER BY QLT_DSN_MNF_TP
		 ]]> 
	 </query>	 
	 
	 <query id="C102100MNF.gw_update" desc="C102100MNF.gw_update" fetchSize="10" isNamed="false">
		 <![CDATA[ 
update /*+ C10 품질설계결과제조사양도금량수정 C102100MNF.gw_update 박재영*/
TB_C10_QLT_DSN_MNF SET
            LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
           ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
           ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
           ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
           ,WK_GW_TRV = ?	                --작업도금량목표값
           ,WK_GW_FRN_ULV = ?	            --작업도금량전면상한값
           ,WK_GW_FRN_LLV = ?	            --작업도금량전면하한값
           ,WK_GW_BAK_ULV = ?	            --작업도금량후면상한값
           ,WK_GW_BAK_LLV = ?	            --작업도금량후면하한값
           ,WK_GW_TOT_ULV = ?	            --작업도금량전체상한값
           ,WK_GW_TOT_LLV = ?	            --작업도금량전체하한값
           ,GAL_THK_LLV = ?	              --도금두께하한
           ,GAL_THK_ULV = ?	              --도금두께상한
           ,GAL_THK_TRV = ?	              --도금두께목표
           ,SPC_GAL_THK = ?                    --사양도금두께
WHERE ORD_NO = ?
AND   ORD_LN = ?
AND   QLT_DSN_MNF_TP = ?
		 ]]> 
	 </query>
