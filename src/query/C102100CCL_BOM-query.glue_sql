<queryMap desc="C102100CCL_BOM"> 
	 <query id="C102100CCL_BOM.select" desc="C102100CCL_BOM.select" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 CCL-BOM기준 조회 C102100CCL_BOM.select 박재영*/
           *
 FROM TB_C10_CCL_BOM
 WHERE CCL_BOM_NO = ?
		 ]]> 
	 </query>
