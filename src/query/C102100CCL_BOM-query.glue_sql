	 <query id="C102100CCL_BOM.Aselect" desc="C102100CCL_BOM.Aselect" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 칼라제조사양조회 C102100CCL_BOM.Aselect 박재영*/    
       *
  FROM TB_C10_QLT_DSN_CCL_BOM A,
       TB_C10_QLT_DSN_CMN B
 WHERE A.ORD_NO = B.ORD_NO
   AND A.ORD_LN = B.ORD_LN
   AND A.ORD_NO = ?
   AND A.ORD_LN = ?
		 ]]> 
	 </query>
	 <query id="C102100CCL_BOM.Adelete" desc="C102100CCL_BOM.Adelete" fetchSize="10" isNamed="false">
		 <![CDATA[ 
DELETE /*+ C10 칼라제조사양삭제 C102100CCL_BOM.Adelete 박재영*/    
 FROM TB_C10_QLT_DSN_CCL_BOM
 WHERE ORD_NO = ?
 AND    ORD_LN = ?
		 ]]> 
	 </query>
	 <query id="C102100CCL_BOM.CLR_USE_N_select" desc="C102100CCL_BOM.CLR_USE_N_select" fetchSize="10" isNamed="false">
		 <![CDATA[ 
select  /*+ C10 칼라코드 사용불가 갯수 조회 C102100CCL_BOM.CLR_USE_N_select 성낙원*/   
         count(*) as CLR_USE_N_CNT
from   C10APUSER.TB_C10_CLR_CD_MNG
where  nvl(USE_YN,' ') <> 'Y'
and    CLR_SUB_MTL_CD in (?,?,?,?,?,?,?,?,?,?,?,?)
		 ]]> 
	 </query>
