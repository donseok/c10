	 <query id="C108000240.sms.insert" desc="시험분석의뢰 완료 알림 메시지" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C108000240 시험분석의뢰 완료 SMS발송  C108000240.sms1.insert  SJS */ 
  INTO EAIAPUSER.TB_M90_SMS (
       IF_GRP_ID
     , SEQ_NO  
     , SEQNO
     , XSTAT                     
     , XDATE                     
     , XTIME                     
     , INTIME                    
     , REQTIME    
       ---------------------------------
     , RECVNAME                  
     , CALLPHONE       
     , SENDNAME                  
     , REQPHONE  
       ---------------------------------
     , SUBJECT
     , MSG          
       ---------------------------------
     , RESULT                    
     , KIND                      
     , SYSCODE
       ---------------------------------
     , CREATED_OBJECT_TYPE       
     , CREATED_OBJECT_ID         
     , CREATED_PROGRAM_ID        
     , CREATION_TIMESTAMP        
     , LAST_UPDATED_OBJECT_TYPE  
     , LAST_UPDATED_OBJECT_ID    
     , LAST_UPDATE_PROGRAM_ID    
     , LAST_UPDATE_TIMESTAMP
       ---------------------------------
     , BIZTYPE
     , YELLOWID_KEY
     , TEMPLATECODE
     , RESEND
   )
SELECT 
       TO_CHAR(SYSTIMESTAMP, 'YYYYMMDDHH24MISSFF3') AS IF_GRP_ID
     , EAIAPUSER.SQ_M90_SMS.NEXTVAL AS SEQ_NO
     , 700000000 + TO_NUMBER( TO_CHAR( SYSDATE, 'yy' ) ) * 1000000 + EAIAPUSER.SQ_M90_SMS2.NEXTVAL AS SEQNO
     , 'R' AS XSTAT
     , TO_CHAR(SYSDATE, 'YYYYMMDD') AS XDATE
     , TO_CHAR(SYSDATE, 'HH24MISS') AS XTIME
     , TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISS') AS INTIME
     , '00000000000000' AS REQTIME
       ---------------------------------
     , :RECEIVE_USER_NAME
     , REPLACE(:PHN_NO,'-','')
     , 'MES'
     , '0222220114'
       ---------------------------------
     , '시험분석의뢰 완료'     
     , '[MES 알림] 시험/분석의뢰 시험완료'||CHR(10)||CHR(10)||
       '시험이 완료되었습니다. 시험결과를 확인해주세요.'||CHR(10)||
       '결과확인 경로 : MES > 품질판정 > 샘플관리 > 시험/분석의뢰'||CHR(10)||CHR(10)||
		'의뢰번호 : '||:TST_ANL_REQ_NO||CHR(10)||
		'의뢰명 : '||:TST_ANL_SBJ||CHR(10)||
		'의뢰자 : '||:TST_ANL_REQ_ID||CHR(10)||
		'분석요망일 : '||:TST_LMT_DD
       ---------------------------------
     , '0' AS RESULT
     , 'T' AS KIND
     , 'UMES' AS SYSCODE
       ---------------------------------
     , :ObjectType AS CREATED_OBJECT_TYPE
     , :ObjectId AS CREATED_OBJECT_ID
     , :ProgramId AS CREATED_PROGRAM_ID
     , :Timestamp AS CREATION_TIMESTAMP
     , :ObjectType AS LAST_UPDATED_OBJECT_TYPE
     , :ObjectId AS LAST_UPDATED_OBJECT_ID
     , :ProgramId AS LAST_UPDATE_PROGRAM_ID
     , :Timestamp AS LAST_UPDATE_TIMESTAMP
       ---------------------------------
     , 'at' AS BIZTYPE
     , '1915d4111be77a18ffd7c5f0bdba383278a9ffc0' AS YELLOWID_KEY
     , 'UNI_QA_06' AS TEMPLATECODE
     , 'Y' AS RESEND
FROM DUAL
		 ]]> 
	 </query>
	 <query id="C108000240.send.update" desc="M" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE  /*+ C108000240 시험분석의뢰 완료 전송일 업데이트 C108000240.send.update  SJS */
MESAPUSER.TB_M20_TST_ANL
SET TST_SMS_SND_DH = SYSDATE
, LAST_UPDATED_OBJECT_TYPE = :ObjectType
, LAST_UPDATED_OBJECT_ID   = :ObjectId
, LAST_UPDATE_PROGRAM_ID   = :ProgramId
, LAST_UPDATE_TIMESTAMP    = :Timestamp
WHERE TST_ANL_REQ_NO = :TST_ANL_REQ_NO
		 ]]> 
	 </query>
	 <query id="C108000240.delete" desc="M" fetchSize="10" isNamed="true">
		 <![CDATA[ 
DELETE  /*+ C108000240 시험분석의뢰 의뢰 삭제 C108000240.delete  SJS */
FROM MESAPUSER.TB_M20_TST_ANL
WHERE TST_ANL_REQ_NO = :TST_ANL_REQ_NO
		 ]]> 
	 </query>
	 <query id="C108000240.update" desc="M" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE  /*+ C108000240 시험분석의뢰 비고 업데이트 C108000240.update  SJS */
MESAPUSER.TB_M20_TST_ANL
SET TST_NOTE = :TST_NOTE
, LAST_UPDATED_OBJECT_TYPE = :ObjectType
, LAST_UPDATED_OBJECT_ID   = :ObjectId
, LAST_UPDATE_PROGRAM_ID   = :ProgramId
, LAST_UPDATE_TIMESTAMP    = :Timestamp
WHERE TST_ANL_REQ_NO = :TST_ANL_REQ_NO
		 ]]> 
	 </query>
</queryMap>
