<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000240 Page 쿼리파일"> 
	 <query id="C108000240.select" desc="C108000240 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C108000240 칼라 개발 관리 조회 C108000240.select SJS */
SUBSTR(DEV_ID,1,8) || '-' || SUBSTR(DEV_ID,9) AS DEV_ID
, (SELECT CD_V_MEANING FROM M00APUSER.VI_M00_CODE_ACCESS
   WHERE CD_TP = 'DEPT_CD' AND CATEGORY_GROUP_NM = 'SZ0000'
   AND CD_V = NVL(
       (SELECT A.DEPT_CD FROM C10APUSER.TB_C10_CLR_DEV_APRV A
               WHERE A.DEV_ID = TB_C10_CLR_DEV_MNG.DEV_ID
               AND NVL(A.APRV_STATUS,'0') NOT IN ('2','3')
               AND A.DEV_PRG_CD = (SELECT MIN(B.DEV_PRG_CD) FROM C10APUSER.TB_C10_CLR_DEV_APRV B
                                   WHERE B.DEV_ID = A.DEV_ID AND NVL(B.APRV_STATUS,'0') NOT IN ('2','3')
                                   AND B.DEV_PRG_CD IN ('1','2','3','4','5','6','7'))
               AND ROWNUM = 1),
       (SELECT A.DEPT_CD FROM C10APUSER.TB_C10_CLR_DEV_APRV A
               WHERE A.DEV_ID = TB_C10_CLR_DEV_MNG.DEV_ID
               AND A.APRV_STATUS = '2'
               AND A.DEV_PRG_CD = (SELECT MAX(B.DEV_PRG_CD) FROM C10APUSER.TB_C10_CLR_DEV_APRV B
                                   WHERE B.DEV_ID = A.DEV_ID AND B.APRV_STATUS = '2'
                                   AND B.DEV_PRG_CD IN ('1','2','3','4','5','6','7'))
               AND ROWNUM = 1)
   )) AS APRV_DEPT_NM
, (SELECT CD_V_MEANING FROM M00APUSER.VI_M00_CODE_ACCESS WHERE CD_TP = 'DEPT_CD' AND CATEGORY_GROUP_NM = 'SZ0000' AND CD_V = DEV_CHR_DEPT) AS DEV_CHR_DEPT_NM
, (SELECT USER_NAME FROM M90APUSER.TB_SEC_USER WHERE USER_NO = DEV_CHR_ID) AS DEV_CHR_NM
, CASE
    WHEN DEV_PRG_CD = '8' THEN '개발중단'
    WHEN EXISTS (SELECT 1 FROM C10APUSER.TB_C10_CLR_DEV_APRV
                 WHERE DEV_ID = TB_C10_CLR_DEV_MNG.DEV_ID AND APRV_STATUS = '3'
                 AND DEV_PRG_CD IN ('1','2','3','4','5','6'))
    THEN (SELECT DECODE(MIN(DEV_PRG_CD), '1','개발접수', '2','분석/개발', '3','시편승인', '4','사양승인', '5','BOM등록', '6','개발완료대기', '7','개발완료')
          FROM C10APUSER.TB_C10_CLR_DEV_APRV
          WHERE DEV_ID = TB_C10_CLR_DEV_MNG.DEV_ID AND APRV_STATUS = '3'
          AND DEV_PRG_CD IN ('1','2','3','4','5','6','7')) || '(반려)'
    ELSE NVL(
        (SELECT DECODE(MIN(DEV_PRG_CD), '1','개발접수', '2','분석/개발', '3','시편승인', '4','사양승인', '5','BOM등록', '6','개발완료대기', '7','개발완료')
         FROM C10APUSER.TB_C10_CLR_DEV_APRV
         WHERE DEV_ID = TB_C10_CLR_DEV_MNG.DEV_ID
         AND NVL(APRV_STATUS, '0') NOT IN ('2', '3')
         AND DEV_PRG_CD IN ('1','2','3','4','5','6','7')),
        '개발완료')
  END AS DEV_PRG_CD
, DEV_SBJ
, DECODE(FNL_CUS_CD, NULL, NULL, FNL_CUS_CD || ' : ' || (SELECT CD_V_MEANING
    FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'CUS_CD'
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = FNL_CUS_CD)) AS FNL_CUS_CD
, DECODE(CUS_CD, NULL, NULL, CUS_CD || ' : ' || (SELECT CD_V_MEANING
    FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'CUS_CD'
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = CUS_CD)) AS CUS_CD
, (SELECT CD_V_MEANING
    FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'ORD_USG_CD'
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = ORD_USG_CD) AS ORD_USG_CD
, (SELECT CD_V_MEANING
    FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'PRD_NM_CD'
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = PRD_NM_CD) AS PRD_NM_CD
, (SELECT CD_V_MEANING
    FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'RSN_TP'
    AND   CATEGORY_GROUP_NM = 'SZ0000'
    AND   CD_V = RSN_TP) AS RSN_TP
, (SELECT CD_V_MEANING
    FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'COT_TP'
    AND   CATEGORY_GROUP_NM = 'AP0000'
    AND   CD_V = COT_TP) AS COT_TP
, (SELECT CD_V_MEANING
    FROM M00APUSER.VI_M00_CODE_ACCESS
     WHERE CD_TP = 'GW_ASG_CD'
    AND   CATEGORY_GROUP_NM = 'SG0000'
    AND   CD_V = GW_ASG_CD) AS GW_ASG_CD
, SUBSTR(DEV_REQ_DD,1,4) || '-' || SUBSTR(DEV_REQ_DD,5,2) || '-' || SUBSTR(DEV_REQ_DD,7,2) AS DEV_REQ_DD
, SUBSTR(DEV_END_DD,1,4) || '-' || SUBSTR(DEV_END_DD,5,2) || '-' || SUBSTR(DEV_END_DD,7,2) AS DEV_END_DD
, TO_CHAR(LAST_UPDATE_TIMESTAMP,'YYYY-MM-DD') AS LAST_UPDATE_DD
FROM C10APUSER.TB_C10_CLR_DEV_MNG
WHERE DEV_REQ_DD BETWEEN REPLACE(:DEV_REQ_DD_START,'-','') AND REPLACE(:DEV_REQ_DD_END,'-','')
AND (:DEV_PRG_CD IS NULL OR :DEV_PRG_CD = '%' OR DEV_PRG_CD = :DEV_PRG_CD)
AND (:PRD_NM_CD IS NULL OR :PRD_NM_CD = '%' OR PRD_NM_CD = :PRD_NM_CD)
AND (:RSN_TP IS NULL OR :RSN_TP = '&' OR RSN_TP = :RSN_TP)
AND (:COT_TP IS NULL OR :COT_TP = '%' OR COT_TP = :COT_TP)
AND (:CUS_CD IS NULL OR CUS_CD LIKE '%' || :CUS_CD || '%')
AND (:FNL_CUS_CD IS NULL OR FNL_CUS_CD LIKE '%' || :FNL_CUS_CD || '%')
AND (:DEV_CHR_DEPT IS NULL OR DEV_CHR_DEPT LIKE '%' || :DEV_CHR_DEPT || '%')
AND (:RAL_CD IS NULL OR RAL_CD LIKE '%' || :RAL_CD || '%')
AND (:DEV_CHR_ID IS NULL OR DEV_CHR_ID LIKE '%' || :DEV_CHR_ID || '%' OR EXISTS (SELECT 1 FROM M90APUSER.TB_SEC_USER WHERE USER_NO = DEV_CHR_ID AND USER_NAME LIKE '%' || :DEV_CHR_ID || '%'))
AND (:DEV_ID IS NULL OR DEV_ID LIKE '%' || REPLACE(:DEV_ID,'-','') || '%')
AND (:APRV_DEPT_CD IS NULL OR (DEV_PRG_CD NOT IN ('8') AND EXISTS (
    SELECT 1 FROM C10APUSER.TB_C10_CLR_DEV_APRV A
    WHERE A.DEV_ID = TB_C10_CLR_DEV_MNG.DEV_ID
    AND A.DEPT_CD LIKE '%' || :APRV_DEPT_CD || '%'
    AND NVL(A.APRV_STATUS, '0') NOT IN ('2', '3')
    AND A.DEV_PRG_CD = (
        SELECT MIN(B.DEV_PRG_CD)
        FROM C10APUSER.TB_C10_CLR_DEV_APRV B
        WHERE B.DEV_ID = A.DEV_ID
        AND NVL(B.APRV_STATUS, '0') NOT IN ('2', '3')
        AND B.DEV_PRG_CD IN ('1','2','3','4','5','6','7')
    )
)))
ORDER BY DEV_REQ_DD DESC, DEV_ID DESC
		 ]]> 
	 </query>
	 <query id="C108000240_Grid_1.insert" desc="M" fetchSize="10" isNamed="true">
		 <![CDATA[ 
