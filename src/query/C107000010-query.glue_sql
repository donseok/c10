:MD_RULE_CON_OLSTATR_9, :MD_RULE_CON_MI_V_9, :MD_RULE_CON_MAX_V_9,
:MD_RULE_CON_OLSTATR_10, :MD_RULE_CON_MI_V_10, :MD_RULE_CON_MAX_V_10,
:MD_RULE_CON_OLSTATR_11, :MD_RULE_CON_MI_V_11, :MD_RULE_CON_MAX_V_11,
:MD_RULE_CON_OLSTATR_12, :MD_RULE_CON_MI_V_12, :MD_RULE_CON_MAX_V_12,
:MD_RULE_CON_OLSTATR_13, :MD_RULE_CON_MI_V_13, :MD_RULE_CON_MAX_V_13,
:MD_RULE_DECISION_RST1, :MD_RULE_DECISION_RST2, :MD_RULE_DECISION_RST3,
:MD_RULE_DECISION_RST4, :MD_RULE_DECISION_RST5, :MD_RULE_DECISION_RST6,
:MD_RULE_DECISION_RST7, :MD_RULE_DECISION_RST8, :MD_RULE_DECISION_RST9,
:MD_RULE_DECISION_RST10, :MD_RULE_DECISION_RST11, :MD_RULE_DECISION_RST12,
:MD_RULE_DECISION_RST13, :MD_RULE_DECISION_RST14
,'Y'
,(SELECT START_ACTIVE_DATE
   FROM M00APUSER.TB_M00_RULES010
  WHERE MD_RULE_NM = 'C10B1040'
    AND ROWNUM = 1)
,(SELECT END_ACTIVE_DATE
   FROM M00APUSER.TB_M00_RULES010
  WHERE MD_RULE_NM = 'C10B1040'
    AND ROWNUM = 1)
,'A'
,:USER_NO
,'C107000010'
,SYSDATE
,'A'
,:USER_NO
,'C107000010'
,SYSDATE
)
		 ]]> 
