MD_RULE_CON_OLSTATR_13, MD_RULE_CON_MI_V_13, MD_RULE_CON_MAX_V_13,
MD_RULE_DECISION_RST1, MD_RULE_DECISION_RST2, MD_RULE_DECISION_RST3,
MD_RULE_DECISION_RST4, MD_RULE_DECISION_RST5, MD_RULE_DECISION_RST6,
MD_RULE_DECISION_RST7, MD_RULE_DECISION_RST8, MD_RULE_DECISION_RST9,
MD_RULE_DECISION_RST10, MD_RULE_DECISION_RST11, MD_RULE_DECISION_RST12,
MD_RULE_DECISION_RST13, MD_RULE_DECISION_RST14
,USE_TP,START_ACTIVE_DATE,END_ACTIVE_DATE
,CREATED_OBJECT_TYPE
,CREATED_OBJECT_ID
,CREATED_PROGRAM_ID
,CREATION_TIMESTAMP
,LAST_UPDATED_OBJECT_TYPE
,LAST_UPDATED_OBJECT_ID
,LAST_UPDATE_PROGRAM_ID
,LAST_UPDATE_TIMESTAMP
)
VALUES(
'6171',
(SELECT MAX(MD_RULE_CON_NUM)+1 
   FROM M00APUSER.TB_M00_RULES040
  WHERE MD_RULE_ID = '6171'),
:MD_RULE_CON_OLSTATR_1, :MD_RULE_CON_MI_V_1, :MD_RULE_CON_MAX_V_1,
:MD_RULE_CON_OLSTATR_2, :MD_RULE_CON_MI_V_2, :MD_RULE_CON_MAX_V_2,
:MD_RULE_CON_OLSTATR_3, :MD_RULE_CON_MI_V_3, :MD_RULE_CON_MAX_V_3,
:MD_RULE_CON_OLSTATR_4, :MD_RULE_CON_MI_V_4, :MD_RULE_CON_MAX_V_4,
:MD_RULE_CON_OLSTATR_5, :MD_RULE_CON_MI_V_5, :MD_RULE_CON_MAX_V_5,
:MD_RULE_CON_OLSTATR_6, :MD_RULE_CON_MI_V_6, :MD_RULE_CON_MAX_V_6,
