	 <query id="C107000010.combo" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT '%LIKE' AS CODE
       ,'LIKE2' AS VALUE
  FROM DUAL
UNION
SELECT '%LIKE%' AS CODE
       ,'LIKE1' AS VALUE 
  FROM DUAL
UNION
SELECT '<' AS CODE
       ,'<' AS VALUE 
  FROM DUAL
UNION
SELECT '<=' AS CODE
       ,'<=' AS VALUE 
  FROM DUAL
UNION
SELECT '<=변수<' AS CODE
       ,'BETWEEN2' AS VALUE 
  FROM DUAL
  UNION
SELECT '<=변수<=' AS CODE
       ,'BETWEEN1' AS VALUE 
  FROM DUAL
UNION
SELECT '<변수<' AS CODE
       ,'BETWEEN4' AS VALUE 
  FROM DUAL      
UNION
SELECT '<변수<=' AS CODE
       ,'BETWEEN3' AS VALUE 
  FROM DUAL 
 UNION
SELECT '=' AS CODE
       ,'=' AS VALUE 
  FROM DUAL
UNION
SELECT '>' AS CODE
       ,'>' AS VALUE 
  FROM DUAL  
  UNION
SELECT '>=' AS CODE
       ,'>=' AS VALUE 
  FROM DUAL 
UNION
SELECT 'IN' AS CODE
       ,'IN' AS VALUE 
  FROM DUAL      
UNION
SELECT 'IS_NULL' AS CODE
       ,'IS_NULL' AS VALUE 
  FROM DUAL      
UNION
SELECT 'LIKE%' AS CODE
       ,'LIKE3' AS VALUE 
  FROM DUAL
UNION
SELECT 'NOT_IN' AS CODE
       ,'NOT_IN' AS VALUE 
  FROM DUAL  
UNION
SELECT 'NOT_NULL' AS CODE
       ,'NOT_NULL' AS VALUE 
  FROM DUAL
UNION
SELECT '다르다' AS CODE
       ,'!=' AS VALUE 
  FROM DUAL
UNION
SELECT '체크안함' AS CODE
       ,'NOT_CHECK' AS VALUE 
  FROM DUAL
		 ]]> 
	 </query>
