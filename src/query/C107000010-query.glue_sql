<queryMap desc="C107000010 Page 쿼리파일"> 
	 <query id="C107000010.select" desc="C107000010 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT DTL.*
          ,:USER_NO AS USER_NO
  FROM M00APUSER.TB_M00_RULES010 CMN
       ,M00APUSER.TB_M00_RULES040 DTL
 WHERE CMN.MD_RULE_ID = DTL.MD_RULE_ID 
   AND CMN.MD_RULE_NM = 'C10B1040'
		 ]]> 
	 </query>
