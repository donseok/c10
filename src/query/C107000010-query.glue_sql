	 <query id="C107000010.insert" desc="C107000010 정보 추가" isNamed="true">
		 <![CDATA[ 
INSERT INTO M00APUSER.TB_M00_RULES040(
MD_RULE_ID,MD_RULE_CON_NUM,
MD_RULE_CON_OLSTATR_1, MD_RULE_CON_MI_V_1, MD_RULE_CON_MAX_V_1,
