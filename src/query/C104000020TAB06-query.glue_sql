      ,COR_TM_GEN_ANN = :COR_TM_GEN_ANN            --일반ANN소둔보정시간
      ,COIL_TMP_GEN_ANN = :COIL_TMP_GEN_ANN        --일반ANN코일온도
      ,CLG_END_TMP_GEN_ANN = :CLG_END_TMP_GEN_ANN  --일반ANN냉각종료온도
      ,HEAT_CYL_NO_HC_ANN = :HEAT_CYL_NO_HC_ANN    --HCANN소둔CYCLE
      ,COR_TM_HC_ANN = :COR_TM_HC_ANN              --HCANN소둔보정시간
      ,COIL_TMP_HC_ANN = :COIL_TMP_HC_ANN          --HCANN코일온도
      ,CLG_END_TMP_HC_ANN = :CLG_END_TMP_HC_ANN    --HCANN냉각종료온도
