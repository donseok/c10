             ,RMTL_TAR_THK_LVL_BF
             ,RMTL_TAR_THK_UVL_BF
             ,RMTL_TAR_WTH_BF
             ,PLTCM_5STD_WR_TP_BF
             ,PLTCM_SLV_USE_YN_BF
             ,PLTCM_EDG_ASG_TP_BF
             ,MDF_PRS_ID
             ,MDF_DH
             ,CREATED_OBJECT_TYPE
             ,CREATED_OBJECT_ID
             ,CREATED_PROGRAM_ID
             ,CREATION_TIMESTAMP
             ,LAST_UPDATED_OBJECT_TYPE
             ,LAST_UPDATED_OBJECT_ID
             ,LAST_UPDATE_PROGRAM_ID
             ,LAST_UPDATE_TIMESTAMP
            )
VALUES
            (
             :ORD_NO
             ,:ORD_LN 
             ,NVL((SELECT MAX(MDF_SEQ) + 1 FROM TB_C10_QLT_DSN_MNF_MDF_LOG WHERE ORD_NO = :ORD_NO AND ORD_LN = :ORD_LN),1)
             ,:QLT_DSN_MNF_TP
             ,:RMTL_TAR_THK
