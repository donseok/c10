             ,:RMTL_TAR_THK_LVL_BF
             ,:RMTL_TAR_THK_UVL_BF
             ,:RMTL_TAR_WTH_BF
             ,:PLTCM_5STD_WR_TP_BF
             ,:PLTCM_SLV_USE_YN_BF
             ,:PLTCM_EDG_ASG_TP_BF
             ,:ObjectId
             ,sysdate
             ,:ObjectType
             ,:ObjectId
             ,:ProgramId
             ,:Timestamp
             ,:ObjectType
             ,:ObjectId
             ,:ProgramId
             ,:Timestamp
            )
		 ]]> 
