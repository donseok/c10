	 <query id="C104000020TAB06.MNF_MDFinsert" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /* C10 품질설계결과수정이력 C104000020TAB06.MNF_MDFinsert 이돈석*/
            TB_C10_QLT_DSN_MNF_MDF_LOG
            (    
              ORD_NO
             ,ORD_LN
             ,MDF_SEQ
             ,QLT_DSN_MNF_TP
             ,RMTL_TAR_THK
             ,RMTL_TAR_THK_LVL
             ,RMTL_TAR_THK_UVL
             ,RMTL_TAR_WTH
