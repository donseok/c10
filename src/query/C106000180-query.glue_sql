    CLG_END_TMP_GEN_ANN_BF,
    HEAT_CYL_NO_HC_ANN_BF,
    COR_TM_HC_ANN_BF,
    COIL_TMP_HC_ANN_BF,
    CLG_END_TMP_HC_ANN_BF,
    WK_GW_FRN_LLV_BF,
    WK_GW_FRN_ULV_BF,
    WK_GW_BAK_LLV_BF,
    WK_GW_BAK_ULV_BF,
    EGL_THK_TRV_BF,
    EGL_WTH_TRV_BF
    MDF_PRS_ID,
    MDF_DH
   FROM C10APUSER.TB_C10_QLT_DSN_MNF_MDF_LOG A
  WHERE A.MDF_DH BETWEEN TO_DATE(DECODE(:ORD_NO||:ORD_LN,'',:MDF_DH_STR,NVL(:MDF_DH_STR, '1900-01-01')),'YYYY-MM-DD')  
    AND TO_DATE(DECODE(:ORD_NO||:ORD_LN,'',:MDF_DH_END,NVL(:MDF_DH_END, '3000-12-31')),'YYYY-MM-DD') + 1
    AND A.ORD_NO LIKE :ORD_NO||'%' 
    AND A.ORD_LN LIKE :ORD_LN||'%'
  ORDER BY MDF_DH
		 ]]> 
	 </query>
</queryMap>
