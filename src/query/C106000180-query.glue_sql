    CGL_THK_TRV,
    CGL_WTH_TRV,
    ECL_CDR_CD,
    ECL_COILG_TS_CD,
    TM_PASS_CNT,
    ROU_RA_LLV,
    ROU_RA_ULV,
    ROU_PPI_LLV,
    ROU_PPI_ULV,
    TM_WTH_TRV,
    TM_WTH_SUB_PROC1_TRV,
    TM_WTH_SUB_PROC2_TRV,
