<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000080pop01-query.glue_sql"> 
	 <query id="C106000080pop01_Grid_1.select" desc="C106000080pop01 정보 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000080pop01   롤 이미지 조회   C106000080pop01_Grid_1.select  이돈석  */
       PRT_ROLL_NO,
       PRT_ROLL_IMG_SEQ_NO,
       SEQ_NO,
       DECODE(IMG_RGS_TP, '2', '모바일', 'PC') IMG_RGS_TP,
       IMG_ADR,
       IMG_NM,
       TO_CHAR(PRT_ROLL_RGS_DH, 'YYYY-MM-DD') PRT_ROLL_RGS_DH,
       PRT_ROLL_RGS_PRS_ID,
       IMG_NM CHK_IMG_NM,
       './'||REPLACE(SUBSTR(IMG_ADR, instr(IMG_ADR, 'IMG_UPLOAD')), '\', '/')||'/' CHK_IMG_ADR
FROM TB_C10_PRT_ROLL_IMG
WHERE PRT_ROLL_NO = :PRT_ROLL_NO
AND PRT_ROLL_IMG_SEQ_NO = :PRT_ROLL_IMG_SEQ_NO
ORDER BY PRT_ROLL_NO, PRT_ROLL_IMG_SEQ_NO, SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000080pop01.insert" desc="프린트롤 이미지 업로드" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C106000080pop01   프린트롤 이미지 업로드  C106000080pop01.insert  이돈석  */
INTO TB_C10_PRT_ROLL_IMG (
    PRT_ROLL_NO,
	PRT_ROLL_IMG_SEQ_NO,
	SEQ_NO,
	IMG_RGS_TP,
	IMG_ADR,
	IMG_NM,
	PRT_ROLL_RGS_DH,
	PRT_ROLL_RGS_PRS_ID,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP)
VALUES (
    :IMG_RGS_FLAG_ID, 
    :IMG_RGS_FLAG_ID2, 
    (SELECT NVL(MAX(SEQ_NO),0)+1 FROM TB_C10_PRT_ROLL_IMG WHERE PRT_ROLL_NO = :IMG_RGS_FLAG_ID AND PRT_ROLL_IMG_SEQ_NO = :IMG_RGS_FLAG_ID2), 
    :IMG_RGS_TP, 
    :FILE_ADDR,
    :FILE_NAME,  
    SYSDATE, 
    :ObjectId,
    'C',
    :ObjectId,
    'C106000080pop01',
    SYSTIMESTAMP,
    'C',
    :ObjectId,
    'C106000080pop01',
    SYSTIMESTAMP)
		 ]]> 
	 </query>
	 <query id="C106000080pop01.delete" desc="프린트 롤 이미지 삭제" isNamed="true">
		 <![CDATA[ 
DELETE  /*+ C106000080pop01   프린트 롤 이미지 삭제  C106000080pop01.delete  이돈석  */
TB_C10_PRT_ROLL_IMG 
WHERE  PRT_ROLL_NO = :IMG_RGS_FLAG_ID
AND PRT_ROLL_IMG_SEQ_NO =  :IMG_RGS_FLAG_ID2
AND SEQ_NO = :SEQ
		 ]]> 
	 </query>
	 <query id="C106000080pop01.update" desc="프린트 롤 이미지 등록여부 yn" isNamed="true">
		 <![CDATA[ 
UPDATE  /*+ C106000080pop01   프린트 롤 이미지 등록여부 yn  C106000080pop01.update  이돈석  */
TB_C10_PTN_ROLL_MNG
SET IMG_YN = DECODE((SELECT COUNT(IMG_NM) CNT
                FROM   TB_C10_PRT_ROLL_IMG
                WHERE  PRT_ROLL_NO =  :IMG_RGS_FLAG_ID
                AND    PRT_ROLL_IMG_SEQ_NO =  :IMG_RGS_FLAG_ID2), 0, 'N', 'Y' ) ,
         LAST_UPDATED_OBJECT_TYPE = :ObjectType,
         LAST_UPDATED_OBJECT_ID = :ObjectId,
         LAST_UPDATE_PROGRAM_ID = :ProgramId,
         LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE  ROLL_CD =  :IMG_RGS_FLAG_ID
AND    ROLL_CD_SEQ_NO =  :IMG_RGS_FLAG_ID2
		 ]]> 
	 </query>
</queryMap>
