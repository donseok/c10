<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000020TAB07pop01"> 
	 <query id="C104000020TAB07pop01.insert" desc="M" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C104000020  신뢰성시험등록 C104000020.trustTestInsert 김종화 */ 
INTO MESAPUSER.TB_M20_TRU_TST_MNG
(   
     TRU_TST_REQ_NO
    ,TRU_TST_REQ_DH
    ,RGS_MTH_CD
    ,TRU_TST_KND_TP
    ,CCL_BOM_NO
    ,ORD_NO
    ,ORD_LN
    ,PU_CRT_YN
    ,SMPL_REQ_ID
    ,SMPL_REQ_DH
    ,CREATED_OBJECT_TYPE
    ,CREATED_OBJECT_ID
    ,CREATED_PROGRAM_ID
    ,CREATION_TIMESTAMP
    ,LAST_UPDATED_OBJECT_TYPE
    ,LAST_UPDATED_OBJECT_ID
    ,LAST_UPDATE_PROGRAM_ID
    ,LAST_UPDATE_TIMESTAMP
)
SELECT
    (SELECT TO_CHAR(SYSDATE,'YYYYMMDD') || NVL(MAX(SUBSTR(TRU_TST_REQ_NO,9,3)), '000') + 1 
       FROM MESAPUSER.TB_M20_TRU_TST_MNG A
      WHERE SUBSTR(TRU_TST_REQ_NO,1,8) = TO_CHAR(SYSDATE,'YYYYMMDD'))
    ,TO_CHAR(SYSDATE,'YYYYMMDD')
    ,'A'
    ,:TRU_TST_KND_TP  
    ,CCL_BOM_NO
    ,ORD_NO
    ,ORD_LN
    ,'N'
    ,:ObjectId
    ,SYSDATE
    ,:ObjectType
    ,:ObjectId
    ,:ProgramId
    ,:Timestamp
    ,:ObjectType
    ,:ObjectId
    ,:ProgramId
    ,:Timestamp
FROM C10APUSER.TB_C10_QLT_DSN_CMN
WHERE ORD_NO = :ORD_NO
  AND ORD_LN = :ORD_LN
  AND QLT_DSN_STS_CD IN( 'A','B')
  AND CCL_BOM_NO IS NOT NULL
		 ]]> 
	 </query>
</queryMap>
