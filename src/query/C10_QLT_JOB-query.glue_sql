<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C10_QLT_JOB"> 
	 <query id="C10_QLT_JOB.Supdate" desc="C10_QLT_JOB.Supdate" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계JOB 상태업데이트 C10_QLT_JOB.Supdate 박재영*/                      
TB_C10_QLT_DSN_JOB
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,JOB_STS = 'S'      --품질설계JOB상태코드                                                                                                                                       
      ,STR_DH = TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS')      --품질설계완료일시 
      ,END_DH = null
		 ]]> 
	 </query>
	 <query id="C10_QLT_JOB.Eupdate" desc="C10_QLT_JOB.Eupdate" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계JOB 상태업데이트 C10_QLT_JOB.Eupdate 박재영*/                      
TB_C10_QLT_DSN_JOB
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,JOB_STS = 'E'      --품질설계JOB상태코드                                                                                                                                       
      ,END_DH = TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS')      --품질설계완료일시
		 ]]> 
	 </query>
	 <query id="C10_QLT_JOB.select" desc="C10_QLT_JOB.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계 JOB상태조회 C10_QLT_JOB.select 박재영 */        
           JOB_STS, JOB_TP
FROM TB_C10_QLT_DSN_JOB
WHERE JOB_STS = 'S'
		 ]]> 
	 </query>
</queryMap>
