<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab01 Page 쿼리파일"> 
	 <query id="C107000020tab01.select" desc="C107000020tab01 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT   /*+ C107000020   규격공통조회   C107000020_Grid1_C10A1010.select   김종화  */
 DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1   SPC_AVR
,DATAS010.MD_MRG_BAS_KEY_CHAR_TP_2  SPC_YR
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_1  SPC_NM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_2  SPC_FUL_NM
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_1  ORD_GRA
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_3  ACPT_RT_SPC
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_4  MQL_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_5  SPC_OFC
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_6  APLY_SPC
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_7  APLY_STL_KND
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_8 DOM_CVT_SPC_AVR
FROM M00APUSER.TB_M00_DATAS010 DATAS010,  
(SELECT MDL_DEFINE_ID   
FROM M00APUSER.TB_M00_DEFINES010  
WHERE MDL_DEFINE_NM='C10A1010'  
AND START_ACTIVE_DATE <=  SYSDATE  
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010  
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
 AND DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 LIKE '%'||:SEARCH_CD||'%'
 ORDER BY DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1
		 ]]> 
	 </query>
</queryMap>
