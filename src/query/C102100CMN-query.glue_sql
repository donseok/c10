	 <query id="C102100CMN_AIF" desc="품질설계결과송신(A) 조회 C102100CMN_IF.select " fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과송신(A) 조회 C102100CMN_IF.select 김종범*/      
            ORD_NO,
            ORD_LN,
            QLT_DSN_STS_CD
 FROM TB_C10_QLT_DSN_CMN
 WHERE ORD_NO = ?
     AND ORD_LN = ?
     AND QLT_DSN_STS_CD = ?
		 ]]> 
	 </query>
	 <query id="C102100CMN_EIF" desc="품질설계결과송신(E)" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과송신 조회 C102100CMN_EIF.SELECT 김종범*/    
* 
  FROM (
SELECT   
            ORD_NO,
            ORD_LN,
            QLT_DSN_STS_CD,
            ? AS QLT_DSN_ERR_MSG
 FROM TB_C10_QLT_DSN_CMN
 WHERE  ORD_NO = ?
     AND  ORD_LN = ?
     AND  QLT_DSN_STS_CD = ?     
     ) WHERE QLT_DSN_ERR_MSG IS NOT NULL
		 ]]> 
	 </query>
	 <query id="C102100CMN.JDLVselect" desc="C102100CMN.JDLVselect" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통 & 인수도조회 C102100CMN.JDLVselect 박재영*/      
*                               
 FROM TB_C10_QLT_DSN_DLV A, TB_C10_QLT_DSN_CMN B
WHERE A.ORD_NO(+) = B.ORD_NO
AND   A.ORD_LN(+) = B.ORD_LN
AND   B.QLT_DSN_STS_CD ='J'
AND   A.QLT_DSN_SPC_TP = '4'
		 ]]> 
	 </query>
