	 <query id="C102100CMN.Jselect" desc="품질설계공통 대기 주문 선택" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C102100CMN.JSELECT 김종범*/      
*                               
 FROM TB_C10_QLT_DSN_CMN                                            
WHERE QLT_DSN_STS_CD ='J'
		 ]]> 
	 </query>
	 <query id="C1021000CMN.modify" desc="QLT_DSN_ERR_YN = 'Y' 업데이트" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통ERR_YN업데이트 C103100040.MODIFY 김종범*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,QLT_DSN_ERR_YN = 'Y'      --품질설계에러여부                                                                                                                                       
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
