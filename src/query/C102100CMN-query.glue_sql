WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100CMN.StsME_modify" desc="C102100CMN.StsME_modify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 설계결과업데이트C102100CMN.StsME_modify 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,QLT_DSN_STS_CD = ?      --품질설계상태코드                                                                                                                                       
      ,QLT_DSN_END_DH = TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS')      --품질설계완료일시                                                                                                                                       
      ,QLT_DSN_PRS_ID = 'SYSTEM'      --품질설계자ID
      ,QLT_DSN_CFM_TP = 'M'            --품질설계확정구분                                                                                                                                      
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100CMN.StsA_modify" desc="C102100CMN.StsA_modify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 설계결과업데이트 C102100CMN.StsA_modify 박재영*/                      
