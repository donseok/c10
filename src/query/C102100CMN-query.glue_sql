	 <query id="C102100CMN.Key_modify" desc="C102100CMN.Key_modify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 설계Key항목업데이트 C102100CMN.Key_modify 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,MQL_CD = ?      --재질코드                                                                                                                                       
      ,RMTL_CD = ?      --원자재코드                                                                                                                                       
      ,RMTL_CD1 = ?      --원자재코드                                                                                                                                       
      ,RMTL_CD2 = ?      --원자재코드                                                                                                                                       
      ,CRM_MNF_STD_NO = ?      --냉연제조표준번호                                                                                                                                       
      ,CRM_MNF_STD_NO1 = ?      --냉연제조표준번호                                                                                                                                       
      ,CRM_MNF_STD_NO2 = ?      --냉연제조표준번호                                                                                                                                       
      ,PAS_PROC_NO = ?      --통과공정번호                                                                                                                                       
      ,QLT_DSN_CFM_TP = ?      --품질설계확정구분          
      ,CLS_CD = ?                    --ClassCode
      ,SUB_CLS_CD = ?             --SubClassCode           
      ,ORD_ROU_CD = ?           --주문조도코드               
      ,APR_INP_BAS_CD = ?      --외관검사기준코드
      ,ORD_PAK_MTL_WGT = ?   --포장재중량                                                                                    
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100CMN.PakMtlWgt__modify" desc="C102100CMN.PakMtlWgt__modify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 포장재중량업데이트 C102100CMN.PakMtlWgt__modify 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,ORD_PAK_MTL_WGT = ?      --포장재중량                                                                                                                                       
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
