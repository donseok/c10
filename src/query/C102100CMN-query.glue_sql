,B.ORD_PAK_SHT_CNT,B.ORD_PAK_UNT_WGT_LLV,B.ORD_PAK_UNT_WGT_ULV
,B.ORD_DLV_ALW_DIF_LLV,B.ORD_DLV_ALW_DIF_ULV,B.ORD_PAK_LTH_LLV
,B.ORD_PAK_LTH_ULV,B.ORD_STDP_LLV,B.ORD_STDP_ULV,B.ORD_STDP_CNT_LLV
,B.ORD_STDP_CNT_ULV,B.ORD_PAK_UNT_CNT,B.ORD_PAK_UNT_WGT,B.ORD_SML_PAK_WGT
,B.ORD_SML_PAK_MIR,B.ORD_UNT_WGT,B.ORD_PAK_MTH,B.ORD_COIL_IDIA
,B.ORD_COIL_ODIA,B.ORD_THK_TLN_LLV,B.ORD_THK_TLN_ULV,B.ORD_WTH_TLN_LLV
,B.ORD_WTH_TLN_ULV,B.ORD_LTH_TLN_LLV,B.ORD_LTH_TLN_ULV
,B.PNT_FLM_THK_FRN_TOT,B.PNT_FLM_THK_BAK_TOT,B.RSN_TP_FRN
,B.RSN_TP_BAK,B.LUS_RT_CD_FRN,B.LUS_RT_CD_BAK,B.COT_MTH,B.CUS_REQ_ROL_THK
,B.ORD_THK_MNG_CD,B.ORD_WTH_MNG_CD,B.ORD_LTH_MNG_CD,B.CUS_REQ_CLR_NM
,B.URG_MTL_TP,B.ORD_RCP_DD,B.ORD_SHT_LOD_MTH,B.ORD_SLIT_GRP_CNT
,B.ORD_MIX_WTH1,B.ORD_MIX_WTH2,B.ORD_MIX_WTH3,B.ORD_MIX_WTH4
,B.ORD_MIX_WTH5,B.ORD_MIX_WTH6,B.ORD_MIX_WTH7,B.ORD_MIX_WTH8,B.ORD_MIX_WTH9,B.ORD_MIX_WTH10
,B.SLIT_MAX_WGT,B.TRST_PROC_YN,B.TAG_TP,B.NAT_CD,B.ORD_SPC_TXT
,B.TAG_PRD_NM,B.TAG_PO_NO,B.TAG_DST,B.TAG_SIZ,B.TAG_SPC_NM,B.TAG_GAA
,B.TAG_HUE_FRN,B.TAG_HUE_BAK,B.TAG_SPC_MRK,B.RMTL_PRFR_CD,B.BAK_MRK
,B.ORD_MDF_DD,B.ORD_CFM_DD,B.ORD_RGS_PRS_ID,B.ORD_TEM_CD,B.MTL_CD
,B.CLS_CD,B.SUB_CLS_CD,B.QLT_DSN_END_DH,B.QLT_DSN_INST_DH,B.QLT_DSN_PRS_ID
,B.MQL_CD,B.RMTL_CD,B.RMTL_GRD,B.CRM_MNF_STD_NO,B.PAS_PROC_NO,B.ACPT_RT_SPC
,B.ORD_END_TP,B.ORD_END_DD,B.ORD_END_PRS_ID,B.QLT_DSN_CFM_DH,B.QLT_DSN_CFM_PRS_ID
,B.QLT_RDSN_DH,B.QLT_RDSN_PRS_ID,B.QLT_DSN_ERR_YN,B.QLT_DSN_YN
,B.QLT_DSN_CFM_TP,B.RMTL_CD1,B.RMTL_CD2,B.CRM_MNF_STD_NO1,B.CRM_MNF_STD_NO2
,B.ORD_CNL_CAU_CD,B.ORD_CNL_DTL_TXT,B.THK_COR_UNT,B.PRD_THK_CAL_APL_CD
,B.APR_INP_BAS_CD,B.TAG_PO_NO2
,SUM(DECODE(A.QLT_DSN_SPC_TP, '4', A.THK_TLN_LLV, 0)) THK_TLN_LLV
,SUM(DECODE(A.QLT_DSN_SPC_TP, '4', A.THK_TLN_ULV, 0)) THK_TLN_ULV
,SUM(DECODE(A.QLT_DSN_SPC_TP, '2', A.THK_TLN_LLV, 0)) THK_TLN_LLV2
,SUM(DECODE(A.QLT_DSN_SPC_TP, '2', A.THK_TLN_ULV, 0)) THK_TLN_ULV2
,SUM(DECODE(A.QLT_DSN_SPC_TP, '4', A.LTH_TLN_LLV, 0)) LTH_TLN_LLV
,SUM(DECODE(A.QLT_DSN_SPC_TP, '4', A.LTH_TLN_ULV, 0)) LTH_TLN_ULV
 FROM TB_C10_QLT_DSN_DLV A, TB_C10_QLT_DSN_CMN B
WHERE A.ORD_NO(+) = B.ORD_NO
AND   A.ORD_LN(+) = B.ORD_LN
AND   B.QLT_DSN_STS_CD ='J'
AND   A.QLT_DSN_SPC_TP IN ('2','4')
GROUP BY B.ORD_NO,B.ORD_LN,B.QLT_DSN_STS_CD,B.PLNT_TP,B.PRD_NM_CD
,B.PRD_SHP,B.FLOW_CHL,B.ORD_KND,B.ORD_PRD_GRD,B.ORD_USG_CD
,B.CUS_CD,B.ACT_CUS_CD,B.FNL_CUS_CD,B.CUS_BTH_PAP_NO,B.SPC_OFC
,B.SPC_AVR,B.SPC_YR,B.SPC_NM,B.SPC_FUL_NM,B.ORD_SZ,B.ORD_EXC_THK
,B.ORD_EXC_WTH,B.ORD_EXC_LTH,B.CUS_REQ_DLV_DD,B.ORD_SCH_DLV_DD
,B.ORD_PTL_STR_DD,B.ORD_PTL_END_DD,B.GW_ASG_CD,B.CCL_BOM_NO
,B.HUE_CD_FRN,B.HUE_CD_BAK,B.ORD_ORG_PLT_SPC_AVR,B.ORD_ROU_CD
,B.ORD_SPNL_TP,B.ORD_COILG_MTH,B.ORD_SUR_HND_CD,B.ORD_SKP_DEG
,B.ORD_EDG_ASG_TP,B.ORD_THK_TP,B.ORD_GRA,B.WGT_DCS_MTH_TP
,B.ORD_SLV_KND_TP,B.EMBS_CD,B.ORD_PTT_FLM_DTL_CD,B.ORD_PTT_FLM_WTH
,B.ORD_PTT_FLM_ADH_LOC_CD,B.ORD_WGT_UNT,B.ORD_LN_WGT,B.ORD_SHT_CNT
,B.ORD_PAK_SHT_CNT,B.ORD_PAK_UNT_WGT_LLV,B.ORD_PAK_UNT_WGT_ULV
,B.ORD_DLV_ALW_DIF_LLV,B.ORD_DLV_ALW_DIF_ULV,B.ORD_PAK_LTH_LLV
,B.ORD_PAK_LTH_ULV,B.ORD_STDP_LLV,B.ORD_STDP_ULV,B.ORD_STDP_CNT_LLV
,B.ORD_STDP_CNT_ULV,B.ORD_PAK_UNT_CNT,B.ORD_PAK_UNT_WGT,B.ORD_SML_PAK_WGT
,B.ORD_SML_PAK_MIR,B.ORD_UNT_WGT,B.ORD_PAK_MTH,B.ORD_COIL_IDIA
,B.ORD_COIL_ODIA,B.ORD_THK_TLN_LLV,B.ORD_THK_TLN_ULV,B.ORD_WTH_TLN_LLV
,B.ORD_WTH_TLN_ULV,B.ORD_LTH_TLN_LLV,B.ORD_LTH_TLN_ULV
,B.PNT_FLM_THK_FRN_TOT,B.PNT_FLM_THK_BAK_TOT,B.RSN_TP_FRN
,B.RSN_TP_BAK,B.LUS_RT_CD_FRN,B.LUS_RT_CD_BAK,B.COT_MTH,B.CUS_REQ_ROL_THK
,B.ORD_THK_MNG_CD,B.ORD_WTH_MNG_CD,B.ORD_LTH_MNG_CD,B.CUS_REQ_CLR_NM
,B.URG_MTL_TP,B.ORD_RCP_DD,B.ORD_SHT_LOD_MTH,B.ORD_SLIT_GRP_CNT
,B.ORD_MIX_WTH1,B.ORD_MIX_WTH2,B.ORD_MIX_WTH3,B.ORD_MIX_WTH4
,B.ORD_MIX_WTH5,B.ORD_MIX_WTH6,B.ORD_MIX_WTH7,B.ORD_MIX_WTH8,B.ORD_MIX_WTH9,B.ORD_MIX_WTH10
,B.SLIT_MAX_WGT,B.TRST_PROC_YN,B.TAG_TP,B.NAT_CD,B.ORD_SPC_TXT
,B.TAG_PRD_NM,B.TAG_PO_NO,B.TAG_DST,B.TAG_SIZ,B.TAG_SPC_NM,B.TAG_GAA
,B.TAG_HUE_FRN,B.TAG_HUE_BAK,B.TAG_SPC_MRK,B.RMTL_PRFR_CD,B.BAK_MRK
,B.ORD_MDF_DD,B.ORD_CFM_DD,B.ORD_RGS_PRS_ID,B.ORD_TEM_CD,B.MTL_CD
,B.CLS_CD,B.SUB_CLS_CD,B.QLT_DSN_END_DH,B.QLT_DSN_INST_DH,B.QLT_DSN_PRS_ID
,B.MQL_CD,B.RMTL_CD,B.RMTL_GRD,B.CRM_MNF_STD_NO,B.PAS_PROC_NO,B.ACPT_RT_SPC
,B.ORD_END_TP,B.ORD_END_DD,B.ORD_END_PRS_ID,B.QLT_DSN_CFM_DH,B.QLT_DSN_CFM_PRS_ID
,B.QLT_RDSN_DH,B.QLT_RDSN_PRS_ID,B.QLT_DSN_ERR_YN,B.QLT_DSN_YN
,B.QLT_DSN_CFM_TP,B.RMTL_CD1,B.RMTL_CD2,B.CRM_MNF_STD_NO1,B.CRM_MNF_STD_NO2
,B.ORD_CNL_CAU_CD,B.ORD_CNL_DTL_TXT,B.THK_COR_UNT,B.PRD_THK_CAL_APL_CD
,B.APR_INP_BAS_CD,B.TAG_PO_NO2
		 ]]> 
	 </query>
	 <query id="C102100CMN.CCL_modify2" desc="C102100CMN.CCL_modify2" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 칼라제조사양항목업데이트 C102100CMN.CCL_modify2 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,HUE_CD_FRN = ?                        --색상코드전면
      ,HUE_CD_BAK = ?                        --색상코드후면
      ,PNT_FLM_THK_FRN_TOT = ?      --도막두께전면Total                                                                                                                                       
      ,PNT_FLM_THK_BAK_TOT = ?      --도막두께후면Total                                                                                                                                       
      ,RSN_TP_FRN = ?      --수지구분전면                                                                                                                                       
      ,RSN_TP_BAK = ?      --수지구분후면                                                                                                                                       
      ,LUS_RT_CD_FRN = ?      --광택도코드전면                                                                                                                                       
      ,LUS_RT_CD_BAK = ?      --광택도코드후면                                                                                                                                       
      ,COT_MTH = ?      --코팅방식                                                                                                                                       
      ,QLT_DSN_CFM_TP = ?   --품질설계확정구분
      ,DEF_RED_TXT = ?  --감량매직체크결과
      ,PPR_RNG_PORD_TXT = ?  --지관발주메시지
      ,PE_FOAM_TXT = ? --PE-FOAM 적용메시지
      ,ATT_ORD_YN = ? --관심주문
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100CMN.ASELECT" desc="C102100CMN.ASELECT" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C102100CMN.ASELECT 김종범*/      
*                               
 FROM TB_C10_QLT_DSN_CMN
		 ]]> 
	 </query>
	 <query id="C102100CMN.Jmodify" desc="C102100CMN.Jmodify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통업데이트 C102100CMN.Jmodify 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,QLT_DSN_STS_CD = 'J'      --품질설계상태                                                                                                                                       
WHERE QLT_DSN_STS_CD = 'I'
		 ]]> 
	 </query>
	 <query id="C102100CMN.ASELECT3" desc="C102100CMN.ASELECT3" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C102100CMN.ASELECT3 박재영*/      
*                               
 FROM TB_C10_QLT_DSN_CMN A
WHERE NOT EXISTS (SELECT 1 
                FROM TB_C10_QLT_IMP_CHK B 
                WHERE A.ORD_NO = B.ORD_NO
                AND   A.ORD_LN = B.ORD_LN)
AND A.ORD_NO LIKE 'TEST%'
		 ]]> 
	 </query>
	 <query id="C102100CMN.UNT_WGTupdate" desc="C102100CMN.UNT_WGTupdate" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 매중량업데이트 C102100CMN.UNT_WGTupdate 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,ORD_UNT_WGT = ?      --주문단위중량                                                                                    
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100CMN.Oms_modify" desc="OMS의 자동수동설계정보를 업데이트 함" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 C102100CMN.Oms_modify 이돈석*/
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,QLT_DSN_STS_CD = ?      --품질설계상태코드                                                                                                                                       
      ,QLT_DSN_END_DH = TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS')      --품질설계완료일시                                                                                                                                       
      ,QLT_DSN_PRS_ID = 'SYSTEM'      --품질설계자ID
      ,QLT_DSN_CFM_TP = 'A'            --품질설계확정구분                                                                                                                                      
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100CMN.REinsert" desc="C10 품질설계반복주문의뢰등록 C102100CMN.REinsert 이돈석" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT INTO  /*+ C10 품질설계반복주문의뢰등록 C102100CMN.REinsert 이돈석*/                           
TB_C10_QLT_DSN_CMN (                                                                           
 ORD_NO		                --주문번호
,ORD_LN		                --주문행번
,QLT_DSN_STS_CD		  --품질설계상태코드
,CCL_BOM_NO                 --CCL BOM번호
,ORD_REP_YN                   --반복주문여부
,ORD_REP_NO                  --반복주문번호
,ORD_REP_LN                   --반복주문행번
,ORD_PTT_FLM_DTL_CD     --보호필름상세코드
,CREATED_OBJECT_TYPE       --생성OBJECT유형  
,CREATED_OBJECT_ID         --생성OBJECTID    
,CREATED_PROGRAM_ID        --생성프로그램ID  
,CREATION_TIMESTAMP        --생성일시                  
,LAST_UPDATED_OBJECT_TYPE  --최종변경OBJECT유형
,LAST_UPDATED_OBJECT_ID    --최종변경OBJECTID  
,LAST_UPDATE_PROGRAM_ID    --최종변경프로그램ID
,LAST_UPDATE_TIMESTAMP     --최종변경일시
)
VALUES(
?,?,'T',?,'Y',?,?,?
,?,?,?,?
,?,?,?,?
)
		 ]]> 
	 </query>
	 <query id="C102100CMN.Tselect" desc="C10 품질설계결과공통조회(대상T인주문)" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C102100CMN.TSELECT 이돈석*/      
*                               
 FROM TB_C10_QLT_DSN_CMN                                            
WHERE QLT_DSN_STS_CD ='T'
		 ]]> 
	 </query>
	 <query id="C102100CMN.Rselect" desc="C102100CMN.Rselect" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT *
    FROM TB_C10_QLT_DSN_CMN A
   WHERE QLT_DSN_STS_CD = 'A'
     AND NVL(ORD_COP_STP,'@') = '@' 
     AND QLT_DSN_YN = 'Y'
     AND PRD_NM_CD IN ('1','2','3','4','5','6','7','8','9') -- 2020.4.21 전현진과장요청
     AND QLT_DSN_END_DH > (SELECT MAX(ERP_SND_DH) AS ERP_SND_DH_LST FROM TB_C10_CLR_MPR WHERE CCL_BOM_NO = A.CCL_BOM_NO)
     AND ORD_NO = ?       
     AND ORD_LN = ?              
     AND PRD_NM_CD = ?            
     AND PLNT_TP = ?             
     AND PRD_SHP = ?            
     AND FLOW_CHL = ?             
     AND ORD_KND = ?             
     AND ORD_USG_CD = ?       
     AND CUS_CD = ?         
     AND ACT_CUS_CD = ?       
     AND FNL_CUS_CD = ?       
     AND NVL(CUS_BTH_PAP_NO,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%' 
     AND SPC_AVR = ?
     AND SPC_YR = ?
     AND ORD_SZ = ?
     AND ORD_EXC_THK = ?
     AND ORD_EXC_WTH = ?
     AND NVL(ORD_EXC_LTH,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(GW_ASG_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(CCL_BOM_NO,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(HUE_CD_FRN,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(HUE_CD_BAK,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_ORG_PLT_SPC_AVR,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_ROU_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SPNL_TP,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_COILG_MTH,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SUR_HND_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SKP_DEG,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND ORD_EDG_ASG_TP = ?
     AND ORD_THK_TP = ?
     AND WGT_DCS_MTH_TP = ?
     AND NVL(ORD_SLV_KND_TP,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(EMBS_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PTT_FLM_DTL_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PTT_FLM_WTH,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PTT_FLM_ADH_LOC_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND ORD_WGT_UNT = ?
     --AND NVL(ORD_SHT_CNT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_SHT_CNT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_UNT_WGT_LLV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_UNT_WGT_ULV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_LTH_LLV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_LTH_ULV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_STDP_CNT_LLV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_STDP_CNT_ULV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_UNT_WGT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND ORD_PAK_MTH = ?
     AND NVL(ORD_COIL_IDIA,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_COIL_ODIA,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND ORD_THK_MNG_CD = ?
     AND ORD_WTH_MNG_CD = ?
     AND NVL(ORD_LTH_MNG_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SHT_LOD_MTH,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SLIT_GRP_CNT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH1,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH2,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH3,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH4,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH5,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH6,0 ) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH7,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH8,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(SLIT_MAX_WGT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(TRST_PROC_YN,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SPC_TXT,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     --AND NVL(BAK_MRK,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND MTL_CD = ?
     AND NVL(TAG_TP,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NAT_CD = ?
     AND NVL(MTL_PRD_ORD_YN,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(CUS_REQ_CLR_NM,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(PAK_MSG_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH9,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH10,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(PTT_FLM_NOT_ADH_WS,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(PTT_FLM_NOT_ADH_DS,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(LTH_MNG_YN,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(LTH_MNG_FROM,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(LTH_MNG_TO,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND TRUNC(SYSDATE - QLT_DSN_END_DH) <= 180
		 ]]> 
	 </query>
	 <query id="C102100CMN.CCL_modify3" desc="C102100CMN.CCL_modify3" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 항목업데이트 C102100CMN.CCL_modify3 이돈석*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,HUE_CD_FRN = ?                        --색상코드전면
      ,HUE_CD_BAK = ?                        --색상코드후면
      ,PNT_FLM_THK_FRN_TOT = ?      --도막두께전면Total                                                                                                                                       
      ,PNT_FLM_THK_BAK_TOT = ?      --도막두께후면Total                                                                                                                                       
      ,RSN_TP_FRN = ?      --수지구분전면                                                                                                                                       
      ,RSN_TP_BAK = ?      --수지구분후면                                                                                                                                       
      ,LUS_RT_CD_FRN = ?      --광택도코드전면                                                                                                                                       
      ,LUS_RT_CD_BAK = ?      --광택도코드후면
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100CMN.CCL_modify4" desc="" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과 칼라제조사양항목업데이트 C102100CMN.CCL_modify4 이돈석*/ 
TB_C10_QLT_DSN_CCL_BOM
      SET LAST_UPDATED_OBJECT_TYPE = ?,  --최종변경OBJECT유형
            LAST_UPDATED_OBJECT_ID = ?,    --최종변경OBJECTID  
            LAST_UPDATE_PROGRAM_ID = ?,    --최종변경프로그램ID
            LAST_UPDATE_TIMESTAMP = ?,     --최종변경일시 
            PTT_FLM_DTL_CD = ?,
            PTT_FLM_LUS_RT_CD = ?,
            PTT_FLM_THK_CD = ?,
            PTT_FLM_MQL_CD = ?,
            PTT_FLM_SUS_ADH_CD = ?, 
            PTT_FLM_PRD_ADH_CD = ?,
            UNI_GLS_FLM_CD = ?
 WHERE ORD_NO = ?
    AND ORD_LN = ?
		 ]]> 
	 </query>
	 <query id="C102100CMN.CCLFLM_modify4" desc="" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT PTT_FLM_DTL_CD, 
           PTT_FLM_LUS_RT_CD, 
           PTT_FLM_THK_CD, 
           PTT_FLM_MQL_CD, 
           PTT_FLM_SUS_ADH_CD, 
           PTT_FLM_PRD_ADH_CD,  
           UNI_GLS_FLM_CD
  FROM TB_C10_QLT_DSN_CCL_BOM
 WHERE ORD_NO = ?
    AND ORD_LN = ?
		 ]]> 
	 </query>
	 <query id="C102100CMN.CCL_modify5" desc="C102100CMN.CCL_modify5" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통 칼라제조사양항목업데이트 C102100CMN.CCL_modify5 이돈석*/                      
TB_C10_QLT_DSN_CMN A                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시                                                                                                                               
      ,RSN_TP_FRN = (SELECT RSN_TP_FRN FROM TB_C10_CCL_BOM WHERE CCL_BOM_NO = A.CCL_BOM_NO)    --수지구분전면                                                                                                                                       
      ,RSN_TP_BAK = (SELECT RSN_TP_BAK FROM TB_C10_CCL_BOM WHERE CCL_BOM_NO = A.CCL_BOM_NO)    --수지구분후면
WHERE ORD_NO =?                                                                                      
  AND ORD_LN =?
		 ]]> 
	 </query>
	 <query id="C102100CMN.BSMS" desc="" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과(B) 관심주문여부확인 C102100CMN.BSMS 이돈석*/      
       ORD_NO,
       ORD_LN,
       DECODE(NVL(ATT_ORD_YN,'N'),'Y','Y','N') ATT_ORD_YN
  FROM TB_C10_QLT_DSN_CMN
 WHERE ORD_NO = ?
   AND ORD_LN = ?
		 ]]> 
	 </query>
	 <query id="C102100CMN.AttSms" desc="" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT INTO /*+ C10 관심주문SMS전송대상 C102100CMN.AttSms 이돈석*/
            C10APUSER.TB_C10_ATT_ORD_MNG
            (
                  ORD_NO 
                , ORD_LN
                , ATT_ORD_RGS_ID
                , ATT_ORD_RGS_DH
                , ATT_RGS_TP
                , CREATED_OBJECT_TYPE         
                , CREATED_OBJECT_ID        
                , CREATED_PROGRAM_ID      
                , CREATION_TIMESTAMP     
                , LAST_UPDATED_OBJECT_TYPE
                , LAST_UPDATED_OBJECT_ID  
                , LAST_UPDATE_PROGRAM_ID  
                , LAST_UPDATE_TIMESTAMP     
            )
VALUES
            (
                  ?
                , ?
                , 'SYSTEM'
                , sysdate
                , 'A'
                , ?
                , ?
                , ?
                , ?
                , ?
                , ?
                , ?
                , ?
            )
		 ]]> 
	 </query>
	 <query id="C102100CMN.Dselect" desc="" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT *
    FROM TB_C10_QLT_DSN_CMN A
   WHERE QLT_DSN_STS_CD = 'A'
     AND NVL(ORD_COP_STP,'@') = '@' 
     AND QLT_DSN_YN = 'Y'
     AND PRD_NM_CD NOT IN ('1','2','3','4','5','6','7','8','9') -- 20190214 CCI, CCEI, CCAI, CCUS,  CCNI 外
     AND ORD_NO = ?       
     AND ORD_LN = ?              
     AND PRD_NM_CD = ?            
     AND PLNT_TP = ?             
     AND PRD_SHP = ?            
     AND FLOW_CHL = ?             
     AND ORD_KND = ?             
     AND ORD_USG_CD = ?       
     AND CUS_CD = ?         
     AND ACT_CUS_CD = ?       
     AND FNL_CUS_CD = ?       
     AND NVL(CUS_BTH_PAP_NO,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%' 
     AND SPC_AVR = ?
     AND SPC_YR = ?
     AND ORD_SZ = ?
     AND ORD_EXC_THK = ?
     AND ORD_EXC_WTH = ?
     AND NVL(ORD_EXC_LTH,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(GW_ASG_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_ORG_PLT_SPC_AVR,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_ROU_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SPNL_TP,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_COILG_MTH,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SUR_HND_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SKP_DEG,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND ORD_EDG_ASG_TP = ?
     AND ORD_THK_TP = ?
     AND WGT_DCS_MTH_TP = ?
     AND NVL(ORD_SLV_KND_TP,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(EMBS_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PTT_FLM_DTL_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PTT_FLM_WTH,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PTT_FLM_ADH_LOC_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND ORD_WGT_UNT = ?
     --AND NVL(ORD_SHT_CNT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_SHT_CNT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_UNT_WGT_LLV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_UNT_WGT_ULV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_LTH_LLV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_LTH_ULV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_STDP_CNT_LLV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_STDP_CNT_ULV,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_PAK_UNT_WGT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND ORD_PAK_MTH = ?
     AND NVL(ORD_COIL_IDIA,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_COIL_ODIA,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND ORD_THK_MNG_CD = ?
     AND ORD_WTH_MNG_CD = ?
     AND NVL(ORD_LTH_MNG_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SHT_LOD_MTH,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SLIT_GRP_CNT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH1,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH2,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH3,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH4,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH5,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH6,0 ) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH7,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH8,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(SLIT_MAX_WGT,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(TRST_PROC_YN,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_SPC_TXT,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     --AND NVL(BAK_MRK,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND MTL_CD = ?
     AND NVL(TAG_TP,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NAT_CD = ?
     AND NVL(MTL_PRD_ORD_YN,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(CUS_REQ_CLR_NM,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(PAK_MSG_CD,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH9,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(ORD_MIX_WTH10,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(PTT_FLM_NOT_ADH_WS,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(PTT_FLM_NOT_ADH_DS,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(LTH_MNG_YN,'%') LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(LTH_MNG_FROM,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND NVL(LTH_MNG_TO,0) LIKE DECODE(?,'null','%', NVL(?,'%')) ||'%'
     AND TRUNC(SYSDATE - QLT_DSN_END_DH) <= 180
		 ]]> 
	 </query>
