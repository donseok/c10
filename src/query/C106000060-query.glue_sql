        PNT_GRA_FRN_3COT,--도료비중전면3Coat
        PNT_GRA_FRN_4COT,--도료비중전면4Coat
        PNT_GRA_BAK_1COT,--도료비중후면1Coat
        PNT_GRA_BAK_2COT,--도료비중후면2Coat
        PNT_GRA_BAK_3COT,--도료비중후면3Coat
        PNT_GRA_BAK_4COT,--도료비중후면4Coat
        NV_FRN_1COT,--고형분전면1Coat
        NV_FRN_2COT,--고형분전면2Coat
        NV_FRN_3COT,--고형분전면3Coat
        NV_FRN_4COT,--고형분전면4Coat
        NV_BAK_1COT,--고형분후면1Coat
        NV_BAK_2COT,--고형분후면2Coat
        NV_BAK_3COT,--고형분후면3Coat
        NV_BAK_4COT,--고형분후면4Coat
        PNT_UNT_FRN_1COT,--도료원단위전면1Coat
        PNT_UNT_FRN_2COT,--도료원단위전면2Coat
        PNT_UNT_FRN_3COT,--도료원단위전면3Coat
        PNT_UNT_FRN_4COT,--도료원단위전면4Coat
        PNT_UNT_BAK_1COT,--도료원단위후면1Coat
        PNT_UNT_BAK_2COT,--도료원단위후면2Coat
        PNT_UNT_BAK_3COT,--도료원단위후면3Coat
        PNT_UNT_BAK_4COT,--도료원단위후면4Coat
        PNT_UNT_LMN,--도료원단위Lamina
        PTT_FLM_DTL_CD,--보호필름상세코드
        PTT_FLM_LUS_RT_CD,--보호필름광택코드
        PTT_FLM_THK_CD,--보호필름두께코드
        PTT_FLM_MQL_CD,--보호필름재질코드
        PTT_FLM_SUS_ADH_CD,--보호필름SUS점착력코드
        PTT_FLM_PRD_ADH_CD,--보호필름제품점착력코드
        FUNC_DECODE('PTT_FLM_LUS_RT_CD', 'SZ0000', PTT_FLM_LUS_RT_CD) AS PTT_FLM_LUS_RT_CD_NM,--보호필름광택코드 NM
        FUNC_DECODE('PTT_FLM_THK_CD', 'SZ0000', PTT_FLM_THK_CD) AS PTT_FLM_THK_CD_NM,--보호필름두께코드 NM
        FUNC_DECODE('PTT_FLM_MQL_CD', 'SZ0000', PTT_FLM_MQL_CD) AS PTT_FLM_MQL_CD_NM,--보호필름재질코드 NM
        FUNC_DECODE('PTT_FLM_SUS_ADH_CD', 'SZ0000', PTT_FLM_SUS_ADH_CD) AS PTT_FLM_SUS_ADH_CD_NM,--보호필름SUS점착력코드 NM    
        FUNC_DECODE('PTT_FLM_PRD_ADH_CD', 'SZ0000', PTT_FLM_PRD_ADH_CD) AS PTT_FLM_PRD_ADH_CD_NM,--보호필름제품점착력코드 NM    
        LMN_BND_UNT,--Lamina접착제원단위 
        LMN_BND_UNT1,--Lamina접착제원단위1 
        LMN_KND_TP || (SELECT  ' : ' || CD_V_MEANING 
             FROM M00APUSER.VI_M00_CODE_ACCESS
             WHERE CD_TP = 'LMN_KND_TP'         
             AND   CATEGORY_GROUP_NM = 'SZ0000'
             AND   CD_V = LMN_KND_TP) AS LMN_KND_TP_NM,--Lamina유형 NM 
        LMN_KND_TP,
        LMN_BND_CD || (SELECT CD_V || ' : ' || CD_V_MEANING 
             FROM M00APUSER.VI_M00_CODE_ACCESS
             WHERE CD_TP = 'LMN_BND_CD'         
             AND   CATEGORY_GROUP_NM = 'SZ0000'
             AND   CD_V = LMN_BND_CD) AS LMN_BND_CD_NM,--Lamina접착제코드 NM 
        LMN_BND_CD,
        LMN_BND_CD1 || (SELECT CD_V || ' : ' || CD_V_MEANING 
             FROM M00APUSER.VI_M00_CODE_ACCESS
             WHERE CD_TP = 'LMN_BND_CD'         
             AND   CATEGORY_GROUP_NM = 'SZ0000'
             AND   CD_V = LMN_BND_CD1) AS LMN_BND_CD_NM1,--Lamina접착제코드1 NM 
        LMN_BND_CD1,
        LMN_BND_THR_CD,--Lamina접착제신나코드    
        LMN_BND_THR_CD1,--Lamina접착제신나코드1   
        LMN_FLM_THK_CD || (SELECT ' : ' || CD_V_MEANING 
             FROM M00APUSER.VI_M00_CODE_ACCESS
             WHERE CD_TP = 'LMN_FLM_THK_CD'         
             AND   CATEGORY_GROUP_NM = 'SZ0000'
             AND   CD_V = LMN_FLM_THK_CD) AS LMN_FLM_THK_CD_NM,--Lamina필름두께코드 NM
        LMN_FLM_THK_CD,
        PRT_ROLL_NO1,--PrintRollNo1도 Top
        PRT_ROLL_NO2,--PrintRollNo2도 Top
        PRT_ROLL_NO3,--PrintRollNo3도 Top
        PRT_ROLL_NO4,--PrintRollNo4도 Top
        PRT_INK_CD1,--PrintInkCode1도 Top
        PRT_INK_CD2,--PrintInkCode2도 Top
        PRT_INK_CD3,--PrintInkCode3도 Top
        PRT_INK_CD4,--PrintInkCode4도 Top
        PRT_ROLL_PTN_CD1,--PrintRollPatternCode1도 Top
        PRT_ROLL_PTN_CD2,--PrintRollPatternCode2도 Top
        PRT_ROLL_PTN_CD3,--PrintRollPatternCode3도 Top
        PRT_ROLL_PTN_CD4,--PrintRollPatternCode4도 Top
        PRT_UNT1,--Print원단위1도 Top
        PRT_UNT2,--Print원단위2도 Top
        PRT_UNT3,--Print원단위3도 Top
        PRT_UNT4,--Print원단위4도 Top
        PRT_ROLL_BAK_NO1,--PrintRollNo1도 Back
        PRT_ROLL_BAK_NO2,--PrintRollNo2도 Back
        PRT_ROLL_BAK_NO3,--PrintRollNo3도 Back
        PRT_ROLL_BAK_NO4,--PrintRollNo4도 Back
        PRT_INK_BAK_CD1,--PrintInkCode1도 Back
        PRT_INK_BAK_CD2,--PrintInkCode2도 Back
        PRT_INK_BAK_CD3,--PrintInkCode3도 Back
        PRT_INK_BAK_CD4,--PrintInkCode4도 Back
        PRT_ROLL_PTN_BAK_CD1,--PrintRollPatternCode1도 Back
        PRT_ROLL_PTN_BAK_CD2,--PrintRollPatternCode2도 Back
        PRT_ROLL_PTN_BAK_CD3,--PrintRollPatternCode3도 Back
        PRT_ROLL_PTN_BAK_CD4,--PrintRollPatternCode4도 Back
        PRT_BAK_UNT1,--Print원단위1도 Back
        PRT_BAK_UNT2,--Print원단위2도 Back
        PRT_BAK_UNT3,--Print원단위3도 Back
        PRT_BAK_UNT4,--Print원단위4도 Back
        PRT_USG_CD,--Print용도코드
        ANON_CD,--아농코드
        ANON_UNT,--아농원단위
        DISC_PTN_WTH_CD,--불연속패턴및폭관리코드
        MAIN_PROC_CD,--주공정코드
        SUB_PROC_CD1,--대체공정코드1
        SUB_PROC_CD2,--대체공정코드2
        SUB_PROC_CD3,--대체공정코드2    
        DECODE(NVL(TO_CHAR(HUE_CD_FRN), '%'), '%',RPAD(NVL(TO_CHAR(HUE_CD_FRN),' '), 5, ' '), HUE_CD_FRN) || ' - '
        || DECODE(NVL(TO_CHAR(HUE_CD_BAK), '%'), '%',LPAD(NVL(TO_CHAR(HUE_CD_BAK),' '), 5, ' '), HUE_CD_BAK) AS HUE_CD,--색상코드(T/B)
         DECODE(NVL(TO_CHAR(RSN_TP_FRN), '%'), '%',RPAD(NVL(TO_CHAR(RSN_TP_FRN),' '), 5, ' '), RSN_TP_FRN) || ' - '
        || DECODE(NVL(TO_CHAR(RSN_TP_BAK), '%'), '%',LPAD(NVL(TO_CHAR(RSN_TP_BAK),' '), 5, ' '), RSN_TP_BAK) AS RSN_TP,--수지타입(T/B)
        FUNC_DECODE('DISC_PTN_WTH_CD', 'SZ0000', DISC_PTN_WTH_CD) AS DISC_PTN_WTH_CD_NM,--불연속패턴및폭관리코드(마스터)  
        LPAD(' ', 7, ' ') ||' - ' ||LPAD(' ', 7, ' ')  as PTT_FLM_ADH, --보호필름 점착력
        TLP_TP,-- 무독성구분
        CUT_LN_YN,-- 재단선유무
        FUNC_DECODE('PRT_PTN_CD', 'SZ0000', PRT_PTN_CD) AS PRT_PTN_CD_NM,--PrintPatternCode NM
        FUNC_DECODE('QLT_DSN_CFM_TP', 'SZ0000', QLT_DSN_CFM_TP) AS QLT_DSN_CFM_TP_NM,--품질설계확정구분
        QLT_DSN_CFM_TP,
         (SELECT USER_NAME
         FROM M90APUSER.TB_M90_EMP_INF
         WHERE USER_NO = TB_C10_CCL_BOM.RGS_PRS_ID) AS RGS_PRS_ID,  --등록자                                                  --등록자
         TO_CHAR(RGS_DH, 'YYYY-MM-DD') AS RGS_DH,      --등록일
         (SELECT USER_NAME
         FROM M90APUSER.TB_M90_EMP_INF
         WHERE USER_NO = TB_C10_CCL_BOM.MDF_PRS_ID) AS MDF_PRS_ID,  --수정자                                       --수정자
         TO_CHAR(MDF_DH, 'YYYY-MM-DD')  AS MDF_DH, --수정일
         TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS') AS ERP_SND_DH,  --ERP전송일 신규추가
         CASE
         WHEN TO_CHAR(LAST_UPDATE_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS') > NVL(TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS'),'1900-01-01 00:00:00')THEN 'Y'
         ELSE 'N'
         END SND_LST, --전송대상건 구분
         UNI_TEX_ROLL_NO, --유니텍스롤번호 
         UNI_TEX_PTN_CD, --패턴코드
         PICK_UP_ROLL_NO, --픽업롤
         PT_TP, --핀트종류
         IMPT_ROLL_NO, --Imprinting롤번호
         IMPT_ROLL_BAK_NO, --Imprinting Bak롤번호
         CLR_SPC_PRD_SCLS --칼라특수제품소분류   
    FROM C10APUSER.TB_C10_CCL_BOM
    WHERE 1=1 
    AND NVL(CCL_BOM_NO,'%') LIKE  :CCL_BOM_NO ||'%'
    AND NVL(RSN_TP_FRN,'%') LIKE '%' || :RSN_TP_FRN ||'%'
    AND NVL(COT_MTH,'%') LIKE '%' || :COT_MTH ||'%'
    AND NVL(LUS_RT_CD_FRN,'%') LIKE '%' || :LUS_RT_CD_FRN ||'%'
    AND LAST_UPDATE_TIMESTAMP > NVL(ERP_SND_DH,TO_DATE('19000101000000', 'YYYYMMDD HH24MISS')))
WHERE SND_LST='Y'
		 ]]> 
	 </query>
	 <query id="C106000060xls.select" desc="C106000060 정보 조회" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계 CCLBOM조회 C106000060xls.select 이돈석 */
       A.CCL_BOM_NO, A.CCL_BOM_USE_YN, A.COT_MTH, A.COL_SUR_HND_CD, A.PRT_PTN_CD, A.HUE_CD_FRN, A.HUE_CD_BAK, A.HUE_CD_SUB, A.HUE_CD_CHM, A.PNT_FLM_THK_FRN_TOT, A.PNT_FLM_THK_BAK_TOT, A.LUS_RT_CD_FRN, A.LUS_RT_CD_BAK, A.RSN_TP_FRN, A.RSN_TP_BAK, A.DTL_CLR_NM, A.RSN_TP_FRN_1COT, A.RSN_TP_FRN_2COT, A.RSN_TP_FRN_3COT, A.RSN_TP_FRN_4COT, A.RSN_TP_BAK_1COT, A.RSN_TP_BAK_2COT, A.RSN_TP_BAK_3COT, A.RSN_TP_BAK_4COT, A.RSN_TP_LMN, A.HUE_CD_FRN_1COT, A.HUE_CD_FRN_2COT, A.HUE_CD_FRN_3COT, A.HUE_CD_FRN_4COT, A.HUE_CD_BAK_1COT, A.HUE_CD_BAK_2COT, A.HUE_CD_BAK_3COT, A.HUE_CD_BAK_4COT, A.HUE_CD_LMN, A.PNT_FLM_THK_FRN_1COT, A.PNT_FLM_THK_FRN_2COT, A.PNT_FLM_THK_FRN_3COT, A.PNT_FLM_THK_FRN_4COT, A.PNT_FLM_THK_BAK_1COT, A.PNT_FLM_THK_BAK_2COT, A.PNT_FLM_THK_BAK_3COT, A.PNT_FLM_THK_BAK_4COT, A.PNT_FLM_THK_LMN, A.LUS_RT_CD_FRN_1COT, A.LUS_RT_CD_FRN_2COT, A.LUS_RT_CD_FRN_3COT, A.LUS_RT_CD_FRN_4COT, A.LUS_RT_CD_BAK_1COT, A.LUS_RT_CD_BAK_2COT, A.LUS_RT_CD_BAK_3COT, A.LUS_RT_CD_BAK_4COT, A.LUS_RT_CD_LMN, A.LUS_RT_FRN_1COT_LLV, A.LUS_RT_FRN_1COT_ULV, A.LUS_RT_FRN_2COT_LLV, A.LUS_RT_FRN_2COT_ULV, A.LUS_RT_FRN_3COT_LLV, A.LUS_RT_FRN_3COT_ULV, A.LUS_RT_FRN_4COT_LLV, A.LUS_RT_FRN_4COT_ULV, A.LUS_RT_BAK_1COT_LLV, A.LUS_RT_BAK_1COT_ULV, A.LUS_RT_BAK_2COT_LLV, A.LUS_RT_BAK_2COT_ULV, A.LUS_RT_BAK_3COT_LLV, A.LUS_RT_BAK_3COT_ULV, A.LUS_RT_BAK_4COT_LLV, A.LUS_RT_BAK_4COT_ULV, A.LUS_RT_LMN_LLV, A.LUS_RT_LMN_ULV, A.WK_VISCO_FRN_1COT, A.WK_VISCO_FRN_2COT, A.WK_VISCO_FRN_3COT, A.WK_VISCO_FRN_4COT, A.WK_VISCO_BAK_1COT, A.WK_VISCO_BAK_2COT, A.WK_VISCO_BAK_3COT, A.WK_VISCO_BAK_4COT, A.PMT_FRN_1COT, A.PMT_FRN_2COT, A.PMT_FRN_3COT, A.PMT_FRN_4COT, A.PMT_BAK_1COT, A.PMT_BAK_2COT, A.PMT_BAK_3COT, A.PMT_BAK_4COT, A.PMT_LMN, A.THR_CD_FRN_1COT, A.THR_CD_FRN_2COT, A.THR_CD_FRN_3COT, A.THR_CD_FRN_4COT, A.THR_CD_BAK_1COT, A.THR_CD_BAK_2COT, A.THR_CD_BAK_3COT, A.THR_CD_BAK_4COT, A.SLV_GRA_FRN_1COT, A.SLV_GRA_FRN_2COT, A.SLV_GRA_FRN_3COT, A.SLV_GRA_FRN_4COT, A.SLV_GRA_BAK_1COT, A.SLV_GRA_BAK_2COT, A.SLV_GRA_BAK_3COT, A.SLV_GRA_BAK_4COT, A.PNT_GRA_FRN_1COT, A.PNT_GRA_FRN_2COT, A.PNT_GRA_FRN_3COT, A.PNT_GRA_FRN_4COT, A.PNT_GRA_BAK_1COT, A.PNT_GRA_BAK_2COT, A.PNT_GRA_BAK_3COT, A.PNT_GRA_BAK_4COT, A.NV_FRN_1COT, A.NV_FRN_2COT, A.NV_FRN_3COT, A.NV_FRN_4COT, A.NV_BAK_1COT, A.NV_BAK_2COT, A.NV_BAK_3COT, A.NV_BAK_4COT, A.PNT_UNT_FRN_1COT, A.PNT_UNT_FRN_2COT, A.PNT_UNT_FRN_3COT, A.PNT_UNT_FRN_4COT, A.PNT_UNT_BAK_1COT, A.PNT_UNT_BAK_2COT, A.PNT_UNT_BAK_3COT, A.PNT_UNT_BAK_4COT, A.PNT_UNT_LMN, A.PTT_FLM_DTL_CD, A.PTT_FLM_LUS_RT_CD, A.PTT_FLM_THK_CD, A.PTT_FLM_MQL_CD, A.PTT_FLM_SUS_ADH_CD, A.PTT_FLM_PRD_ADH_CD, A.LMN_KND_TP, A.LMN_BND_CD, A.LMN_BND_THR_CD, A.LMN_BND_CD1, A.LMN_BND_THR_CD1, A.LMN_FLM_THK_CD, A.LMN_FLM_WTH_CD, A.PRT_ROLL_NO1, A.PRT_ROLL_NO2, A.PRT_ROLL_NO3, A.PRT_ROLL_NO4, A.PRT_INK_CD1, A.PRT_INK_CD2, A.PRT_INK_CD3, A.PRT_INK_CD4, A.PRT_ROLL_PTN_CD1, A.PRT_ROLL_PTN_CD2, A.PRT_ROLL_PTN_CD3, A.PRT_ROLL_PTN_CD4, A.PRT_UNT1, A.PRT_UNT2, A.PRT_UNT3, A.PRT_UNT4, A.PRT_USG_CD, A.ANON_CD, A.ANON_UNT, A.LUXTEEL_BRD_CD, A.MAIN_PROC_CD, A.SUB_PROC_CD1, A.SUB_PROC_CD2, A.SUB_PROC_CD3, A.TLP_TP, A.CUT_LN_YN, A.QLT_DSN_CFM_TP, A.LMN_BND_UNT, A.LMN_BND_UNT1, A.UNI_TEX_ROLL_NO, A.UNI_TEX_PTN_CD, A.PICK_UP_ROLL_NO, A.PRT_ROLL_BAK_NO1, A.PRT_ROLL_BAK_NO2, A.PRT_ROLL_BAK_NO3, A.PRT_ROLL_BAK_NO4, A.PRT_INK_BAK_CD1, A.PRT_INK_BAK_CD2, A.PRT_INK_BAK_CD3, A.PRT_INK_BAK_CD4, A.PRT_ROLL_PTN_BAK_CD1, A.PRT_ROLL_PTN_BAK_CD2, A.PRT_ROLL_PTN_BAK_CD3, A.PRT_ROLL_PTN_BAK_CD4, A.PRT_BAK_UNT1, A.PRT_BAK_UNT2, A.PRT_BAK_UNT3, A.PRT_BAK_UNT4, A.CCL_BOM_WR_YN, A.PT_TP, A.DISC_PTN_WTH_CD, A.IMPT_ROLL_NO, A.IMPT_ROLL_BAK_NO,
       B.CUS_CD, B.ORD_USG_CD, B.PTT_FLM_DTL_CD, B.CLR_DIF_FRN_LLV, B.CLR_DIF_FRN_ULV, B.CLR_DIF_BAK_LLV, B.CLR_DIF_BAK_ULV, B.MPR_BAS_PNCL_HRDN_FRN, B.MPR_BAS_PNCL_HRDN_BAK, B.MPR_BAS_MEK_FRN, B.MPR_BAS_MEK_BAK, B.CLR_BND_TST_FRN_STD_CD, B.CLR_BND_TST_FRN_GRD_PNT, B.CLR_BND_TST_BAK_STD_CD, B.CLR_BND_TST_BAK_GRD_PNT, B.PTT_FLM_ADH_LLV, B.PTT_FLM_ADH_ULV, B.CCL_QLT_MSG_TXT, B.UNI_GLS_FLM_CD, B.PTT_FLM_DTL_CD_N,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.RGS_PRS_ID) AS RGS_PRS_ID,
       TO_CHAR(a.RGS_DH, 'YYYY-MM-DD HH24:MI:SS') AS RGS_DH,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.MDF_PRS_ID)AS MDF_PRS_ID,
       TO_CHAR(a.MDF_DH, 'YYYY-MM-DD HH24:MI:SS') AS MDF_DH
  FROM TB_C10_CCL_BOM A,
       TB_C10_CLR_MPR B
 WHERE A.CCL_BOM_NO = B.CCL_BOM_NO(+)
		 ]]> 
	 </query>
