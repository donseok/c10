<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000060-Query"> 
	 <query id="C106000060.cclBomInfoSelect" desc="C106000060 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  /* C10 CCL-BOM관리- CCL-BOM조회 C106000060.cclBomInfoSelect 이민균 */ 
    CCL_BOM_NO,--CCLBOM번호
    DECODE(NVL(CCL_BOM_WR_YN,'N'),'N',0,1) AS CCL_BOM_WR_YN,
    DECODE(NVL(CCL_BOM_USE_YN,'N'),'N',0,1) AS CCL_BOM_USE_YN,
    CCL_BOM_USE_YN AS CCL_BOM_USE_YN_HIDDEN,
    DECODE(NVL(CCL_BOM_USE_YN,'N'),'N',0,1) AS ORG_CCL_BOM_USE_YN,
    FUNC_DECODE('COT_MTH', 'SZ0000', COT_MTH) AS COT_MTH_NM, --도장방식(마스터)
    COT_MTH,--도장방식
    COL_SUR_HND_CD,--칼라표면처리코드
    PRT_PTN_CD,--PrintPatternCode
    HUE_CD_FRN,--색상코드전면
    HUE_CD_BAK,--색상코드후면
    HUE_CD_CHM,--색상코드Chemical
    PNT_FLM_THK_FRN_TOT,--도막두께전면Total
    PNT_FLM_THK_BAK_TOT,--도막두께후면Total
    FUNC_DECODE('LUS_RT_CD', 'SZ0000', LUS_RT_CD_FRN) AS LUS_RT_CD_FRN_NM, --광택도코드전면(마스터)
    FUNC_DECODE('LUS_RT_CD', 'SZ0000', LUS_RT_CD_BAK) AS LUS_RT_CD_BAK_NM, --광택도코드후면(마스터)
    LUS_RT_CD_FRN,--광택도코드전면
    LUS_RT_CD_BAK,--광택도코드후면
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_FRN) AS RSN_TP_FRN_NM, --수지구분전면(마스터)
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_BAK) AS RSN_TP_BAK_NM, --수지구분후면(마스터)
    RSN_TP_FRN,--수지구분전면
    RSN_TP_BAK,--수지구분후면
    DTL_CLR_NM,--상세색상명
    RSN_TP_FRN_1COT,--수지구분전면1Coat
    RSN_TP_FRN_2COT,--수지구분전면2Coat
    RSN_TP_FRN_3COT,--수지구분전면3Coat
    RSN_TP_FRN_4COT,--수지구분전면4Coat
    RSN_TP_BAK_1COT,--수지구분후면1Coat
    RSN_TP_BAK_2COT,--수지구분후면2Coat
    RSN_TP_BAK_3COT,--수지구분후면3Coat
    RSN_TP_BAK_4COT,--수지구분후면4Coat
    RSN_TP_LMN,--수지구분Lamina
    HUE_CD_FRN_1COT,--색상코드전면1Coat
    HUE_CD_FRN_2COT,--색상코드전면2Coat
    HUE_CD_FRN_3COT,--색상코드전면3Coat
    HUE_CD_FRN_4COT,--색상코드전면4Coat
    HUE_CD_BAK_1COT,--색상코드후면1Coat
    HUE_CD_BAK_2COT,--색상코드후면2Coat
    HUE_CD_BAK_3COT,--색상코드후면3Coat
    HUE_CD_BAK_4COT,--색상코드후면4Coat
    HUE_CD_LMN,--색상코드Lamina
    PNT_FLM_THK_FRN_1COT,--도막두께전면1Coat
    PNT_FLM_THK_FRN_2COT,--도막두께전면2Coat
    PNT_FLM_THK_FRN_3COT,--도막두께전면3Coat
    PNT_FLM_THK_FRN_4COT,--도막두께전면4Coat
    PNT_FLM_THK_BAK_1COT,--도막두께후면1Coat
    PNT_FLM_THK_BAK_2COT,--도막두께후면2Coat
    PNT_FLM_THK_BAK_3COT,--도막두께후면3Coat
    PNT_FLM_THK_BAK_4COT,--도막두께후면4Coat
    PNT_FLM_THK_LMN,--도막두께Lamina
    LUS_RT_CD_FRN_1COT,--광택도코드전면1Coat
    LUS_RT_CD_FRN_2COT,--광택도코드전면2Coat
    LUS_RT_CD_FRN_3COT,--광택도코드전면3Coat
    LUS_RT_CD_FRN_4COT,--광택도코드전면4Coat
    LUS_RT_CD_BAK_1COT,--광택도코드후면1Coat
    LUS_RT_CD_BAK_2COT,--광택도코드후면2Coat
    LUS_RT_CD_BAK_3COT,--광택도코드후면3Coat
    LUS_RT_CD_BAK_4COT,--광택도코드후면4Coat
    LUS_RT_CD_LMN,--광택도코드Lamina
    LUS_RT_FRN_1COT_LLV,--광택도전면1Coat하한값
    LUS_RT_FRN_1COT_ULV,--광택도전면1Coat상한값
    LUS_RT_FRN_2COT_LLV,--광택도전면2Coat하한값
    LUS_RT_FRN_2COT_ULV,--광택도전면2Coat상한값
    LUS_RT_FRN_3COT_LLV,--광택도전면3Coat하한값
    LUS_RT_FRN_3COT_ULV,--광택도전면3Coat상한값
    LUS_RT_FRN_4COT_LLV,--광택도전면4Coat하한값
    LUS_RT_FRN_4COT_ULV,--광택도전면4Coat상한값
    LUS_RT_BAK_1COT_LLV,--광택도후면1Coat하한값
    LUS_RT_BAK_1COT_ULV,--광택도후면1Coat상한값
    LUS_RT_BAK_2COT_LLV,--광택도후면2Coat하한값
    LUS_RT_BAK_2COT_ULV,--광택도후면2Coat상한값
    LUS_RT_BAK_3COT_LLV,--광택도후면3Coat하한값
    LUS_RT_BAK_3COT_ULV,--광택도후면3Coat상한값
    LUS_RT_BAK_4COT_LLV,--광택도후면4Coat하한값
    LUS_RT_BAK_4COT_ULV,--광택도후면4Coat상한값
    LUS_RT_LMN_LLV,--광택도Lamina하한값
    LUS_RT_LMN_ULV,--광택도Lamina상한값
    WK_VISCO_FRN_1COT,--작업점도전면1Coat
    WK_VISCO_FRN_2COT,--작업점도전면2Coat
    WK_VISCO_FRN_3COT,--작업점도전면3Coat
    WK_VISCO_FRN_4COT,--작업점도전면4Coat
    WK_VISCO_BAK_1COT,--작업점도후면1Coat
    WK_VISCO_BAK_2COT,--작업점도후면2Coat
    WK_VISCO_BAK_3COT,--작업점도후면3Coat
    WK_VISCO_BAK_4COT,--작업점도후면4Coat
    PMT_FRN_1COT,--PMT전면1Coat
    PMT_FRN_2COT,--PMT전면2Coat
    PMT_FRN_3COT,--PMT전면3Coat
    PMT_FRN_4COT,--PMT전면4Coat
    PMT_BAK_1COT,--PMT후면1Coat
    PMT_BAK_2COT,--PMT후면2Coat
    PMT_BAK_3COT,--PMT후면3Coat
    PMT_BAK_4COT,--PMT후면4Coat
    THR_CD_FRN_1COT,--신나코드전면1Coat
    THR_CD_FRN_2COT,--신나코드전면2Coat
    THR_CD_FRN_3COT,--신나코드전면3Coat
    THR_CD_FRN_4COT,--신나코드전면4Coat
    THR_CD_BAK_1COT,--신나코드후면1Coat
    THR_CD_BAK_2COT,--신나코드후면2Coat
    THR_CD_BAK_3COT,--신나코드후면3Coat
    THR_CD_BAK_4COT,--신나코드후면4Coat
    SLV_GRA_FRN_1COT,--용제비중전면1Coat
    SLV_GRA_FRN_2COT,--용제비중전면2Coat
    SLV_GRA_FRN_3COT,--용제비중전면3Coat
    SLV_GRA_FRN_4COT,--용제비중전면4Coat
    SLV_GRA_BAK_1COT,--용제비중후면1Coat
    SLV_GRA_BAK_2COT,--용제비중후면2Coat
    SLV_GRA_BAK_3COT,--용제비중후면3Coat
    SLV_GRA_BAK_4COT,--용제비중후면4Coat
    PNT_GRA_FRN_1COT,--도료비중전면1Coat
    PNT_GRA_FRN_2COT,--도료비중전면2Coat
    PNT_GRA_FRN_3COT,--도료비중전면3Coat
    PNT_GRA_FRN_4COT,--도료비중전면4Coat
    PNT_GRA_BAK_1COT,--도료비중후면1Coat
    PNT_GRA_BAK_2COT,--도료비중후면2Coat
    PNT_GRA_BAK_3COT,--도료비중후면3Coat
    PNT_GRA_BAK_4COT,--도료비중후면4Coat
    NV_FRN_1COT,--고형분전면1Coat
    NV_FRN_2COT,--고형분전면2Coat
    NV_FRN_3COT,--고형분전면3Coat
    NV_FRN_4COT,--고형분전면4Coat
    NV_BAK_1COT,--고형분후면1Coat
    NV_BAK_2COT,--고형분후면2Coat
    NV_BAK_3COT,--고형분후면3Coat
    NV_BAK_4COT,--고형분후면4Coat
    PNT_UNT_FRN_1COT,--도료원단위전면1Coat
    PNT_UNT_FRN_2COT,--도료원단위전면2Coat
    PNT_UNT_FRN_3COT,--도료원단위전면3Coat
    PNT_UNT_FRN_4COT,--도료원단위전면4Coat
    PNT_UNT_BAK_1COT,--도료원단위후면1Coat
    PNT_UNT_BAK_2COT,--도료원단위후면2Coat
    PNT_UNT_BAK_3COT,--도료원단위후면3Coat
    PNT_UNT_BAK_4COT,--도료원단위후면4Coat
    PNT_UNT_LMN,--도료원단위Lamina
    PTT_FLM_DTL_CD,--보호필름상세코드
    PTT_FLM_LUS_RT_CD,--보호필름광택코드
    PTT_FLM_THK_CD,--보호필름두께코드
    PTT_FLM_MQL_CD,--보호필름재질코드
    PTT_FLM_SUS_ADH_CD,--보호필름SUS점착력코드
    PTT_FLM_PRD_ADH_CD,--보호필름제품점착력코드
    FUNC_DECODE('PTT_FLM_LUS_RT_CD','SZ0000', PTT_FLM_LUS_RT_CD) AS PTT_FLM_LUS_RT_CD_NM, --보호필름광택코드 NM
    FUNC_DECODE('PTT_FLM_THK_CD','SZ0000', PTT_FLM_THK_CD) AS PTT_FLM_THK_CD_NM, --보호필름두께코드 NM
    FUNC_DECODE('PTT_FLM_MQL_CD','SZ0000', PTT_FLM_MQL_CD) AS PTT_FLM_MQL_CD_NM, --보호필름재질코드 NM
    FUNC_DECODE('PTT_FLM_SUS_ADH_CD','SZ0000', PTT_FLM_SUS_ADH_CD) AS PTT_FLM_SUS_ADH_CD_NM, --보호필름SUS점착력코드 NM
    FUNC_DECODE('PTT_FLM_PRD_ADH_CD','SZ0000', PTT_FLM_PRD_ADH_CD) AS PTT_FLM_PRD_ADH_CD_NM, --보호필름제품점착력코드 NM
    LMN_BND_UNT, --Lamina접착제원단위 
    LMN_BND_UNT1,--Lamina접착제원단위1 
    LMN_KND_TP || (SELECT  ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'LMN_KND_TP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = LMN_KND_TP) AS LMN_KND_TP_NM,--Lamina유형 NM 
    LMN_KND_TP,
         LMN_BND_CD || (SELECT CD_V || ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'LMN_BND_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = LMN_BND_CD) AS LMN_BND_CD_NM,--Lamina접착제코드 NM 
    LMN_BND_CD,     --Lamina접착제코드
    LMN_BND_THR_CD, --Lamina접착제신나코드    
    LMN_BND_CD1,    --Lamina접착제코드1
    LMN_BND_THR_CD1,--Lamina접착제신나코드1    
LMN_FLM_THK_CD || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'LMN_FLM_THK_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = LMN_FLM_THK_CD) AS LMN_FLM_THK_CD_NM,--Lamina필름두께코드 NM
    LMN_FLM_THK_CD,
    PRT_ROLL_NO1,--PrintRollNo1도 Top
    PRT_ROLL_NO2,--PrintRollNo2도 Top
    PRT_ROLL_NO3,--PrintRollNo3도 Top
    PRT_ROLL_NO4,--PrintRollNo4도 Top
    PRT_INK_CD1,--PrintInkCode1도 Top
    PRT_INK_CD2,--PrintInkCode2도 Top
    PRT_INK_CD3,--PrintInkCode3도 Top
    PRT_INK_CD4,--PrintInkCode4도 Top
    PRT_ROLL_PTN_CD1,--PrintRollPatternCode1도 Top
    PRT_ROLL_PTN_CD2,--PrintRollPatternCode2도 Top
    PRT_ROLL_PTN_CD3,--PrintRollPatternCode3도 Top
    PRT_ROLL_PTN_CD4,--PrintRollPatternCode4도 Top
    PRT_UNT1,--Print원단위1도 Top
    PRT_UNT2,--Print원단위2도 Top
    PRT_UNT3,--Print원단위3도 Top
    PRT_UNT4,--Print원단위4도 Top
    PRT_ROLL_BAK_NO1,--PrintRollNo1도 Back
    PRT_ROLL_BAK_NO2,--PrintRollNo2도 Back
    PRT_ROLL_BAK_NO3,--PrintRollNo3도 Back
    PRT_ROLL_BAK_NO4,--PrintRollNo4도 Back
    PRT_INK_BAK_CD1,--PrintInkCode1도 Back
    PRT_INK_BAK_CD2,--PrintInkCode2도 Back
    PRT_INK_BAK_CD3,--PrintInkCode3도 Back
    PRT_INK_BAK_CD4,--PrintInkCode4도 Back
    PRT_ROLL_PTN_BAK_CD1,--PrintRollPatternCode1도 Back
    PRT_ROLL_PTN_BAK_CD2,--PrintRollPatternCode2도 Back
    PRT_ROLL_PTN_BAK_CD3,--PrintRollPatternCode3도 Back
    PRT_ROLL_PTN_BAK_CD4,--PrintRollPatternCode4도 Back
    PRT_BAK_UNT1,--Print원단위1도 Back
    PRT_BAK_UNT2,--Print원단위2도 Back
    PRT_BAK_UNT3,--Print원단위3도 Back
    PRT_BAK_UNT4,--Print원단위4도 Back
    PRT_USG_CD,--Print용도코드
    ANON_CD,--아농코드
    ANON_UNT,--아농원단위
    DISC_PTN_WTH_CD,--럭스틸브랜드코드
    MAIN_PROC_CD,--주공정코드
    SUB_PROC_CD1,--대체공정코드1
    SUB_PROC_CD2,--대체공정코드2
    SUB_PROC_CD3,--대체공정코드2    
    DECODE(NVL(TO_CHAR(HUE_CD_FRN), '%'), '%',RPAD(NVL(TO_CHAR(HUE_CD_FRN),' '), 5, ' '), HUE_CD_FRN) || ' - '
    || DECODE(NVL(TO_CHAR(HUE_CD_BAK), '%'), '%',LPAD(NVL(TO_CHAR(HUE_CD_BAK),' '), 5, ' '), HUE_CD_BAK) AS HUE_CD,--색상코드(T/B)
     DECODE(NVL(TO_CHAR(RSN_TP_FRN), '%'), '%',RPAD(NVL(TO_CHAR(RSN_TP_FRN),' '), 5, ' '), RSN_TP_FRN) || ' - '
    || DECODE(NVL(TO_CHAR(RSN_TP_BAK), '%'), '%',LPAD(NVL(TO_CHAR(RSN_TP_BAK),' '), 5, ' '), RSN_TP_BAK) AS RSN_TP,--수지타입(T/B)
    FUNC_DECODE('DISC_PTN_WTH_CD','SZ0000', DISC_PTN_WTH_CD) AS DISC_PTN_WTH_CD_NM, --불연속패턴및폭관리코드 NM
    LPAD(' ', 7, ' ') ||' - ' ||LPAD(' ', 7, ' ')  as PTT_FLM_ADH, --보호필름 점착력
    TLP_TP,-- 무독성구분
    CUT_LN_YN,-- 재단선유무
    FUNC_DECODE('PRT_PTN_CD','SZ0000', PRT_PTN_CD) AS PRT_PTN_CD_NM, --PrintPatternCode NM
    PRT_PTN_CD,
    FUNC_DECODE('QLT_DSN_CFM_TP','SZ0000', QLT_DSN_CFM_TP) AS QLT_DSN_CFM_TP_NM, --품질설계확정구분 NM
    QLT_DSN_CFM_TP,
    (SELECT USER_NAME
     FROM M90APUSER.TB_M90_EMP_INF
     WHERE USER_NO = TB_C10_CCL_BOM.RGS_PRS_ID) AS RGS_PRS_ID,  --등록자                                                  --등록자
     TO_CHAR(RGS_DH, 'YYYY-MM-DD') AS RGS_DH,      --등록일
    (SELECT USER_NAME
     FROM M90APUSER.TB_M90_EMP_INF
     WHERE USER_NO = TB_C10_CCL_BOM.MDF_PRS_ID) AS MDF_PRS_ID,  --수정자                                       --수정자
    TO_CHAR(MDF_DH, 'YYYY-MM-DD')  AS MDF_DH, --수정일
    TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS') AS ERP_SND_DH,  --ERP전송일 신규추가
    LAST_UPDATE_TIMESTAMP,
    CASE
      WHEN TO_CHAR(LAST_UPDATE_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS') > NVL(TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS'),'1900-01-01 00:00:00')THEN 'Y'
      ELSE 'N'
    END SND_LST,  --전송대상건 구분
    UNI_TEX_ROLL_NO, --유니텍스롤번호 
    UNI_TEX_PTN_CD, --패턴코드
    PICK_UP_ROLL_NO, --픽업롤
    PT_TP, --핀트종류
    IMPT_ROLL_NO, --Imprinting롤번호
    IMPT_ROLL_BAK_NO, --Imprinting Bak롤번호
    CLR_SPC_PRD_SCLS, --칼라특수제품소분류
    (select CLR_SUB_MTL_CD_OLD from C10APUSER.TB_C10_CLR_CD_MNG where CLR_SUB_MTL_CD = TB_C10_CCL_BOM.HUE_CD_FRN) HUE_CD_FRN_OLD,
    DECODE(NVL(CCL_BOM_ATT_YN,'N'),'N',0,1) AS CCL_BOM_ATT_YN,
    RSN_TP_QT_BR_FRN_1COT, 
    RSN_TP_QT_BR_FRN_2COT, 
    RSN_TP_QT_BR_FRN_3COT, 
    RSN_TP_QT_BR_FRN_4COT, 
    RSN_TP_QT_BR_BAK_1COT, 
    RSN_TP_QT_BR_BAK_2COT, 
    RSN_TP_QT_BR_BAK_3COT, 
    RSN_TP_QT_BR_BAK_4COT, 
    BR_WT_CD,
    RSN_TP_QT_BR_FRN,
    RSN_TP_QT_BR_BAK,
    LUXTEEL_BRD_CD
FROM C10APUSER.TB_C10_CCL_BOM
WHERE 1=1 
AND NVL(CCL_BOM_NO,'%') LIKE  :CCL_BOM_NO ||'%'
AND NVL(RSN_TP_FRN,'%') LIKE '%' || :RSN_TP_FRN ||'%'
AND NVL(COT_MTH,'%') LIKE '%' || :COT_MTH ||'%'
AND NVL(LUS_RT_CD_FRN,'%') LIKE '%' || :LUS_RT_CD_FRN ||'%'
		 ]]> 
	 </query>
