        LUS_RT_BAK_3COT_ULV,--광택도후면3Coat상한값
        LUS_RT_BAK_4COT_LLV,--광택도후면4Coat하한값
        LUS_RT_BAK_4COT_ULV,--광택도후면4Coat상한값
        LUS_RT_LMN_LLV,--광택도Lamina하한값
        LUS_RT_LMN_ULV,--광택도Lamina상한값
        WK_VISCO_FRN_1COT,--작업점도전면1Coat
