	 <query id="C106000060.colorInfo_IU_Log_Insert" desc="C106000060.colorInfo_IU_Log_Insert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 품질설계 CCL-BOM관리 C106000060.colorInfo_IU_Log_Insert 이민균*/ TB_C10_CLR_MPR_MDF_LOG(
    CCL_BOM_NO,--CCLBOM번호
    CUS_CD,--고객사코드
    ORD_USG_CD,--주문용도코드
    MDF_SEQ, --수정 Seq
    MDF_RSN, --수정 사유
    PTT_FLM_DTL_CD,--보호필름상세코드
    PTT_FLM_DTL_CD_N,--구보호필름상세코드
    UNI_GLS_FLM_CD,--UGS필름
    PTT_FLM_MNG_ADH_TXT, --보호필름 관리 점착력
    CLR_DIF_FRN_LLV,--색차전면하한값
    CLR_DIF_FRN_ULV,--색차전면상한값
    CLR_DIF_BAK_LLV,--색차후면하한값
    CLR_DIF_BAK_ULV,--색차후면상한값
    MPR_BAS_PNCL_HRDN_FRN,--물성기준연필경도전면
    MPR_BAS_PNCL_HRDN_BAK,--물성기준연필경도후면
    MPR_BAS_MEK_FRN,--물성기준MEK전면
    MPR_BAS_MEK_BAK,--물성기준MEK후면
    CLR_BND_TST_FRN_STD_CD,--칼라Bending전면기준코드
    CLR_BND_TST_FRN_GRD_PNT,--칼라Bending시험전면평점
    CLR_BND_TST_BAK_STD_CD,--칼라Bending후면기준코드
    CLR_BND_TST_BAK_GRD_PNT,--칼라Bending시험후면평점
    PTT_FLM_ADH_LLV,--보호필름점착력하한
    PTT_FLM_ADH_ULV,--보호필름점착력상한
    CCL_QLT_MSG_TXT,--CCL공정품질메시지
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
    :CCL_BOM_NO,--CCLBOM번호
    :CUS_CD,--고객사코드
    :ORD_USG_CD,--주문용도코드
    nvl((select max(mdf_seq)+1 from TB_C10_CLR_MPR_MDF_LOG where CCL_BOM_NO = :CCL_BOM_NO and CUS_CD = :CUS_CD and ORD_USG_CD = :ORD_USG_CD),0), --수정 Seq No
    :MDF_RSN, -- 수정 사유
    :PTT_FLM_DTL_CD,--보호필름상세코드
    :PTT_FLM_DTL_CD_N,--구보호필름상세코드
    :UNI_GLS_FLM_CD,--UGS필름
    :PTT_FLM_MNG_ADH_TXT, --보호필름 관리 점착력
    :CLR_DIF_FRN_LLV,--색차전면하한값
    :CLR_DIF_FRN_ULV,--색차전면상한값
    :CLR_DIF_BAK_LLV,--색차후면하한값
    :CLR_DIF_BAK_ULV,--색차후면상한값
    :MPR_BAS_PNCL_HRDN_FRN,--물성기준연필경도전면
    :MPR_BAS_PNCL_HRDN_BAK,--물성기준연필경도후면
    :MPR_BAS_MEK_FRN,--물성기준MEK전면
    :MPR_BAS_MEK_BAK,--물성기준MEK후면
    :CLR_BND_TST_FRN_STD_CD,--칼라Bending전면기준코드
    :CLR_BND_TST_FRN_GRD_PNT,--칼라Bending시험전면평점
    :CLR_BND_TST_BAK_STD_CD,--칼라Bending후면기준코드
    :CLR_BND_TST_BAK_GRD_PNT,--칼라Bending시험후면평점
    :PTT_FLM_ADH_LLV,--보호필름점착력하한
    :PTT_FLM_ADH_ULV,--보호필름점착력상한
    :CCL_QLT_MSG_TXT,--CCL공정품질메시지
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp
)
		 ]]> 
	 </query>
	 <query id="C106000060.colorInfo_D_Log_Insert" desc="C106000060.colorInfo_D_Log_Insert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 품질설계 CCL-BOM관리 C106000060.colorInfo_D_Log_Insert 이민균*/ TB_C10_CLR_MPR_MDF_LOG(
    CCL_BOM_NO,--CCLBOM번호
    CUS_CD,--고객사코드
    ORD_USG_CD,--주문용도코드
    MDF_SEQ, --수정 Seq
    MDF_RSN, --수정 사유
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
    :CCL_BOM_NO,--CCLBOM번호
    :CUS_CD,--고객사코드
    :ORD_USG_CD,--주문용도코드
    nvl((select max(mdf_seq)+1 from TB_C10_CLR_MPR_MDF_LOG where CCL_BOM_NO = :CCL_BOM_NO and CUS_CD = :CUS_CD and ORD_USG_CD = :ORD_USG_CD),0), --수정 Seq No
    :MDF_RSN, -- 수정 사유
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp
)
		 ]]> 
	 </query>
	 <query id="C106000060.tru_tst_Insert" desc="C106000060.colorInfo_D_Log_Insert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C106000060  신뢰성시험등록 C106010060.insert 김종화 */ 
INTO MESAPUSER.TB_M20_TRU_TST_MNG
(   
     TRU_TST_REQ_NO
    ,TRU_TST_REQ_DH
    ,RGS_MTH_CD
    ,TRU_TST_KND_TP
    ,CCL_BOM_NO
    ,PU_CRT_YN
    ,SMPL_REQ_ID
    ,SMPL_REQ_DH
    ,CREATED_OBJECT_TYPE
    ,CREATED_OBJECT_ID
    ,CREATED_PROGRAM_ID
    ,CREATION_TIMESTAMP
    ,LAST_UPDATED_OBJECT_TYPE
    ,LAST_UPDATED_OBJECT_ID
    ,LAST_UPDATE_PROGRAM_ID
    ,LAST_UPDATE_TIMESTAMP
)
SELECT
    (SELECT TO_CHAR(SYSDATE,'YYYYMMDD') || NVL(MAX(SUBSTR(TRU_TST_REQ_NO,9,3)), '000') + 1 
       FROM MESAPUSER.TB_M20_TRU_TST_MNG A
      WHERE SUBSTR(TRU_TST_REQ_NO,1,8) = TO_CHAR(SYSDATE,'YYYYMMDD'))
    ,TO_CHAR(SYSDATE,'YYYYMMDD')
    ,'A'
    ,'A'
    ,:CCL_BOM_NO
    ,'N'
    ,:ObjectId
    ,SYSDATE
    ,:ObjectType
    ,:ObjectId
    ,:ProgramId
    ,:Timestamp
    ,:ObjectType
    ,:ObjectId
    ,:ProgramId
    ,:Timestamp
FROM DUAL
WHERE (SELECT COUNT(CCL_BOM_NO) 
         FROM C10APUSER.TB_C10_CCL_BOM 
        WHERE SUBSTR(CCL_BOM_NO,1,5) = SUBSTR(:CCL_BOM_NO,1,5) ) = 0
		 ]]> 
	 </query>
	 <query id="C106000060.c10A2200Select" desc="공정별담당자정보" fetchSize="1" isNamed="true">
		 <![CDATA[ 
select MAIN_EMP_CD
	, SUB_EMP_CD1
	, SUB_EMP_CD2 
from M00APUSER.VI_M00_C10A2200
where MAIN_PROC_CD = :MAIN_PROC_CD
and ROWNUM = 1
		 ]]> 
	 </query>
</queryMap>
