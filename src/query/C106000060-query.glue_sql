	 <query id="C106000060.detailSelect" desc="상세조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  /* C10 CCL-BOM관리-고객사 주문용도조회 C106000060.detailSelect 이민균 */ 
    CCL_BOM_NO,--CCLBOM번호
    CUS_CD,--고객사코드
    (SELECT CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'CUS_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = CUS_CD)  AS CUS_CD_NM,--고객사코드_MASTER  
    ORD_USG_CD,--주문용도코드
    (SELECT CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'ORD_USG_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = ORD_USG_CD) AS ORD_USG_CD_NM,--주문용도코드_MASTER 
    PTT_FLM_DTL_CD,--보호필름상세코드
    PTT_FLM_DTL_CD_N,--구보호필름상세코드
    UNI_GLS_FLM_CD,--UNIGLS필름코드
    CLR_DIF_FRN_LLV,--색차전면하한값
    CLR_DIF_FRN_ULV,--색차전면상한값
    CLR_DIF_BAK_LLV,--색차후면하한값
    CLR_DIF_BAK_ULV,--색차후면상한값
    MPR_BAS_PNCL_HRDN_FRN,--물성기준연필경도전면
    MPR_BAS_PNCL_HRDN_BAK,--물성기준연필경도후면
    MPR_BAS_MEK_FRN,--물성기준MEK전면
    MPR_BAS_MEK_BAK,--물성기준MEK후면
    CLR_BND_TST_FRN_STD_CD,--칼라Bending전면기준코드
    CLR_BND_TST_FRN_GRD_PNT,--칼라Bending시험전면평점
    CLR_BND_TST_BAK_STD_CD,--칼라Bending후면기준코드
    CLR_BND_TST_BAK_GRD_PNT,--칼라Bending시험후면평점
    PTT_FLM_ADH_LLV,--보호필름점착력하한
    PTT_FLM_ADH_ULV,--보호필름점착력상한
    CCL_QLT_MSG_TXT,--CCL공정품질메시지
    PTT_FLM_MNG_ADH_TXT, --보호필름 관리 점착력
    (SELECT CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_PRD_ADH_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = SUBSTR(PTT_FLM_DTL_CD,5,1))  AS PTT_FLM_PRD_ADH_CD_NM_MASTER,--보호필름 제품점착력_MASTER  
    (SELECT CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_THK_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = SUBSTR(PTT_FLM_DTL_CD,2,1)) AS PTT_FLM_THK_CD_NM_MASTER,--보호필름두께코드_MASTER     
    (SELECT CD_V_MEANING 
      FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PTT_FLM_MQL_CD'         
      AND   CATEGORY_GROUP_NM = 'SZ0000'
      AND   CD_V = SUBSTR(PTT_FLM_DTL_CD,3,1)) AS PTT_FLM_MQL_CD_NM_MASTER,--보호필름재질코드_MASTER
      TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS') AS ERP_SND_DH,   --ERP전송일시 추가
    KEY_WRD1,
    KEY_WRD2,
    KEY_WRD3,
    KEY_WRD4,
    KEY_WRD1 AS KEY_WRD11,
    KEY_WRD2 AS KEY_WRD22,
    KEY_WRD3 AS KEY_WRD33,
    KEY_WRD4 AS KEY_WRD44
FROM C10APUSER.TB_C10_CLR_MPR
WHERE CCL_BOM_NO = :CCL_BOM_NO
ORDER BY decode(CUS_CD,'******','0', CUS_CD), decode(ORD_USG_CD, '******','0', ORD_USG_CD)
		 ]]> 
	 </query>
	 <query id="C106000060.colorSelect" desc="C106000060.colorSelect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  /* C10 CCL-BOM관리- 색상코드조회 C106000060.colorSelect 이민균 */ 
        CCL_BOM_NO,--CCLBOM번호
    DECODE(NVL(CCL_BOM_USE_YN,'N'),'N',0,1) AS CCL_BOM_USE_YN,
    CCL_BOM_USE_YN AS CCL_BOM_USE_YN_HIDDEN,
    FUNC_DECODE('COT_MTH', 'SZ0000', COT_MTH) AS COT_MTH_NM,--도장방식(마스터)
    COT_MTH,--도장방식
    COL_SUR_HND_CD,--칼라표면처리코드
    PRT_PTN_CD,--PrintPatternCode
    HUE_CD_FRN,--색상코드전면
    HUE_CD_BAK,--색상코드후면
    HUE_CD_SUB,--색상코드SUB
    HUE_CD_CHM,--색상코드Chemical
    PNT_FLM_THK_FRN_TOT,--도막두께전면Total
    PNT_FLM_THK_BAK_TOT,--도막두께후면Total
    FUNC_DECODE('LUS_RT_CD', 'SZ0000', LUS_RT_CD_FRN) AS LUS_RT_CD_FRN_NM,--광택도코드전면(마스터)
    LUS_RT_CD_FRN,--광택도코드전면
    LUS_RT_CD_BAK,--광택도코드후면
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_FRN) AS RSN_TP_FRN_NM,--수지구분전면(마스터)
    RSN_TP_FRN,--수지구분전면
    RSN_TP_BAK,--수지구분후면
    DTL_CLR_NM,--상세색상명
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_FRN_1COT) AS RSN_TP_FRN_1COT,----구매수지구분전면1Coat
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_FRN_2COT) AS RSN_TP_FRN_2COT,----구매수지구분전면2Coat
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_FRN_3COT) AS RSN_TP_FRN_3COT,----구매수지구분전면3Coat
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_FRN_4COT) AS RSN_TP_FRN_4COT,----구매수지구분전면4Coat
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_BAK_1COT) AS RSN_TP_BAK_1COT,----구매수지구분후면1Coat
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_BAK_2COT) AS RSN_TP_BAK_2COT,----구매수지구분후면2Coat
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_BAK_3COT) AS RSN_TP_BAK_3COT,----구매수지구분후면3Coat
    FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_BAK_4COT) AS RSN_TP_BAK_4COT,----구매수지구분후면4Coat
    RSN_TP_LMN,--수지구분Lamina                                        
    HUE_CD_FRN_1COT,--색상코드전면1Coat
    HUE_CD_FRN_2COT,--색상코드전면2Coat
    HUE_CD_FRN_3COT,--색상코드전면3Coat
    HUE_CD_FRN_4COT,--색상코드전면4Coat
    HUE_CD_BAK_1COT,--색상코드후면1Coat
    HUE_CD_BAK_2COT,--색상코드후면2Coat
    HUE_CD_BAK_3COT,--색상코드후면3Coat
    HUE_CD_BAK_4COT,--색상코드후면4Coat
    HUE_CD_LMN,--색상코드Lamina
    PNT_FLM_THK_FRN_1COT,--도막두께전면1Coat
    PNT_FLM_THK_FRN_2COT,--도막두께전면2Coat
    PNT_FLM_THK_FRN_3COT,--도막두께전면3Coat
