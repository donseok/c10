    ,DECODE(:COT_MTH,'K',(SELECT PNT_UNT FROM  C10APUSER.TB_C10_CLR_CD_MNG WHERE CLR_SUB_MTL_CD = 'TIJ0Y' AND ROWNUM = 1),'')
    ,DECODE(:COT_MTH,'K','TIJLC','')
    ,DECODE(:COT_MTH,'K',(SELECT PNT_UNT FROM  C10APUSER.TB_C10_CLR_CD_MNG WHERE CLR_SUB_MTL_CD = 'TIJLC' AND ROWNUM = 1),'')
    ,DECODE(:COT_MTH,'K','TIJLK','')
    ,DECODE(:COT_MTH,'K',(SELECT PNT_UNT FROM  C10APUSER.TB_C10_CLR_CD_MNG WHERE CLR_SUB_MTL_CD = 'TIJLK' AND ROWNUM = 1),'')
    ,DECODE(:COT_MTH,'K','TIJLM','')
    ,DECODE(:COT_MTH,'K',(SELECT PNT_UNT FROM  C10APUSER.TB_C10_CLR_CD_MNG WHERE CLR_SUB_MTL_CD = 'TIJLM' AND ROWNUM = 1),'')
	,:LAST_UPDATED_OBJECT_ID                           --최종변경ObjectID
    ,:RSN_TP_QT_BR_FRN_1COT
    ,:RSN_TP_QT_BR_FRN_2COT
    ,:RSN_TP_QT_BR_FRN_3COT
    ,:RSN_TP_QT_BR_FRN_4COT
    ,:RSN_TP_QT_BR_BAK_1COT
    ,:RSN_TP_QT_BR_BAK_2COT
    ,:RSN_TP_QT_BR_BAK_3COT
    ,:RSN_TP_QT_BR_BAK_4COT
	,:ObjectType                                       --생성Object유형
	,:ObjectId                                         --생성ObjectID 
	,:ProgramId                                        --생성프로그램ID
	,:Timestamp                                        --생성일시 
	,:ObjectType                                       --최종변경Object유형
	,:ObjectId                                         --최종변경ObjectID 
	,:ProgramId                                        --최종변경프로그램ID
	,:Timestamp                                        --최종변경일시
   )
		 ]]> 
	 </query>
	 <query id="C106000060.cusCdAjaxSelect" desc="C106000060.cusCdAjaxSelect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 CCL-BOM관리- 고객사 AJAX 조회 C106000060.cusCdAjaxSelect 이민균 */   
CD_V,
CD_V_MEANING
FROM M00APUSER.VI_M00_CODE_ACCESS
WHERE CD_TP = 'CUS_CD'         
AND CATEGORY_GROUP_NM = 'SZ0000'
AND  CD_V LIKE '%' || :CD_V || '%'
		 ]]> 
	 </query>
	 <query id="C106000060.ordUsgCdAjaxSelect" desc="C106000060.ordUsgCdAjaxSelect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 CCL-BOM관리- 주문용도 AJAX 조회 C106000060.ordUsgCdAjaxSelect 이민균 */   
CD_V,
CD_V_MEANING
FROM M00APUSER.VI_M00_CODE_ACCESS
WHERE CD_TP = 'ORD_USG_CD'         
AND CATEGORY_GROUP_NM = 'SZ0000'
AND  CD_V LIKE '%' || :CD_V || '%'
		 ]]> 
	 </query>
	 <query id="C106000060.PrtPntCdSelect" desc="C106000060.PrtPntCdSelect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 PrintPatternCode 조회  C106000060.PrtPntCdSelect 김종범*/   
PRT_PTN_CD, --프린트패턴코드
PRT_PTN_CD || (SELECT ' : ' || CD_V_MEANING 
	 FROM M00APUSER.VI_M00_CODE_ACCESS
	 WHERE CD_TP = 'PRT_PTN_CD'         
	 AND   CATEGORY_GROUP_NM = 'SZ0000'
	 AND   CD_V = PRT_PTN_CD) AS PRT_PTN_CD_NM--PrintPatternCode NM
FROM M00APUSER.VI_M00_C10A1091
WHERE PRT_ROLL_NO = :PRT_ROLL_NO
		 ]]> 
	 </query>
	 <query id="C106000060.UtPntCdSelect" desc="C106000060.UtPntCdSelect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 UnitexPatternCode 조회  C106000060.UtPntCdSelect 이돈석*/   
PRT_PTN_CD, --유니텍스패턴코드
PRT_PTN_CD || (SELECT ' : ' || CD_V_MEANING 
	 FROM M00APUSER.VI_M00_CODE_ACCESS
	 WHERE CD_TP = 'PRT_PTN_CD'         
	 AND   CATEGORY_GROUP_NM = 'SZ0000'
	 AND   CD_V = PRT_PTN_CD) AS PRT_PTN_CD_NM--유니텍스패턴코드명
FROM M00APUSER.VI_M00_C10A1092
WHERE PRT_ROLL_NO = :PRT_ROLL_NO
		 ]]> 
	 </query>
	 <query id="C106000060.clr_snd_update" desc="칼라물성전송시 ERP전송일시 등록" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 칼라물성전송관리 C106000060.clr_snd_update 김종범 */ 
TB_C10_CLR_MPR SET 
ERP_SND_DH = sysdate,  --ERP전송일시
LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
LAST_UPDATED_OBJECT_ID=:ObjectId,      
LAST_UPDATE_PROGRAM_ID=:ProgramId,     
LAST_UPDATE_TIMESTAMP=:Timestamp 
WHERE CCL_BOM_NO = :CCL_BOM_NO
AND CUS_CD = :CUS_CD--고객사코드
AND ORD_USG_CD = :ORD_USG_CD--고객사코드
		 ]]> 
	 </query>
	 <query id="C106000060.interFaceColorDel" desc="C106000060.interFaceColorDel 삭제건" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 CCL-BOM관리 C106000060.interFaceColorDel 삭제건 김종범  */   
INTO TB_C10_B10S0120
(
      IF_GRP_ID                                         --인터페이스그룹아이디
    , SEQ_NO                                            --인터페이스 SEQ
    , XSEQ                                              --PI Sequence Key Value
    , XCRUD                                             --PI Data 유형
    , XSTAT                                             --처리상태 
    , XDATE                                             --응답날짜
    , XTIME                                             --응답시간
    , CCL_BOM_NO                                        --CCLBOM번호
    , CUS_CD                                            --고객사코드
    , ORD_USG_CD                                        --주문용도코드
    , PTT_FLM_DTL_CD                                    --보호필름상세코드
    , PTT_FLM_PRD_ADH_NM                                --보호필름제품점착력명
    , PTT_FLM_THK_NM                                    --보호필름두께명
    , PTT_FLM_MQL_NM                                    --보호필름재질명    
    , CREATED_OBJECT_TYPE                               --생성Object유형
    , CREATED_OBJECT_ID                                 --생성ObjectID 
    , CREATED_PROGRAM_ID                                --생성프로그램ID
    , CREATION_TIMESTAMP                                --생성일시 
    , LAST_UPDATED_OBJECT_TYPE                          --최종변경Object유형
    , LAST_UPDATED_OBJECT_ID                            --최종변경ObjectID 
    , LAST_UPDATE_PROGRAM_ID                            --최종변경프로그램ID
    , LAST_UPDATE_TIMESTAMP                             --최종변경일시
    , DEL_YN     --삭제여부추가 12-07-09 한윤섭
)
VALUES
(
     :IF_GRP_ID --인터페이스그룹아이디
    , SQ_C10_B10S0120.NEXTVAL                           --인터페이스 SEQ
    , '1'                                               --PI Sequence Key Value
    , 'C'                                               --PI Data 유형
    , 'R'                                               --처리상태
    , SUBSTR(:IF_GRP_ID, 1, 8)                          --응답날짜
    , SUBSTR(:IF_GRP_ID, 9, 6)                          --응답시간
    , :CCL_BOM_NO                                       --CCLBOM번호
    , :CUS_CD                                           --고객사코드
    , :ORD_USG_CD                                       --주문용도코드
    , :PTT_FLM_DTL_CD                                   --보호필름상세코드
    , :PTT_FLM_PRD_ADH_CD_NM_MASTER                     --보호필름제품점착력명
    , :PTT_FLM_THK_CD_NM_MASTER                         --보호필름두께명
    , :PTT_FLM_MQL_CD_NM_MASTER                         --보호필름재질명   
    , :ObjectType                                       --생성Object유형
    , :ObjectId                                         --생성ObjectID 
    , :ProgramId                                        --생성프로그램ID
    , :Timestamp                                        --생성일시 
    , :ObjectType                                       --최종변경Object유형
    , :ObjectId                                         --최종변경ObjectID 
    , :ProgramId                                        --최종변경프로그램ID
    , :Timestamp                                        --최종변경일시 
    , 'Y'
)
		 ]]> 
	 </query>
	 <query id="C106000060.ccl_snd_update" desc="CCL-BOM정보전송후 전송일시UPDATE" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 CCL-BOM전송관리 C106000060.ccl_snd_update 김종범 */ 
TB_C10_CCL_BOM SET 
ERP_SND_DH = sysdate,  --ERP전송일시
LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
LAST_UPDATED_OBJECT_ID=:ObjectId,      
LAST_UPDATE_PROGRAM_ID=:ProgramId,
LAST_UPDATE_TIMESTAMP=:Timestamp 
WHERE CCL_BOM_NO = :CCL_BOM_NO
		 ]]> 
	 </query>
