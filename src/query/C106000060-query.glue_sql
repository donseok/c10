    FUNC_DECODE('RSN_TP_QT_BR', 'SZ0000', RSN_TP_QT_BR_BAK_3COT) AS RSN_TP_QT_BR_BAK_3COT,----품질수지구분후면3Coat
    FUNC_DECODE('RSN_TP_QT_BR', 'SZ0000', RSN_TP_QT_BR_BAK_4COT) AS RSN_TP_QT_BR_BAK_4COT,----품질수지구분후면4Coat
     (SELECT CLR_SUB_MTL_CD_OLD 
     FROM TB_C10_CLR_CD_MNG
     WHERE CLR_SUB_MTL_CD = HUE_CD_LMN) AS CLR_SUB_MTL_CD_OLD_HUE_CD_LMN, --Lamina구색상코드
     (SELECT RL_LUS_RT
     FROM TB_C10_CLR_CD_MNG
     WHERE CLR_SUB_MTL_CD = HUE_CD_FRN) AS RL_LUS_RT_FRN, --실광택값(전면)
     (SELECT RL_LUS_RT
     FROM TB_C10_CLR_CD_MNG
     WHERE CLR_SUB_MTL_CD = HUE_CD_BAK) AS RL_LUS_RT_BAK --실광택값(후면)     
FROM C10APUSER.TB_C10_CCL_BOM
WHERE  CCL_BOM_NO = :CCL_BOM_NO
		 ]]> 
	 </query>
	 <query id="C106000060.cclBomUseUpdate" desc="cclBomUseUpdate" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE/*+ C10 CCL-BOM관리 확정 Update C106000040.cclBomUseUpdate 이민균 */ TB_C10_CCL_BOM
SET CCL_BOM_USE_YN = :CCL_BOM_USE_YN_HIDDEN,
MDF_PRS_ID=:ObjectId,      --수정자
MDF_DH=sysdate,            --수정일
LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
LAST_UPDATED_OBJECT_ID=:ObjectId,      
LAST_UPDATE_PROGRAM_ID=:ProgramId,     
LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE CCL_BOM_NO  = :CCL_BOM_NO
		 ]]> 
	 </query>
	 <query id="C106000060.colorAjaxSelect" desc="C106000060.colorAjaxSelect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT/* C10 CCL-BOM관리- COLOR AJAX 조회 C106000060.colorAjaxSelect 이민균 */   
CLR_SUB_MTL_CD,--칼라부자재코드
FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP) AS RSN_TP_NM,--구매수지구분 NM
RSN_TP,--수지코드
FUNC_DECODE('LUS_RT_CD', 'SZ0000', LUS_RT_CD) AS LUS_RT_CD_NM,--광택도코드 NM
LUS_RT_CD,--광택도코드
DECODE(DECODE(NVL(TO_CHAR(LUS_RT_LLV), '%'), '%',RPAD(NVL(TO_CHAR(LUS_RT_LLV),' '), 3, ' '), LUS_RT_LLV) || ' - '
    || DECODE(NVL(TO_CHAR(LUS_RT_ULV), '%'), '%',LPAD(NVL(TO_CHAR(LUS_RT_ULV),' '), 3, ' '), LUS_RT_LLV),'    -    ','',DECODE(NVL(TO_CHAR(LUS_RT_LLV), '%'), '%',RPAD(NVL(TO_CHAR(LUS_RT_LLV),' '), 3, ' '), LUS_RT_LLV) || ' - '
    || DECODE(NVL(TO_CHAR(LUS_RT_ULV), '%'), '%',LPAD(NVL(TO_CHAR(LUS_RT_ULV),' '), 3, ' '), LUS_RT_LLV)) AS LUS_RT,--광택도
WK_VISCO,--작업점도
PMT,--PMT
PNT_FLM_THK,--도막두께
SLV_GRA,--용재비중
PNT_GRA,--도료비중(SG)
NV,--고형
PNT_UNT,--원단위
THR_CD,--신나코드
LUS_RT_LLV,--광택도하한값
LUS_RT_ULV,--광택도상한값
SUB_MTL_TP,--부자재구분코드
PTT_FLM_LUS_RT_CD,--보호필름광택코드
PTT_FLM_THK_CD,--보호필름두께코드
PTT_FLM_MQL_CD,--보호필름재질코드
PTT_FLM_SUS_ADH_CD,--보호필름SUS점착력코드
PTT_FLM_PRD_ADH_CD,--보호필름제품점착력코드
LMN_KND_TP,--Lamina유형
LMN_BND_CD,--Lamina접착제코드
LMN_BND_THR_CD,--Lamina접착제신나코드
LMN_BND_CD1,--Lamina접착제코드1
LMN_BND_THR_CD1,--Lamina접착제신나코드1
LMN_FLM_THK_CD,--Lamina필름두께코드
FUNC_DECODE('RSN_TP_QT_BR', 'SZ0000', RSN_TP_QT_BR) AS RSN_TP_QT_BR_NM,--품질수지구분 NM
RSN_TP_QT_BR,--품질수지
CLR_SUB_MTL_CD_OLD AS CLR_SUB_MTL_CD_OLD_HUE_CD_LMN, --구칼라부자재코드 Lamina
FUNC_DECODE('PTT_FLM_LUS_RT_CD', 'SZ0000', PTT_FLM_LUS_RT_CD) AS PTT_FLM_LUS_RT_CD_NM,--보호필름광택코드 NM
FUNC_DECODE('PTT_FLM_THK_CD', 'SZ0000', PTT_FLM_THK_CD) AS PTT_FLM_THK_CD_NM,--보호필름두께코드 NM
FUNC_DECODE('PTT_FLM_MQL_CD', 'SZ0000', PTT_FLM_MQL_CD) AS PTT_FLM_MQL_CD_NM,--보호필름재질코드 NM
FUNC_DECODE('PTT_FLM_SUS_ADH_CD', 'SZ0000', PTT_FLM_SUS_ADH_CD) AS PTT_FLM_SUS_ADH_CD_NM,--보호필름SUS점착력코드 NM 
FUNC_DECODE('PTT_FLM_PRD_ADH_CD', 'SZ0000', PTT_FLM_PRD_ADH_CD) AS PTT_FLM_PRD_ADH_CD_NM,--보호필름제품점착력코드 NM
FUNC_DECODE01('PTT_FLM_PRD_ADH_CD', 'SZ0000', PTT_FLM_PRD_ADH_CD) AS PTT_FLM_PRD_ADH_CD_NM_MASTER,--보호필름제품점착력코드 NM_MASTER
FUNC_DECODE01('PTT_FLM_THK_CD', 'SZ0000', PTT_FLM_THK_CD) AS PTT_FLM_THK_CD_NM_MASTER,--보호필름두께코드 NM_MASTER
FUNC_DECODE01('PTT_FLM_MQL_CD', 'SZ0000', PTT_FLM_MQL_CD) AS PTT_FLM_MQL_CD_NM_MASTER,--보호필름재질코드 NM_MASTER
LMN_KND_TP || (SELECT  ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'LMN_KND_TP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = LMN_KND_TP) AS LMN_KND_TP_NM,--Lamina유형 NM     
LMN_BND_CD || (SELECT CD_V || ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'LMN_BND_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = LMN_BND_CD) AS LMN_BND_CD_NM,--Lamina접착제코드 NM   
LMN_BND_CD1 || (SELECT CD_V || ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'LMN_BND_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = LMN_BND_CD1) AS LMN_BND_CD_NM1,--Lamina접착제코드1 NM   
LMN_FLM_THK_CD || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'LMN_FLM_THK_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = LMN_FLM_THK_CD) AS LMN_FLM_THK_CD_NM,--Lamina필름두께코드 NM
PNT_UNT AS LMN_BND_UNT,--(도료원단위)Lamina접착제원단위
PNT_UNT AS LMN_BND_UNT1,--(도료원단위)Lamina접착제원단위1
CLR_NM, --색상명
USE_YN, -- 컬러코드사용유무
TO_CHAR(ERP_SND_DH,'YYYYMMDD') ERP_SND_DH,  -- ERP전송일자
RL_LUS_RT -- 실광택값
FROM TB_C10_CLR_CD_MNG
WHERE (SUB_MTL_TP = :SUB_MTL_TP1 OR SUB_MTL_TP = :SUB_MTL_TP2 OR SUB_MTL_TP = :SUB_MTL_TP3 
       OR SUB_MTL_TP = :SUB_MTL_TP4 OR SUB_MTL_TP = :SUB_MTL_TP5 OR SUB_MTL_TP = :SUB_MTL_TP6)
AND CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000060.colorInfoInsert" desc="C106000060.colorInfoInsert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /* C10 품질설계 CCL-BOM관리 C106000060.colorInfoInsert 이민균*/TB_C10_CLR_MPR(
    CCL_BOM_NO,--CCLBOM번호
    CUS_CD,--고객사코드
    ORD_USG_CD,--주문용도코드
    PTT_FLM_DTL_CD,--보호필름상세코드
    PTT_FLM_DTL_CD_N,--구보호필름상세코드
    UNI_GLS_FLM_CD,--UGS필름
    PTT_FLM_MNG_ADH_TXT, --보호필름 관리 점착력
    CLR_DIF_FRN_LLV,--색차전면하한값
    CLR_DIF_FRN_ULV,--색차전면상한값
    CLR_DIF_BAK_LLV,--색차후면하한값
    CLR_DIF_BAK_ULV,--색차후면상한값
    MPR_BAS_PNCL_HRDN_FRN,--물성기준연필경도전면
    MPR_BAS_PNCL_HRDN_BAK,--물성기준연필경도후면
    MPR_BAS_MEK_FRN,--물성기준MEK전면
    MPR_BAS_MEK_BAK,--물성기준MEK후면
    CLR_BND_TST_FRN_STD_CD,--칼라Bending전면기준코드
    CLR_BND_TST_FRN_GRD_PNT,--칼라Bending시험전면평점
    CLR_BND_TST_BAK_STD_CD,--칼라Bending후면기준코드
    CLR_BND_TST_BAK_GRD_PNT,--칼라Bending시험후면평점
    PTT_FLM_ADH_LLV,--보호필름점착력하한
    PTT_FLM_ADH_ULV,--보호필름점착력상한
    CCL_QLT_MSG_TXT,--CCL공정품질메시지
    KEY_WRD1,--키워드1
    KEY_WRD2,--키워드2
    KEY_WRD3,--키워드3
    KEY_WRD4,--키워드4
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
    :CCL_BOM_NO,--CCLBOM번호
    :CUS_CD,--고객사코드
    :ORD_USG_CD,--주문용도코드
    :PTT_FLM_DTL_CD,--보호필름상세코드
    :PTT_FLM_DTL_CD_N,--구보호필름상세코드
    :UNI_GLS_FLM_CD,--UGS필름
    :PTT_FLM_MNG_ADH_TXT, --보호필름 관리 점착력
    :CLR_DIF_FRN_LLV,--색차전면하한값
    :CLR_DIF_FRN_ULV,--색차전면상한값
    :CLR_DIF_BAK_LLV,--색차후면하한값
    :CLR_DIF_BAK_ULV,--색차후면상한값
    :MPR_BAS_PNCL_HRDN_FRN,--물성기준연필경도전면
    :MPR_BAS_PNCL_HRDN_BAK,--물성기준연필경도후면
    :MPR_BAS_MEK_FRN,--물성기준MEK전면
    :MPR_BAS_MEK_BAK,--물성기준MEK후면
    :CLR_BND_TST_FRN_STD_CD,--칼라Bending전면기준코드
    :CLR_BND_TST_FRN_GRD_PNT,--칼라Bending시험전면평점
    :CLR_BND_TST_BAK_STD_CD,--칼라Bending후면기준코드
    :CLR_BND_TST_BAK_GRD_PNT,--칼라Bending시험후면평점
    :PTT_FLM_ADH_LLV,--보호필름점착력하한
    :PTT_FLM_ADH_ULV,--보호필름점착력상한
    :CCL_QLT_MSG_TXT,--CCL공정품질메시지
    :KEY_WRD1,--키워드1
    :KEY_WRD2,--키워드2
    :KEY_WRD3,--키워드3
    :KEY_WRD4,--키워드4
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp
)
		 ]]> 
	 </query>
	 <query id="C106000060.colorInfoUpdate" desc="C106000060.colorInfoUpdate " fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /* C10 품질설계 CCL-BOM관리 C106000060.colorInfoUpdate 이민균 */ 
TB_C10_CLR_MPR SET
CUS_CD = :CUS_CD,--고객사코드
ORD_USG_CD = :ORD_USG_CD,--주문용도코드
PTT_FLM_DTL_CD = :PTT_FLM_DTL_CD,--보호필름상세코드
PTT_FLM_DTL_CD_N = :PTT_FLM_DTL_CD_N,--구보호필름상세코드
UNI_GLS_FLM_CD = :UNI_GLS_FLM_CD,--UGS필름상세코드
PTT_FLM_MNG_ADH_TXT = :PTT_FLM_MNG_ADH_TXT, --보호필름 관리 점착력
CLR_DIF_FRN_LLV = :CLR_DIF_FRN_LLV,--색차전면하한값
CLR_DIF_FRN_ULV = :CLR_DIF_FRN_ULV,--색차전면상한값
CLR_DIF_BAK_LLV = :CLR_DIF_BAK_LLV,--색차후면하한값
CLR_DIF_BAK_ULV = :CLR_DIF_BAK_ULV,--색차후면상한값
MPR_BAS_PNCL_HRDN_FRN = :MPR_BAS_PNCL_HRDN_FRN,--물성기준연필경도전면
MPR_BAS_PNCL_HRDN_BAK = :MPR_BAS_PNCL_HRDN_BAK,--물성기준연필경도후면
MPR_BAS_MEK_FRN = :MPR_BAS_MEK_FRN,--물성기준MEK전면
MPR_BAS_MEK_BAK = :MPR_BAS_MEK_BAK,--물성기준MEK후면
CLR_BND_TST_FRN_STD_CD = :CLR_BND_TST_FRN_STD_CD,--칼라Bending전면기준코드
CLR_BND_TST_FRN_GRD_PNT = :CLR_BND_TST_FRN_GRD_PNT,--칼라Bending시험전면평점
CLR_BND_TST_BAK_STD_CD = :CLR_BND_TST_BAK_STD_CD,--칼라Bending후면기준코드
CLR_BND_TST_BAK_GRD_PNT = :CLR_BND_TST_BAK_GRD_PNT,--칼라Bending시험후면평점
PTT_FLM_ADH_LLV = :PTT_FLM_ADH_LLV,--보호필름점착력하한
PTT_FLM_ADH_ULV = :PTT_FLM_ADH_ULV,--보호필름점착력상한
CCL_QLT_MSG_TXT = :CCL_QLT_MSG_TXT,--CCL공정품질메시지
KEY_WRD1 = :KEY_WRD1,--키워드1
KEY_WRD2 = :KEY_WRD2,--키워드2
KEY_WRD3 = :KEY_WRD3,--키워드3
KEY_WRD4 = :KEY_WRD4,--키워드4
LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
LAST_UPDATED_OBJECT_ID=:ObjectId,      
LAST_UPDATE_PROGRAM_ID=:ProgramId,     
LAST_UPDATE_TIMESTAMP=:Timestamp      
WHERE CCL_BOM_NO = :CCL_BOM_NO
AND CUS_CD = :CUS_CD--고객사코드
AND ORD_USG_CD = :ORD_USG_CD--고객사코드
		 ]]> 
	 </query>
	 <query id="C106000060.colorInfoDelete" desc="C106000060.colorInfoDelete" fetchSize="10" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 CCL-BOM관리 C106000060.colorInfoUpdate 이민균 */ 
FROM TB_C10_CLR_MPR 
WHERE CCL_BOM_NO = :CCL_BOM_NO
AND CUS_CD = :CUS_CD--고객사코드
AND ORD_USG_CD = :ORD_USG_CD--고객사코드
		 ]]> 
	 </query>
	 <query id="C106000060.interFaceColor" desc="C106000060.interFaceColor" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 CCL-BOM관리 C106000060.interFaceColor  이민균  */   
INTO TB_C10_B10S0120
(
      IF_GRP_ID                                         --인터페이스그룹아이디
    , SEQ_NO                                            --인터페이스 SEQ
    , XSEQ                                              --PI Sequence Key Value
    , XCRUD                                             --PI Data 유형
    , XSTAT                                             --처리상태 
    , XDATE                                             --응답날짜
    , XTIME                                             --응답시간
    , CCL_BOM_NO                                        --CCLBOM번호
    , CUS_CD                                            --고객사코드
    , ORD_USG_CD                                        --주문용도코드
    , PTT_FLM_DTL_CD                                    --보호필름상세코드
    , PTT_FLM_PRD_ADH_NM                                --보호필름제품점착력명
    , PTT_FLM_THK_NM                                    --보호필름두께명
    , PTT_FLM_MQL_NM                                    --보호필름재질명
    , UNI_GLS_FLM_CD                                    --UniGls필름코드    
    , CCL_QLT_MSG_TXT                                   --품질메시지
    , CREATED_OBJECT_TYPE                               --생성Object유형
    , CREATED_OBJECT_ID                                 --생성ObjectID 
    , CREATED_PROGRAM_ID                                --생성프로그램ID
    , CREATION_TIMESTAMP                                --생성일시 
    , LAST_UPDATED_OBJECT_TYPE                          --최종변경Object유형
    , LAST_UPDATED_OBJECT_ID                            --최종변경ObjectID 
    , LAST_UPDATE_PROGRAM_ID                            --최종변경프로그램ID
    , LAST_UPDATE_TIMESTAMP                             --최종변경일시
)
VALUES
(
     :IF_GRP_ID --인터페이스그룹아이디
    , SQ_C10_B10S0120.NEXTVAL                           --인터페이스 SEQ
    , '1'                                               --PI Sequence Key Value
    , 'C'                                               --PI Data 유형
    , 'R'                                               --처리상태
    , SUBSTR(:IF_GRP_ID, 1, 8)                          --응답날짜
    , SUBSTR(:IF_GRP_ID, 9, 6)                          --응답시간
    , :CCL_BOM_NO                                       --CCLBOM번호
    , :CUS_CD                                           --고객사코드
    , :ORD_USG_CD                                       --주문용도코드
    , :PTT_FLM_DTL_CD                                   --보호필름상세코드
    , :PTT_FLM_PRD_ADH_CD_NM_MASTER                     --보호필름제품점착력명
    , :PTT_FLM_THK_CD_NM_MASTER                         --보호필름두께명
    , :PTT_FLM_MQL_CD_NM_MASTER                         --보호필름재질명
    , :UNI_GLS_FLM_CD                                   --UNIGLS필름코드   
    , :CCL_QLT_MSG_TXT                                  --품질메시지
    , :ObjectType                                       --생성Object유형
    , :ObjectId                                         --생성ObjectID 
    , :ProgramId                                        --생성프로그램ID
    , :Timestamp                                        --생성일시 
