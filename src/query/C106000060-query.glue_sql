WHERE  CCL_BOM_NO = :CCL_BOM_NO--CCLBOM번호
		 ]]> 
	 </query>
	 <query id="C106000060.cclBomInfoDelete" desc="ccl-bom 정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 CCL-BOM관리 C106000060.cclBomInfoDelete 이민균 */ 
FROM TB_C10_CCL_BOM 
WHERE CCL_BOM_NO = :CCL_BOM_NO--고객사코드
		 ]]> 
	 </query>
