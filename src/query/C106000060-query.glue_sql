FROM(
    SELECT  
        CCL_BOM_NO,--CCLBOM번호
        DECODE(NVL(CCL_BOM_USE_YN,'N'),'N',0,1) AS CCL_BOM_USE_YN,
        CCL_BOM_USE_YN AS CCL_BOM_USE_YN_HIDDEN,
        DECODE(NVL(CCL_BOM_USE_YN,'N'),'N',0,1) AS ORG_CCL_BOM_USE_YN,
        FUNC_DECODE('COT_MTH', 'SZ0000', COT_MTH) AS COT_MTH_NM,--도장방식(마스터)
        COT_MTH,--도장방식
        COL_SUR_HND_CD,--칼라표면처리코드
        PRT_PTN_CD,--PrintPatternCode
        HUE_CD_FRN,--색상코드전면
        HUE_CD_BAK,--색상코드후면
        HUE_CD_SUB,--색상코드SUB
        HUE_CD_CHM,--색상코드Chemical
        PNT_FLM_THK_FRN_TOT,--도막두께전면Total
        PNT_FLM_THK_BAK_TOT,--도막두께후면Total
        FUNC_DECODE('LUS_RT_CD', 'SZ0000', LUS_RT_CD_FRN) AS LUS_RT_CD_FRN_NM,--광택도코드전면(마스터)
        FUNC_DECODE('LUS_RT_CD', 'SZ0000', LUS_RT_CD_BAK) AS LUS_RT_CD_BAK_NM,--광택도코드후면(마스터)
        LUS_RT_CD_FRN,--광택도코드전면
        LUS_RT_CD_BAK,--광택도코드후면
        FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_FRN) AS RSN_TP_FRN_NM,--수지구분전면(마스터)
        FUNC_DECODE('RSN_TP', 'SZ0000', RSN_TP_BAK) AS RSN_TP_BAK_NM,--수지구분전면(마스터)
        RSN_TP_FRN,--수지구분전면
        RSN_TP_BAK,--수지구분후면
        DTL_CLR_NM,--상세색상명
        RSN_TP_FRN_1COT,--수지구분전면1Coat
        RSN_TP_FRN_2COT,--수지구분전면2Coat
        RSN_TP_FRN_3COT,--수지구분전면3Coat
        RSN_TP_FRN_4COT,--수지구분전면4Coat
        RSN_TP_BAK_1COT,--수지구분후면1Coat
        RSN_TP_BAK_2COT,--수지구분후면2Coat
        RSN_TP_BAK_3COT,--수지구분후면3Coat
        RSN_TP_BAK_4COT,--수지구분후면4Coat
        RSN_TP_LMN,--수지구분Lamina
        HUE_CD_FRN_1COT,--색상코드전면1Coat
        HUE_CD_FRN_2COT,--색상코드전면2Coat
        HUE_CD_FRN_3COT,--색상코드전면3Coat
        HUE_CD_FRN_4COT,--색상코드전면4Coat
        HUE_CD_BAK_1COT,--색상코드후면1Coat
        HUE_CD_BAK_2COT,--색상코드후면2Coat
        HUE_CD_BAK_3COT,--색상코드후면3Coat
        HUE_CD_BAK_4COT,--색상코드후면4Coat
        HUE_CD_LMN,--색상코드Lamina
        PNT_FLM_THK_FRN_1COT,--도막두께전면1Coat
        PNT_FLM_THK_FRN_2COT,--도막두께전면2Coat
        PNT_FLM_THK_FRN_3COT,--도막두께전면3Coat
        PNT_FLM_THK_FRN_4COT,--도막두께전면4Coat
        PNT_FLM_THK_BAK_1COT,--도막두께후면1Coat
