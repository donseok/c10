	 <query id="C102100000.CHM_ADELETE" desc="C102100000.CHM_ADELETE" fetchSize="10" isNamed="false">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 품질설계JOB관리 C102100000.CHM_ADELETE 박재영 */ 
    TB_C10_QLT_DSN_CHM A  --품질설계성분
WHERE EXISTS (SELECT 1 FROM TB_C10_QLT_DSN_CMN B
              WHERE  A.ORD_NO = B.ORD_NO
              AND    A.ORD_LN = B.ORD_LN
              AND    B.QLT_DSN_STS_CD = 'J')
		 ]]> 
	 </query>
