	 <query id="C102100000.AUPDATE" desc="C102100000.AUPDATE" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 품질설계JOB관리 C102100000.AUPDATE 박재영*/ 
    TB_C10_QLT_DSN_CMN 
SET
    SPC_NM = '',--규격명
    SPC_FUL_NM = '',--규격FULLNAME
    MQL_CD = '',--재질코드    
    RMTL_CD = '',--원자재코드
    RMTL_CD1 = '',--원자재코드1
    RMTL_CD2 = '',--원자재코드2    
    RMTL_GRD = '',--원자재등급
    CRM_MNF_STD_NO = '',--냉연제조표준번호
    CRM_MNF_STD_NO1 = '',--냉연제조표준번호1
    CRM_MNF_STD_NO2 = '',--냉연제조표준번호2
    PAS_PROC_NO = '',--통과공정번호    
    ACPT_RT_SPC = '',--인수도규격    
    CUS_REQ_ROL_THK = '',	--고객요청압연두께
    THK_COR_UNT = '', --두께보정단위
    PRD_THK_CAL_APL_CD = '', --제품두께계산적용코드
    QLT_DSN_ERR_YN = '', --품질설계에러여부
    PLTCM_SET_THK_LNK_TP = '' --압연Set지정체크해제
WHERE QLT_DSN_STS_CD = 'J'
		 ]]> 
	 </query>
	 <query id="C102100000.LmtJmodify" desc="C102100000.LmtJmodify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통업데이트 C102100000.LmtJmodify 박재영*/                      
TB_C10_QLT_DSN_CMN                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,QLT_DSN_STS_CD = 'J'      --품질설계상태                                                                                                                                       
WHERE ROWID IN (SELECT  AA.RID
                FROM (SELECT BB.ROWID RID
                        FROM TB_C10_QLT_DSN_CMN BB
                        WHERE BB.QLT_DSN_STS_CD = 'I'
                        ORDER BY BB.ORD_NO, BB.ORD_LN ) AA
                WHERE ROWNUM <= 10)
		 ]]> 
	 </query>
	 <query id="C102100000.Iselect" desc="C102100000.Iselect" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 품질설계 품질설계JOB관리 C102100000.Iselect 박재영 */ 
    ORD_NO,--주문번호
    ORD_LN--주문행번
FROM TB_C10_QLT_DSN_CMN
WHERE QLT_DSN_STS_CD ='I'
		 ]]> 
	 </query>
