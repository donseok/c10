<queryMap desc="C102100000"> 
	 <query id="C102100000.SELECT" desc="C102100000.SELECT" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계 품질설계JOB관리 C102100000.SELECT 이민균 */ 
    ORD_NO,--주문번호
    ORD_LN,--주문행번
    SPC_NM,--규격명
    SPC_FUL_NM,--규격FULLNAME
    MQL_CD,--재질코드    
    RMTL_CD,--원자재코드
    RMTL_CD1,--원자재코드1
    RMTL_CD2,--원자재코드2    
    RMTL_GRD,--원자재등급
    CRM_MNF_STD_NO,--냉연제조표준번호
    CRM_MNF_STD_NO1,--냉연제조표준번호1
    CRM_MNF_STD_NO2,--냉연제조표준번호2
    PAS_PROC_NO,--통과공정번호    
    ACPT_RT_SPC,--인수도규격    
    CUS_REQ_ROL_THK	--고객요청압연두께
FROM TB_C10_QLT_DSN_CMN
WHERE QLT_DSN_STS_CD ='J'
		 ]]> 
	 </query>
	 <query id="C102100000.UPDATE" desc="C102100000.UPDATE" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 품질설계JOB관리 C102100000.UPDATE 이민균 */ 
    TB_C10_QLT_DSN_CMN 
SET
    SPC_NM = '',--규격명
    SPC_FUL_NM = '',--규격FULLNAME
    MQL_CD = '',--재질코드    
    RMTL_CD = '',--원자재코드
    RMTL_CD1 = '',--원자재코드1
    RMTL_CD2 = '',--원자재코드2    
    RMTL_GRD = '',--원자재등급
    CRM_MNF_STD_NO = '',--냉연제조표준번호
    CRM_MNF_STD_NO1 = '',--냉연제조표준번호1
    CRM_MNF_STD_NO2 = '',--냉연제조표준번호2
    PAS_PROC_NO = '',--통과공정번호    
    ACPT_RT_SPC = '',--인수도규격    
    CUS_REQ_ROL_THK = '', --고객요청압연두께
    THK_COR_UNT = '', --두께보정단위
    PRD_THK_CAL_APL_CD = '', --제품두께계산적용코드
WHERE 
    ORD_NO = :ORD_NO --주문번호
AND ORD_LN = :ORD_LN --주문행번
		 ]]> 
	 </query>
