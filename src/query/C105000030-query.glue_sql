<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C105000030 Page 쿼리파일"> 
	 <query id="C105000030_selectPrdNm" desc="보증서 품명 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C105000030   보증서 품명 조회  C105000030_selectPrdNm */
	   FUNC_DECODE01('PRD_NM_CD', 'SZ0000', A.PRD_NM_CD) AS PRD_NM_CD
  FROM TB_C10_QLT_DSN_CMN A
 WHERE ORD_NO = :ORD_NO
   AND ROWNUM = 1
		 ]]> 
	 </query>
	 <query id="C105000030_selNat.select" desc="보증서 국가코드 출력" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C105000030   보증서 국가코드 출력  C105000030_selNat.select */
	   DISTINCT NAT_CD
	 , NAT_KNM
  FROM TB_C10_WAR_NAT_MNG
 WHERE TO_NUMBER(VER_CD) = (SELECT MAX(TO_NUMBER(VER_CD)) FROM TB_C10_WAR_NAT_MNG)
 ORDER BY NAT_KNM
		 ]]> 
	 </query>
	 <query id="C105000030_cclBomChk.select" desc="보증서 CCLBOM 체크여부 출력" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C105000030   보증서 CCLBOM 체크여부 출력  C105000030_cclBomChk.select */
	   NVL((SELECT NVL(CCL_BOM_WR_YN,'N')
			  FROM TB_C10_CCL_BOM
			 WHERE CCL_BOM_NO = :CCL_BOM_NO),'X') AS CCL_BOM_WR_YN
  FROM DUAL
		 ]]> 
	 </query>
	 <query id="C105000030.selectClass" desc="Class 대상 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C105000030   Class 대상 조회  C105000030.selectClass */
	   CLS_CD
	 , CLS_CD AS CLS_KNM
  FROM TB_C10_WAR_NAT_MNG
 WHERE TO_NUMBER(VER_CD) = (SELECT MAX(TO_NUMBER(VER_CD)) FROM TB_C10_WAR_NAT_MNG)
   AND NAT_CD = :NAT_CD
 ORDER BY CLS_CD
		 ]]> 
	 </query>
	 <query id="C105000030.selectAuthority" desc="보증서 출력 권한 체크" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C105000030   보증서 출력 권한 체크  C105000030.selectAuthority */
	   COUNT(*) CNT
  FROM M90APUSER.TB_SEC_USER A
 WHERE USER_NO = :USER_NO
   AND EXISTS (SELECT 1
				 FROM M90APUSER.TB_USER_MENU_MAPPING
				WHERE MENU_ID = '5903'
				  AND USER_ID = A.USER_ID)
		 ]]> 
	 </query>
	 <query id="C105000030.selectOrdLn" desc="주문행번 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C105000030   주문행번 조회  C105000030.selectOrdLn */
	   ORD_LN
  FROM TB_C10_QLT_DSN_CMN
 WHERE ORD_NO = :ORD_NO
		 ]]> 
	 </query>
	 <query id="C105000030.saveWarPubHst" desc="보증서 발행 이력 등록" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C105000030   보증서 발행 이력 등록  C105000030.saveWarPubHst */
   INTO C10APUSER.TB_C10_WAR_PUB_HST
	  ( WAR_SEQ_NO
	  , PDN_CLS_CD
	  , PUB_DH
	  , PUB_EMP_ID
	  , PUB_REA
	  , NAT_CD
	  , ORD_NO
	  , ORD_LN
	  , ORD_STD
	  , ORD_PRD
	  , ORD_THK
	  , ORD_WTH
	  , ORD_COT_WGT
	  , ORD_CLT
	  , WAR_TRM
	  , TP_USE
	  , WAR_CTT1
	  , WAR_CTT2
	  , WAR_CTT3
	  , WAR_CTT4
	  , WAR_CTT5
	  , WAR_CTT6
	  , CREATED_OBJECT_TYPE
	  , CREATED_OBJECT_ID
	  , CREATED_PROGRAM_ID
	  , CREATION_TIMESTAMP
	  , LAST_UPDATED_OBJECT_TYPE
	  , LAST_UPDATED_OBJECT_ID
	  , LAST_UPDATE_PROGRAM_ID
	  , LAST_UPDATE_TIMESTAMP )
 SELECT (SELECT TO_CHAR(SYSDATE,'YYYYMMDD') || TO_CHAR(LPAD(NVL(MAX(TO_NUMBER(SUBSTR(WAR_SEQ_NO,9,11)))+1,1),3,0))
		   FROM C10APUSER.TB_C10_WAR_PUB_HST
		  WHERE SUBSTR(WAR_SEQ_NO, 0, 8) = TO_CHAR(SYSDATE, 'YYYYMMDD'))
	  , :PRD_NM_CD
	  , TO_DATE(TO_CHAR(SYSDATE, 'YYYYMMDD'), 'YYYYMMDD')
	  , :ObjectId
	  , :PUB_REA
	  , :NAT_CD
	  , :ORD_NO
	  , :ORD_LN
	  , A.SPC_FUL_NM
	  , C10APUSER.FUNC_DECODE01('PRD_NM_CD', 'SZ0000', A.PRD_NM_CD)
	  , ORD_EXC_THK
	  , ORD_EXC_WTH
	  , C10APUSER.FUNC_DECODE01('GW_ASG_CD', 'SV0000', A.GW_ASG_CD)
	  , C10APUSER.FUNC_DECODE01('CUS_CD', 'SZ0000', A.CUS_CD)
	  , CASE :PRD_NM_CD WHEN 'GIX' THEN '25 Years'
	  		ELSE '40 Years' END
	  , CASE :PRD_NM_CD WHEN 'GIX' THEN 'Frame (ISO C3)'
	  		ELSE 'Roofing (ISO C4)' END
	  , :WAR_CTT1
	  , :WAR_CTT2
	  , :WAR_CTT3
	  , :WAR_CTT4
	  , :WAR_CTT5
	  , :WAR_CTT6
	  , :ObjectType
	  , :ObjectId
	  , :ProgramId
	  , :Timestamp 
	  , :ObjectType
	  , :ObjectId
	  , :ProgramId
	  , :Timestamp
   FROM C10APUSER.TB_C10_QLT_DSN_CMN A
  WHERE A.ORD_NO = :ORD_NO
    AND A.ORD_LN = :ORD_LN
		 ]]> 
	 </query>
</queryMap>
