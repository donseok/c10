INSERT INTO /*+ C10 규격공통송신 TB_C10_B10S0010.insert 김종범*/
            TB_C10_B10S0010
            (
                IF_GRP_ID,
                SEQ_NO,
		  XSEQ,
                XCRUD,
                XSTAT,
                SPC_AVR,
                SPC_YR,
