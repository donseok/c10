	 <query id="B10R0050.select" desc="Material Code 수신 B10R0050.select" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /*+ C10 Material Code 수신 B10R0050.select 김종범 */
*
FROM EAIAPUSER.TB_C10_B10R0050
WHERE IF_GRP_ID = ?
AND XSTAT = 'D'
ORDER BY SEQ_NO, XSEQ
		 ]]> 
	 </query>
	 <query id="B10R0050.modify" desc="Material Code 수신 B10R0050.modify" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 Material Code 수신 B10R0050.modify 김종범*/                      
TB_C10_B10R0050
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,XSTAT = ?                     --PI 처리 상태
      ,XMSGS = ?                     --PI 에러 메세지
      ,XSTAT_CALLBACK = ?            --PI 처리 상태
WHERE IF_GRP_ID = ?                  --Interface Group ID                                                                                      
  AND SEQ_NO = ?                     --Interface SEQ
  AND XSEQ =?
		 ]]> 
	 </query>
