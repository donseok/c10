                ORD_GRA,
                ACPT_RT_SPC,
                MQL_CD,
                CREATED_OBJECT_TYPE, 
                CREATED_OBJECT_ID,
                CREATED_PROGRAM_ID,
                CREATION_TIMESTAMP,
                LAST_UPDATED_OBJECT_TYPE, 
                LAST_UPDATED_OBJECT_ID, 
                LAST_UPDATE_PROGRAM_ID, 
                LAST_UPDATE_TIMESTAMP
            )
VALUES
            (
                 ?,
                 EAIAPUSER.SQ_C10_B10S0010.NEXTVAL,
		  '1',
                'C',
                'R',
                ?,
