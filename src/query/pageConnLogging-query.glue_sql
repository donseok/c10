<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="사용자 접속정보 기록"> 
	 <query id="pageConnLogging.insert" desc="사용자 접속 정보 기록" isNamed="true">
		 <![CDATA[ 
INSERT INTO M90APUSER.TB_M90_CONN_USER_LOG(USER_ID, CONN_DH, PGM_ID, PGM_NM, CLIENT_IP

,CREATED_OBJECT_TYPE ,CREATED_OBJECT_ID ,CREATED_PROGRAM_ID ,CREATION_TIMESTAMP
,LAST_UPDATED_OBJECT_TYPE ,LAST_UPDATED_OBJECT_ID ,LAST_UPDATE_PROGRAM_ID ,LAST_UPDATE_TIMESTAMP)

VALUES(
            SUBSTR(:USER_ID,1,(SELECT DATA_LENGTH FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'TB_M90_CONN_USER_LOG' AND COLUMN_NAME = 'USER_ID'))
           ,SYSDATE
           ,SUBSTR(:PGM_ID,1,(SELECT DATA_LENGTH FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'TB_M90_CONN_USER_LOG' AND COLUMN_NAME = 'PGM_ID'))
           ,(SELECT SUBSTR(PROGRAM_NAME,1,(SELECT DATA_LENGTH FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'TB_M90_CONN_USER_LOG' AND COLUMN_NAME = 'PGM_NM')) FROM M90APUSER.TB_PROGRAM WHERE PROGRAM_URL = :REQUEST_URI AND ROWNUM = 1)
           ,SUBSTR(:CLIENT_IP,1,(SELECT DATA_LENGTH FROM USER_TAB_COLUMNS WHERE TABLE_NAME = 'TB_M90_CONN_USER_LOG' AND COLUMN_NAME = 'CLIENT_IP'))

,:ObjectType ,:ObjectId ,:ProgramId ,:Timestamp
,:ObjectType ,:ObjectId ,:ProgramId ,:Timestamp
)
		 ]]> 
	 </query>
</queryMap>
