<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C102100CHM"> 
	 <query id="C102100CHM.insert" desc="성분사양 등록" fetchSize="10" isNamed="false">
		 <![CDATA[ 
INSERT INTO  /*+ C10 품질설계결과성분등록 C102100CHM.INSERT 김종범*/                           
TB_C10_QLT_DSN_CHM (                                                                           
              ORD_NO                    --주문번호                                                                            
             ,ORD_LN                    --주문행번                                                                            
             ,QLT_DSN_SPC_TP            --품질설계사양구분                                                                    
             ,C_LLV                     --C하한값                                                                             
             ,C_ULV                     --C상한값                                                                             
             ,SI_LLV                    --SI하한값                                                                            
             ,SI_ULV                    --SI상한값                                                                            
             ,MN_LLV                    --MN하한값                                                                            
             ,MN_ULV                    --MN상한값                                                                            
             ,P_LLV                     --P하한값                                                                             
             ,P_ULV                     --P상한값                                                                             
             ,S_LLV                     --S하한값                                                                             
             ,S_ULV                     --S상한값                                                                             
             ,CR_LLV                    --CR하한값                                                                            
             ,CR_ULV                    --CR상한값                                                                            
             ,NI_LLV                    --NI하한값                                                                            
             ,NI_ULV                    --NI상한값                                                                            
             ,CU_LLV                    --CU하한값                                                                            
             ,CU_ULV                    --CU상한값                                                                            
             ,AL_LLV                    --AL하한값                                                                            
             ,AL_ULV                    --AL상한값                                                                            
             ,TI_LLV                    --TI하한값                                                                            
             ,TI_ULV                    --TI상한값                                                                            
             ,NB_LLV                    --NB하한값                                                                            
             ,NB_ULV                    --NB상한값                                                                            
             ,V_LLV                     --V하한값                                                                             
             ,V_ULV                     --V상한값                                                                            
             ,N_LLV                     --N하한값                                                                             
             ,N_ULV                     --N상한값                                                                             
             ,CREATED_OBJECT_TYPE       --생성OBJECT유형  
             ,CREATED_OBJECT_ID         --생성OBJECTID    
             ,CREATED_PROGRAM_ID        --생성프로그램ID  
             ,CREATION_TIMESTAMP        --생성일시                  
             ,LAST_UPDATED_OBJECT_TYPE  --최종변경OBJECT유형
             ,LAST_UPDATED_OBJECT_ID    --최종변경OBJECTID  
             ,LAST_UPDATE_PROGRAM_ID    --최종변경프로그램ID
             ,LAST_UPDATE_TIMESTAMP     --최종변경일시      
)                                                                                              
VALUES(                                                                                              
?,?,?,?,                                                                                       
?,?,?,?,                                                                                       
?,?,?,?,                                                                                       
?,?,?,?,                                                                                       
?,?,?,?,                                                                                       
?,?,?,?,                                                                                       
?,?,?,?,                                                                                       
?,                                                                                             
?,?,?,?,                                                                                       
?,?,?,?                                                                                        
)
		 ]]> 
	 </query>
	 <query id="C102100CHM.select" desc="" fetchSize="10" isNamed="false">
		 <![CDATA[ 
select /*+ C10 품질설계결과성분조회 C102100CHM.select 박재영*/ 
        C_LLV,C_ULV,SI_LLV,SI_ULV,MN_LLV,MN_ULV,P_LLV,P_ULV,S_LLV
        ,S_ULV,CR_LLV,CR_ULV,NI_LLV,NI_ULV,CU_LLV,CU_ULV,AL_LLV
        ,AL_ULV,TI_LLV,TI_ULV,NB_LLV,NB_ULV,V_LLV,V_ULV,N_LLV,N_ULV
FROM TB_C10_QLT_DSN_CHM
WHERE ORD_NO = ?
AND   ORD_LN = ?
AND   QLT_DSN_SPC_TP = ?
		 ]]> 
	 </query>
	 <query id="C102100CHM.delete" desc="C102100CHM.delete" fetchSize="10" isNamed="false">
		 <![CDATA[ 
DELETE /*+ C10 품질설계결과성분삭제 C102100CHM.delete 박재영*/
FROM TB_C10_QLT_DSN_CHM
WHERE ORD_NO = ?
AND   ORD_LN = ?
		 ]]> 
	 </query>
</queryMap>
