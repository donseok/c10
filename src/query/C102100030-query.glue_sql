<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C102100030"> 
	 <query id="C102100030.modify" desc="품질설계공통 고객요청압연두께 Update" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계결과공통업데이트 C102100030.MODIFY 김종범*/                             
TB_C10_QLT_DSN_CMN                                                                             
SET 
       LAST_UPDATED_OBJECT_TYPE =?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID   =?     --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID   =?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP    =?    --최종변경일시                                                                                               
      ,CUS_REQ_ROL_THK =?                   --고객요청압연두께                                                                    
      ,THK_COR_UNT =?                   --두께보정단위        
      ,PRD_THK_CAL_APL_CD =?        --제품두께계산적용코드                                                            
WHERE ORD_NO =?                                                                                      
    AND ORD_LN =?
		 ]]> 
	 </query>
</queryMap>
