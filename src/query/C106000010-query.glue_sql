<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000010 Page 쿼리파일"> 
	 <query id="C106000010.select" desc="C106000010 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 칼라시편관리조회 C106000010.select 이민균 */
    CLR_SMP_REQ_NO,--칼라시편의뢰번호
    CLR_SMP_RCP_NO,--칼라시편접수번호
    CUS_REQ_HUE_TXT,--고객요청색상명
    RSN_TP || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'RSN_TP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = RSN_TP) AS RSN_TP,--수지타입
    RSN_ANL_REQ_YN, --수지분석여부  
    SMP_SND_YN, --시편송부여부   
    PNT_FLM_THK_TXT,--도막두께TXT 
    SMP_LUS_YN, --샘플광
    LUS_RT_CD || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'LUS_RT_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = LUS_RT_CD) AS LUS_RT_CD,--광택도코드
    CLR_USE_NM,--사용용도명
    PRD_NM_CD,--품명코드
    PRD_TP_YN, --품명구분여부
    SAL_CHR_PRS_ID,--영업담당자ID
    CUS_CD_TXT,--고객사명
    USE_REG_TXT,--사용지역명
    TO_CHAR(SAL_CHR_REQ_DH,'yyyy-mm-dd') AS SAL_CHR_REQ_DH,--영업담당자요청일
    TO_CHAR(SAL_CHR_RGN_DH,'yyyy-mm-dd') AS SAL_CHR_RGN_DH,--영업담당자승인일
    DEV_PNT_CMP_CD,
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PNT_CMP_CD'         
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = DEV_PNT_CMP_CD) AS DEV_PNT_CMP_CD_NM,--개발도료업체코드
    TO_CHAR(CLR_SMP_DEV_REQ_DH,'yyyy-mm-dd') AS CLR_SMP_DEV_REQ_DH,--칼라시편개발의뢰일
    TO_CHAR(CLR_SMP_DEV_LMT_DH,'yyyy-mm-dd') AS CLR_SMP_DEV_LMT_DH,--칼라시편개발예정일
    TO_CHAR(CLR_SMP_DEV_END_DH,'yyyy-mm-dd') AS CLR_SMP_DEV_END_DH,--칼라시편개발완료일
    TO_CHAR(CLR_SMP_DEV_SND_DH,'yyyy-mm-dd') AS CLR_SMP_DEV_SND_DH,--칼라시편개발송부일
    SMP_SND_INF, --시편송부정보
    DSN_CHR_RGN_YN,
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'DSN_CHR_RGN_YN'         
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = DSN_CHR_RGN_YN) AS DSN_CHR_RGN_YN_NM,--승인
    HUE_CD,-- 색상코드
    CCL_BOM_NO,--CCLBOM번호
    TO_CHAR(CCL_BOM_RGS_DH,'yyyy-mm-dd') AS CCL_BOM_RGS_DH,--CCLBOM등록일
    CLR_TP,
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'CLR_TP'         
        AND   CATEGORY_GROUP_NM = 'SZ0000'
        AND   CD_V = CLR_TP) AS CLR_TP_NM,--색구분
    SIM_HUE_PRG_YN, --유사색상진행여부
    DSN_CHR_PRS_ID, --설계담당자
    B.SMP_PRC_MAN,
    B.MGR_CAL,  
    CLR_SMP_RMK, --비고  
    CLR_SMP_DSN_RMK, --설계비고
    RSN_TP_TXT,
    ORD_PRE_WGT,
    COL_CFM_ACT_YN,
    DECODE(PRJ_DEV_CD,'1','1~3회','2','반복','') AS PRJ_DEV_CD --프로젝트성개발   
FROM  C10APUSER.TB_C10_CLR_SMP A,
          C10APUSER.TB_C10_CLR_CMP_DEV_MNG B
WHERE  CLR_SMP_DEV_RCP_DH BETWEEN TO_DATE(NVL(:CLR_SMP_DEV_RCP_DH_START,'1900-01-01'),'YYYY-MM-DD')
AND TO_DATE(NVL(:CLR_SMP_DEV_RCP_DH_END,'2999-12-31'),'YYYY-MM-DD') + 1
AND NVL(CLR_SMP_REQ_NO, ' ') LIKE NVL(:CLR_SMP_REQ_NO,'%') || '%'
AND NVL(CLR_SMP_RCP_NO, ' ') LIKE NVL(:CLR_SMP_RCP_NO,'%')  || '%'
AND NVL(DEV_PNT_CMP_CD, ' ') LIKE  NVL(:DEV_PNT_CMP_CD,'%')  || '%'
AND NVL(SAL_CHR_PRS_ID, ' ') LIKE  NVL(:SAL_CHR_PRS_ID,'%') || '%'
AND A.DEV_PNT_CMP_CD = B.PNT_CMP_CD(+)
AND ((:NOT_REC_YN = '1' AND (DEV_PNT_CMP_CD IS NULL OR CLR_SMP_DEV_REQ_DH IS NULL OR CLR_SMP_DEV_LMT_DH IS NULL))
 OR :NOT_REC_YN != '1')  --미의뢰현황 클릭시 도료업체값, 의뢰일, 예정일 중 한 개 항목이라도 없는 대상List 조회 
ORDER BY CLR_SMP_REQ_NO, CLR_SMP_RCP_NO
		 ]]> 
	 </query>
	 <query id="C106000010.update" desc="C106000010 정보 수정" isNamed="true">
		 <![CDATA[ 
UPDATE/*+ C10 품질설계 칼라시편관리 저장(update) C106000010.update 이민균 */ 
TB_C10_CLR_SMP SET
CLR_SMP_RCP_NO= :CLR_SMP_RCP_NO,--칼라시편접수번호
CUS_REQ_HUE_TXT= :CUS_REQ_HUE_TXT,--고객요청색상명
PNT_CMP_CD= :PNT_CMP_CD,--도료업체코드
STD_CLR_NM= :STD_CLR_NM,--표준색상명
RSN_TP= :RSN_TP,--수지타입
LUS_RT_CD= :LUS_RT_CD,--광택도코드=
PNT_FLM_THK_TXT= :PNT_FLM_THK_TXT,--도막두께TXT
CLR_USE_NM= :CLR_USE_NM,--사용용도명
COAT2_TXT= :COAT2_TXT,--2Coat내역
COAT3_TXT= :COAT3_TXT,--3Coat내역
COAT4_TXT= :COAT4_TXT,--4Coat내역
PRD_NM_CD= :PRD_NM_CD,--품명코드
LMN_TXT= :LMN_TXT,--Lamina내역
PRT_TXT= :PRT_TXT,--Print내역
SAL_CHR_PRS_ID= :SAL_CHR_PRS_ID,--영업담당자ID
CUS_CD_TXT = :CUS_CD_TXT, --고객사명
ORD_TEM_CD= :ORD_TEM_CD,--영업팀코드
CUS_CD= :CUS_CD,--고객사코드
USE_REG_TXT= :USE_REG_TXT,--사용지역명
DEV_PNT_CMP_CD= :DEV_PNT_CMP_CD,--개발도료업체코트
LST_PNT_CMP_CD= :LST_PNT_CMP_CD,--최종도료업체코트
CLR_SMP_DEV_RCP_DH= :CLR_SMP_DEV_REQ_DH,--칼라개발시편접수일
CLR_SMP_DEV_REQ_DH= :CLR_SMP_DEV_REQ_DH,--칼라시편개발의뢰일
CLR_SMP_DEV_LMT_DH= :CLR_SMP_DEV_LMT_DH,--칼라시편개발기한일
CLR_SMP_DEV_END_DH= :CLR_SMP_DEV_END_DH,--칼라시편개발완료일
SAL_CHR_RGN_DH= :SAL_CHR_RGN_DH,--영업담당자승인일
SAL_CHR_RGN_YN= :SAL_CHR_RGN_YN,--영업담당자승인여부
SAL_CHR_RGN_TXT= :SAL_CHR_RGN_TXT,--영업담당자승인내역
CCL_BOM_NO= :CCL_BOM_NO,--CCLBOM번호
HUE_CD_RGS_YN= :HUE_CD_RGS_YN,--색상코드등록여부=
CCL_BOM_RGS_DH= :CCL_BOM_RGS_DH,--CCLBOM등록일
CLR_SMP_END_TXT= :CLR_SMP_END_TXT,--칼라시편완료내역
ORD_PRE_WGT=:ORD_PRE_WGT,
LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
LAST_UPDATED_OBJECT_ID=:ObjectId,      
LAST_UPDATE_PROGRAM_ID=:ProgramId,     
LAST_UPDATE_TIMESTAMP=:Timestamp      
WHERE  CLR_SMP_REQ_NO= :CLR_SMP_REQ_NO
		 ]]> 
	 </query>
	 <query id="C106000010.delete" desc="C106000010 정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE/*+ C10 품질설계 칼라시편관리 삭제(update) C106000010.delete 이민균 */  
FROM TB_C10_CLR_SMP
WHERE  CLR_SMP_REQ_NO= :CLR_SMP_REQ_NO
		 ]]> 
	 </query>
	 <query id="C106000010.insert" desc="C106000010 정보 추가" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 칼라시편관리 C106000010.insert 이민균*/ 
INTO TB_C10_CLR_SMP
(   CLR_SMP_REQ_NO,--칼라시편의뢰번호
    CUS_REQ_HUE_TXT,--고객요청색상명
    RSN_TP ,--수지구분
    RSN_ANL_REQ_YN, --수지구분 분석요망
    SMP_SND_YN, --시편송부여부
    PNT_FLM_THK_TXT,--도막두께TXT
    LUS_RT_CD,--광택도코드
    SMP_LUS_YN, --샘플광
    CLR_USE_NM,--사용용도명
    SAL_CHR_PRS_ID,--영업담당자ID
    CUS_CD_TXT, --고객사명
    USE_REG_TXT,--사용지역명
    PRD_NM_CD,--품명코드
    PRD_TP_YN, --품명구분여부
    CLR_SMP_DEV_RCP_DH,--시편개발접수일
    SAL_CHR_REQ_DH,--영업담당자요청일
    SAL_CHR_RGN_DH,--영업담당자승인일
    CLR_SMP_RMK,--비고
    CLR_SMP_RCP_NO,--칼라시편접수번호
    DEV_PNT_CMP_CD,--개발도료업체코드
    CLR_SMP_DEV_REQ_DH,--칼라시편개발의뢰일
    CLR_SMP_DEV_LMT_DH,--칼라시편개발예정일
    CLR_SMP_DEV_END_DH,--칼라시편개발완료일
    CLR_SMP_DEV_SND_DH,--칼라시편개발송부일
    SMP_SND_INF, --시편송부정보
    DSN_CHR_RGN_YN,--설계담당자승인여부
    HUE_CD,--색상코드 
    CCL_BOM_NO,--CCLBOM번호
    CCL_BOM_RGS_DH,--CCLBOM등록일
    CLR_TP, --색구분
    CLR_SMP_DSN_RMK, --설계비고
    RSN_TP_TXT,
    ORD_PRE_WGT,
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
(SELECT NVL(MAX(CLR_SMP_REQ_NO),TO_CHAR(SYSDATE,'yyyymmdd')||'00')+1 FROM TB_C10_CLR_SMP
      WHERE CLR_SMP_REQ_NO LIKE TO_CHAR(SYSDATE,'yyyymmdd') || '%' )
,(CASE WHEN LENGTHB(:CUS_REQ_HUE_TXT) >30 THEN substrb(:CUS_REQ_HUE_TXT,1,30) ELSE :CUS_REQ_HUE_TXT END)
,SUBSTR(:RSN_TP,'1','2')
,:RSN_ANL_REQ_YN
,:SMP_SND_YN
,:PNT_FLM_THK_TXT
,SUBSTR(:LUS_RT_CD,'1','1')
,:SMP_LUS_YN
,:CLR_USE_NM
,:SAL_CHR_PRS_ID
,:CUS_CD_TXT
,:USE_REG_TXT
,:PRD_NM_CD
,:PRD_TP_YN
,SYSDATE
,:SAL_CHR_REQ_DH
,:SAL_CHR_RGN_DH
,:CLR_SMP_RMK
,:CLR_SMP_RCP_NO
,:DEV_PNT_CMP_CD
,:CLR_SMP_DEV_REQ_DH
,:CLR_SMP_DEV_LMT_DH
,:CLR_SMP_DEV_END_DH
,:CLR_SMP_DEV_SND_DH
,:SMP_SND_INF
,:DSN_CHR_RGN_YN
,:HUE_CD
,:CCL_BOM_NO
,:CCL_BOM_RGS_DH
,:CLR_TP
,:CLR_SMP_DSN_RMK
,:RSN_TP_TXT
,:ORD_PRE_WGT
,:ObjectType
,:ObjectId
,:ProgramId
,:Timestamp
,:ObjectType
,:ObjectId
,:ProgramId
,:Timestamp)
		 ]]> 
	 </query>
	 <query id="C106000010xls.select" desc="C106000010 정보 조회" isNamed="true">
		 <![CDATA[ 
SELECT/* C10 품질설계 칼라시편관리조회 C106000010xls.select 김종화 */
    CLR_SMP_REQ_NO,--칼라시편의뢰번호
    CLR_SMP_RCP_NO,--칼라시편접수번호
    CUS_REQ_HUE_TXT,--고객요청색상명
    RSN_TP_TXT,--수지TXT
    RSN_ANL_REQ_YN, --수지분석여부  
    SMP_SND_YN, --시편송부여부   
    PNT_FLM_THK_TXT,--도막두께TXT 
    SMP_LUS_YN, --샘플광
    LUS_RT_CD,--광택도코드
    CLR_USE_NM,--사용용도명
    PRD_NM_CD,--품명코드
    PRD_TP_YN, --품명구분여부
    SAL_CHR_PRS_ID,--영업담당자ID
    CUS_CD_TXT, --고객사명
    USE_REG_TXT,--사용지역명
    TO_CHAR(SAL_CHR_REQ_DH,'yyyy-mm-dd') AS SAL_CHR_REQ_DH,--영업담당자요청일
    TO_CHAR(SAL_CHR_RGN_DH,'yyyy-mm-dd') AS SAL_CHR_RGN_DH,--영업담당자승인일
    CLR_SMP_RMK, --비고 
    DEV_PNT_CMP_CD, --개발도료업체코드
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'PNT_CMP_CD'         
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = DEV_PNT_CMP_CD) AS DEV_PNT_CMP_CD_NM,--개발도료업체코드
    RSN_TP, --수직분
    TO_CHAR(CLR_SMP_DEV_REQ_DH,'yyyy-mm-dd') AS CLR_SMP_DEV_REQ_DH,--칼라시편개발의뢰일
    TO_CHAR(CLR_SMP_DEV_LMT_DH,'yyyy-mm-dd') AS CLR_SMP_DEV_LMT_DH,--칼라시편개발예정일
    TO_CHAR(CLR_SMP_DEV_END_DH,'yyyy-mm-dd') AS CLR_SMP_DEV_END_DH,--칼라시편개발완료일
    TO_CHAR(CLR_SMP_DEV_SND_DH,'yyyy-mm-dd') AS CLR_SMP_DEV_SND_DH,--칼라시편개발송부일
    SMP_SND_INF, --시편송부정보
    DSN_CHR_RGN_YN,--승인
    HUE_CD,-- 색상코드
    CCL_BOM_NO,--CCLBOM번호
    TO_CHAR(CCL_BOM_RGS_DH,'yyyy-mm-dd') AS CCL_BOM_RGS_DH,--CCLBOM등록일
    CLR_TP,--색구분
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'CLR_TP'         
        AND   CATEGORY_GROUP_NM = 'SZ0000'
        AND   CD_V = CLR_TP) AS CLR_TP_NM,--색구분
    SIM_HUE_PRG_YN, --유사색상진행여부
    DSN_CHR_PRS_ID, --설계담당자         
    CLR_SMP_DSN_RMK, --설계비고
    B.SMP_PRC_MAN,
    B.MGR_CAL,
    COL_CFM_ACT_YN, --색상확인활동
    DECODE(PRJ_DEV_CD,'1','1~3회','2','반복','') AS PRJ_DEV_CD  --프로젝트성개발  
FROM  C10APUSER.TB_C10_CLR_SMP A,
          C10APUSER.TB_C10_CLR_CMP_DEV_MNG B
WHERE  CLR_SMP_DEV_RCP_DH BETWEEN TO_DATE(NVL(:CLR_SMP_DEV_RCP_DH_START,'1900-01-01'),'YYYY-MM-DD')
AND TO_DATE(NVL(:CLR_SMP_DEV_RCP_DH_END,'2999-12-31'),'YYYY-MM-DD') + 1
AND NVL(CLR_SMP_REQ_NO, ' ') LIKE NVL(:CLR_SMP_REQ_NO,'%') || '%'
AND NVL(CLR_SMP_RCP_NO, ' ') LIKE NVL(:CLR_SMP_RCP_NO,'%')  || '%'
AND NVL(DEV_PNT_CMP_CD, ' ') LIKE  NVL(:DEV_PNT_CMP_CD,'%')  || '%'
AND NVL(SAL_CHR_PRS_ID, ' ') LIKE  NVL(:SAL_CHR_PRS_ID,'%') || '%'
AND A.DEV_PNT_CMP_CD = B.PNT_CMP_CD(+)
AND ((:NOT_REC_YN = '1' AND (DEV_PNT_CMP_CD IS NULL OR CLR_SMP_DEV_REQ_DH IS NULL OR CLR_SMP_DEV_LMT_DH IS NULL))
 OR :NOT_REC_YN != '1')  --미의뢰현황 클릭시 도료업체값, 의뢰일, 예정일 중 한 개 항목이라도 없는 대상List 조회 
ORDER BY CLR_SMP_REQ_NO, CLR_SMP_RCP_NO
		 ]]> 
	 </query>
</queryMap>
