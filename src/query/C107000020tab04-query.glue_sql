<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab04 Page 쿼리파일"> 
	 <query id="C107000020tab04.select" desc="C107000020tab04 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT 
       DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 CUS_BTH_PAP_NO,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_1 THK_TLN_LLV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_2 THK_TLN_ULV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_3 WTH_TLN_LLV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_4 WTH_TLN_ULV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_5 LTH_TLN_LLV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_6 LTH_TLN_ULV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_7 HWAV_H,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_8 MWAV_H,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_9 EWAV_H,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_10 SLR_ULV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_11 RAR_ULV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_12 DGLN_DIF_ULV,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_13 STPN,
       DATAS010.MD_MRG_BAS_DATA_NUM_TP_14 TLC
FROM   M00APUSER.TB_M00_DATAS010 DATAS010,
       (SELECT MDL_DEFINE_ID
        FROM   M00APUSER.TB_M00_DEFINES010
        WHERE  MDL_DEFINE_NM='C10A1023'
        AND    START_ACTIVE_DATE <= SYSDATE
        AND    SYSDATE < END_ACTIVE_DATE) DEFINES010
WHERE  DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
AND DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 LIKE '%'||:SEARCH_CD||'%'
ORDER BY CUS_BTH_PAP_NO
		 ]]> 
	 </query>
</queryMap>
