            WHERE ROWNUM<3
          )
         WHERE R_NO=2
) AS CMPL_SIT_QLT_FREQ2,

(
    select SUM(CMPL_CFM_COIL_WGT)
    FROM C10APUSER.TB_C10_CUS_CMPL_HST
    WHERE SAL_END_DD BETWEEN REPLACE(:SAL_END_DD_FR, '-', '') AND REPLACE(:SAL_END_DD_TO, '-', '')
    AND( 
          (  
              ((:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NOT NULL)) 
              AND (CCL_BOM_NO = :CCL_BOM_NO) 
              AND (FNL_CUS_CD = :FNL_CUS_CD)
              AND PRD_NM = (SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
          )
        OR (  
             ( (:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NULL) ) 
             AND (FNL_CUS_CD = :FNL_CUS_CD) AND CCL_BOM_NO IS NULL
             AND PRD_NM =(SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
           ) 
       )
) AS CMPL_CFM_COIL_WGT,

(
select TRUNC(SUM(A.ACTL_CPN_AMT)/1000000)
FROM
(
    select
    CASE WHEN CUR_UNT='USD' THEN TRUNC(ACTL_CPN_AMT*1198)
         WHEN CUR_UNT='JPY' THEN TRUNC(ACTL_CPN_AMT*11)
         WHEN CUR_UNT='KRW' THEN ACTL_CPN_AMT*100
         WHEN CUR_UNT='EUR' THEN TRUNC(ACTL_CPN_AMT*1362.17)
    END
    AS ACTL_CPN_AMT
    FROM C10APUSER.TB_C10_CUS_CMPL_HST
    WHERE SAL_END_DD BETWEEN REPLACE(:SAL_END_DD_FR, '-', '') AND REPLACE(:SAL_END_DD_TO, '-', '')
    AND( 
          (  
              ((:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NOT NULL)) 
              AND (CCL_BOM_NO = :CCL_BOM_NO) 
              AND (FNL_CUS_CD = :FNL_CUS_CD)
              AND PRD_NM = (SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
          )
        OR (  
             ( (:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NULL) ) 
             AND (FNL_CUS_CD = :FNL_CUS_CD) AND CCL_BOM_NO IS NULL
             AND PRD_NM =(SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
           ) 
       )
    ) A
) AS ACTL_CPN_AMT,

(
    SELECT CUS_CMPL_NO
    FROM
    ( 
       SELECT ROWNUM AS R_NO, A.* FROM
       (
            SELECT  CUS_CMPL_NO || '-' || CUS_CMPL_LN AS CUS_CMPL_NO,SAL_END_DD FROM C10APUSER.TB_C10_CUS_CMPL_HST
            WHERE SAL_END_DD BETWEEN REPLACE(:SAL_END_DD_FR, '-', '') AND REPLACE(:SAL_END_DD_TO, '-', '')
            AND( 
                  (  
                      ((:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NOT NULL)) 
                      AND (CCL_BOM_NO = :CCL_BOM_NO) 
                      AND (FNL_CUS_CD = :FNL_CUS_CD)
                      AND PRD_NM = (SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
                  )
                OR (  
                     ( (:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NULL) ) 
                     AND (FNL_CUS_CD = :FNL_CUS_CD) AND CCL_BOM_NO IS NULL
                     AND PRD_NM =(SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
                   ) 
               )
            GROUP BY SAL_END_DD, CUS_CMPL_NO, CUS_CMPL_LN
            ORDER BY SAL_END_DD DESC
       )A    
       WHERE ROWNUM<4
    )
    WHERE R_NO=1
) AS CUS_CMPL_NO_FREQ1,

(
    SELECT CUS_CMPL_NO
