<queryMap desc="C107000070pop01 Page 쿼리파일"> 
	 <query id="C107000070pop01.select" desc="C107000070pop01 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 

		  
SELECT
:SAL_END_DD_FR AS SAL_END_DD_FR,
:SAL_END_DD_TO AS SAL_END_DD_TO,
(
    SELECT PRD_NM
    FROM
    (
       SELECT ROWNUM AS R_NO, A.* FROM
       (
            SELECT PRD_NM FROM C10APUSER.TB_C10_CUS_CMPL_HST
            WHERE SAL_END_DD BETWEEN REPLACE(:SAL_END_DD_FR, '-', '') AND REPLACE(:SAL_END_DD_TO, '-', '')
            AND( 
                  (  
                      ((:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NOT NULL)) 
                      AND (CCL_BOM_NO = :CCL_BOM_NO) 
                      AND (FNL_CUS_CD = :FNL_CUS_CD)
                      AND PRD_NM = (SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
                  )
                OR (  
                     ( (:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NULL) ) 
                     AND (FNL_CUS_CD = :FNL_CUS_CD) AND CCL_BOM_NO IS NULL
                     AND PRD_NM =(SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
                   ) 
               )
            GROUP BY PRD_NM
            ORDER BY count(PRD_NM) DESC
       ) A
       WHERE ROWNUM<3
    )
    WHERE R_NO=1
) AS PRD_NM_FREQ1,

(
    SELECT PRD_NM
    FROM
    (
       SELECT ROWNUM AS R_NO, A.* FROM
       (
            SELECT PRD_NM FROM C10APUSER.TB_C10_CUS_CMPL_HST
            WHERE SAL_END_DD BETWEEN REPLACE(:SAL_END_DD_FR, '-', '') AND REPLACE(:SAL_END_DD_TO, '-', '')
            AND( 
                  (  
                      ((:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NOT NULL)) 
                      AND (CCL_BOM_NO = :CCL_BOM_NO) 
                      AND (FNL_CUS_CD = :FNL_CUS_CD)
                      AND PRD_NM = (SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
                  )
                OR (  
                     ( (:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NULL) ) 
                     AND (FNL_CUS_CD = :FNL_CUS_CD) AND CCL_BOM_NO IS NULL
                     AND PRD_NM =(SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
                   ) 
               )
            GROUP BY PRD_NM
            ORDER BY count(PRD_NM) DESC
       ) A
       WHERE ROWNUM<3
    )
    WHERE R_NO=2
) AS PRD_NM_FREQ2,

(
    SELECT 
    LISTAGG(CCL_BOM_NO, ',') WITHIN GROUP (ORDER BY CCL_BOM_NO) AS CCL_BOM_NO
    FROM 
    (
    select
    DISTINCT CCL_BOM_NO
    FROM C10APUSER.TB_C10_CUS_CMPL_HST
    WHERE SAL_END_DD BETWEEN REPLACE(:SAL_END_DD_FR, '-', '') AND REPLACE(:SAL_END_DD_TO, '-', '')
    AND( 
          (  
              ((:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NOT NULL)) 
              AND (CCL_BOM_NO = :CCL_BOM_NO) 
              AND (FNL_CUS_CD = :FNL_CUS_CD)
              AND PRD_NM = (SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
          )
        OR (  
             ( (:FNL_CUS_CD IS NOT NULL) AND (:CCL_BOM_NO IS NULL) ) 
             AND (FNL_CUS_CD = :FNL_CUS_CD) AND CCL_BOM_NO IS NULL
             AND PRD_NM =(SELECT CD_V_MEANING FROM   M00APUSER.VI_M00_CODE_ACCESS WHERE  CD_TP='PRD_NM_CD' AND CATEGORY_GROUP_NM ='SZ0000' AND CD_V = :PRD_NM_CD)
           ) 
       )
    )
) AS CCL_BOM_NO,

(
    SELECT ORD_USG_NM
    FROM
    ( 
       SELECT ROWNUM AS R_NO, A.* FROM
       (
            SELECT ORD_USG_NM FROM C10APUSER.TB_C10_CUS_CMPL_HST
            WHERE SAL_END_DD BETWEEN REPLACE(:SAL_END_DD_FR, '-', '') AND REPLACE(:SAL_END_DD_TO, '-', '')
            AND( 
