<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000060 Page 쿼리파일"> 
	 <query id="C104000060.select" desc="C104000060 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT ORD_NO,
       ORD_LN,
       TO_CHAR(QLT_DSN_END_DH,'YYYY-MM-DD') QLT_DSN_END_DH,
       (SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_NM_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_NM_CD) AS PRD_NM_CD,--품명코드
      (SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_SHP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_SHP) AS PRD_SHP,    --제품형태코드
      (SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'FLOW_CHL'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = FLOW_CHL) AS FLOW_CHL,  --유통경로코드
      (SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'ORD_KND'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = ORD_KND) AS ORD_KND,    --주문종류코드
       (SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'CUS_CD' 
           AND CATEGORY_GROUP_NM = 'SZ0000'
           AND CD_V = FNL_CUS_CD) FNL_CUS_CD, --고객사코드
       ORD_EXC_THK,
       ORD_EXC_WTH,
       ORD_EXC_LTH,
       ORD_REP_NO,
       ORD_REP_LN,
       ORD_REP_YN,
       nvl((SELECT EMP_NM FROM M90APUSER.TB_M90_EMP_INF
            WHERE  EMP_ID = T1.ORD_RGS_PRS_ID),
            T1.ORD_RGS_PRS_ID) AS ORD_RGS_PRS_ID
  FROM C10APUSER.TB_C10_QLT_DSN_CMN T1
 WHERE QLT_DSN_END_DH > TO_DATE(REPLACE(:QLT_DSN_END_DH_STR,'-'), 'YYYYMMDD')
   AND QLT_DSN_END_DH < TO_DATE(REPLACE(:QLT_DSN_END_DH_END,'-'), 'YYYYMMDD') + 1
   AND ORD_REP_YN = 'X'
   AND ORD_REP_NO IS NOT NULL
   AND T1.QLT_DSN_CFM_TP = 'A'
   AND T1.QLT_DSN_STS_CD = 'A'
      AND (   (:ORD_RGS_PRS_ID is null)
        or (T1.ORD_RGS_PRS_ID in (SELECT EMP_ID FROM M90APUSER.TB_M90_EMP_INF
                                  WHERE  EMP_NM LIKE '%' || :ORD_RGS_PRS_ID || '%'))
       )                           
   AND FNL_CUS_CD LIKE :FNL_CUS_NAME||'%'
   AND NVL(PRD_NM_CD,' ') LIKE :PRD_NM_CD||'%'
   ORDER BY QLT_DSN_END_DH, ORD_NO
		 ]]> 
	 </query>
	 <query id="C104000060FnlCusComb.select" desc="C104000060 고객사콤보 리스트 출력" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT '%' AS FNL_CUS_CD,'　' AS FNL_CUS_NM -- '전체'컬럼 생성
FROM DUAL
UNION ALL -- 테이블 조합
SELECT FNL_CUS_CD, --고객사코드
       REPLACE((SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'CUS_CD' 
           AND CATEGORY_GROUP_NM = 'SZ0000'
           AND CD_V = FNL_CUS_CD),'&','&amp;') FNL_CUS_NM --고객사명
  FROM C10APUSER.TB_C10_QLT_DSN_CMN
 WHERE ORD_REP_YN = 'X'
   AND QLT_DSN_CFM_TP = 'A'
   AND QLT_DSN_STS_CD = 'A'
   AND QLT_DSN_END_DH > TO_DATE(REPLACE(:QLT_DSN_END_DH_STR,'-'), 'YYYYMMDD')
   AND QLT_DSN_END_DH < TO_DATE(REPLACE(:QLT_DSN_END_DH_END,'-'), 'YYYYMMDD') + 1
   GROUP BY FNL_CUS_CD
		 ]]> 
	 </query>
	 <query id="C104000060Ord.select" desc="주문검색" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT ORD_NO,
       ORD_LN,
       TO_CHAR(QLT_DSN_END_DH,'YYYY-MM-DD') QLT_DSN_END_DH,
       (SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_NM_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_NM_CD) AS PRD_NM_CD,--품명코드
      (SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_SHP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_SHP) AS PRD_SHP,    --제품형태코드
      (SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'FLOW_CHL'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = FLOW_CHL) AS FLOW_CHL,  --유통경로코드
      (SELECT CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'ORD_KND'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = ORD_KND) AS ORD_KND,    --주문종류코드
       (SELECT CD_V_MEANING 
          FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'CUS_CD' 
           AND CATEGORY_GROUP_NM = 'SZ0000'
           AND CD_V = FNL_CUS_CD) FNL_CUS_CD, --고객사코드
       ORD_EXC_THK,
       ORD_EXC_WTH,
       ORD_EXC_LTH,
       ORD_REP_NO,
       ORD_REP_LN,
       ORD_REP_YN,
       EMP_NM AS ORD_RGS_PRS_ID
  FROM C10APUSER.TB_C10_QLT_DSN_CMN T1,
       (SELECT EMP_ID, EMP_NM FROM M90APUSER.TB_M90_EMP_INF
        WHERE EMP_NM LIKE '%' || :ORD_RGS_PRS_ID || '%') T2
 WHERE ORD_REP_YN = 'X'
   AND T1.QLT_DSN_CFM_TP = 'A'
   AND T1.QLT_DSN_STS_CD = 'A'
   AND T1.ORD_RGS_PRS_ID = T2.EMP_ID
   AND NVL(ORD_NO,' ') LIKE :ORD_NO||'%'
   AND NVL(ORD_LN,' ') LIKE :ORD_LN||'%'
   ORDER BY QLT_DSN_END_DH, ORD_NO
		 ]]> 
	 </query>
</queryMap>
