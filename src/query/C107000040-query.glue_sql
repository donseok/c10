<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000040 Page 쿼리파일"> 
	 <query id="C107000040.select" desc="C107000040 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과상세 C107000040.select 이돈석 */ 
       A.ORD_NO  -- 주문번호
      ,A.ORD_LN  -- 주문행번   
      ,(SELECT CD_V || ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_NM_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_NM_CD) AS PRD_NM_CD  --품명코드
      ,(SELECT CD_V || ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_SHP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_SHP) AS PRD_SHP--제품유형
      ,FNL_CUS_CD ||
      (SELECT  ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'CUS_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = FNL_CUS_CD) FNL_CUS_CD -- 최종수요가코드
      ,ORD_EXC_THK --주문환산두께
      ,ORD_EXC_WTH --주문환산폭
      ,ORD_EXC_LTH
      ,B.PLTCM_SET_THK_TRV 
      ,MQL_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'MQL_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = MQL_CD) MQL_CD  -- 재질코드      
      ,GW_ASG_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'GW_ASG_CD' 
       AND   CD_V = GW_ASG_CD 
       AND   CATEGORY_GROUP_NM = DECODE(PRD_NM_CD,'4','SL0000','L','SL0000','2','SE0000','E','SE0000','8','SE0000','N','SE0000','V','SV0000','6','SV0000','W','SW0000','9','SW0000','SG0000')) GW_ASG_CD
      ,TO_CHAR(QLT_DSN_CFM_DH, 'YYYY-MM-DD HH24:MI') QLT_DSN_CFM_DH
      ,QLT_DSN_YN--품질설계유무
   FROM TB_C10_QLT_DSN_CMN A,
        TB_C10_QLT_DSN_MNF B
   WHERE A.ORD_NO = B.ORD_NO
      AND A.ORD_LN = B.ORD_LN
      AND B.QLT_DSN_MNF_TP = '1'
      AND TO_CHAR(QLT_DSN_END_DH,'YYYY-MM-DD') BETWEEN :QLT_DSN_CFM_DH_STR AND :QLT_DSN_CFM_DH_END
      AND NVL(PRD_NM_CD,' ') LIKE :PRD_NM_CD||'%'
      AND NVL(EMBS_CD,' ') LIKE :EMBS_CD_NM||'%'
      AND NVL(MQL_CD,' ') LIKE :MQL_CD_NM||'%'
      AND NVL(GW_ASG_CD,' ') LIKE :GW_ASG_CD||'%'
      AND NVL(PRD_SHP,' ') LIKE :PRD_SHP_NM||'%'
      AND NVL(RSN_TP_FRN,' ') LIKE :RSN_TP_NM||'%'  --수지타입
      AND NVL(EMBS_CD,' ') LIKE :EMBS_CD_NM||'%' --EMBOSS
      AND NVL(ORD_ROU_CD,' ') LIKE :ORD_ROU_CD_NM||'%'  --주문조도
      AND NVL(ORD_RGS_PRS_ID,' ') LIKE FUNC_USER_ID(:ORD_RGS_PRS_NAME)||'%' --등록자
      AND NVL(ORD_SPNL_TP,' ') LIKE :ORD_SPNL_TP_NM||'%'  --SPANGLE
      AND NVL(ORD_SUR_HND_CD,' ') LIKE :ORD_SUR_HND_CD_NM||'%' --주문표면처리
      AND NVL(ORD_EXC_WTH,0) BETWEEN NVL(:ORD_EXC_WTH_STR,0) 
                                        AND NVL(:ORD_EXC_WTH_END,10000)
      AND NVL(PLTCM_SET_THK_TRV,0) BETWEEN NVL(:PLTCM_SET_THK_TRV_STR,0) 
                                        AND NVL(:PLTCM_SET_THK_TRV_END,10000)
ORDER BY A.ORD_NO, A.ORD_LN
		 ]]> 
	 </query>
</queryMap>
