<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab10 Page 쿼리파일"> 
	 <query id="C107000020tab10.select" desc="C107000020tab10 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  
 DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 PRT_ROLL_NO
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_1 RPV_CLR_NM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_2 PRC_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_3 PTN_NM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_4 PRT_PTN_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_9 PRT_ROLL_WHS_DD
FROM M00APUSER.TB_M00_DATAS010 DATAS010, 
(SELECT MDL_DEFINE_ID  
FROM M00APUSER.TB_M00_DEFINES010 
WHERE MDL_DEFINE_NM='C10A1092' 
AND START_ACTIVE_DATE <=  SYSDATE 
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010 
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
		 ]]> 
	 </query>
</queryMap>
