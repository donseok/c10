<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000010"> 
	 <query id="C104000010.select" desc="C104000010.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계의뢰현황 C104000010.select 박재영 */ 
       ORD_NO  -- 주문번호
      ,ORD_LN  -- 주문행번   
      ,SPC_AVR  -- 규격약호
      ,CUS_BTH_PAP_NO  --고객사양서번호
      ,ORD_USG_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'ORD_USG_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = ORD_USG_CD) ORD_USG_CD  --주문용도코드
      ,(SELECT CD_V || ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_NM_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_NM_CD) AS PRD_NM_CD--품명코드
      ,FNL_CUS_CD ||
      (SELECT  ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'CUS_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = FNL_CUS_CD) FNL_CUS_CD -- 최종수요가코드
      ,URG_MTL_TP -- 긴급재구분
      ,ORD_EXC_THK --주문환산두께
      ,ORD_EXC_WTH --주문환산폭
      ,MQL_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'MQL_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = MQL_CD) MQL_CD  -- 재질코드
      ,QLT_DSN_STS_CD
      ,RMTL_CD
      ,RMTL_CD1        -- 원자재코드1
      ,RMTL_CD2        -- 원자재코드2  
      ,CRM_MNF_STD_NO
      ,CRM_MNF_STD_NO1 -- 냉연제조표준번호1
      ,CRM_MNF_STD_NO2 -- 냉연제조표준번호2   
      ,PAS_PROC_NO     -- 통과공정번호
      ,CCL_BOM_NO      -- CCLBOM번호
      ,MTL_CD          -- MaterialCode
      ,ORD_EDG_ASG_TP  -- 주문Edge지정구분    
      ,(SELECT CD_V || ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_SHP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_SHP) AS PRD_SHP--제품유형      
      ,GW_ASG_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'GW_ASG_CD' 
       AND   CD_V = GW_ASG_CD 
       AND   CATEGORY_GROUP_NM = DECODE(PRD_NM_CD,'4','SL0000','L','SL0000','2','SE0000','E','SE0000','8','SE0000','N','SE0000','V','SV0000','6','SV0000','W','SW0000','9','SW0000','SG0000')) GW_ASG_CD
      ,HUE_CD_FRN
      ,ORD_SUR_HND_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'ORD_SUR_HND_CD' 
       AND   CD_V = ORD_SUR_HND_CD 
       AND   CATEGORY_GROUP_NM = DECODE(PRD_NM_CD,'C','SC0000','D','SC0000','E','SE0000','N','SE0000','G','SG0000','K','SG0000','J','SG0000','L','SL0000','V','SV0000','6','SV0000','W','SW0000','9','SW0000','SZ0000')) ORD_SUR_HND_CD
      ,ORD_PTT_FLM_DTL_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'ORD_PTT_FLM_DTL_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = ORD_PTT_FLM_DTL_CD) ORD_PTT_FLM_DTL_CD
      ,TO_CHAR(ORD_LN_WGT,'999,999,999,990') ORD_LN_WGT
      ,TO_CHAR(QLT_DSN_END_DH, 'YYYY-MM-DD HH24:MI') QLT_DSN_END_DH
      ,DECODE(QLT_DSN_YN,'Y','대상','N','비대상','') AS QLT_DSN_YN_NM--품질설계유무(한글)
      ,QLT_DSN_YN--품질설계유무
      ,MO_CVT_ORD_YN || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'MO_CVT_ORD_YN' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = MO_CVT_ORD_YN) AS MO_CVT_ORD_YN_NM  --MO전환주문여부
      ,MO_CVT_ORD_YN--MO전환주문여부
   FROM
      TB_C10_QLT_DSN_CMN A
   WHERE ORD_NO LIKE :ORD_NO||'%' 
      AND QLT_DSN_INST_DH BETWEEN TO_DATE(DECODE(:ORD_NO,'',:QLT_DSN_INST_DH_STR,'1900-01-01'),'YYYY-MM-DD')  
                          AND TO_DATE(DECODE(:ORD_NO,'',:QLT_DSN_INST_DH_END,'3000-12-31'),'YYYY-MM-DD') + 1
      AND NVL(PRD_NM_CD,' ') LIKE :PRD_NM_CD||'%' 
      AND NVL(SPC_AVR,' ') LIKE :SPC_AVR||'%' 
      AND NVL(ORD_USG_CD,' ') LIKE :ORD_USG_CD||'%' 
      AND NVL(FNL_CUS_CD,' ') LIKE :CUS_CD||'%' 
      AND NVL(QLT_DSN_YN,' ') LIKE :QLT_DSN_YN||'%' --품질설계유무 추가
      AND NVL(QLT_DSN_STS_CD,' ') LIKE :QLT_DSN_STS_CD||'%' 
      AND NVL(ORD_EXC_THK,0) BETWEEN NVL(:ORD_EXT_THK_STR,0) 
                                        AND NVL(:ORD_EXT_THK_END,10)
      AND NVL(URG_MTL_TP,' ') LIKE DECODE(:URG_MTL_TP,1,'Y','')||'%'
      AND NVL(MO_CVT_ORD_YN,' ') LIKE DECODE(:MO_CVT_ORD_YN,1,'X','')||'%'
      AND NOT EXISTS (SELECT 'Y' FROM MESAPUSER.VI_MES_TRM_CTL WHERE CTL_NO = A.ORD_NO AND CTL_TP = 'O')
ORDER BY ORD_NO, ORD_LN
		 ]]> 
	 </query>
</queryMap>
