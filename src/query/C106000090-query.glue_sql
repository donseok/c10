<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000090 Page 쿼리파일"> 
	 <query id="C106000090_Grid1_CLRCD.select" desc="10" fetchSize="1000" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   칼라코드조회   C106000090_Grid1_CLRCD.select   김종화  */
   CLR_SUB_MTL_CD, CLR_NM, SUB_MTL_TP 
FROM TB_C10_CLR_CD_MNG
WHERE CLR_SUB_MTL_CD LIKE NVL(:FIND_CD||'%','%')
  AND SUB_MTL_TP IN('S31','S32','S35','ZZZ','S38')
ORDER BY SUB_MTL_TP , CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000090_Grid1_CCLBOM.select" desc="10" fetchSize="1000" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   CCLBOM조회   C106000090_Grid1_CCLBOM.select   김종화  */
CCL_BOM_NO , DTL_CLR_NM , RSN_TP_FRN  
FROM TB_C10_CCL_BOM
WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
ORDER BY CCL_BOM_NO
		 ]]> 
	 </query>
	 <query id="C106000090_Grid1_RSNTP.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C106000090   수지타입조회   C106000090_Grid1_RSNTP.select   김종화  */
       CD_V RSN_TP, CD_V_MEANING RSN_TP_NM
       FROM   M00APUSER.VI_M00_CODE_ACCESS
       WHERE  CD_TP= 'RSN_TP'
       AND    CATEGORY_GROUP_NM ='SZ0000'
       AND  CD_V LIKE NVL(:FIND_CD||'%','%')
ORDER BY CD_V
		 ]]> 
	 </query>
	 <query id="C106000090_Grid1_PrintRoll.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C106000090   PrintRoll조회   C106000090_Grid1_PrintRoll.select   김종화  */
PRT_ROLL_NO, -- ROLL NO
RPV_CLR_NM, --대표색상
PTN_NM --PATTERN 명
FROM M00APUSER.VI_M00_C10A1091
WHERE NVL(PRT_ROLL_NO,'%') LIKE '%'|| :FIND_CD ||'%'
ORDER BY PRT_ROLL_NO
		 ]]> 
	 </query>
	 <query id="C106000090_Grid1_SamePrintRoll.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT CCL_BOM_NO CCL_BOM_NO1, 
    (SELECT CD_V || ' : ' || CD_V_MEANING 
	FROM M00APUSER.VI_M00_CODE_ACCESS
	WHERE CD_TP = 'COT_MTH'         
	AND   CATEGORY_GROUP_NM = 'SZ0000'
	AND   CD_V = COT_MTH) AS COT_MTH_NM
FROM C10APUSER.TB_C10_CCL_BOM
WHERE CCL_BOM_NO LIKE NVL(:FIND_CD||'%','%')
 AND  COT_MTH IN('F','G','H','J')
ORDER BY CCL_BOM_NO
		 ]]> 
	 </query>
	 <query id="C106000090_Grid1_INK.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   칼라코드조회   C106000090_Grid1_INK.select   김종화  */
   CLR_SUB_MTL_CD CLR_SUB_MTL_CD_INK, CLR_NM CLR_NM_INK,
   (SELECT CD_V_MEANING RSN_TP_NM
    FROM   M00APUSER.VI_M00_CODE_ACCESS
    WHERE  CD_TP= 'RSN_TP'
    AND    CATEGORY_GROUP_NM ='SZ0000'
    AND  CD_V =RSN_TP) RSN_TP_INK
FROM TB_C10_CLR_CD_MNG
WHERE CLR_SUB_MTL_CD LIKE NVL(:FIND_CD||'%','%')
  AND SUB_MTL_TP ='S34'
ORDER BY SUB_MTL_TP , CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_CLRCD.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   칼라코드사용   C106000090_Grid2_CLRCD.select   김종화  */
       a.CCL_BOM_NO, a.CCL_BOM_USE_YN, a.HUE_CD_FRN, a.HUE_CD_BAK,
       a.HUE_CD_FRN_1COT, a.HUE_CD_FRN_2COT, a.HUE_CD_FRN_3COT, a.HUE_CD_FRN_4COT,
       a.HUE_CD_BAK_1COT, a.HUE_CD_BAK_2COT, a.HUE_CD_BAK_3COT, a.HUE_CD_BAK_4COT,
       a.HUE_CD_LMN, 
       b.CUS_CD FNL_CUS_CD, C10APUSER.FUNC_DECODE01('CUS_CD','SZ0000',b.CUS_CD) FNL_CUS_CD_NM,
       b.ORD_USG_CD, C10APUSER.FUNC_DECODE01('ORD_USG_CD','SZ0000',b.ORD_USG_CD) ORD_USG_CD_NM,
       b.PTT_FLM_DTL_CD
FROM   C10APUSER.TB_C10_CCL_BOM a,
       C10APUSER.TB_C10_CLR_MPR b
WHERE  ( a.HUE_CD_FRN = :CLR_SUB_MTL_CD OR  
         a.HUE_CD_BAK = :CLR_SUB_MTL_CD OR
         a.HUE_CD_FRN_1COT = :CLR_SUB_MTL_CD OR 
         a.HUE_CD_FRN_2COT = :CLR_SUB_MTL_CD OR 
         a.HUE_CD_FRN_3COT = :CLR_SUB_MTL_CD OR 
         a.HUE_CD_FRN_4COT = :CLR_SUB_MTL_CD OR 
         a.HUE_CD_BAK_1COT = :CLR_SUB_MTL_CD OR 
         a.HUE_CD_BAK_2COT = :CLR_SUB_MTL_CD OR   
         a.HUE_CD_BAK_3COT = :CLR_SUB_MTL_CD OR  
         a.HUE_CD_BAK_4COT = :CLR_SUB_MTL_CD OR
         a.HUE_CD_LMN      = :HUE_CD_LMN        )
AND    a.CCL_BOM_NO = b.CCL_BOM_NO
ORDER BY a.CCL_BOM_NO, decode(b.CUS_CD,'******','0',b.CUS_CD), decode(b.ORD_USG_CD,'******','0',b.ORD_USG_CD)
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_CCLBOM.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT /* C106000090   CCLBOM사용   C106000090_Grid2_CCLBOM.select   김종화  */
      --+ INDEX_DESC(A IX_QLT_DSN_CMN_1)
      A.ORD_NO ||'-'||A.ORD_LN AS ORD_NO
      ,A.SPC_AVR
      ,(SELECT CD_V_MEANING 
        FROM M00APUSER.VI_M00_CODE_ACCESS
        WHERE CD_TP = 'ORD_USG_CD' 
        AND   CATEGORY_GROUP_NM = 'SZ0001'
        AND   CD_V = A.ORD_USG_CD)
        AS ORD_USG_CD  --주문용도코드
      ,A.PRD_NM_CD
      ,(SELECT CD_V_MEANING 
        FROM M00APUSER.VI_M00_CODE_ACCESS
        WHERE CD_TP = 'CUS_CD' 
        AND   CATEGORY_GROUP_NM = 'SZ0000'
        AND   CD_V = A.FNL_CUS_CD) AS FNL_CUS_CD -- 최종수요가코드
      ,A.ORD_EXC_THK --주문환산두께
      ,A.ORD_EXC_WTH --주문환산폭
      ,TO_CHAR(A.QLT_DSN_END_DH, 'YYYY-MM-DD') AS QLT_DSN_END_DH
      ,DECODE(SUBSTR(A.MTL_CD,0,1),'G','△',DECODE((SELECT COUNT(WH.COIL_ID)
                 FROM MESAPUSER.TB_M60_WHS_RET WH
                WHERE WH.ORD_NO = A.ORD_NO
                  AND WH.ORD_LN = A.ORD_LN),0,'X',DECODE(B.WK_END_DH,'','△','O'))) AS PRD_WHS_OX
      ,MTL_PRD_ORD_YN || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'MTL_PRD_ORD_YN' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = MTL_PRD_ORD_YN) MTL_PRD_ORD_YN --소재생산주문여부
      ,MO_CVT_ORD_YN || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'MO_CVT_ORD_YN' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = MO_CVT_ORD_YN) MO_CVT_ORD_YN --MO전환주문여부
      ,(SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.QLT_DSN_CFM_PRS_ID) AS QLT_DSN_CFM_PRS_ID
      , TO_CHAR(B.WK_END_DH, 'YYYY-MM-DD HH24:MI') AS WK_END_DH
      , (SELECT CD_V_MEANING
        FROM M00APUSER.VI_M00_CODE_ACCESS
        WHERE CD_TP = 'PROC_CD' 
        AND   CATEGORY_GROUP_NM = 'SZ0000'
        AND   CD_V = C.PROC_CD) AS PROC_CD_NM
 FROM   C10APUSER.TB_C10_QLT_DSN_CMN A
        LEFT JOIN (SELECT ORD_NO, ORD_LN, MAX(WK_END_DH) WK_END_DH FROM MESAPUSER.TB_M47_PRD_ACT_CMN CMN WHERE OP_GRD = '1' GROUP BY ORD_NO, ORD_LN) B ON A.ORD_NO =B.ORD_NO AND A.ORD_LN = B.ORD_LN
        LEFT JOIN (SELECT DISTINCT ORD_NO, ORD_LN, WK_END_DH, PROC_CD FROM MESAPUSER.TB_M47_PRD_ACT_CMN WHERE OP_GRD = '1') C ON A.ORD_NO = C.ORD_NO AND A.ORD_LN = C.ORD_LN AND B.WK_END_DH = C.WK_END_DH
 WHERE  A.CCL_BOM_NO = :CCL_BOM_NO
 AND    A.QLT_DSN_INST_DH BETWEEN ADD_MONTHS(SYSDATE, -(:TERM)) AND SYSDATE+1
 AND    NVL(A.ORD_END_TP,'N') <> 'E'
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_RSNTP.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   RSNTP사용   C106000090_Grid2_RSNTP.select   김종화  */
      CLR_SUB_MTL_CD
      ,USE_YN
      ,CLR_NM
      ,SUB_MTL_TP
      ,LUS_RT_CD ||
       (SELECT  ':'||CD_V_MEANING
          FROM  M00APUSER.VI_M00_CODE_ACCESS
         WHERE  CD_TP='LUS_RT_CD'
           AND  CATEGORY_GROUP_NM ='SZ0000'
           AND  CD_V = LUS_RT_CD) LUS_RT_NM
       ,(SELECT USER_NAME
           FROM M90APUSER.TB_M90_EMP_INF
          WHERE USER_NO = MDF_PRS_ID) MDF_PRS_ID   
       ,TO_CHAR(CLR_MDF_DH,'YYYY-MM-DD') CLR_MDF_DH
 FROM   TB_C10_CLR_CD_MNG
 WHERE NVL(RSN_TP,'ZZ') = :RSN_TP
 ORDER BY CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_PrintRoll.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   CCLBOM사용   C106000090_Grid2_PrintRoll.select   김종화  */
CCL_BOM_NO CCL_BOM_NO1, CCL_BOM_USE_YN CCL_BOM_USE_YN1, 
PRT_ROLL_NO1,PRT_ROLL_NO2,PRT_ROLL_NO3,PRT_ROLL_NO4,
PRT_ROLL_BAK_NO1,PRT_ROLL_BAK_NO2,PRT_ROLL_BAK_NO3,PRT_ROLL_BAK_NO4
 FROM   C10APUSER.TB_C10_CCL_BOM 
 WHERE PRT_ROLL_NO1  = :PRT_ROLL_NO OR  
       PRT_ROLL_NO2  = :PRT_ROLL_NO OR
       PRT_ROLL_NO3  = :PRT_ROLL_NO OR 
       PRT_ROLL_NO4  = :PRT_ROLL_NO OR 
       PRT_ROLL_BAK_NO1  = :PRT_ROLL_NO OR 
       PRT_ROLL_BAK_NO2  = :PRT_ROLL_NO OR 
       PRT_ROLL_BAK_NO3  = :PRT_ROLL_NO OR 
       PRT_ROLL_BAK_NO4  = :PRT_ROLL_NO
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_SamePrintRoll.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT CCL_BOM_NO CCL_BOM_NO2, 
       PRT_ROLL_NO1 PRT_ROLL_NO1U, 
       PRT_ROLL_NO2 PRT_ROLL_NO2U, 
       PRT_ROLL_NO3 PRT_ROLL_NO3U, 
       PRT_ROLL_NO4 PRT_ROLL_NO4U,
       PRT_ROLL_BAK_NO1 PRT_ROLL_BAK_NO1U, 
       PRT_ROLL_BAK_NO2 PRT_ROLL_BAK_NO2U, 
       PRT_ROLL_BAK_NO3 PRT_ROLL_BAK_NO3U, 
       PRT_ROLL_BAK_NO4 PRT_ROLL_BAK_NO4U
FROM C10APUSER.TB_C10_CCL_BOM
WHERE COT_MTH IN('F','G','H','J')
 AND     ( NVL(PRT_ROLL_NO1,'Z')
      ,NVL(PRT_ROLL_NO2,'Z')
      ,NVL(PRT_ROLL_NO3,'Z')
      ,NVL(PRT_ROLL_NO4,'Z')
      ,NVL(PRT_ROLL_BAK_NO1,'Z')
      ,NVL(PRT_ROLL_BAK_NO2,'Z')
      ,NVL(PRT_ROLL_BAK_NO3,'Z')
      ,NVL(PRT_ROLL_BAK_NO4,'Z') ) IN (SELECT NVL(PRT_ROLL_NO1,'Z')
                                                          ,NVL(PRT_ROLL_NO2,'Z')
                                             ,NVL(PRT_ROLL_NO3,'Z')
                                             ,NVL(PRT_ROLL_NO4,'Z')
                                             ,NVL(PRT_ROLL_BAK_NO1,'Z')
                                             ,NVL(PRT_ROLL_BAK_NO2,'Z')
                                             ,NVL(PRT_ROLL_BAK_NO3,'Z')
                                             ,NVL(PRT_ROLL_BAK_NO4 ,'Z')
                                       FROM  C10APUSER.TB_C10_CCL_BOM 
                                       WHERE CCL_BOM_NO = :CCL_BOM_NO1)
ORDER BY CCL_BOM_NO
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_INKCD.select" desc="10" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   칼라코드사용   C106000090_Grid2_INKCD.select   김종화  */
CCL_BOM_NO CCL_BOM_NO_INK, CCL_BOM_USE_YN CCL_BOM_USE_YN_INK, 
PRT_INK_CD1, PRT_INK_CD2, PRT_INK_CD3, PRT_INK_CD4, PRT_INK_BAK_CD1,
PRT_INK_BAK_CD2, PRT_INK_BAK_CD3, PRT_INK_BAK_CD4
FROM  C10APUSER.TB_C10_CCL_BOM 
WHERE PRT_INK_CD1 = :CLR_SUB_MTL_CD_INK OR 
      PRT_INK_CD2 = :CLR_SUB_MTL_CD_INK OR 
      PRT_INK_CD3 = :CLR_SUB_MTL_CD_INK OR 
      PRT_INK_CD4 = :CLR_SUB_MTL_CD_INK OR 
      PRT_INK_BAK_CD1 = :CLR_SUB_MTL_CD_INK OR 
      PRT_INK_BAK_CD2 = :CLR_SUB_MTL_CD_INK OR   
      PRT_INK_BAK_CD3 = :CLR_SUB_MTL_CD_INK OR  
      PRT_INK_BAK_CD4 = :CLR_SUB_MTL_CD_INK
		 ]]> 
	 </query>
	 <query id="C106000090_Grid1_FLM.select" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   보호필름코드조회   C106000090_Grid1_FLM.select   이돈석  */
   CLR_SUB_MTL_CD PTT_FLM_DTL_CD 
FROM TB_C10_CLR_CD_MNG
WHERE CLR_SUB_MTL_CD LIKE NVL(:FIND_CD||'%','%')
  AND SUB_MTL_TP ='S36'
ORDER BY SUB_MTL_TP , CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_FLMCD.select" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT CCL_BOM_NO CCL_BOM_NO3, 
       CUS_CD FNL_CUS_CD,
       (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'CUS_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = CUS_CD) FNL_CUS_CD_NM,
       ORD_USG_CD,
       (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'ORD_USG_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = ORD_USG_CD) ORD_USG_CD_NM
  FROM TB_C10_CLR_MPR
 WHERE PTT_FLM_DTL_CD = :PTT_FLM_DTL_CD
		 ]]> 
	 </query>
	 <query id="C106000090_Grid1_BND.select" desc="접착제 코드 정보" fetchSize="100" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000090   접착제코드조회   C106000090_Grid1_BND.select   JKJ  */
	CLR_SUB_MTL_CD AS LMN_BND_CD, 
	CLR_NM	AS BND_CLR_NM, 
	SUB_MTL_TP AS BND_SUB_MTL_TP
FROM TB_C10_CLR_CD_MNG
WHERE CLR_SUB_MTL_CD LIKE TRIM(:FIND_CD)||'%'
AND   SUB_MTL_TP = 'S37'
AND   CLR_SUB_MTL_CD  LIKE 'U%'
AND  USE_YN = 'Y'
ORDER BY SUB_MTL_TP , CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_BND_CCLBOM.select" desc="접착제에 따른 CCL BOM" isNamed="true">
		 <![CDATA[ 
SELECT A.CCL_BOM_NO AS CCL_BOM_NO3,
       B.CUS_CD AS FNL_CUS_CD,
       (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'CUS_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = B.CUS_CD) AS FNL_CUS_CD_NM,
       B.ORD_USG_CD,
       (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'ORD_USG_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = B.ORD_USG_CD) AS ORD_USG_CD_NM,
       (SELECT LISTAGG((SELECT CD_V_MEANING
        FROM   M00APUSER.VI_M00_CODE_ACCESS
        WHERE  CD_TP='PNT_CMP_CD'
        AND    CATEGORY_GROUP_NM ='SZ0000'
        AND    CD_V = PNT_CMP_CD),',') WITHIN GROUP(ORDER BY 1) 
        FROM TB_C10_CLR_CMP_MNG
        WHERE CLR_SUB_MTL_CD = :LMN_BND_CD
        AND USE_YN = 'Y') AS PNT_CMP_NM
  FROM C10APUSER.TB_C10_CCL_BOM A
      ,C10APUSER.TB_C10_CLR_MPR B
 WHERE A.CCL_BOM_USE_YN = 'Y'
   AND A.CCL_BOM_NO = B.CCL_BOM_NO
   AND A.LMN_BND_CD =:LMN_BND_CD
ORDER BY A.CCL_BOM_NO, B.CUS_CD
		 ]]> 
	 </query>
	 <query id="C106000090_Grid1_FLMUGS.select" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C106000090   생산UGS필름코드조회   C106000090_Grid1_FLMUGS.select   이돈석  */
   CLR_SUB_MTL_CD UNI_GLS_FLM_CD
FROM TB_C10_CLR_CD_MNG
WHERE CLR_SUB_MTL_CD LIKE NVL(:FIND_CD||'%','%')
  AND SUB_MTL_TP ='S49'
ORDER BY SUB_MTL_TP , CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000090_Grid2_USGCD.select" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT CCL_BOM_NO CCL_BOM_NO3
  FROM TB_C10_CLR_MPR
 WHERE UNI_GLS_FLM_CD = :UNI_GLS_FLM_CD
		 ]]> 
	 </query>
</queryMap>
