<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C108000070 Page 쿼리파일"> 
	 <query id="C108000070.selectSpec" desc="제품개발SPEC 조회" isNamed="true">
		 <![CDATA[ 
SELECT/*+ C10 품질설계 제품개발SPEC 조회 C108000070.selectSpec 전경진 */
    SP.PRD_DEV_NO,
    SP.DEV_REQ_SPEC_NO,
    SP.PRD_DEV_NO||SP.DEV_REQ_SPEC_NO AS PRD_DEV_SPEC_NO,
    SP.PRD_NM_CD,
    SP.CLR_DEV_TP,
    SP.CUS_REQ_HUE_TXT,
    SP.COT_MTH,
    SP.RSN_TP,
    SP.TLP_TP,
    SP.RL_LUS_RT,
    SP.PNT_FLM_THK_TXT,
    SP.PTT_FLM_YN,
    SP.ORD_PRE_WGT,
    SP.DEV_REF_TP,
    SP.REF_CLR_CD_TXT,
    SP.REF_CCL_BOM,
    SP.SIM_HUE_PRG_YN
FROM  C10APUSER.TB_C10_PRD_DEV_SPEC SP
WHERE SP.PRD_DEV_NO = :PRD_DEV_NO
AND   SP.DEV_REQ_SPEC_NO = NVL(:DEV_REQ_SPEC_NO,SP.DEV_REQ_SPEC_NO)
ORDER BY SP.DEV_REQ_SPEC_NO
		 ]]> 
	 </query>
	 <query id="C108000070.updateSpec" desc="제품개발SPEC 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 제품개발SPEC 수정 C108000070.updateSpec 전경진 */
    C10APUSER.TB_C10_PRD_DEV_SPEC
SET PRD_NM_CD= :PRD_NM_CD,
    CLR_DEV_TP= :CLR_DEV_TP,
    CUS_REQ_HUE_TXT= :CUS_REQ_HUE_TXT,
    COT_MTH= :COT_MTH,
    RSN_TP= :RSN_TP,
    TLP_TP= :TLP_TP,
    RL_LUS_RT= :RL_LUS_RT,
    PNT_FLM_THK_TXT= :PNT_FLM_THK_TXT,
    PTT_FLM_YN= :PTT_FLM_YN,
    ORD_PRE_WGT= :ORD_PRE_WGT,
    DEV_REF_TP= :DEV_REF_TP,
    REF_CLR_CD_TXT= :REF_CLR_CD_TXT,
    REF_CCL_BOM= :REF_CCL_BOM,
    SIM_HUE_PRG_YN= :SIM_HUE_PRG_YN,
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE PRD_DEV_NO = :PRD_DEV_NO
AND   DEV_REQ_SPEC_NO = :DEV_REQ_SPEC_NO
		 ]]> 
	 </query>
	 <query id="C108000070.insertSpec" desc="제품개발SPEC 삽입" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C10 품질설계 제품개발SPEC 등록 C108000070.insertSpec 전경진*/
INTO C10APUSER.TB_C10_PRD_DEV_SPEC
(   PRD_DEV_NO,
    DEV_REQ_SPEC_NO,
    PRD_NM_CD,
    CLR_DEV_TP,
    CUS_REQ_HUE_TXT,
    COT_MTH,
    RSN_TP,
    TLP_TP,
    RL_LUS_RT,
    PNT_FLM_THK_TXT,
    PTT_FLM_YN,
    ORD_PRE_WGT,
    DEV_REF_TP,
    REF_CLR_CD_TXT,
    REF_CCL_BOM,
    SIM_HUE_PRG_YN,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP
)VALUES(
:PRD_DEV_NO
,TO_CHAR(
 (SELECT TO_NUMBER(NVL(MAX(DEV_REQ_SPEC_NO), '10')) + 1
  FROM   C10APUSER.TB_C10_PRD_DEV_SPEC
  WHERE  PRD_DEV_NO = :PRD_DEV_NO))
,:PRD_NM_CD
,:CLR_DEV_TP
,:CUS_REQ_HUE_TXT
,:COT_MTH
,:RSN_TP
,:TLP_TP
,:RL_LUS_RT
,:PNT_FLM_THK_TXT
,:PTT_FLM_YN
,:ORD_PRE_WGT
,:DEV_REF_TP
,:REF_CLR_CD_TXT
,:REF_CCL_BOM
,:SIM_HUE_PRG_YN
,:ObjectType
,:ObjectId
,:ProgramId
,:Timestamp
,:ObjectType
,:ObjectId
,:ProgramId
,:Timestamp)
		 ]]> 
	 </query>
	 <query id="C108000070.selectSmp" desc="샘플 이력 조회" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C108000070   개발참조샘플 조회  C108000070.selectSmp  전경진 */ 
    SMPL_NO,
    SMPL_TP,
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'SMPL_TP'         
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SMPL_TP) AS SMPL_TP_NM, 
    DEV_NO AS PRD_DEV_SPEC_NO,
    (SELECT CD_V_MEANING
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'CUS_CD'
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = CUS_CD) CUS_CD_NM,
    TO_CHAR(SMPL_RCV_DH,'YYYY-MM-DD ') SMPL_RCV_DH,
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'SMPL_STS_CD'         
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SMPL_STS_CD) AS SMPL_STS_CD_NM, 
    (SELECT CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
      WHERE CD_TP = 'SMPL_SZ_CD'         
        AND CATEGORY_GROUP_NM = 'SZ0000'
        AND CD_V = SMPL_SZ_CD) AS SMPL_SZ_CD_NM, 
    SMPL_QTY,
    SMPL_PUB_YN,
    REMARK,
    ( SELECT COUNT(SMPL_NO) FROM MESAPUSER.TB_M20_SMPL_CUR_APPR_DTL WHERE SMPL_NO = A.SMPL_NO) APPR_CNT,
    ( SELECT COUNT(SMPL_NO) FROM MESAPUSER.TB_M20_SMPL_MKT_REQ_DTL WHERE SMPL_NO = A.SMPL_NO) MKT_CNT
 FROM MESAPUSER.TB_M20_SMPL_DEV_REF_MNG A
WHERE DEV_NO = :PRD_DEV_SPEC_NO
ORDER BY SMPL_RCV_DH, SMPL_NO
		 ]]> 
	 </query>
	 <query id="C108000070.updateSmp" desc="샘플 이력 삭제" isNamed="true">
		 <![CDATA[ 
UPDATE  /*+ C108000070   샘플이력 삭제  C108000070.updateSmp  전경진 */ 
	MESAPUSER.TB_M20_SMPL_DEV_REF_MNG
SET DEV_NO = '',
    LAST_UPDATED_OBJECT_TYPE=:ObjectType,
    LAST_UPDATED_OBJECT_ID=:ObjectId,  
    LAST_UPDATE_PROGRAM_ID=:ProgramId,
    LAST_UPDATE_TIMESTAMP=:Timestamp
WHERE SMPL_NO = :SMPL_NO
AND	  DEV_NO = :PRD_DEV_SPEC_NO
		 ]]> 
	 </query>
	 <query id="C108000070.deleteSpec" desc="제품개발SPEC 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 제품개발SPEC 삭제 C108000070.deleteSpec 전경진 */
    C10APUSER.TB_C10_PRD_DEV_SPEC SP
WHERE SP.PRD_DEV_NO = :PRD_DEV_NO
AND   SP.DEV_REQ_SPEC_NO = :DEV_REQ_SPEC_NO
AND  NOT EXISTS
	(SELECT 'X'
     FROM  C10APUSER.TB_C10_PRD_DEV_REQ_BOM RB
     WHERE RB.PRD_DEV_NO = SP.PRD_DEV_NO
	 AND   RB.DEV_REQ_SPEC_NO = SP.DEV_REQ_SPEC_NO)
		 ]]> 
	 </query>
</queryMap>
