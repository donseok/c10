<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000100pop03 Page 쿼리파일"> 
	 <query id="C106000100pop03.update" desc="C106000100pop03 정보 수정" isNamed="true">
		 <![CDATA[ 
UPDATE  /*+ C106000100pop03   CCLBOM 물성파일 등록여부 yn  C106000100pop03.update  이돈석  */
TB_C10_CCL_BOM_IMG_MNG
SET DOC_YN = DECODE((SELECT COUNT(IMG_NM) CNT
                FROM   TB_C10_CCL_BOM_IMG
                WHERE  CCL_BOM_NO =  :IMG_RGS_FLAG_ID
                AND    CCL_BOM_IMG_SEQ_NO =  :IMG_RGS_FLAG_ID2
                AND    PRD_SPC_TP = '3') , 0, 'N', 'Y' ) ,
         LAST_UPDATED_OBJECT_TYPE = :ObjectType,
         LAST_UPDATED_OBJECT_ID = :ObjectId,
         LAST_UPDATE_PROGRAM_ID = :ProgramId,
         LAST_UPDATE_TIMESTAMP = :Timestamp
WHERE  CCL_BOM_NO =  :IMG_RGS_FLAG_ID
AND    CCL_BOM_IMG_SEQ_NO =  :IMG_RGS_FLAG_ID2
		 ]]> 
	 </query>
	 <query id="C106000100pop03.delete" desc="C106000100pop03 정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE  /*+ C106000100pop03  CCLBOM 물성파일 삭제  C106000100pop03.delete  이돈석  */
TB_C10_CCL_BOM_IMG 
WHERE  CCL_BOM_NO = :IMG_RGS_FLAG_ID
AND CCL_BOM_IMG_SEQ_NO =  :IMG_RGS_FLAG_ID2
AND SEQ_NO = :SEQ
		 ]]> 
	 </query>
	 <query id="C106000100pop03.insert" desc="C106000100pop03 정보 추가" isNamed="true">
		 <![CDATA[ 
INSERT /*+ C106000100pop03   CCLBOM 물성파일 업로드  C106000100pop03.insert  이돈석  */
INTO TB_C10_CCL_BOM_IMG (
    CCL_BOM_NO,
	CCL_BOM_IMG_SEQ_NO,
	SEQ_NO,
	IMG_RGS_TP,
	IMG_ADR,
	IMG_NM,
	CCL_BOM_RGS_DH,
	CCL_BOM_RGS_PRS_ID,
    CREATED_OBJECT_TYPE, 
    CREATED_OBJECT_ID, 
    CREATED_PROGRAM_ID, 
    CREATION_TIMESTAMP, 
    LAST_UPDATED_OBJECT_TYPE, 
    LAST_UPDATED_OBJECT_ID, 
    LAST_UPDATE_PROGRAM_ID, 
    LAST_UPDATE_TIMESTAMP,
    PRD_SPC_TP)
VALUES (
    :IMG_RGS_FLAG_ID, 
    :IMG_RGS_FLAG_ID2, 
    (SELECT NVL(MAX(SEQ_NO),0)+1 FROM TB_C10_CCL_BOM_IMG WHERE CCL_BOM_NO = :IMG_RGS_FLAG_ID AND CCL_BOM_IMG_SEQ_NO = :IMG_RGS_FLAG_ID2), 
    :IMG_RGS_TP, 
    :FILE_ADDR,
    :FILE_NAME,  
    SYSDATE, 
    :ObjectId,
    'C',
    :ObjectId,
    'C106000100pop03',
    SYSTIMESTAMP,
    'C',
    :ObjectId,
    'C106000100pop03',
    SYSTIMESTAMP,
    :PRD_SPC_TP)
		 ]]> 
	 </query>
	 <query id="C106000100pop03_Grid_1.select" desc="물성파일등록" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C106000100pop03   CCLBOM 물성파일 조회   C106000100pop03_Grid_1.select  이돈석  */
       CCL_BOM_NO,
       CCL_BOM_IMG_SEQ_NO,
       SEQ_NO,
       DECODE(IMG_RGS_TP, '2', '모바일', 'PC') IMG_RGS_TP,
       IMG_ADR,
       IMG_NM,
       TO_CHAR(CCL_BOM_RGS_DH, 'YYYY-MM-DD') CCL_BOM_RGS_DH,
       CCL_BOM_RGS_PRS_ID,
       IMG_NM CHK_IMG_NM,
       './'||REPLACE(SUBSTR(IMG_ADR, instr(IMG_ADR, 'IMG_UPLOAD')), '\', '/')||'/' CHK_IMG_ADR
FROM TB_C10_CCL_BOM_IMG
WHERE CCL_BOM_NO = :CCL_BOM_NO
AND CCL_BOM_IMG_SEQ_NO = :CCL_BOM_IMG_SEQ_NO
AND PRD_SPC_TP = '3' 
ORDER BY CCL_BOM_NO, CCL_BOM_IMG_SEQ_NO, SEQ_NO
		 ]]> 
	 </query>
</queryMap>
