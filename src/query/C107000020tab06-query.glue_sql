<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab06 Page 쿼리파일"> 
	 <query id="C107000020tab06.select" desc="C107000020tab06 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT 
 DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 PRD_NM_CD
,DATAS010.MD_MRG_BAS_KEY_CHAR_TP_2 GW_ASG_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_1 SPC_GW_KS
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_2 SPC_GW_JIS
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_3 SPC_GW_ASTM
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_4 SPC_GW_ISO
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_5 SPC_GW_EU
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_6 SPC_GW_AS
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_1 WK_GW_TRV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_2 WK_GW_TRV_FRN
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_3 WK_GW_TRV_BAK
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_4 WK_GW_FRN_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_5 WK_GW_FRN_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_6 WK_GW_BAK_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_7 WK_GW_BAK_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_8 WK_GW_TOT_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_9 WK_GW_TOT_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_10 GAL_THK_LLV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_11 GAL_THK_ULV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_12 GAL_THK_TRV
,DATAS010.MD_MRG_BAS_DATA_NUM_TP_13 SPC_GAL_THK
FROM M00APUSER.TB_M00_DATAS010 DATAS010,
(SELECT MDL_DEFINE_ID 
FROM M00APUSER.TB_M00_DEFINES010
WHERE MDL_DEFINE_NM='C10A1061'
AND START_ACTIVE_DATE <=  SYSDATE
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
 AND DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 LIKE '%'||:SEARCH_CD||'%'
ORDER BY MD_MRG_BAS_KEY_CHAR_TP_1,MD_MRG_BAS_KEY_CHAR_TP_2
		 ]]> 
	 </query>
</queryMap>
