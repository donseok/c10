<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000050 Page 쿼리파일"> 
	 <query id="C106000050.colorselect" desc="칼라부자재코드조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C10 칼라코드관리- 칼라코드조회 C106000050.colorselect 김종범 */ 
       DECODE(A.USE_YN,'Y','1','N','0') AS USE_YN,--사용여부
       A.CLR_SUB_MTL_CD,
       A.CLR_NM,
       A.SUB_MTL_TP,
       A.SUB_MTL_TP AS SUB_MTL_TP_HIDDEN,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='SUB_MTL_TP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = SUB_MTL_TP) SUB_MTL_TP_NM,
       RSN_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP) RSN_TP_NM,
       RSN_TP_QT_BR,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP_QT_BR'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP_QT_BR) RSN_TP_QT_BR_NM,
       LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LUS_RT_CD) LUS_RT_NM,
       LUS_RT_LLV,
       LUS_RT_ULV,
       TP_CD,
       RL_LUS_RT,
       DECODE(EX_YN,'Y','1','N','0') AS EX_YN,
       COL_DIF_STD,
       DECODE(EX_YN1,'Y','1','N','0') AS EX_YN1,
       WK_VISCO,
       PNT_FLM_THK,
       PRT_INK_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PRT_INK_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PRT_INK_TP) PRT_INK_TP_NM,
       NV,
       PNT_GRA,
       SLV_GRA,
       THR_CD,
       PNT_UNT,
       PMT,
       QT_L,
       QT_A,
       QT_B,
       STD_CLR_NM,
       LMN_KND_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_KND_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_KND_TP) LMN_KND_TP_NM,
       LMN_BND_CD,
       LMN_BND_THR_CD,
       LMN_BND_CD1,
       LMN_BND_THR_CD1,
       LMN_FLM_THK_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_FLM_THK_CD) LMN_FLM_THK_CD_NM,  --Lamina필름두께코드
       PTT_FLM_LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_LUS_RT_CD) PTT_FLM_LUS_RT_NM,
       PTT_FLM_THK_CD,
      (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_THK_CD) PTT_FLM_THK_NM,
       PTT_FLM_MQL_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_MQL_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_MQL_CD) PTT_FLM_MQL_NM,
       PTT_FLM_SUS_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_SUS_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_SUS_ADH_CD) PTT_FLM_SUS_ADH_NM,
       PTT_FLM_PRD_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_PRD_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_PRD_ADH_CD) PTT_FLM_PRD_ADH_NM,
       RMRK,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.CREATED_OBJECT_ID) AS RGS_PRS_ID,
       TO_CHAR(RGS_DH, 'YYYY-MM-DD HH24:MI:SS') AS RGS_DH,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.LAST_UPDATED_OBJECT_ID)AS MDF_PRS_ID,
       TO_CHAR(CLR_MDF_DH, 'YYYY-MM-DD HH24:MI:SS') AS CLR_MDF_DH,
       MGR_CLR_SUB_MTL_CD,
       CLR_SUB_MTL_CD_OLD,
       RSN_TP_OLD,
       LUS_RT_CD_OLD,
       PNT_FLM_THK_OLD,
       TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS') AS ERP_SND_DH,  --ERP전송일시 추가
       MOD_YN,
       RAL_CD, 
       CASE
        WHEN TO_CHAR(A.LAST_UPDATE_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS') > NVL(TO_CHAR(A.ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS'),'1900-01-01 00:00:00')THEN 'Y'
        ELSE 'N'
        END SND_LST,
        '' as USERNO,
        RSN_TP_QT,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP_QT'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP_QT) RSN_TP_QT_NM,
        PAT_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PAT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PAT_CD) PAT_CD_NM,
        FUNC_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='FUNC_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = FUNC_CD) FUNC_CD_NM,
        TTE_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='TTE_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = TTE_CD) TTE_CD_NM,
        USE_POS_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='USE_POS_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = USE_POS_CD) USE_POS_CD_NM,
        WTY_YN,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='WTY_YN'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = WTY_YN) WTY_YN_NM,
        LAMINA_INS_YN,
        PUR_CHR_CFM,
        NVL(B.IMAGE_YN,'N') AS MIMAGE_YN,
        NVL(B.FILE_YN,'N')  AS MFILE_YN,
        (SELECT IMG_NM FROM C10APUSER.TB_C10_CLR_CD_IMG WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD AND PRD_SPC_TP = '9' AND ROWNUM = 1) AS PCM_SPEC_FILE1,
        (SELECT IMG_NM FROM C10APUSER.TB_C10_CLR_CD_IMG WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD AND PRD_SPC_TP = '0' AND ROWNUM = 1) AS COST_STM_FILE1,
        A.LAST_UPDATED_OBJECT_ID AS LAST_UPDATED_OBJECT_ID
  FROM C10APUSER.TB_C10_CLR_CD_MNG A,
       C10APUSER.TB_C10_CLR_CD_IMG_MNG B
 WHERE A.CLR_SUB_MTL_CD = B.CLR_SUB_MTL_CD(+)
   AND NVL(A.CLR_SUB_MTL_CD,'%') LIKE  :CLR_SUB_MTL_CD_SH ||'%'
   AND NVL(A.SUB_MTL_TP,'%') LIKE '%' || DECODE(:SUB_MTL_TP_SH,'all','%',:SUB_MTL_TP_SH) ||'%'
   AND NVL(A.TP_CD,'%') LIKE '%' || :TP_CD ||'%'
   AND NVL(A.RSN_TP,'%') LIKE '%' || :RSN_TP_SH ||'%'
   AND NVL(A.RSN_TP_QT_BR,'%') LIKE '%' || :RSN_TP_QT_BR_SH ||'%'
   AND NVL(A.LUS_RT_CD,'%') LIKE '%' || :LUS_RT_CD_SH ||'%'
   AND NVL(A.PRT_INK_TP,'%') LIKE '%' || :PRT_INK_TP_SH ||'%'
   AND (NVL(A.RAL_CD,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || UPPER(:RAL_CD||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || LOWER(:RAL_CD||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_SUB_MTL_CD_OLD,'%') LIKE '%' || :RAL_CD ||'%')
		 ]]> 
	 </query>
	 <query id="C106000050.colorupdate" desc="칼라코드정보 수정" isNamed="true">
		 <![CDATA[ 
UPDATE /* C10 품질설계 칼라코드관리 C106000050.colorupdate 김종범 */ 
TB_C10_CLR_CD_MNG SET 
	CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD,--칼라부자재코드
	CLR_NM = :CLR_NM,--색상명
	SUB_MTL_TP = :SUB_MTL_TP,--부자재구분
	RSN_TP = :RSN_TP,--수지타입
	LUS_RT_CD = :LUS_RT_CD,--광택도코드
	LUS_RT_LLV = :LUS_RT_LLV,--광택도하한값
	LUS_RT_ULV = :LUS_RT_ULV,--광택도상한값
	WK_VISCO = :WK_VISCO,--작업점도
	PNT_FLM_THK = :PNT_FLM_THK,--도막두께
	PRT_INK_TP = :PRT_INK_TP,--PrintInkType
	NV = :NV,--고형분
	PNT_GRA = :PNT_GRA,--도료비중
	SLV_GRA = :SLV_GRA,--용재비중
	THR_CD = :THR_CD,--신나코드
	PNT_UNT = :PNT_UNT,--도료원단위
	PMT = :PMT,--PMT
	QT_L = :QT_L,--L
	QT_A = :QT_A,--A
	QT_B = :QT_B,--B
	STD_CLR_NM = :STD_CLR_NM,--표준색상명
	LMN_KND_TP = :LMN_KND_TP,--Lamina유형
	LMN_BND_CD = :LMN_BND_CD,--Lamina접착제코드
	LMN_BND_THR_CD = :LMN_BND_THR_CD,--Lamina접착제신나코드
	LMN_BND_CD1 = :LMN_BND_CD1,--Lamina접착제코드1
	LMN_BND_THR_CD1 = :LMN_BND_THR_CD1,--Lamina접착제신나코드1
	LMN_FLM_THK_CD = :LMN_FLM_THK_CD,--Lamina필름두께코드
	PTT_FLM_LUS_RT_CD = :PTT_FLM_LUS_RT_CD,--보호필름광택코드
	PTT_FLM_THK_CD = :PTT_FLM_THK_CD,--보호필름두께코드
	PTT_FLM_MQL_CD = :PTT_FLM_MQL_CD,--보호필름재질코드
	PTT_FLM_SUS_ADH_CD = :PTT_FLM_SUS_ADH_CD,--보호필름SUS점착력코드
	PTT_FLM_PRD_ADH_CD = :PTT_FLM_PRD_ADH_CD,--보호필름제품점착력코드
	RMRK = :RMRK,--비고
	RL_LUS_RT = :RL_LUS_RT,
	EX_YN = DECODE(:EX_YN,'1','Y','N'),
	COL_DIF_STD = :COL_DIF_STD,
	EX_YN1 = DECODE(:EX_YN1,'1','Y','N'),
	TP_CD = :TP_CD,
	RSN_TP_QT = :RSN_TP_QT,
	PAT_CD = :PAT_CD,
	FUNC_CD = :FUNC_CD,
	TTE_CD = :TTE_CD,
	USE_POS_CD = :USE_POS_CD,
	WTY_YN = :WTY_YN,
       RSN_TP_QT_BR = :RSN_TP_QT_BR,
	MDF_PRS_ID = :ObjectId, 
	CLR_MDF_DH = SYSDATE,
	USE_YN = DECODE(:USE_YN,'1','Y','Y','Y','N'),--사용여부
	MGR_CLR_SUB_MTL_CD = :MGR_CLR_SUB_MTL_CD, --통합컬러코드
	CLR_SUB_MTL_CD_OLD = :CLR_SUB_MTL_CD_OLD,--구칼라부자재코드
	RSN_TP_OLD = :RSN_TP_OLD,--구수지타입
	LUS_RT_CD_OLD = :LUS_RT_CD_OLD,--구광택도코드
	PNT_FLM_THK_OLD = :PNT_FLM_THK_OLD,--구도막두께
	MOD_YN = :MOD_YN,
	RAL_CD = :RAL_CD,
	LAMINA_INS_YN = :LAMINA_INS_YN,
	LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
	LAST_UPDATED_OBJECT_ID=:ObjectId,      
	LAST_UPDATE_PROGRAM_ID=:ProgramId,     
	LAST_UPDATE_TIMESTAMP=:Timestamp   
WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.colordelete" desc="칼라코드정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 칼라코드관리 C106000050.colordelete 김종범 */ 
FROM TB_C10_CLR_CD_MNG 
WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.colorinsert" desc="칼라코드정보 추가" isNamed="true">
		 <![CDATA[ 
INSERT INTO TB_C10_CLR_CD_MNG/* C10 품질설계 칼라코드관리 C106000050.colorinsert 김종범 */ (
    CLR_SUB_MTL_CD,--칼라부자재코드
    CLR_NM,--색상명
    SUB_MTL_TP,--부자재구분
    RSN_TP,--수지타입
    LUS_RT_CD,--광택도코드
    LUS_RT_LLV,--광택도하한값
    LUS_RT_ULV,--광택도상한값
    WK_VISCO,--작업점도
    PNT_FLM_THK,--도막두께
    PRT_INK_TP,--PrintInkType
    NV,--고형분
    PNT_GRA,--도료비중
    SLV_GRA,--용재비중
    THR_CD,--신나코드
    PNT_UNT,--도료원단위
    PMT,--PMT
    QT_L,--L
    QT_A,--A
    QT_B,--B
    STD_CLR_NM,--표준색상명
    LMN_KND_TP,--Lamina유형
    LMN_BND_CD,--Lamina접착제코드
    LMN_BND_THR_CD,--Lamina접착제신나코드
    LMN_BND_CD1,--Lamina접착제코드1
    LMN_BND_THR_CD1,--Lamina접착제신나코드1
    LMN_FLM_THK_CD,--Lamina필름두께코드
    PTT_FLM_LUS_RT_CD,--보호필름광택코드
    PTT_FLM_THK_CD,--보호필름두께코드
    PTT_FLM_MQL_CD,--보호필름재질코드
    PTT_FLM_SUS_ADH_CD,--보호필름SUS점착력코드
    PTT_FLM_PRD_ADH_CD,--보호필름제품점착력코드
    RMRK,--비고
    RGS_PRS_ID,--등록자
    RGS_DH,--등록일
    MDF_PRS_ID,--수정자
    CLR_MDF_DH,--수정일 
    MGR_CLR_SUB_MTL_CD, --통합컬러코드  
    CLR_SUB_MTL_CD_OLD,--구칼라부자재코드
    RSN_TP_OLD,--구수지타입
    LUS_RT_CD_OLD,--구광택도코드
    PNT_FLM_THK_OLD,--구도막두께
    USE_YN,--사용여부
    RAL_CD,
    RL_LUS_RT,
    EX_YN,
    COL_DIF_STD,
    EX_YN1,
    TP_CD,
    RSN_TP_QT,
    PAT_CD,
    FUNC_CD,
    TTE_CD,
    USE_POS_CD,
    WTY_YN,
    LAMINA_INS_YN,
    RSN_TP_QT_BR,
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
    :CLR_SUB_MTL_CD,--칼라부자재코드
    :CLR_NM,--색상명
    :SUB_MTL_TP,--부자재구분
    :RSN_TP,--수지타입
    :LUS_RT_CD,--광택도코드
    :LUS_RT_LLV,--광택도하한값
    :LUS_RT_ULV,--광택도상한값
    :WK_VISCO,--작업점도
    :PNT_FLM_THK,--도막두께
    :PRT_INK_TP,--PrintInkType
    :NV,--고형분
    :PNT_GRA,--도료비중
    :SLV_GRA,--용재비중
    :THR_CD,--신나코드
    :PNT_UNT,--도료원단위
    :PMT,--PMT
    :QT_L,--L
    :QT_A,--A
    :QT_B,--B
    :STD_CLR_NM,--표준색상명
    :LMN_KND_TP,--Lamina유형
    :LMN_BND_CD,--Lamina접착제코드
    :LMN_BND_THR_CD,--Lamina접착제신나코드
    :LMN_BND_CD1,--Lamina접착제코드
    :LMN_BND_THR_CD1,--Lamina접착제신나코드
    :LMN_FLM_THK_CD,--Lamina필름두께코드
    :PTT_FLM_LUS_RT_CD,--보호필름광택코드
    :PTT_FLM_THK_CD,--보호필름두께코드
    :PTT_FLM_MQL_CD,--보호필름재질코드
    :PTT_FLM_SUS_ADH_CD,--보호필름SUS점착력코드
    :PTT_FLM_PRD_ADH_CD,--보호필름제품점착력코드
    :RMRK,--비고
    :ObjectId, --RGS_PRS_ID등록자
    SYSDATE,--등록일
    :ObjectId,--MDF_PRS_ID수정자
    SYSDATE,--수정일
    :MGR_CLR_SUB_MTL_CD, --통합컬러코드
    :CLR_SUB_MTL_CD_OLD,--구칼라부자재코드
    :RSN_TP_OLD,--구수지타입
    :LUS_RT_CD_OLD,--구광택도코드
    :PNT_FLM_THK_OLD,--구도막두께
    DECODE(:USE_YN,'1','Y','N'),--사용여부
    :RAL_CD,
    :RL_LUS_RT,
    DECODE(:EX_YN,'1','Y','N'),
    :COL_DIF_STD,
    DECODE(:EX_YN1,'1','Y','N'),
    :TP_CD,
    :RSN_TP_QT,
    :PAT_CD,
    :FUNC_CD,
    :TTE_CD,
    :USE_POS_CD,
    :WTY_YN,
    :LAMINA_INS_YN,
    :RSN_TP_QT_BR,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp
)
		 ]]> 
	 </query>
	 <query id="C106000050.cclbomupdate" desc="cclbom 수정" isNamed="true">
