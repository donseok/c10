       LUS_RT_FRN_4COT_LLV = decode(HUE_CD_FRN_4COT, :CLR_SUB_MTL_CD, :LUS_RT_LLV, LUS_RT_FRN_4COT_LLV),
       LUS_RT_BAK_1COT_LLV = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :LUS_RT_LLV, LUS_RT_BAK_1COT_LLV),
       LUS_RT_BAK_2COT_LLV = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :LUS_RT_LLV, LUS_RT_BAK_2COT_LLV),
       LUS_RT_BAK_3COT_LLV = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :LUS_RT_LLV, LUS_RT_BAK_3COT_LLV),
       LUS_RT_BAK_4COT_LLV = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :LUS_RT_LLV, LUS_RT_BAK_4COT_LLV),
       LUS_RT_FRN_1COT_ULV = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :LUS_RT_ULV, LUS_RT_FRN_1COT_ULV),
       LUS_RT_FRN_2COT_ULV = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :LUS_RT_ULV, LUS_RT_FRN_2COT_ULV),
       LUS_RT_FRN_3COT_ULV = decode(HUE_CD_FRN_3COT, :CLR_SUB_MTL_CD, :LUS_RT_ULV, LUS_RT_FRN_3COT_ULV),
       LUS_RT_FRN_4COT_ULV = decode(HUE_CD_FRN_4COT, :CLR_SUB_MTL_CD, :LUS_RT_ULV, LUS_RT_FRN_4COT_ULV),
       LUS_RT_BAK_1COT_ULV = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :LUS_RT_ULV, LUS_RT_BAK_1COT_ULV),
       LUS_RT_BAK_2COT_ULV = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :LUS_RT_ULV, LUS_RT_BAK_2COT_ULV),
       LUS_RT_BAK_3COT_ULV = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :LUS_RT_ULV, LUS_RT_BAK_3COT_ULV),
       LUS_RT_BAK_4COT_ULV = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :LUS_RT_ULV, LUS_RT_BAK_4COT_ULV),
       WK_VISCO_FRN_1COT = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :WK_VISCO, WK_VISCO_FRN_1COT),
       WK_VISCO_FRN_2COT = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :WK_VISCO, WK_VISCO_FRN_2COT),
