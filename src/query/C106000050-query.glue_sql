       LUS_RT_FRN_1COT_LLV = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :LUS_RT_LLV, LUS_RT_FRN_1COT_LLV),
       LUS_RT_FRN_2COT_LLV = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :LUS_RT_LLV, LUS_RT_FRN_2COT_LLV),
