       WK_VISCO_BAK_1COT = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :WK_VISCO, WK_VISCO_BAK_1COT),
       WK_VISCO_BAK_2COT = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :WK_VISCO, WK_VISCO_BAK_2COT),
       WK_VISCO_BAK_3COT = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :WK_VISCO, WK_VISCO_BAK_3COT),
       WK_VISCO_BAK_4COT = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :WK_VISCO, WK_VISCO_BAK_4COT),
       NV_FRN_1COT = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :NV, NV_FRN_1COT),
       NV_FRN_2COT = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :NV, NV_FRN_2COT),
       NV_FRN_3COT = decode(HUE_CD_FRN_3COT, :CLR_SUB_MTL_CD, :NV, NV_FRN_3COT),
       NV_FRN_4COT = decode(HUE_CD_FRN_4COT, :CLR_SUB_MTL_CD, :NV, NV_FRN_4COT),
       NV_BAK_1COT = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :NV, NV_BAK_1COT),
       NV_BAK_2COT = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :NV, NV_BAK_2COT),
       NV_BAK_3COT = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :NV, NV_BAK_3COT),
       NV_BAK_4COT = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :NV, NV_BAK_4COT),
       PNT_GRA_FRN_1COT = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :PNT_GRA, PNT_GRA_FRN_1COT),
       PNT_GRA_FRN_2COT = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :PNT_GRA, PNT_GRA_FRN_2COT),
       PNT_GRA_FRN_3COT = decode(HUE_CD_FRN_3COT, :CLR_SUB_MTL_CD, :PNT_GRA, PNT_GRA_FRN_3COT),
       PNT_GRA_FRN_4COT = decode(HUE_CD_FRN_4COT, :CLR_SUB_MTL_CD, :PNT_GRA, PNT_GRA_FRN_4COT),
       PNT_GRA_BAK_1COT = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :PNT_GRA, PNT_GRA_BAK_1COT),
       PNT_GRA_BAK_2COT = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :PNT_GRA, PNT_GRA_BAK_2COT),
       PNT_GRA_BAK_3COT = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :PNT_GRA, PNT_GRA_BAK_3COT),
       PNT_GRA_BAK_4COT = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :PNT_GRA, PNT_GRA_BAK_4COT),
       SLV_GRA_FRN_1COT = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :SLV_GRA, SLV_GRA_FRN_1COT),
       SLV_GRA_FRN_2COT = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :SLV_GRA, SLV_GRA_FRN_2COT),
       SLV_GRA_FRN_3COT = decode(HUE_CD_FRN_3COT, :CLR_SUB_MTL_CD, :SLV_GRA, SLV_GRA_FRN_3COT),
       SLV_GRA_FRN_4COT = decode(HUE_CD_FRN_4COT, :CLR_SUB_MTL_CD, :SLV_GRA, SLV_GRA_FRN_4COT),
       SLV_GRA_BAK_1COT = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :SLV_GRA, SLV_GRA_BAK_1COT),
       SLV_GRA_BAK_2COT = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :SLV_GRA, SLV_GRA_BAK_2COT),
       SLV_GRA_BAK_3COT = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :SLV_GRA, SLV_GRA_BAK_3COT),
       SLV_GRA_BAK_4COT = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :SLV_GRA, SLV_GRA_BAK_4COT),
       THR_CD_FRN_1COT = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :THR_CD, THR_CD_FRN_1COT),
       THR_CD_FRN_2COT = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :THR_CD, THR_CD_FRN_2COT),
       THR_CD_FRN_3COT = decode(HUE_CD_FRN_3COT, :CLR_SUB_MTL_CD, :THR_CD, THR_CD_FRN_3COT),
       THR_CD_FRN_4COT = decode(HUE_CD_FRN_4COT, :CLR_SUB_MTL_CD, :THR_CD, THR_CD_FRN_4COT),
       THR_CD_BAK_1COT = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :THR_CD, THR_CD_BAK_1COT),
       THR_CD_BAK_2COT = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :THR_CD, THR_CD_BAK_2COT),
       THR_CD_BAK_3COT = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :THR_CD, THR_CD_BAK_3COT),
       THR_CD_BAK_4COT = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :THR_CD, THR_CD_BAK_4COT),
       PNT_UNT_FRN_1COT = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :PNT_UNT, PNT_UNT_FRN_1COT),
       PNT_UNT_FRN_2COT = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :PNT_UNT, PNT_UNT_FRN_2COT),
       PNT_UNT_FRN_3COT = decode(HUE_CD_FRN_3COT, :CLR_SUB_MTL_CD, :PNT_UNT, PNT_UNT_FRN_3COT),
       PNT_UNT_FRN_4COT = decode(HUE_CD_FRN_4COT, :CLR_SUB_MTL_CD, :PNT_UNT, PNT_UNT_FRN_4COT),
       PNT_UNT_BAK_1COT = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :PNT_UNT, PNT_UNT_BAK_1COT),
       PNT_UNT_BAK_2COT = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :PNT_UNT, PNT_UNT_BAK_2COT),
       PNT_UNT_BAK_3COT = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :PNT_UNT, PNT_UNT_BAK_3COT),
       PNT_UNT_BAK_4COT = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :PNT_UNT, PNT_UNT_BAK_4COT),
       PMT_FRN_1COT = decode(HUE_CD_FRN_1COT, :CLR_SUB_MTL_CD, :PMT, PMT_FRN_1COT),
       PMT_FRN_2COT = decode(HUE_CD_FRN_2COT, :CLR_SUB_MTL_CD, :PMT, PMT_FRN_2COT),
       PMT_FRN_3COT = decode(HUE_CD_FRN_3COT, :CLR_SUB_MTL_CD, :PMT, PMT_FRN_3COT),
       PMT_FRN_4COT = decode(HUE_CD_FRN_4COT, :CLR_SUB_MTL_CD, :PMT, PMT_FRN_4COT),
       PMT_BAK_1COT = decode(HUE_CD_BAK_1COT, :CLR_SUB_MTL_CD, :PMT, PMT_BAK_1COT),
       PMT_BAK_2COT = decode(HUE_CD_BAK_2COT, :CLR_SUB_MTL_CD, :PMT, PMT_BAK_2COT),
       PMT_BAK_3COT = decode(HUE_CD_BAK_3COT, :CLR_SUB_MTL_CD, :PMT, PMT_BAK_3COT),
       PMT_BAK_4COT = decode(HUE_CD_BAK_4COT, :CLR_SUB_MTL_CD, :PMT, PMT_BAK_4COT),
       LMN_FLM_THK_CD = decode(HUE_CD_LMN, :CLR_SUB_MTL_CD, :LMN_FLM_THK_CD, LMN_FLM_THK_CD),
       LAST_UPDATED_OBJECT_TYPE = :ObjectType,  
       LAST_UPDATED_OBJECT_ID   = :ObjectId,      
       LAST_UPDATE_PROGRAM_ID   = :ProgramId,     
       LAST_UPDATE_TIMESTAMP    = :Timestamp  
where  :CLR_SUB_MTL_CD in (HUE_CD_FRN_1COT, HUE_CD_FRN_2COT, HUE_CD_FRN_3COT, HUE_CD_FRN_4COT,
                           HUE_CD_BAK_1COT, HUE_CD_BAK_2COT, HUE_CD_BAK_3COT, HUE_CD_BAK_4COT, HUE_CD_LMN)
		 ]]> 
	 </query>
	 <query id="C106000050.detailselect" desc="상세조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT 
       DECODE(USE_YN,'Y','1','N','0') AS USE_YN,--사용여부
       CLR_SUB_MTL_CD,--칼라부재료코드
       PNT_CMP_CD,--도료업체코드
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PNT_CMP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PNT_CMP_CD) PNT_CMP_NM,--도료업체코드(마스터)
       NV,--고형분
       PNT_GRA,--도료비중
       SLV_GRA,--용재비중
       PNT_UNT,--도료원단위
       DECODE(USE_YN,'Y','1','N','0') AS USE_YN_BAK, --사용여부
       '' MOD_YN_BAK ,--수정여부
       PTC_YN  , -- 입자유무
       PTC_TYPE , --입자TYPE
       TEX_KND , --질감종류
       PTC_MIN , --입자MIN
       PTC_MAX , --입자MAX
       PTC_AVG , --입자AVG
       CMT , --비고
       QUE_MIN , --소광제MIN
       QUE_MAX , --소광제 MAX
       QUE_AVG ,  --소광제AVG
       (SELECT (CASE WHEN COUNT(1) > 0 THEN 'Y'
                     ELSE 'N' END)
          FROM C10APUSER.TB_C10_CLR_CMP_MNG_FILE
         WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD
           AND PNT_CMP_CD = A.PNT_CMP_CD) DOC_YN,
       CCL_TXT,  -- 2020.5.19 추가
       (SELECT SUBSTR(REV_DD,1,4)||'-'||SUBSTR(REV_DD,5,2)||'-'||SUBSTR(REV_DD,7,2)
          FROM C10APUSER.TB_C10_CLR_CMP_MNG_FILE
         WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD
           AND PNT_CMP_CD = A.PNT_CMP_CD) REV_DD
 FROM TB_C10_CLR_CMP_MNG A
 WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.detaildelete" desc="" isNamed="true">
		 <![CDATA[ 
DELETE /*+ C10 품질설계 칼라코드관리 C106000050.colordelete 김종범 */ 
FROM TB_C10_CLR_CMP_MNG 
WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
    AND PNT_CMP_CD = :PNT_CMP_CD
		 ]]> 
	 </query>
	 <query id="IFB10S0130.insert" desc="" isNamed="true">
		 <![CDATA[ 
INSERT INTO /* C10 칼라부자재코드전송IF TB_C10_B10S0130.insert 김종범*/
            TB_C10_B10S0130
            (
                  IF_GRP_ID
                 ,SEQ_NO   
                 ,XSEQ       
                 ,XCRUD  
                 ,XSTAT
                 ,ITM_TP  
                 ,ITM_CD
                 ,ITM_NM
                 ,MAK_CD
                 ,MAK_NM
                 ,RSN_TP
                 ,RSN_NM
                 ,LUS_RT_CD
                 ,LUS_RT_NM
                 ,INK_TP
                 ,INK_NM
                 ,PTT_FLM_MQL_CD
                 ,PTT_FLM_MQL_NM
                 ,PTT_FLM_THK_CD
                 ,PTT_FLM_THK_NM
                 ,PTT_FLM_SUS_ADH_CD
                 ,PTT_FLM_SUS_ADH_NM
                 ,PTT_FLM_PRD_ADH_CD
                 ,PTT_FLM_PRD_ADH_NM
                 ,PNT_CMP_USE_YN
                 ,MOD_YN
                 ,RSN_TP_QT
                 ,RSN_TP_QT_NM
                 ,PAT_CD
                 ,PAT_CD_NM
                 ,FUNC_CD
                 ,FUNC_CD_NM
                 ,TTE_CD
                 ,TTE_CD_NM
                 ,USE_POS_CD
                 ,USE_POS_CD_NM
                 ,WTY_YN
                 ,WTY_YN_NM
                 ,RSN_TP_QT_BR
                 ,RSN_TP_QT_BR_NM
                 ,PCM_SPEC_FILE1
                 ,COST_STM_FILE1
                 ,RGS_PRS_ID 
                 ,CREATED_OBJECT_TYPE         
                 ,CREATED_OBJECT_ID        
                 ,CREATED_PROGRAM_ID      
                 ,CREATION_TIMESTAMP     
                 ,LAST_UPDATED_OBJECT_TYPE
                 ,LAST_UPDATED_OBJECT_ID  
                 ,LAST_UPDATE_PROGRAM_ID  
                 ,LAST_UPDATE_TIMESTAMP     
            )
VALUES
            (
              :IF_GRP_ID,
              SQ_C10_B10S0130.NEXTVAL,
	          '1',
              'C',
              'R',
              :SUB_MTL_TP,
              :CLR_SUB_MTL_CD,
              :CLR_NM,
              :PNT_CMP_CD,
              :PNT_CMP_NM,
              :RSN_TP,
              :RSN_TP_NM,
              :LUS_RT_CD,
              :LUS_RT_NM,
              :PRT_INK_TP,
              :PRT_INK_TP_NM,
              :PTT_FLM_MQL_CD,
              :PTT_FLM_MQL_NM,
              :PTT_FLM_THK_CD,
              :PTT_FLM_THK_NM,
              :PTT_FLM_SUS_ADH_CD,
              :PTT_FLM_SUS_ADH_NM,
              :PTT_FLM_PRD_ADH_CD,
              :PTT_FLM_PRD_ADH_NM,
              DECODE(:USE_YN,'1','Y','N'),
              :MOD_YN,
              :RSN_TP_QT,
              :RSN_TP_QT_NM,
              :PAT_CD,
              :PAT_CD_NM,
              :FUNC_CD,
              :FUNC_CD_NM,
              :TTE_CD,
              :TTE_CD_NM,
              :USE_POS_CD,
              :USE_POS_CD_NM,
              :WTY_YN,
              :WTY_YN_NM,
              :RSN_TP_QT_BR,
              :RSN_TP_QT_BR_NM,
              :PCM_SPEC_FILE1,
              :COST_STM_FILE1,
              :LAST_UPDATED_OBJECT_ID, 
              :ObjectType,
              :ObjectId,
              :ProgramId,
              :Timestamp,
              :ObjectType,
              :ObjectId,
              :ProgramId,
              :Timestamp
            )
		 ]]> 
	 </query>
	 <query id="C106000050.detailupdate" desc="도료사코드업데이트" isNamed="true">
		 <![CDATA[ 
UPDATE TB_C10_CLR_CMP_MNG
      SET   USE_YN = DECODE(:USE_YN,'1','Y','Y','Y','N'),--사용여부
            NV =:NV, --고형분
            PNT_GRA =:PNT_GRA, --도료비중
            SLV_GRA =:SLV_GRA, --용재비중
            PNT_UNT =:PNT_UNT,  --도료원단위
            PTC_YN  =:PTC_YN , -- 입자유무
            PTC_TYPE =:PTC_TYPE, --입자TYPE
            TEX_KND =:TEX_KND, --질감종류
            PTC_MIN =:PTC_MIN, --입자MIN
            PTC_MAX =:PTC_MAX, --입자MAX
            PTC_AVG =:PTC_AVG, --입자AVG
            CMT =:CMT, --비고
            QUE_MIN =:QUE_MIN, --소광제MIN
            QUE_MAX =:QUE_MAX, --소광제 MAX
            QUE_AVG  =:QUE_AVG, --소광제AVG
            CCL_TXT =:CCL_TXT,  -- CCL텍스트
	     LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
	     LAST_UPDATED_OBJECT_ID=:ObjectId,      
	     LAST_UPDATE_PROGRAM_ID=:ProgramId,     
	     LAST_UPDATE_TIMESTAMP=:Timestamp            
WHERE  CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
            AND PNT_CMP_CD =:PNT_CMP_CD
		 ]]> 
	 </query>
	 <query id="C106000050.detailinsert" desc="" isNamed="true">
		 <![CDATA[ 
INSERT INTO TB_C10_CLR_CMP_MNG/*+ C10 품질설계 칼라코드관리 C106000050.detailinsert 김종범 */ (
    CLR_SUB_MTL_CD,--칼라부재료코드
    PNT_CMP_CD,--도료업체코드
    NV,--고형분
    PNT_GRA,--도료비중
    SLV_GRA,--용재비중
    PNT_UNT,--도료원단위
    USE_YN,--사용여부
    PTC_YN  , -- 입자유무
    PTC_TYPE , --입자TYPE
    TEX_KND , --질감종류
    PTC_MIN , --입자MIN
    PTC_MAX , --입자MAX9
    PTC_AVG , --입자AVG
    CMT , --비고
    QUE_MIN , --소광제MIN
    QUE_MAX , --소광제 MAX
    QUE_AVG  , --소광제AVG
    CCL_TXT,  --CCL TXT
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
    :CLR_SUB_MTL_CD,
    :PNT_CMP_CD,
    :NV,
    :PNT_GRA,
    :SLV_GRA,
    :PNT_UNT,
    DECODE(:USE_YN,'1','Y','N'),--사용여부  
    :PTC_YN  , -- 입자유무
    :PTC_TYPE , --입자TYPE
    :TEX_KND , --질감종류
    :PTC_MIN , --입자MIN
    :PTC_MAX , --입자MAX
    :PTC_AVG , --입자AVG
    :CMT , --비고
    :QUE_MIN , --소광제MIN
    :QUE_MAX , --소광제 MAX
    :QUE_AVG ,  --소광제AVG
    :CCL_TXT, -- CCLTXT
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp)
		 ]]> 
	 </query>
	 <query id="C106000050.colorAjaxFind" desc="C106000050.colorAjaxFind" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C10 칼라코드관리- 칼라코드AJAX조회 C106000050.colorAjaxFind 김종범 */ 
       CLR_SUB_MTL_CD,
       SUB_MTL_TP
FROM C10APUSER.TB_C10_CLR_CD_MNG
WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.DetailSendSelec" desc="전송 칼라코드업체조회 C106000050.DetailSendSelect 김종범" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 칼라코드관리- 칼라코드업체조회 C106000050.DetailSendSelect 김종범 */ 
       (SELECT (CASE WHEN CC.USE_YN = 'Y'THEN DECODE(BB.USE_YN,'Y','1','N','0')
                                                                   ELSE '0' END )
        FROM C10APUSER.TB_C10_CLR_CD_MNG CC
        WHERE CC.CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD) AS USE_YN,--사용여부
       CLR_SUB_MTL_CD,--칼라부재료코드
       PNT_CMP_CD,--도료업체코드
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PNT_CMP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PNT_CMP_CD) PNT_CMP_NM,--도료업체코드(마스터)
       NV,--고형분
       PNT_GRA,--도료비중
       SLV_GRA,--용재비중
       PNT_UNT--도료원단위
  FROM C10APUSER.TB_C10_CLR_CMP_MNG BB
 WHERE BB.CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.erp_snd_update" desc="ERP전송일시관리" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /* C10 품질설계 칼라코드관리 C106000050.erp_snd_update 김종범 */ 
TB_C10_CLR_CD_MNG SET 
ERP_SND_DH = sysdate + 0.5/1440
WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.colorupdate2" desc="도료사저장시 Color수정일 자동 업데이트" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 칼라코드관리 C106000050.colorupdate2 김종범 */ 
TB_C10_CLR_CD_MNG SET      
MDF_PRS_ID =  :ObjectId,
CLR_MDF_DH = SYSDATE,
LAST_UPDATED_OBJECT_TYPE=:ObjectType,  
LAST_UPDATED_OBJECT_ID=:ObjectId,      
LAST_UPDATE_PROGRAM_ID=:ProgramId,     
LAST_UPDATE_TIMESTAMP=:Timestamp 
WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.colorselect2" desc="칼라코드관리- 전송대상조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 칼라코드관리- 전송대상조회 C106000050.COLORSELECT2 김종범 */ 
       USE_YN,
       CLR_SUB_MTL_CD,
       CLR_NM,
       SUB_MTL_TP,
       SUB_MTL_TP_HIDDEN,
       SUB_MTL_TP_NM,
       RSN_TP,
       RSN_TP_NM,
       LUS_RT_CD,
       LUS_RT_NM,
       LUS_RT_LLV,
       LUS_RT_ULV,
       WK_VISCO,
       PNT_FLM_THK,
       PRT_INK_TP,
       PRT_INK_TP_NM,
       NV,
       PNT_GRA,
       SLV_GRA,
       THR_CD,
       PNT_UNT,
       PMT,
       QT_L,
       QT_A,
       QT_B,
       STD_CLR_NM,
       LMN_KND_TP,
       LMN_KND_TP_NM,
       LMN_BND_CD,
       LMN_BND_THR_CD,
       LMN_BND_CD1,
       LMN_BND_THR_CD1,
       LMN_FLM_THK_CD,
       LMN_FLM_THK_CD_NM,  --LAMINA필름두께코드
       PTT_FLM_LUS_RT_CD,
       PTT_FLM_LUS_RT_NM,
       PTT_FLM_THK_CD,
       PTT_FLM_THK_NM,
       PTT_FLM_MQL_CD,
       PTT_FLM_MQL_NM,
       PTT_FLM_SUS_ADH_CD,
       PTT_FLM_SUS_ADH_NM,
       PTT_FLM_PRD_ADH_CD,
       PTT_FLM_PRD_ADH_NM,
       RMRK,
       RGS_PRS_ID,
       RGS_DH,
       MDF_PRS_ID,
       CLR_MDF_DH,
       CLR_SUB_MTL_CD_OLD,
       RSN_TP_OLD,
       LUS_RT_CD_OLD,
       PNT_FLM_THK_OLD,
       ERP_SND_DH,   --ERP전송일시 추가
       LAST_UPDATE_TIMESTAMP,
       SND_LST
FROM (
SELECT 
       DECODE(USE_YN,'Y','1','N','0') AS USE_YN,--사용여부
       CLR_SUB_MTL_CD,
       CLR_NM,
       SUB_MTL_TP,
       SUB_MTL_TP AS SUB_MTL_TP_HIDDEN,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='SUB_MTL_TP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = SUB_MTL_TP) SUB_MTL_TP_NM,
       RSN_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP) RSN_TP_NM,
       LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LUS_RT_CD) LUS_RT_NM,
       LUS_RT_LLV,
       LUS_RT_ULV,
       WK_VISCO,
       PNT_FLM_THK,
       PRT_INK_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PRT_INK_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PRT_INK_TP) PRT_INK_TP_NM,
       NV,
       PNT_GRA,
       SLV_GRA,
       THR_CD,
       PNT_UNT,
       PMT,
       QT_L,
       QT_A,
       QT_B,
       STD_CLR_NM,
       LMN_KND_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_KND_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_KND_TP) LMN_KND_TP_NM,
       LMN_BND_CD,
       LMN_BND_THR_CD,
       LMN_BND_CD1,
       LMN_BND_THR_CD1,
       LMN_FLM_THK_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_FLM_THK_CD) LMN_FLM_THK_CD_NM,  --LAMINA필름두께코드
       PTT_FLM_LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_LUS_RT_CD) PTT_FLM_LUS_RT_NM,
       PTT_FLM_THK_CD,
      (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_THK_CD) PTT_FLM_THK_NM,
       PTT_FLM_MQL_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_MQL_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_MQL_CD) PTT_FLM_MQL_NM,
       PTT_FLM_SUS_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_SUS_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_SUS_ADH_CD) PTT_FLM_SUS_ADH_NM,
       PTT_FLM_PRD_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_PRD_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_PRD_ADH_CD) PTT_FLM_PRD_ADH_NM,
       RMRK,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = TB_C10_CLR_CD_MNG.CREATED_OBJECT_ID) AS RGS_PRS_ID,
       TO_CHAR(RGS_DH, 'YYYY-MM-DD') AS RGS_DH,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = TB_C10_CLR_CD_MNG.LAST_UPDATED_OBJECT_ID)AS MDF_PRS_ID,
       TO_CHAR(CLR_MDF_DH, 'YYYY-MM-DD HH24:MI:SS') AS CLR_MDF_DH,
       CLR_SUB_MTL_CD_OLD,
       RSN_TP_OLD,
       LUS_RT_CD_OLD,
       PNT_FLM_THK_OLD,
       TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS') AS ERP_SND_DH,   --ERP전송일시 추가
       LAST_UPDATE_TIMESTAMP,
        CASE
        WHEN TO_CHAR(LAST_UPDATE_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS') > NVL(TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS'),'1900-01-01 00:00:00')THEN 'Y'
        ELSE 'N'
        END SND_LST --전송대상건 구분
  FROM C10APUSER.TB_C10_CLR_CD_MNG 
 WHERE NVL(CLR_SUB_MTL_CD,'%') LIKE  :CLR_SUB_MTL_CD_SH ||'%'
   AND NVL(SUB_MTL_TP,'%') LIKE '%' || DECODE(:SUB_MTL_TP_SH,'all','%',:SUB_MTL_TP_SH) ||'%'
   AND NVL(TP_CD,'%') LIKE '%' || :TP_CD ||'%'
   AND NVL(RSN_TP,'%') LIKE '%' || :RSN_TP_SH ||'%'
   AND NVL(LUS_RT_CD,'%') LIKE '%' || :LUS_RT_CD_SH ||'%'
   AND NVL(PRT_INK_TP,'%') LIKE '%' || :PRT_INK_TP_SH ||'%'
   AND LAST_UPDATE_TIMESTAMP > NVL(ERP_SND_DH,TO_DATE('19000101000000', 'YYYYMMDD HH24MISS')))
WHERE SND_LST ='Y'
		 ]]> 
	 </query>
	 <query id="C106000050.updateModYn" desc="" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계 수지광택도수정여부 업데이트 C106000050.updateModYn 원성옥 */ 
C10APUSER.TB_C10_CLR_CD_MNG SET 
MOD_YN  = NULL,
MDF_PRS_ID =  :ObjectId,
CLR_MDF_DH = SYSDATE,
LAST_UPDATED_OBJECT_TYPE=:LAST_UPDATED_OBJECT_TYPE,  
LAST_UPDATED_OBJECT_ID=:LAST_UPDATED_OBJECT_ID,      
LAST_UPDATE_PROGRAM_ID=:LAST_UPDATE_PROGRAM_ID,     
LAST_UPDATE_TIMESTAMP=SYSTIMESTAMP
WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
   AND MOD_YN = 'M'
		 ]]> 
	 </query>
	 <query id="C106000050xls.select" desc="C106000050xls.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계 CCLBOM조회 C106000050xls.select 이돈석 */
DECODE(NVL(A.USE_YN,'N'),'Y','사용','N','미사용') AS USE_YN,
       A.CLR_SUB_MTL_CD,
       A.CLR_NM,
       A.SUB_MTL_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='SUB_MTL_TP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = SUB_MTL_TP) SUB_MTL_TP_NM,
       A.RSN_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP) RSN_TP_NM,
       A.LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LUS_RT_CD) LUS_RT_NM,
       A.LUS_RT_LLV,
       A.LUS_RT_ULV,
       A.RL_LUS_RT,
       A.WK_VISCO,
       A.PNT_FLM_THK,
       A.PRT_INK_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PRT_INK_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PRT_INK_TP) PRT_INK_TP_NM,
       A.NV,
       A.PNT_GRA,
       A.SLV_GRA,
       A.THR_CD,
       A.PNT_UNT,
       A.PMT,
       A.QT_L,
       A.QT_A,
       A.QT_B,
       A.STD_CLR_NM,
       A.LMN_KND_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_KND_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_KND_TP) LMN_KND_TP_NM,
       A.LMN_BND_CD,
       A.LMN_BND_THR_CD,
       A.LMN_BND_CD1,
       A.LMN_BND_THR_CD1,
       A.LMN_FLM_THK_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_FLM_THK_CD) LMN_FLM_THK_CD_NM,  --Lamina필름두께코드
       A.PTT_FLM_LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_LUS_RT_CD) PTT_FLM_LUS_RT_NM,
       A.PTT_FLM_THK_CD,
      (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_THK_CD) PTT_FLM_THK_NM,
       A.PTT_FLM_MQL_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_MQL_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_MQL_CD) PTT_FLM_MQL_NM,
       A.PTT_FLM_SUS_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_SUS_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_SUS_ADH_CD) PTT_FLM_SUS_ADH_NM,
       A.PTT_FLM_PRD_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_PRD_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_PRD_ADH_CD) PTT_FLM_PRD_ADH_NM,
       A.RMRK,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.CREATED_OBJECT_ID) AS RGS_PRS_ID,
       TO_CHAR(RGS_DH, 'YYYY-MM-DD HH24:MI:SS') AS RGS_DH,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.LAST_UPDATED_OBJECT_ID)AS MDF_PRS_ID,
       TO_CHAR(CLR_MDF_DH, 'YYYY-MM-DD HH24:MI:SS') AS CLR_MDF_DH,
       A.MGR_CLR_SUB_MTL_CD,
       A.CLR_SUB_MTL_CD_OLD,
       A.RSN_TP_OLD,
       A.LUS_RT_CD_OLD,
       A.PNT_FLM_THK_OLD,
       DECODE(NVL(B.USE_YN,'N'),'Y','사용','N','미사용') AS CMP_USE_YN,
       B.PNT_CMP_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PNT_CMP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PNT_CMP_CD) PNT_CMP_NM,
       B.NV, 
       B.PNT_GRA, 
       B.SLV_GRA, 
       B.PNT_UNT 
  FROM TB_C10_CLR_CD_MNG A,
       TB_C10_CLR_CMP_MNG B
 WHERE A.CLR_SUB_MTL_CD = B.CLR_SUB_MTL_CD(+)
		 ]]> 
	 </query>
	 <query id="C106000050.rule_chk" desc="C106000050.rule_chk" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C10 칼라코드관리- 수지 MTC Note 편집기준 Check C106000050.rule_chk 성낙원 */ 
        MPR_ACT_SUB_TST
from   M00APUSER.VI_M00_M20B3030
where  RSN_TP_FRN = :RSN_TP_FRN
  and  rownum = 1
		 ]]> 
	 </query>
	 <query id="C106000050.detailupsert_log" desc="C106000050.detailupsert_log" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO TB_C10_CLR_CMP_MNG_MDF_LOG/*+ C10 품질설계 칼라코드관리 C106000050.detailupsert_log 성낙원 */ (
    CLR_SUB_MTL_CD,--칼라부재료코드
    PNT_CMP_CD,--도료업체코드
    MDF_SEQ, --수정 Seq
    MDF_RSN, --수정 사유
    NV,--고형분
    PNT_GRA,--도료비중
    SLV_GRA,--용재비중
    PNT_UNT,--도료원단위
    USE_YN,--사용여부
    PTC_YN  , -- 입자유무
    PTC_TYPE , --입자TYPE
    TEX_KND , --질감종류
    PTC_MIN , --입자MIN
    PTC_MAX , --입자MAX9
    PTC_AVG , --입자AVG
    CMT , --비고
    QUE_MIN , --소광제MIN
    QUE_MAX , --소광제 MAX
    QUE_AVG  , --소광제AVG
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
    :CLR_SUB_MTL_CD,
    :PNT_CMP_CD,
    nvl((select max(mdf_seq)+1 from TB_C10_CLR_CMP_MNG_MDF_LOG where CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD and PNT_CMP_CD = :PNT_CMP_CD),0), --수정 Seq No
    :MDF_RSN, -- 수정 사유
    :NV,
    :PNT_GRA,
    :SLV_GRA,
    :PNT_UNT,
    DECODE(:USE_YN,'1','Y','N'),--사용여부  
    :PTC_YN  , -- 입자유무
    :PTC_TYPE , --입자TYPE
    :TEX_KND , --질감종류
    :PTC_MIN , --입자MIN
    :PTC_MAX , --입자MAX
    :PTC_AVG , --입자AVG
    :CMT , --비고
    :QUE_MIN , --소광제MIN
    :QUE_MAX , --소광제 MAX
    :QUE_AVG ,  --소광제AVG
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp)
		 ]]> 
	 </query>
	 <query id="C106000050.detaildelete_log" desc="C106000050.detaildelete_log" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO TB_C10_CLR_CMP_MNG_MDF_LOG/*+ C10 품질설계 칼라코드관리 C106000050.detaildelete_log 성낙원 */ (
    CLR_SUB_MTL_CD,--칼라부재료코드
    PNT_CMP_CD,--도료업체코드
    MDF_SEQ, --수정 Seq
    MDF_RSN, --수정 사유
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)VALUES(
    :CLR_SUB_MTL_CD,
    :PNT_CMP_CD,
    nvl((select max(mdf_seq)+1 from TB_C10_CLR_CMP_MNG_MDF_LOG where CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD and PNT_CMP_CD = :PNT_CMP_CD),0), --수정 Seq No
    :MDF_RSN, -- 수정 사유
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp)
		 ]]> 
	 </query>
	 <query id="C106000050.clrMngMdf_log" desc="C106000050.clrMngMdf_log" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO TB_C10_CLR_CD_MNG_MDF_LOG /* C10 칼라코드로그 C106000050.colorloginsert JKJ */
(
    CLR_SUB_MTL_CD,
    MDF_SEQ,
    MDF_RSN,
    SUB_MTL_TP,
    RSN_TP,
    LUS_RT_CD,
    LUS_RT_LLV,
    LUS_RT_ULV,
    WK_VISCO,
    PNT_FLM_THK,
    PRT_INK_TP,
    NV,
    PNT_GRA,
    SLV_GRA,
    THR_CD,
    PNT_UNT,
    PMT,
    QT_L, QT_A, QT_B,
    STD_CLR_NM,
    LMN_KND_TP,
    LMN_BND_CD,
    LMN_BND_THR_CD,
    LMN_FLM_THK_CD,
    PTT_FLM_LUS_RT_CD,
    PTT_FLM_THK_CD,
    PTT_FLM_MQL_CD,
    PTT_FLM_SUS_ADH_CD,
    PTT_FLM_PRD_ADH_CD,
    RMRK,
    RGS_PRS_ID,
    RGS_DH,
    MDF_PRS_ID,
    CLR_MDF_DH,
    CLR_SUB_MTL_CD_OLD,
    RSN_TP_OLD,
    LUS_RT_CD_OLD,
    PNT_FLM_THK_OLD,
    USE_YN,
    ERP_SND_DH,
    MGR_CLR_SUB_MTL_CD,
    MOD_YN,
    RAL_CD,
    RL_LUS_RT,
    EX_YN,
    TP_CD,
    COL_DIF_STD,
    EX_YN1,
    LMN_BND_CD1,
    LMN_BND_THR_CD1,
    RSN_TP_QT,
    PAT_CD,
    FUNC_CD,
    TTE_CD,
    USE_POS_CD,
    WTY_YN,
    LAMINA_INS_YN,
    PUR_CHR_CFM,
    RSN_TP_QT_BR,
    CREATED_OBJECT_TYPE,
    CREATED_OBJECT_ID,
    CREATED_PROGRAM_ID,
    CREATION_TIMESTAMP,
    LAST_UPDATED_OBJECT_TYPE,
    LAST_UPDATED_OBJECT_ID,
    LAST_UPDATE_PROGRAM_ID,
    LAST_UPDATE_TIMESTAMP
)
SELECT  CLR_SUB_MTL_CD,
        NVL((SELECT MAX(MDF_SEQ)+1 
               FROM TB_C10_CLR_CD_MNG_MDF_LOG
              WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD),0),
        :MDF_RSN,
        SUB_MTL_TP,
        RSN_TP,
        LUS_RT_CD,
        LUS_RT_LLV,
        LUS_RT_ULV,
        WK_VISCO,
        PNT_FLM_THK,
        PRT_INK_TP,
        NV,
        PNT_GRA,
        SLV_GRA,
        THR_CD,
        PNT_UNT,
        PMT,
        QT_L, QT_A, QT_B,
        STD_CLR_NM,
        LMN_KND_TP,
        LMN_BND_CD,
        LMN_BND_THR_CD,
        LMN_FLM_THK_CD,
        PTT_FLM_LUS_RT_CD,
        PTT_FLM_THK_CD,
        PTT_FLM_MQL_CD,
        PTT_FLM_SUS_ADH_CD,
        PTT_FLM_PRD_ADH_CD,
        RMRK,
        RGS_PRS_ID,
        RGS_DH,
        MDF_PRS_ID,
        CLR_MDF_DH,    
        CLR_SUB_MTL_CD_OLD,
        RSN_TP_OLD,
        LUS_RT_CD_OLD,
        PNT_FLM_THK_OLD,
        USE_YN,
        ERP_SND_DH,
        MGR_CLR_SUB_MTL_CD,
        MOD_YN,
        RAL_CD,
        RL_LUS_RT,
        EX_YN,
        TP_CD,
        COL_DIF_STD,
        EX_YN1,
        LMN_BND_CD1,
        LMN_BND_THR_CD1,
        RSN_TP_QT,
        PAT_CD,
        FUNC_CD,
        TTE_CD,
        USE_POS_CD,
        WTY_YN,
        LAMINA_INS_YN,
        PUR_CHR_CFM,
        RSN_TP_QT_BR,
        :ObjectType,
        :ObjectId,
        :ProgramId,
        :Timestamp,
        LAST_UPDATED_OBJECT_TYPE,
        LAST_UPDATED_OBJECT_ID,
        LAST_UPDATE_PROGRAM_ID,
        LAST_UPDATE_TIMESTAMP
FROM TB_C10_CLR_CD_MNG
WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.fileuploadinsert" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO C10APUSER.TB_C10_CLR_CD_IMG_MNG(
             CLR_SUB_MTL_CD
            ,CLR_SUB_MTL_CD_SEQ_NO
            ,CLR_SUB_MTL_CD_RGS_DH
            ,CLR_SUB_MTL_CD_RGS_PRS_ID
            ,CLR_SUB_MTL_CD_MDF_DH
            ,CLR_SUB_MTL_CD_MDF_PRS_ID 
            ,IMAGE_YN
            ,FILE_YN
            ,CREATED_OBJECT_TYPE 
            ,CREATED_OBJECT_ID 
            ,CREATED_PROGRAM_ID
            ,CREATION_TIMESTAMP
            ,LAST_UPDATED_OBJECT_TYPE
            ,LAST_UPDATED_OBJECT_ID
            ,LAST_UPDATE_PROGRAM_ID
            ,LAST_UPDATE_TIMESTAMP)
VALUES(:CLR_SUB_MTL_CD
       ,(SELECT NVL(MAX(CLR_SUB_MTL_CD)+1,1) 
        FROM TB_C10_CLR_CD_IMG_MNG 
        WHERE CLR_SUB_MTL_CD =  :CLR_SUB_MTL_CD)
       ,SYSDATE
       ,:ObjectId
       ,SYSDATE
       ,:ObjectId
       ,'N'
       ,'N'
       ,:ObjectType
       ,:ObjectId 
       ,:ProgramId
       ,:Timestamp
       ,:ObjectType
       ,:ObjectId
       ,:ProgramId
       ,:Timestamp)
		 ]]> 
	 </query>
	 <query id="C106000050.fileuploadupdate" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE TB_C10_CLR_CD_IMG_MNG
   SET LAST_UPDATE_PROGRAM_ID = :ProgramId
 	WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
	   AND CLR_SUB_MTL_CD_SEQ_NO= :CLR_SUB_MTL_CD_SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000050.fileuploaddelete" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
DELETE FROM C10APUSER.TB_C10_CLR_CD_IMG_MNG
 	WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
	   AND CLR_SUB_MTL_CD_SEQ_NO= :CLR_SUB_MTL_CD_SEQ_NO
		 ]]> 
	 </query>
	 <query id="C106000050.compAjaxFind" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C10 칼라코드관리- 업체코드AJAX조회 C106000050.compAjaxFind 이돈석 */ 
       CLR_SUB_MTL_CD
  FROM C10APUSER.TB_C10_CLR_CMP_MNG
 WHERE CLR_SUB_MTL_CD = :CLR_SUB_MTL_CD
		 ]]> 
	 </query>
	 <query id="C106000050.colorselect2" desc="구매,생산라미나 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C10 칼라코드관리- 구매,생산라미나 조회 C106000050.colorselect2 이돈석 */ 
       DECODE(A.USE_YN,'Y','1','N','0') AS USE_YN,--사용여부
       A.CLR_SUB_MTL_CD,
       A.CLR_NM,
       A.SUB_MTL_TP,
       A.SUB_MTL_TP AS SUB_MTL_TP_HIDDEN,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='SUB_MTL_TP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = SUB_MTL_TP) SUB_MTL_TP_NM,
       RSN_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP) RSN_TP_NM,
       RSN_TP_QT_BR,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP_QT_BR'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP_QT_BR) RSN_TP_QT_BR_NM,
       LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LUS_RT_CD) LUS_RT_NM,
       LUS_RT_LLV,
       LUS_RT_ULV,
       TP_CD,
       RL_LUS_RT,
       DECODE(EX_YN,'Y','1','N','0') AS EX_YN,
       COL_DIF_STD,
       DECODE(EX_YN1,'Y','1','N','0') AS EX_YN1,
       WK_VISCO,
       PNT_FLM_THK,
       PRT_INK_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PRT_INK_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PRT_INK_TP) PRT_INK_TP_NM,
       NV,
       PNT_GRA,
       SLV_GRA,
       THR_CD,
       PNT_UNT,
       PMT,
       QT_L,
       QT_A,
       QT_B,
       STD_CLR_NM,
       LMN_KND_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_KND_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_KND_TP) LMN_KND_TP_NM,
       LMN_BND_CD,
       LMN_BND_THR_CD,
       LMN_BND_CD1,
       LMN_BND_THR_CD1,
       LMN_FLM_THK_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_FLM_THK_CD) LMN_FLM_THK_CD_NM,  --Lamina필름두께코드
       PTT_FLM_LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_LUS_RT_CD) PTT_FLM_LUS_RT_NM,
       PTT_FLM_THK_CD,
      (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_THK_CD) PTT_FLM_THK_NM,
       PTT_FLM_MQL_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_MQL_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_MQL_CD) PTT_FLM_MQL_NM,
       PTT_FLM_SUS_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_SUS_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_SUS_ADH_CD) PTT_FLM_SUS_ADH_NM,
       PTT_FLM_PRD_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_PRD_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_PRD_ADH_CD) PTT_FLM_PRD_ADH_NM,
       RMRK,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.CREATED_OBJECT_ID) AS RGS_PRS_ID,
       TO_CHAR(RGS_DH, 'YYYY-MM-DD HH24:MI:SS') AS RGS_DH,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.LAST_UPDATED_OBJECT_ID)AS MDF_PRS_ID,
       TO_CHAR(CLR_MDF_DH, 'YYYY-MM-DD HH24:MI:SS') AS CLR_MDF_DH,
       MGR_CLR_SUB_MTL_CD,
       CLR_SUB_MTL_CD_OLD,
       RSN_TP_OLD,
       LUS_RT_CD_OLD,
       PNT_FLM_THK_OLD,
       TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS') AS ERP_SND_DH,  --ERP전송일시 추가
       MOD_YN,
       RAL_CD, 
       CASE
        WHEN TO_CHAR(A.LAST_UPDATE_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS') > NVL(TO_CHAR(A.ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS'),'1900-01-01 00:00:00')THEN 'Y'
        ELSE 'N'
        END SND_LST,
        '' as USERNO,
        RSN_TP_QT,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP_QT'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP_QT) RSN_TP_QT_NM,
        PAT_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PAT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PAT_CD) PAT_CD_NM,
        FUNC_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='FUNC_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = FUNC_CD) FUNC_CD_NM,
        TTE_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='TTE_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = TTE_CD) TTE_CD_NM,
        USE_POS_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='USE_POS_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = USE_POS_CD) USE_POS_CD_NM,
        WTY_YN,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='WTY_YN'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = WTY_YN) WTY_YN_NM,
        LAMINA_INS_YN,
        PUR_CHR_CFM,
        NVL(B.IMAGE_YN,'N') AS MIMAGE_YN,
        NVL(B.FILE_YN,'N')  AS MFILE_YN,
        (SELECT IMG_NM FROM C10APUSER.TB_C10_CLR_CD_IMG WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD AND PRD_SPC_TP = '9' AND ROWNUM = 1) AS PCM_SPEC_FILE1,
        (SELECT IMG_NM FROM C10APUSER.TB_C10_CLR_CD_IMG WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD AND PRD_SPC_TP = '0' AND ROWNUM = 1) AS COST_STM_FILE1,
        A.LAST_UPDATED_OBJECT_ID AS LAST_UPDATED_OBJECT_ID
  FROM C10APUSER.TB_C10_CLR_CD_MNG A,
       C10APUSER.TB_C10_CLR_CD_IMG_MNG B
 WHERE A.CLR_SUB_MTL_CD = B.CLR_SUB_MTL_CD(+)
   AND NVL(A.CLR_SUB_MTL_CD,'%') LIKE  :CLR_SUB_MTL_CD_SH ||'%'
   AND A.SUB_MTL_TP IN ('S38','S40')
   AND NVL(A.TP_CD,'%') LIKE '%' || :TP_CD ||'%'
   AND NVL(A.RSN_TP,'%') LIKE '%' || :RSN_TP_SH ||'%'
   AND NVL(A.RSN_TP_QT_BR,'%') LIKE '%' || :RSN_TP_QT_BR_SH ||'%'
   AND NVL(A.LUS_RT_CD,'%') LIKE '%' || :LUS_RT_CD_SH ||'%'
   AND NVL(A.PRT_INK_TP,'%') LIKE '%' || :PRT_INK_TP_SH ||'%'
   AND (NVL(A.RAL_CD,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || UPPER(:RAL_CD||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || LOWER(:RAL_CD||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_SUB_MTL_CD_OLD,'%') LIKE '%' || :RAL_CD ||'%')
ORDER BY A.RGS_DH
		 ]]> 
	 </query>
	 <query id="C106000050.colorselect3" desc="구매,생산UGS 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C10 칼라코드관리- 구매,생산UGS 조회 C106000050.colorselect3 이돈석 */ 
       DECODE(A.USE_YN,'Y','1','N','0') AS USE_YN,--사용여부
       A.CLR_SUB_MTL_CD,
       A.CLR_NM,
       A.SUB_MTL_TP,
       A.SUB_MTL_TP AS SUB_MTL_TP_HIDDEN,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='SUB_MTL_TP_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = SUB_MTL_TP) SUB_MTL_TP_NM,
       RSN_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP) RSN_TP_NM,
       RSN_TP_QT_BR,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP_QT_BR'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP_QT_BR) RSN_TP_QT_BR_NM,
       LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LUS_RT_CD) LUS_RT_NM,
       LUS_RT_LLV,
       LUS_RT_ULV,
       TP_CD,
       RL_LUS_RT,
       DECODE(EX_YN,'Y','1','N','0') AS EX_YN,
       COL_DIF_STD,
       DECODE(EX_YN1,'Y','1','N','0') AS EX_YN1,
       WK_VISCO,
       PNT_FLM_THK,
       PRT_INK_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PRT_INK_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PRT_INK_TP) PRT_INK_TP_NM,
       NV,
       PNT_GRA,
       SLV_GRA,
       THR_CD,
       PNT_UNT,
       PMT,
       QT_L,
       QT_A,
       QT_B,
       STD_CLR_NM,
       LMN_KND_TP,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_KND_TP'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_KND_TP) LMN_KND_TP_NM,
       LMN_BND_CD,
       LMN_BND_THR_CD,
       LMN_BND_CD1,
       LMN_BND_THR_CD1,
       LMN_FLM_THK_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='LMN_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = LMN_FLM_THK_CD) LMN_FLM_THK_CD_NM,  --Lamina필름두께코드
       PTT_FLM_LUS_RT_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_LUS_RT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_LUS_RT_CD) PTT_FLM_LUS_RT_NM,
       PTT_FLM_THK_CD,
      (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_THK_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_THK_CD) PTT_FLM_THK_NM,
       PTT_FLM_MQL_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_MQL_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_MQL_CD) PTT_FLM_MQL_NM,
       PTT_FLM_SUS_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_SUS_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_SUS_ADH_CD) PTT_FLM_SUS_ADH_NM,
       PTT_FLM_PRD_ADH_CD,
       (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PTT_FLM_PRD_ADH_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PTT_FLM_PRD_ADH_CD) PTT_FLM_PRD_ADH_NM,
       RMRK,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.CREATED_OBJECT_ID) AS RGS_PRS_ID,
       TO_CHAR(RGS_DH, 'YYYY-MM-DD HH24:MI:SS') AS RGS_DH,
       (SELECT USER_NAME
        FROM M90APUSER.TB_M90_EMP_INF
        WHERE USER_NO = A.LAST_UPDATED_OBJECT_ID)AS MDF_PRS_ID,
       TO_CHAR(CLR_MDF_DH, 'YYYY-MM-DD HH24:MI:SS') AS CLR_MDF_DH,
       MGR_CLR_SUB_MTL_CD,
       CLR_SUB_MTL_CD_OLD,
       RSN_TP_OLD,
       LUS_RT_CD_OLD,
       PNT_FLM_THK_OLD,
       TO_CHAR(ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS') AS ERP_SND_DH,  --ERP전송일시 추가
       MOD_YN,
       RAL_CD, 
       CASE
        WHEN TO_CHAR(A.LAST_UPDATE_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS') > NVL(TO_CHAR(A.ERP_SND_DH, 'YYYY-MM-DD HH24:MI:SS'),'1900-01-01 00:00:00')THEN 'Y'
        ELSE 'N'
        END SND_LST,
        '' as USERNO,
        RSN_TP_QT,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='RSN_TP_QT'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = RSN_TP_QT) RSN_TP_QT_NM,
        PAT_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='PAT_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = PAT_CD) PAT_CD_NM,
        FUNC_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='FUNC_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = FUNC_CD) FUNC_CD_NM,
        TTE_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='TTE_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = TTE_CD) TTE_CD_NM,
        USE_POS_CD,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='USE_POS_CD'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = USE_POS_CD) USE_POS_CD_NM,
        WTY_YN,
        (SELECT CD_V_MEANING
            FROM   M00APUSER.VI_M00_CODE_ACCESS
            WHERE  CD_TP='WTY_YN'
            AND    CATEGORY_GROUP_NM ='SZ0000'
            AND    CD_V = WTY_YN) WTY_YN_NM,
        LAMINA_INS_YN,
        PUR_CHR_CFM,
        NVL(B.IMAGE_YN,'N') AS MIMAGE_YN,
        NVL(B.FILE_YN,'N')  AS MFILE_YN,
        (SELECT IMG_NM FROM C10APUSER.TB_C10_CLR_CD_IMG WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD AND PRD_SPC_TP = '9' AND ROWNUM = 1) AS PCM_SPEC_FILE1,
        (SELECT IMG_NM FROM C10APUSER.TB_C10_CLR_CD_IMG WHERE CLR_SUB_MTL_CD = A.CLR_SUB_MTL_CD AND PRD_SPC_TP = '0' AND ROWNUM = 1) AS COST_STM_FILE1,
        A.LAST_UPDATED_OBJECT_ID AS LAST_UPDATED_OBJECT_ID
  FROM C10APUSER.TB_C10_CLR_CD_MNG A,
       C10APUSER.TB_C10_CLR_CD_IMG_MNG B
 WHERE A.CLR_SUB_MTL_CD = B.CLR_SUB_MTL_CD(+)
   AND NVL(A.CLR_SUB_MTL_CD,'%') LIKE  :CLR_SUB_MTL_CD_SH ||'%'
   AND A.SUB_MTL_TP IN ('S39','S49')
   AND NVL(A.TP_CD,'%') LIKE '%' || :TP_CD ||'%'
   AND NVL(A.RSN_TP,'%') LIKE '%' || :RSN_TP_SH ||'%'
   AND NVL(A.RSN_TP_QT_BR,'%') LIKE '%' || :RSN_TP_QT_BR_SH ||'%'
   AND NVL(A.LUS_RT_CD,'%') LIKE '%' || :LUS_RT_CD_SH ||'%'
   AND NVL(A.PRT_INK_TP,'%') LIKE '%' || :PRT_INK_TP_SH ||'%'
   AND (NVL(A.RAL_CD,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RAL_CD,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || UPPER(:RAL_CD||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || LOWER(:RAL_CD||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_NM,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.RMRK,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || UPPER(:RAL_CD ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || LOWER(:RAL_CD ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || UPPER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.STD_CLR_NM,'%') LIKE '%' || LOWER(REPLACE(:RAL_CD,' ','') ||'%') OR
        NVL(A.CLR_SUB_MTL_CD_OLD,'%') LIKE '%' || :RAL_CD ||'%')
ORDER BY A.RGS_DH
		 ]]> 
	 </query>
	 <query id="IFB10S0150.insert" desc="" isNamed="true">
		 <![CDATA[ 
INSERT INTO /* C10 부재료 정보(FMES) 전송 IF TB_C10_B10S0150.insert 서재섭*/
            TB_C10_B10S0150
            (
                  IF_GRP_ID
                 ,SEQ_NO   
                 ,XSEQ       
                 ,XCRUD  
                 ,XSTAT
				 ,XMSGS
				 ,XDATE
				 ,XTIME
				 ,XSTAT_CALLBACK 
				 ,ERP_IF_GRP_ID
				 ,ERP_SEQ_NO
				 ,CLR_SUB_MTL_CD
				 ,CLR_NM
				 ,FILM_WTH
				 ,FILM_THK
				 ,SUB_MTL_TP
				 ,LMN_KND_TP
				 ,USE_YN 
                 ,CREATED_OBJECT_TYPE         
                 ,CREATED_OBJECT_ID        
                 ,CREATED_PROGRAM_ID      
                 ,CREATION_TIMESTAMP     
                 ,LAST_UPDATED_OBJECT_TYPE
                 ,LAST_UPDATED_OBJECT_ID  
                 ,LAST_UPDATE_PROGRAM_ID  
                 ,LAST_UPDATE_TIMESTAMP     
            )
VALUES
            (
              :IF_GRP_ID,
              SQ_C10_B10S0150.NEXTVAL,
	          '1',
              'C',
              'R',
			  :XMSGS,
			  :XDATE,
			  :XTIME,
			  :XSTAT_CALLBACK,
			  :ERP_IF_GRP_ID,
			  :ERP_SEQ_NO,
			  :CLR_SUB_MTL_CD,
			  :CLR_NM,
			  '',
			  DECODE(:SUB_MTL_TP,'S40',:PNT_FLM_THK,:PTT_FLM_THK_NM),
			  :SUB_MTL_TP,
			  :LMN_KND_TP,
			  DECODE(:USE_YN,'1','Y','N'),
              :ObjectType,
              :ObjectId,
              :ProgramId,
              :Timestamp,
              :ObjectType,
              :ObjectId,
              :ProgramId,
              :Timestamp
            )
		 ]]> 
	 </query>
</queryMap>
