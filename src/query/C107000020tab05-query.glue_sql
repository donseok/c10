<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C107000020tab05 Page 쿼리파일"> 
	 <query id="C107000020tab05.select" desc="C107000020tab05 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  
 DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1  PAS_PROC_NO
,DATAS010.MD_MRG_BAS_KEY_NUM_TP_1   PROC_SEQ 
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_1 MAIN_PROC_CD
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_2 SUB_PROC_CD1
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_3 SUB_PROC_CD2
,DATAS010.MD_MRG_BAS_DATA_CHAR_TP_4 SUB_PROC_CD3
FROM M00APUSER.TB_M00_DATAS010 DATAS010, 
(SELECT MDL_DEFINE_ID  
FROM M00APUSER.TB_M00_DEFINES010 
WHERE MDL_DEFINE_NM='C10A1054' 
AND START_ACTIVE_DATE <=  SYSDATE 
AND SYSDATE < END_ACTIVE_DATE)  DEFINES010 
WHERE DEFINES010.MDL_DEFINE_ID=DATAS010.MD_MRG_BAS_ID
  AND DATAS010.MD_MRG_BAS_KEY_CHAR_TP_1 LIKE '%'||:SEARCH_CD||'%'
ORDER BY PAS_PROC_NO, PROC_SEQ
		 ]]> 
	 </query>
</queryMap>
