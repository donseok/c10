<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000020"> 
	 <query id="C104000020.select" desc="C104000020.select" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C10 품질설계결과Main C104000020.select 박재영 */
       CUS_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'CUS_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = CUS_CD) CUS_CD
      ,ACT_CUS_CD || 
       (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'CUS_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = ACT_CUS_CD) AS ACT_CUS_CD  --수요가
      ,FNL_CUS_CD || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'CUS_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = FNL_CUS_CD) AS FNL_CUS_CD  --최종수요가  
      , SPC_AVR
      ,TO_CHAR(ORD_EXC_THK,'90.000') ORD_EXC_THK
      ,TO_CHAR(ORD_EXC_WTH,'9,990.0') ORD_EXC_WTH
      ,TO_CHAR(ORD_EXC_LTH,'99,990.0') ORD_EXC_LTH
      ,(SELECT CUS_BTH_PAP_NO||' : '||CUS_BTH_NM
         FROM M00APUSER.VI_M00_C10A1020
         WHERE MDL_DEFINE_NM = 'C10A1020'
         AND   CUS_BTH_PAP_NO = A.CUS_BTH_PAP_NO) CUS_BTH_NM  --고객사양명
      ,PRD_NM_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS 
       WHERE CD_TP = 'PRD_NM_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = PRD_NM_CD) PRD_NM_CD
      ,ORD_USG_CD ||
      (SELECT  ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS 
       WHERE CD_TP = 'ORD_USG_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = ORD_USG_CD) ORD_USG_CD
      ,CUS_BTH_PAP_NO
      ,MQL_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'MQL_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = MQL_CD) MQL_CD
      ,RMTL_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'RMTL_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = RMTL_CD) RMTL_CD
      ,A.CRM_MNF_STD_NO
      ,A.HUE_CD_FRN
      ,A.PAS_PROC_NO
      ,A.CCL_BOM_NO
      ,DECODE(A.TRST_PROC_YN,'N',NULL,TRST_PROC_YN) AS TRST_PROC_YN
      ,NVL(A.ATT_ORD_YN,'N') AS ATT_ORD_YN
      ,B.RSN_TP_QT_BR_FRN || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'RSN_TP_QT_BR' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = B.RSN_TP_QT_BR_FRN) AS RSN_TP_QT_BR_FRN
      ,B.RSN_TP_QT_BR_BAK || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'RSN_TP_QT_BR' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = B.RSN_TP_QT_BR_BAK) AS RSN_TP_QT_BR_BAK
      ,B.LUXTEEL_BRD_CD || 
      (SELECT ' : ' || CD_V_MEANING 
       FROM M00APUSER.VI_M00_CODE_ACCESS
       WHERE CD_TP = 'LUXTEEL_BRD_CD' 
       AND   CATEGORY_GROUP_NM = 'SZ0000'
       AND   CD_V = B.LUXTEEL_BRD_CD) AS LUXTEEL_BRD_CD,
      (SELECT LAST_UPDATED_OBJECT_ID
          FROM C10APUSER.TB_C10_QLT_DSN_CHG_HST
         WHERE ORD_NO = :ORD_NO
           AND ORD_LN = :ORD_LN
           AND CHG_TXT = 'C104000020TAB05'
           AND SEQ = 
        (   
        SELECT MAX(SEQ)
          FROM C10APUSER.TB_C10_QLT_DSN_CHG_HST
         WHERE ORD_NO = :ORD_NO
           AND ORD_LN = :ORD_LN
           AND CHG_TXT = 'C104000020TAB05'
        )
       ) AS MOD_ID,
             (SELECT CHG_TXT
          FROM C10APUSER.TB_C10_QLT_DSN_CHG_HST
         WHERE ORD_NO = :ORD_NO
           AND ORD_LN = :ORD_LN
           AND CHG_TXT = 'C104000020TAB05'
           AND SEQ = 
        (   
        SELECT MAX(SEQ)
          FROM C10APUSER.TB_C10_QLT_DSN_CHG_HST
         WHERE ORD_NO = :ORD_NO
           AND ORD_LN = :ORD_LN
           AND CHG_TXT = 'C104000020TAB05'
        )
       ) AS MOD_PGM,
       (SELECT FUNC_USER_NM(LAST_UPDATED_OBJECT_ID)
          FROM C10APUSER.TB_C10_QLT_DSN_CHG_HST
         WHERE ORD_NO = :ORD_NO
           AND ORD_LN = :ORD_LN
           AND CHG_TXT = 'C104000020TAB05'
           AND SEQ = 
        (   
        SELECT MAX(SEQ)
          FROM C10APUSER.TB_C10_QLT_DSN_CHG_HST
         WHERE ORD_NO = :ORD_NO
           AND ORD_LN = :ORD_LN
           AND CHG_TXT = 'C104000020TAB05'
        )
       ) AS MOD_USER_NM
       , A.CUS_CD AS CUS_CD_ORG
       , A.FNL_CUS_CD AS FNL_CUS_CD_ORG
       , A.ACT_CUS_CD AS ACT_CUS_CD_ORG
       , A.PRD_NM_CD AS PRD_NM_CD_ORG
   FROM C10APUSER.TB_C10_QLT_DSN_CMN A,
        C10APUSER.TB_C10_QLT_DSN_CCL_BOM B
WHERE A.ORD_NO = B.ORD_NO(+)
AND A.ORD_LN = B.ORD_LN(+)
AND A.ORD_NO = :ORD_NO
AND A.ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020.combo" desc="C104000020.combo" fetchSize="10" isNamed="true">
		 <![CDATA[ 
select /*+ C10 품질설계결과Main C104000020.combo 박재영 */ ORD_LN
FROM TB_C10_QLT_DSN_CMN
WHERE ORD_NO = :ORD_NO
		 ]]> 
	 </query>
	 <query id="C104000020.STSselect" desc="C104000020.STSselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C104000020.STSselect 박재영*/      
*                               
 FROM TB_C10_QLT_DSN_CMN
 WHERE ORD_NO = :ORD_NO
 AND    ORD_LN = :ORD_LN
 AND    (QLT_DSN_STS_CD != 'B'
 OR       ORD_BAK_SND_TP = 'R'
 OR       QLT_HLD_YN = 'Y')
		 ]]> 
	 </query>
	 <query id="C104000020.update" desc="C104000020.update" fetchSize="10" isNamed="true">
		 <![CDATA[ 
update /*+ C10 품질설계확정 C104000020.update 박재영 */  
TB_C10_QLT_DSN_CMN
SET         LAST_UPDATED_OBJECT_TYPE = :ObjectType,
       LAST_UPDATED_OBJECT_ID = :ObjectId,
       LAST_UPDATE_PROGRAM_ID = :ProgramId,
       LAST_UPDATE_TIMESTAMP = :Timestamp,
       QLT_DSN_STS_CD = 'A' ,
       QLT_DSN_CFM_PRS_ID = :ObjectId,	 --품질설계확정자ID
      QLT_DSN_CFM_DH = TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS')      --품질설계완료일시
WHERE ORD_NO = :ORD_NO
AND ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020.update1" desc="C104000020.update1" fetchSize="10" isNamed="true">
		 <![CDATA[ 
update /*+ C10 품질설계확정 C104000020.update1 이돈석 */  
TB_C10_QLT_DSN_CMN
SET    LAST_UPDATED_OBJECT_TYPE = :ObjectType,
       LAST_UPDATED_OBJECT_ID = :ObjectId,
       LAST_UPDATE_PROGRAM_ID = :ProgramId,
       LAST_UPDATE_TIMESTAMP = :Timestamp,
       QLT_HLD_YN = 'Y',
       QLT_DSN_CFM_PRS_ID = :ObjectId,	 --품질설계확정자ID
      QLT_DSN_CFM_DH = TO_DATE(TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS'),'YYYYMMDDHH24MISS')      --품질설계완료일시
WHERE ORD_NO = :ORD_NO
AND ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020.update2" desc="C104000020.update2" fetchSize="10" isNamed="true">
		 <![CDATA[ 
update /*+ C10 품질설계확정 C104000020.update2 이돈석 */  
TB_C10_QLT_DSN_CMN
SET    LAST_UPDATED_OBJECT_TYPE = :ObjectType,
       LAST_UPDATED_OBJECT_ID = :ObjectId,
       LAST_UPDATE_PROGRAM_ID = :ProgramId,
       LAST_UPDATE_TIMESTAMP = :Timestamp,
       QLT_HLD_YN = '',
       QLT_DSN_CFM_PRS_ID = '',	 --품질설계확정자ID
      QLT_DSN_CFM_DH = ''
WHERE ORD_NO = :ORD_NO
AND ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020.IFinsert" desc="C104000020.IFinsert" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 품질설계결과IF C104000020.IFinsert 박재영*/
            EAIAPUSER.TB_C10_B10S1010
            (
                  IF_GRP_ID
                 ,SEQ_NO   
                 ,XSEQ       
                 ,XCRUD  
                 ,XSTAT  
                 ,ORD_NO
                 ,ORD_LN
                 ,QLT_DSN_STS
                 ,QLT_DSN_MSG
                 ,CREATED_OBJECT_TYPE         
                 ,CREATED_OBJECT_ID        
                 ,CREATED_PROGRAM_ID      
                 ,CREATION_TIMESTAMP     
                 ,LAST_UPDATED_OBJECT_TYPE
                 ,LAST_UPDATED_OBJECT_ID  
                 ,LAST_UPDATE_PROGRAM_ID  
                 ,LAST_UPDATE_TIMESTAMP     
            )
VALUES
            (
              TO_CHAR(SYSDATE, 'YYYYMMDDHH24MISSSSS'),
              EAIAPUSER.SQ_C10_B10S1010.NEXTVAL,
		      '1',
              'C',
              'R',
              :ORD_NO,
              :ORD_LN,
              'A',
              'B',
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp,
    :ObjectType,
    :ObjectId,
    :ProgramId,
    :Timestamp
)
		 ]]> 
	 </query>
	 <query id="C104000020.ERRselect" desc="C104000020.ERRselect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과공통조회 C104000020.ERRselect 박재영*/      
          SUM(DECODE(A.QLT_DSN_ERR_CD,'CF80',1,'CF81',1,0)) -  
          SUM(DECODE(A.QLT_DSN_ERR_CD,'CF80',0,'CF81',0,1)) NO_THK
FROM   C10APUSER.TB_C10_QLT_DSN_ERR A, C10APUSER.TB_C10_QLT_DSN_CMN B
WHERE  A.ORD_NO = B.ORD_NO
AND    A.ORD_LN = B.ORD_LN
AND    A.ORD_NO = :ORD_NO
AND    A.ORD_LN = :ORD_LN
AND    B.QLT_DSN_STS_CD = 'E'
AND    NVL(B.ORD_BAK_SND_TP,' ') != 'R'
		 ]]> 
	 </query>
	 <query id="C104000020.PROCselect" desc="CP통과공정확인" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT *
  FROM TB_C10_QLT_DSN_PROC
 WHERE ORD_NO = :ORD_NO
   AND ORD_LN = :ORD_LN
   AND (MAIN_PROC_CD = 'CP' OR SUB_PROC_CD1 = 'CP' OR SUB_PROC_CD2 = 'CP')
		 ]]> 
	 </query>
	 <query id="C104000020.update3" desc="관심주문등록" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 관심주문등록 C104000020.update3 이돈석 */  
TB_C10_QLT_DSN_CMN
SET    LAST_UPDATED_OBJECT_TYPE = :ObjectType,
       LAST_UPDATED_OBJECT_ID = :ObjectId,
       LAST_UPDATE_PROGRAM_ID = :ProgramId,
       LAST_UPDATE_TIMESTAMP = :Timestamp,
       ATT_ORD_YN = 'Y'
WHERE ORD_NO = :ORD_NO
AND ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020.update4" desc="관심주문등록해제" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 관심주문등록해제 C104000020.update4 이돈석 */  
TB_C10_QLT_DSN_CMN
SET    LAST_UPDATED_OBJECT_TYPE = :ObjectType,
       LAST_UPDATED_OBJECT_ID = :ObjectId,
       LAST_UPDATE_PROGRAM_ID = :ProgramId,
       LAST_UPDATE_TIMESTAMP = :Timestamp,
       ATT_ORD_YN = 'N'
WHERE ORD_NO = :ORD_NO
AND ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020.AttOrdInsert" desc="C10 관심주문SMS전송대상" fetchSize="10" isNamed="true">
		 <![CDATA[ 
INSERT INTO /*+ C10 관심주문SMS전송대상 C104000020.AttOrdInsert 이돈석*/
            C10APUSER.TB_C10_ATT_ORD_MNG
            (
                  ORD_NO 
                , ORD_LN
                , ATT_ORD_RGS_ID
                , ATT_ORD_RGS_DH
                , ATT_RGS_TP
                , CREATED_OBJECT_TYPE         
                , CREATED_OBJECT_ID        
                , CREATED_PROGRAM_ID      
                , CREATION_TIMESTAMP     
                , LAST_UPDATED_OBJECT_TYPE
                , LAST_UPDATED_OBJECT_ID  
                , LAST_UPDATE_PROGRAM_ID  
                , LAST_UPDATE_TIMESTAMP     
            )
VALUES
            (
                  :ORD_NO
                , :ORD_LN
                , :ObjectId
                , sysdate
                , 'A'
                , :ObjectType
                , :ObjectId
                , :ProgramId
                , :Timestamp
                , :ObjectType
                , :ObjectId
                , :ProgramId
                , :Timestamp
            )
		 ]]> 
	 </query>
	 <query id="C104000020.AttOrdDelete" desc="C10 관심주문SMS전송대상삭제" fetchSize="10" isNamed="true">
		 <![CDATA[ 
/*+ C10 관심주문SMS전송대상삭제 C104000020.AttOrdDelete 이돈석*/
DELETE C10APUSER.TB_C10_ATT_ORD_MNG
 WHERE ORD_NO = :ORD_NO
   AND ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020.SMSselect" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 품질설계결과 SMS상태확인 C104000020.SMSselect 이돈석 */ 
  *
  FROM TB_C10_ATT_ORD_MNG
 WHERE ORD_NO = :ORD_NO
   AND ORD_LN = :ORD_LN
   AND (NVL(TO_CHAR(SMS_SND_DH),'@') != '@' OR ATT_RGS_TP = 'M')
		 ]]> 
	 </query>
	 <query id="C104000020.AttSmsupdate" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
UPDATE /*+ C10 품질설계확정 C104000020.AttSmsupdate 이돈석 */  
TB_C10_ATT_ORD_MNG
SET    LAST_UPDATED_OBJECT_TYPE = :ObjectType,
       LAST_UPDATED_OBJECT_ID = :ObjectId,
       LAST_UPDATE_PROGRAM_ID = :ProgramId,
       LAST_UPDATE_TIMESTAMP = :Timestamp,
       ATT_ORD_RGS_ID  = :ObjectId	 --품질설계확정자ID
WHERE ORD_NO = :ORD_NO
  AND ORD_LN = :ORD_LN
		 ]]> 
	 </query>
	 <query id="C104000020.selectForB20R5030" desc="품질설계 확정결과 M20송신" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C104000020  품질설계확정결과송신  C104000020.selectForB20R5030  이돈석  */
     'B20R5030' AS TC_CD           --TC코드
     , :ORD_NO AS ORD_NO           --주문번호 
     , :ORD_LN AS ORD_LN          --주문행번
     , 'Y' AS QLT_DSN_CFM_YN       --품질설계확정여부
FROM DUAL
		 ]]> 
	 </query>
	 <query id="C104000020.MODselect" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT LAST_UPDATED_OBJECT_ID/* C10 품질설계변경이력조회 C104000020.MODselect 이돈석*/      
  FROM C10APUSER.TB_C10_QLT_DSN_CHG_HST
 WHERE ORD_NO = :ORD_NO
   AND ORD_LN = :ORD_LN
   AND CHG_TXT = 'C104000020TAB05'
   AND SEQ = 
(   
    SELECT MAX(SEQ)
      FROM C10APUSER.TB_C10_QLT_DSN_CHG_HST
     WHERE ORD_NO = :ORD_NO
       AND ORD_LN = :ORD_LN
       AND CHG_TXT = 'C104000020TAB05'
)
		 ]]> 
	 </query>
	 <query id="C104000020.QLTselect" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /* C10 품질협정서 조회 C104000020.QLTselect 이돈석*/ COUNT(*) AS QLT_CNT
  FROM TB_M20_QLTIV_CUS_SQ
 WHERE CUS_SPC_TP_CD = '3'
   AND CUS_CD IN (:CUS_CD,:FNL_CUS_CD,:ACT_CUS_CD)
		 ]]> 
	 </query>
	 <query id="C104000020.PROCselect1" desc="" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT *
  FROM TB_C10_QLT_DSN_PROC
 WHERE ORD_NO = :ORD_NO
   AND ORD_LN = :ORD_LN
   AND (MAIN_PROC_CD = '82' OR SUB_PROC_CD1 = '82' OR SUB_PROC_CD2 = '82')
		 ]]> 
	 </query>
</queryMap>
