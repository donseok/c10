<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C106000040 Page 쿼리파일"> 
	 <query id="C106000040.select" desc="C106000040 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 Material Code관리 C106000040.select 이민균 */
       MTL_CD   --Material Code
      ,MAT_TYPE || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'MAT_TYPE'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = MAT_TYPE) AS MAT_TYPE--자재유형
      ,PRD_NM_CD || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_NM_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_NM_CD) AS PRD_NM_CD--품명코드
      ,PRD_SHP || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PRD_TP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PRD_SHP) AS PRD_SHP--제품형태
      ,MQL_CD || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'MQL_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = MQL_CD) AS MQL_CD--재질코드
      ,ORD_GW_ASG_CD || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'GW_ASG_CD'         
         AND   CATEGORY_GROUP_NM = DECODE(PRD_NM_CD,'G','SG0000','K','SG0000','H','SG0000','Z','SG0000','J','SG0000','3','SG0000',
                                          'L','SL0000','M','SL0000','4','SL0000','V','SV0000','6','SV0000','W','SW0000','9','SW0000',
                                          'E','SE0000','F','SE0000','2','SE0000','N','SE0000','8','SE0000')
         AND   CD_V = ORD_GW_ASG_CD) AS ORD_GW_ASG_CD--도금량지정코드    
      ,ORD_ROU_CD --표면조도
      ,ORD_SPNL_TP || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'MTL_SPNL_TP'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = ORD_SPNL_TP) AS ORD_SPNL_TP--스팽글
      ,ORD_SUR_HND_CD || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'ORD_SUR_HND_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = ORD_SUR_HND_CD) AS ORD_SUR_HND_CD--표면처리(도금후처리)
      ,CCL_BOM_NO  --CCL BOM 코드
      ,CUS_REQ_ROL_THK --압연 Set 두께
      ,ORD_EXC_WTH  --주문폭
      ,ORD_PAK_MTH || (SELECT ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'ORD_PAK_MTH'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = ORD_PAK_MTH) AS ORD_PAK_MTH--포장벙법    
      ,PTT_FLM_DTL_CD  --보호필름코드
      ,STD_CST  --표준원가
      ,TO_CHAR(MTL_RCV_DH, 'YYYY-MM-DD HH24:MI:SS') AS MTL_RCV_DH  --수신일시
   FROM
      TB_C10_MTL_MST  
   WHERE
        MTL_CD like :MTL_CD || '%'
   AND  NVL(PRD_NM_CD,' ') like :PRD_NM_CD || '%'
   AND  NVL(PRD_SHP,' ') like :PRD_SHP || '%'
   AND  NVL(MQL_CD,' ') like :MQL_CD || '%'
   AND  NVL(ORD_GW_ASG_CD,' ') like :ORD_GW_ASG_CD || '%'
   AND  NVL(CCL_BOM_NO,' ') like :CCL_BOM_NO || '%'
		 ]]> 
	 </query>
	 <query id="C106000040.update" desc="C106000040 정보 수정" isNamed="true">
		 <![CDATA[ 
UPDATE EMP
            SET ENAME=:ENAME,            
	    JOB=:JOB,
	    MGR=:MGR,
	    HIREDATE=:HIREDATE,
	    SAL=:SAL,
	    COMM=:COMM,
	    DEPTNO=:DEPTNO
            WHERE EMPNO=:EMPNO
		 ]]> 
	 </query>
	 <query id="C106000040.delete" desc="C106000040 정보 삭제" isNamed="true">
		 <![CDATA[ 
DELETE FROM EMP
            WHERE EMPNO=:EMPNO
		 ]]> 
	 </query>
	 <query id="C106000040.insert" desc="C106000040 정보 추가" isNamed="true">
		 <![CDATA[ 
INSERT INTO EMP(EMPNO, ENAME, JOB, MGR, HIREDATE, SAL, COMM, DEPTNO)
            VALUES(:EMPNO,:ENAME, :JOB, :MGR,:HIREDATE, :SAL,:COMM,:DEPTNO)
		 ]]> 
	 </query>
	 <query id="C106000040.detailSelect" desc="C106000040.detailSelect" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT  /*+ C10 Material Code관리 C106000040.detailSelect 이민균 */
       MTL_CD,--MATERIALCODE
    PLNT_TP,--플랜트구분
    PROC_SEQ,--공정순서
    (SELECT CD_V || ' : ' || CD_V_MEANING 
         FROM M00APUSER.VI_M00_CODE_ACCESS
         WHERE CD_TP = 'PROC_CD'         
         AND   CATEGORY_GROUP_NM = 'SZ0000'
         AND   CD_V = PROC_CD) AS  PROC_CD, --공정코드    
    SEM_PROD_MTL_CD,--반제품MATERIALCODE
    MTL_RCV_DH,
TO_CHAR(MTL_RCV_DH,'yyyy-mm-dd hh24:mi:ss') AS MTL_RCV_DH--수신일시
FROM TB_C10_MTL_SEM_PROD
WHERE MTL_CD =:MTL_CD
		 ]]> 
	 </query>
</queryMap>
