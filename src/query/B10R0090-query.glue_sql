AND CUS_CMPL_LN = ?
AND COIL_ID = ?
		 ]]> 
	 </query>
	 <query id="B10R0090.modify" desc="." fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE /*+ C10 고객불만이력 B10R0090 update_ B10R0090.modify 김민섭*/                      
EAIAPUSER.TB_C10_B10R0090
SET    
       LAST_UPDATED_OBJECT_TYPE = ?  --최종변경OBJECT유형
      ,LAST_UPDATED_OBJECT_ID = ?    --최종변경OBJECTID  
      ,LAST_UPDATE_PROGRAM_ID = ?    --최종변경프로그램ID
      ,LAST_UPDATE_TIMESTAMP = ?     --최종변경일시    
      ,XSTAT = ?                     --PI 처리 상태
      ,XMSGS = ?                     --PI 에러 메세지
      ,XSTAT_CALLBACK = ?            --PI 처리 상태
WHERE IF_GRP_ID = ?                  --Interface Group ID                                                                                      
  AND SEQ_NO = ?                     --Interface SEQ
  AND XSEQ = ?                       --PI Sequence Key Value
		 ]]> 
	 </query>
	 <query id="B10R0090_C10.update" desc="" fetchSize="10" isNamed="false">
		 <![CDATA[ 
UPDATE 
C10APUSER.TB_C10_CUS_CMPL_HST                                                                             
SET    
       LAST_UPDATED_OBJECT_TYPE = ?
      ,LAST_UPDATED_OBJECT_ID = ?    
      ,LAST_UPDATE_PROGRAM_ID = ?    
      ,LAST_UPDATE_TIMESTAMP = ?  
      ,CUS_CD = SUBSTR(CUS_CD, -6)
      ,ORD_LN = SUBSTR(ORD_LN, -3)
      ,FNL_CUS_CD = SUBSTR(FNL_CUS_CD, -6)                                                                                                                
WHERE CUS_CMPL_NO = ?
AND CUS_CMPL_LN = ?
AND COIL_ID = ?
		 ]]> 
	 </query>
</queryMap>
