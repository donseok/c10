	 <query id="B10R0090.select" desc="고객불만이력수신" fetchSize="10" isNamed="false">
		 <![CDATA[ 
SELECT /* 고객불만이력수신 B10R0090.select 김민섭 */ 
*
FROM
EAIAPUSER.TB_C10_B10R0090
WHERE XSTAT='D'
ORDER BY IF_GRP_ID, SEQ_NO
		 ]]> 
	 </query>
	 <query id="B10R0090_C10.select" desc="고객불만이력 존재유무 조회" fetchSize="10">
		 <![CDATA[ 
SELECT
CUS_CMPL_NO, 
FNL_CUS_CD, 
FNL_CUS_NM, 
SAL_END_DD, 
PRD_NM, 
CCL_BOM_NO, 
ORD_USG_NM, 
CMPL_CFM_COIL_WGT, 
RET_COIL_WGT, 
CMPL_SIT_QLT, 
ACTL_CPN_AMT, 
CUR_UNT, 
CMPL_DATE, 
CUS_CMPL_LN, 
COIL_ID, 
TRN_DD_CNT, 
DOC_STS, 
CUS_CD, 
CUS_NM, 
PRD_GRP, 
FLOW_CHL, 
SAL_TEM, 
SAL_CHR, 
QLT_CHR, 
MTL_CD, 
ORD_NO, 
ORD_LN, 
PROC_NM, 
PRD_DD, 
DLV_DD, 
