<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C104000020POP04 Page 쿼리파일"> 
	 <query id="C104000020POP04.select" desc="C104000020POP04 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT ORD_NO, ORD_LN, WK_END_DH
, (SELECT CD_V_MEANING
   FROM   M00APUSER.VI_M00_CODE_ACCESS
   WHERE  CD_TP= 'PROC_CD'
   AND    CATEGORY_GROUP_NM ='SZ0000'
   AND    CD_V = PROC_CD) PROC_CD
FROM
    (
     SELECT A.ORD_NO, A.ORD_LN, B.WK_END_DH, C.PROC_CD
     FROM   C10APUSER.TB_C10_QLT_DSN_CMN A
            LEFT JOIN (SELECT ORD_NO, ORD_LN, MAX(WK_END_DH) WK_END_DH, MAX(PDN_PST_DD) PDN_PST_DD FROM MESAPUSER.TB_M47_PRD_ACT_CMN CMN WHERE OP_GRD = '1' GROUP BY ORD_NO, ORD_LN) B ON A.ORD_NO =B.ORD_NO AND A.ORD_LN = B.ORD_LN
            LEFT JOIN (SELECT DISTINCT ORD_NO, ORD_LN, WK_END_DH, PROC_CD FROM MESAPUSER.TB_M47_PRD_ACT_CMN WHERE OP_GRD = '1') C ON A.ORD_NO = C.ORD_NO AND A.ORD_LN = C.ORD_LN AND B.WK_END_DH = C.WK_END_DH
     WHERE  A.CCL_BOM_NO = :CCL_BOM_NO
     AND    NVL(A.ORD_END_TP,'N') <> 'E'
     AND    B.WK_END_DH IS NOT NULL
     ORDER BY B.WK_END_DH DESC
    )
WHERE ROWNUM = 1
		 ]]> 
	 </query>
<query id="C104000020POP04.selectProc" desc="C104000020POP04 통과공정 조회" fetchSize="10" isNamed="true">
		 <![CDATA[ 
SELECT /*+ C10 프로젝트 수주-통과공정 C104000020POP04.selectproc SJS */
(SELECT CD_V_MEANING
   FROM   M00APUSER.VI_M00_CODE_ACCESS
   WHERE  CD_TP= 'PROC_CD'
   AND    CATEGORY_GROUP_NM ='SZ0000'
   AND    CD_V = MAIN_PROC_CD) MAIN_PROC_CD
, (SELECT CD_V_MEANING
   FROM   M00APUSER.VI_M00_CODE_ACCESS
   WHERE  CD_TP= 'PROC_CD'
   AND    CATEGORY_GROUP_NM ='SZ0000'
   AND    CD_V = SUB_PROC_CD1) SUB_PROC_CD1  
, (SELECT CD_V_MEANING
   FROM   M00APUSER.VI_M00_CODE_ACCESS
   WHERE  CD_TP= 'PROC_CD'
   AND    CATEGORY_GROUP_NM ='SZ0000'
   AND    CD_V = SUB_PROC_CD2) SUB_PROC_CD2  
, (SELECT CD_V_MEANING
   FROM   M00APUSER.VI_M00_CODE_ACCESS
   WHERE  CD_TP= 'PROC_CD'
   AND    CATEGORY_GROUP_NM ='SZ0000'
   AND    CD_V = SUB_PROC_CD3) SUB_PROC_CD3     
, (SELECT CD_V_MEANING
   FROM   M00APUSER.VI_M00_CODE_ACCESS
   WHERE  CD_TP= 'PROC_CD'
   AND    CATEGORY_GROUP_NM ='SZ0000'
   AND    CD_V = SUB_PROC_CD4) SUB_PROC_CD4
, (SELECT CD_V_MEANING
   FROM   M00APUSER.VI_M00_CODE_ACCESS
   WHERE  CD_TP= 'PROC_CD'
   AND    CATEGORY_GROUP_NM ='SZ0000'
   AND    CD_V = SUB_PROC_CD5) SUB_PROC_CD5
, (SELECT CD_V_MEANING
   FROM   M00APUSER.VI_M00_CODE_ACCESS
   WHERE  CD_TP= 'PROC_CD'
   AND    CATEGORY_GROUP_NM ='SZ0000'
   AND    CD_V = SUB_PROC_CD6) SUB_PROC_CD6
FROM 
	(
	SELECT MAIN_PROC_CD, SUB_PROC_CD1, SUB_PROC_CD2, SUB_PROC_CD3, SUB_PROC_CD4, SUB_PROC_CD5, SUB_PROC_CD6
	FROM C10APUSER.TB_C10_QLT_DSN_PROC
	WHERE ORD_NO = :ORD_NO
	AND ORD_LN = :ORD_LN
	AND SUBSTR(MAIN_PROC_CD,0,1) = 'A'
	ORDER BY PROC_SEQ DESC
	)
WHERE ROWNUM = 1
		 ]]> 
	 </query>	 
</queryMap>
