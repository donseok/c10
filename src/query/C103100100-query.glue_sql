<?xml version="1.0" encoding="UTF-8"?> 
<queryMap desc="C103100100"> 
	 <query id="C103100100.select" desc="제조사양조회" fetchSize="10" isNamed="false">
		 <![CDATA[ 
select /* C10 품질설계원자재제조사양조회 C103100100.select 이돈석*/ 
       A.ORD_NO, A.ORD_LN, A.QLT_DSN_MNF_TP, A.RMTL_CD, A.RMTL_GRD,
       B.PLTCM_THK_TRV, B.PLTCM_SET_THK_TRV, B.PLTCM_WTH_TRV, B.PLTCM_EDG_ASG_TP,
       B.COR_WTH_TRV, B.PLTCM_WTH_TRV, B.PLTCM_WTH_SUB_PROC1_TRV, 
       B.PLTCM_WTH_SUB_PROC2_TRV, B.EGL_THK_TRV, B.EGL_WTH_TRV,
       B.TM_THK_TRV, B.TM_WTH_TRV, C.MQL_CD,
       B.CGL_THK_TRV, B.CGL_WTH_TRV, C.FNL_CUS_CD,
       (SELECT MAIN_PROC_CD 
        FROM TB_C10_QLT_DSN_PROC
        WHERE ORD_NO = C.ORD_NO
        AND ORD_LN = C.ORD_LN
        AND MAIN_PROC_CD LIKE '8%') AS CGL_MAIN_PROC_CD,
       (SELECT MAIN_PROC_CD
        FROM TB_C10_QLT_DSN_PROC
        WHERE ORD_NO = C.ORD_NO
        AND ORD_LN = C.ORD_LN
        AND MAIN_PROC_CD LIKE '9%') AS EGL_MAIN_PROC_CD,
       C.CUS_BTH_PAP_NO, C.CCL_BOM_NO, C.ORD_THK_MNG_CD, C.PRD_NM_CD, C.ORD_USG_CD, C.CUS_CD, C.ORD_EXC_THK
FROM TB_C10_QLT_DSN_RMT A, 
     TB_C10_QLT_DSN_MNF B,
     TB_C10_QLT_DSN_CMN C
WHERE A.ORD_NO = B.ORD_NO
AND   A.ORD_LN = B.ORD_LN 
AND   A.ORD_NO = C.ORD_NO
AND   A.ORD_LN = C.ORD_LN 
AND   A.QLT_DSN_MNF_TP = B.QLT_DSN_MNF_TP
AND   A.ORD_NO = ?
AND   A.ORD_LN = ?
		 ]]> 
	 </query>
</queryMap>
