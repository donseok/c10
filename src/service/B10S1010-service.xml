<?xml version="1.0" encoding="UTF-8"?>
<service name="B10S1010-service" initial="IFGroupID">
  <activity name="ERROR_LOG" class="com.unionsteel.mes.c10.activity.common.DbSetParam">
    <transition name="success" value="end" />
    <property name="param0" value="P_ERR_KEY|Y" />
    <property name="param1" value="QLT_DSN_ERR_CD|CF73" />
    <property name="param2" value="QLT_DSN_ERR_MSG|CF73" />
    <property name="param-count" value="3" />
  </activity>
  <activity name="COMMIT" class="com.unionsteel.mes.c10.activity.common.DbSetCommit">
    <transition name="success" value="end" />
    <transition name="failure" value="ERROR_LOG" />
    <property name="checkId" value="P_ERR_KEY" />
    <property name="txname" value="tx2" />
    <property name="exitFlag" value="N" />
  </activity>
  <activity name="INSERT_A" class="com.posdata.glue.biz.activity.PosInsert">
    <transition name="success" value="COMMIT" />
    <property name="param-count" value="4" />
    <property name="resultkey" value="RK_RESULT" />
    <property name="param0" value="IF_GRP_ID" />
    <property name="param1" value="ORD_NO" />
    <property name="dao" value="eaidao" />
    <property name="param2" value="ORD_LN" />
    <property name="isAudit" value="true" />
    <property name="sqlkey" value="B10S1010A.insert" />
    <property name="param3" value="QLT_DSN_STS_CD" />
  </activity>
  <activity name="ROUTER_IF_THEN" class="com.unionsteel.mes.c10.activity.common.DbConditionRouter">
    <transition name="exist" value="SEARCH_E" />
    <transition name="none" value="ERROR_LOG" />
    <property name="param1" value="sp_null" />
    <property name="param2" value="none" />
    <property name="param3" value="exist" />
    <property name="param-count" value="4" />
    <property name="param0" value="QLT_DSN_ERR_MSG" />
  </activity>
  <activity name="INSERT_E" class="com.posdata.glue.biz.activity.PosInsert">
    <transition name="success" value="COMMIT" />
    <property name="resultkey" value="RK_RESULT" />
    <property name="param-count" value="5" />
    <property name="isAudit" value="true" />
    <property name="dao" value="eaidao" />
    <property name="param0" value="IF_GRP_ID" />
    <property name="param1" value="ORD_NO" />
    <property name="param2" value="ORD_LN" />
    <property name="sqlkey" value="B10S1010E.insert" />
    <property name="param3" value="QLT_DSN_STS_CD" />
    <property name="param4" value="QLT_DSN_ERR_MSG" />
  </activity>
  <activity name="ROUTER_CHK" class="com.poscoict.glue.biz.dhtmlx.PosValueRouter">
    <transition name="error" value="ROUTER_IF_THEN" />
    <transition name="failure" value="end" />
    <transition name="success" value="SEARCH_A" />
    <property name="param0" value="QLT_DSN_STS_CD|A|success" />
    <property name="param1" value="QLT_DSN_STS_CD|E|error" />
    <property name="param2" value="QLT_DSN_STS_CD|B|att" />
    <property name="param-count" value="3" />
  </activity>
  <activity name="SEARCH_E" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="failure" value="ERROR_LOG" />
    <transition name="success" value="INSERT_E" />
    <property name="param-count" value="4" />
    <property name="resultkey" value="RK_SEARCH" />
    <property name="param0" value="QLT_DSN_ERR_MSG" />
    <property name="param1" value="ORD_NO" />
    <property name="param2" value="ORD_LN" />
    <property name="param3" value="QLT_DSN_STS_CD" />
    <property name="dao" value="mesdao" />
    <property name="sqlkey" value="C102100CMN_EIF" />
  </activity>
  <activity name="IFGroupID" class="com.poscoict.glue.biz.dhtmlx.PosIFGroupID">
    <transition name="success" value="ROUTER_CHK" />
  </activity>
  <activity name="SEARCH_A" class="com.posdata.glue.biz.activity.PosSearch">
    <transition name="failure" value="ERROR_LOG" />
    <transition name="success" value="INSERT_A" />
    <property name="dao" value="mesdao" />
    <property name="resultkey" value="RK_SEARCH" />
    <property name="param0" value="ORD_NO" />
    <property name="sqlkey" value="C102100CMN_AIF" />
    <property name="param1" value="ORD_LN" />
    <property name="param2" value="QLT_DSN_STS_CD" />
    <property name="param-count" value="3" />
  </activity>
  <transaction-manager id="tx1" commit="true" />
  <transaction-manager id="tx2" commit="true" />
</service>

