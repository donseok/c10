<column id="TST_REQ_FILE"  	 index="23" sort="sort_str_custom" align="left" width="12" type="ro" hidden="true">요청YN</column>
<column id="TST_END_FILE"  	 index="24" sort="sort_str_custom" align="left" width="12" type="ro" hidden="true">완료YN</column>
<settings>
<colwidth><![CDATA[%]]></colwidth>
</settings>
</head>
<userdata name="column-info">TST_NO,TST_PRG_CD,TST_TP,TST_REQ_ID,REQ_RGS_DH,PRD_DEV_NO,CLAIM_NO,TST_TITLE,TST_CONTENT,TST_CMP,TST_OUT_CMP,TST_LINE,CMP_RGS_DH,ORD_NO,TST_RMK,FILE_YN,TST_RSP_ID,TST_CMP_DH,TST_FLD_LOC,TST_START_DH,TST_END_DH,TST_RST,DOC_YN,TST_REQ_FILE,TST_END_FILE</userdata>
</rows>